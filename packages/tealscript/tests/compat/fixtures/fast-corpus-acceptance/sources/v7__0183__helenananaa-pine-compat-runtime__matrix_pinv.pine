//@version=6
indicator("Matrix pseudo-inverse")

values = matrix.new<float>(2, 2, na)
matrix.set(values, 0, 0, 4)
matrix.set(values, 0, 1, 7)
matrix.set(values, 1, 0, 2)
matrix.set(values, 1, 1, 6)
namespace_pinv = matrix.pinv(values)
method_pinv = values.pinv()
matrix.set(values, 0, 0, 99)

singular = matrix.new<float>(2, 2, na)
matrix.set(singular, 0, 0, 1)
matrix.set(singular, 0, 1, 2)
matrix.set(singular, 1, 0, 2)
matrix.set(singular, 1, 1, 4)
singular_pinv = matrix.pinv(singular)

tall = matrix.new<float>(3, 2, 0)
matrix.set(tall, 0, 0, 1)
matrix.set(tall, 1, 1, 1)
tall_pinv = matrix.pinv(tall)

wide = matrix.new<float>(2, 3, 0)
matrix.set(wide, 0, 0, 1)
matrix.set(wide, 1, 1, 1)
wide_pinv = wide.pinv()

all_na = matrix.new<float>(1, 1)
empty_rows_pinv = matrix.pinv(matrix.new<float>(0, 3))

plot(matrix.get(namespace_pinv, 0, 0), "namespace_00")
plot(matrix.get(namespace_pinv, 0, 1), "namespace_01")
plot(matrix.get(namespace_pinv, 1, 0), "namespace_10")
plot(matrix.get(namespace_pinv, 1, 1), "namespace_11")
plot(matrix.get(method_pinv, 0, 0), "method_00")
plot(matrix.get(singular_pinv, 0, 0), "singular_00")
plot(matrix.get(singular_pinv, 1, 1), "singular_11")
plot(matrix.rows(tall_pinv), "tall_pinv_rows")
plot(matrix.columns(tall_pinv), "tall_pinv_columns")
plot(matrix.get(tall_pinv, 1, 1), "tall_pinv_11")
plot(matrix.rows(wide_pinv), "wide_pinv_rows")
plot(matrix.columns(wide_pinv), "wide_pinv_columns")
plot(matrix.get(wide_pinv, 2, 0), "wide_pinv_20")
plot(na(matrix.pinv(all_na)) ? 1 : 0, "all_na_is_na")
plot(matrix.rows(empty_rows_pinv), "empty_rows_pinv_rows")
plot(matrix.columns(empty_rows_pinv), "empty_rows_pinv_columns")
plot(matrix.elements_count(empty_rows_pinv), "empty_rows_pinv_cells")
