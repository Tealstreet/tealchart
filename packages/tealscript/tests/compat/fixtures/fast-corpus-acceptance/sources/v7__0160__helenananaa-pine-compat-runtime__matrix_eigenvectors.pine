//@version=6
indicator("Matrix eigenvectors")

diagonal = matrix.new<float>(2, 2, 0)
matrix.set(diagonal, 0, 0, 2)
matrix.set(diagonal, 1, 1, 3)
namespace_vectors = matrix.eigenvectors(diagonal)
method_vectors = diagonal.eigenvectors()
matrix.set(diagonal, 0, 0, 99)

upper = matrix.new<float>(2, 2, 0)
matrix.set(upper, 0, 0, 3)
matrix.set(upper, 0, 1, 1)
matrix.set(upper, 1, 1, 2)
upper_vectors = matrix.eigenvectors(upper)

complex_values = matrix.new<float>(2, 2, 0)
matrix.set(complex_values, 0, 1, -1)
matrix.set(complex_values, 1, 0, 1)

all_na = matrix.new<float>(1, 1)
empty_vectors = matrix.eigenvectors(matrix.new<float>(0, 0))

plot(matrix.get(namespace_vectors, 0, 0), "namespace_0_0")
plot(matrix.get(namespace_vectors, 1, 1), "namespace_1_1")
plot(matrix.get(method_vectors, 0, 0), "method_0_0")
plot(matrix.get(upper_vectors, 0, 0), "upper_0_0")
plot(matrix.get(upper_vectors, 1, 0), "upper_1_0")
plot(matrix.get(upper_vectors, 0, 1), "upper_0_1")
plot(matrix.get(upper_vectors, 1, 1), "upper_1_1")
plot(na(matrix.eigenvectors(complex_values)) ? 1 : 0, "complex_is_na")
plot(na(matrix.eigenvectors(all_na)) ? 1 : 0, "all_na_is_na")
plot(matrix.rows(empty_vectors), "empty_rows")
plot(matrix.columns(empty_vectors), "empty_columns")
