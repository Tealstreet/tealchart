//@version=3
study("V13 barcolor v3 series", overlay=true)
phase = n % 16
shift = phase < 8 ? 2 : -2
code = phase == 2 ? 1 : phase == 5 ? 2 : phase == 10 ? 3 : phase == 13 ? 4 : 0
barcolor(code == 1 ? red : code == 2 ? blue : code == 3 ? lime : code == 4 ? orange : na, offset=shift)
plot(n, "N", transp=100)
plot(code, "SOURCE_CODE", transp=100)
plot(shift, "SOURCE_OFFSET", transp=100)
