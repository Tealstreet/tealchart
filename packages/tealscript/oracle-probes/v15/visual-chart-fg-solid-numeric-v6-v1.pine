//@version=6
indicator("V13 chart foreground numeric channels", overlay=false)
bg = chart.bg_color
fg = chart.fg_color
plot(color.r(bg), "BG_R")
plot(color.g(bg), "BG_G")
plot(color.b(bg), "BG_B")
plot(color.r(fg), "FG_R")
plot(color.g(fg), "FG_G")
plot(color.b(fg), "FG_B")
plot(color.t(fg), "FG_T")
if barstate.islast
    log.info("bg={0},{1},{2} fg={3},{4},{5}", color.r(bg), color.g(bg), color.b(bg), color.r(fg), color.g(fg), color.b(fg))
