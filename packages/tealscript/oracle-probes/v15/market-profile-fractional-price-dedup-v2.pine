//@version=5
indicator("Market profile fractional price deduplication v2")
float step = 10 * 0.01
array<float> prices = array.new_float()
for price = 77572.0 to 77573.0 by step
    if array.indexof(prices, price) == -1
        array.push(prices, price)
int firstPass = array.size(prices)
for price = 77572.5 to 77573.0 by step
    if array.indexof(prices, price) == -1
        array.push(prices, price)
int overlapPass = array.size(prices)
float accumulated = 0.1 + 0.2
array<float> near = array.from(0.3)
plot(firstPass, "FIRST_PASS_SIZE")
plot(overlapPass, "OVERLAP_PASS_SIZE")
plot(array.indexof(near, accumulated), "NEAR_INDEX")
plot(accumulated == 0.3 ? 1 : 0, "NEAR_EQUAL")
array.clear(prices)
array.push(prices, 17.0)
plot(array.size(prices), "AFTER_CLEAR_SIZE")
plot(array.shift(prices), "SHIFT_VALUE")
plot(array.size(prices), "AFTER_SHIFT_SIZE")
float away12 = 0.3 + 1e-12
float away9 = 0.3 + 1e-9
plot(array.indexof(near, away12), "INDEX_DELTA_1E12")
plot(away12 == 0.3 ? 1 : 0, "EQUAL_DELTA_1E12")
plot(array.indexof(near, away9), "INDEX_DELTA_1E9")
plot(away9 == 0.3 ? 1 : 0, "EQUAL_DELTA_1E9")
array<float> zero = array.from(0.0)
plot(array.indexof(zero, 1e-10), "INDEX_BOUNDARY_1E10")
plot(1e-10 == 0.0 ? 1 : 0, "EQUAL_BOUNDARY_1E10")
