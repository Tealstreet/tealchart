//@version=5
indicator("BTC Dip Alerts HQ", "BTC Dip Alerts HQ", overlay=false)

// This script is for alert generation only. It does not place trades or send orders.
// Create one TradingView alert using "Any alert() function call" after adding the script to a BTC chart.

groupIntraday = "Intraday Crash Thresholds"
groupDaily = "Daily Triggers"
groupLadder = "Cross-Down Ladder"

intradayThreshold1 = input.float(4.7, "Intraday Threshold 1 (%)", minval=0.1, step=0.1, group=groupIntraday)
intradayThreshold2 = input.float(7.0, "Intraday Threshold 2 (%)", minval=0.1, step=0.1, group=groupIntraday)
intradayThreshold3 = input.float(9.5, "Intraday Threshold 3 (%)", minval=0.1, step=0.1, group=groupIntraday)
intradayThreshold4 = input.float(12.0, "Intraday Threshold 4 (%)", minval=0.1, step=0.1, group=groupIntraday)
intradayThreshold5 = input.float(15.0, "Intraday Threshold 5 (%)", minval=0.1, step=0.1, group=groupIntraday)
intradayThreshold6 = input.float(18.0, "Intraday Threshold 6 (%)", minval=0.1, step=0.1, group=groupIntraday)

dailyCloseThreshold = input.float(3.3, "Daily Close Threshold (%)", minval=0.1, step=0.1, group=groupDaily)

ladderLevel1 = input.float(67000.0, "Cross-Down Level 1", step=10.0, group=groupLadder)
ladderLevel2 = input.float(65000.0, "Cross-Down Level 2", step=10.0, group=groupLadder)
ladderLevel3 = input.float(63000.0, "Cross-Down Level 3", step=10.0, group=groupLadder)
ladderLevel4 = input.float(61000.0, "Cross-Down Level 4", step=10.0, group=groupLadder)
ladderLevel5 = input.float(59000.0, "Cross-Down Level 5", step=10.0, group=groupLadder)
ladderLevel6 = input.float(57000.0, "Cross-Down Level 6", step=10.0, group=groupLadder)
ladderLevel7 = input.float(55000.0, "Cross-Down Level 7", step=10.0, group=groupLadder)
ladderLevel8 = input.float(54000.0, "Cross-Down Level 8", step=10.0, group=groupLadder)

intradayThresholds = array.from(intradayThreshold1, intradayThreshold2, intradayThreshold3, intradayThreshold4, intradayThreshold5, intradayThreshold6)
crossDownLevels = array.from(ladderLevel1, ladderLevel2, ladderLevel3, ladderLevel4, ladderLevel5, ladderLevel6, ladderLevel7, ladderLevel8)

currentBtcPrice = close
symbolName = syminfo.ticker
timeframeName = timeframe.period

formatTimestamp(int unixMs) =>
    str.format("{0,date,yyyy-MM-dd'T'HH:mm:ss'Z'}", unixMs)

buildMetadata(string alertName) =>
    "\"metadata\":{\"alert_name\":\"" + alertName + "\"}"

buildBaseJson(string triggerType, float triggerValue, int eventTime, float btcPrice, string extraFields, string alertName) =>
    "{" +
    "\"source\":\"tradingview\"," +
    "\"symbol\":\"" + symbolName + "\"," +
    "\"timeframe\":\"" + timeframeName + "\"," +
    "\"trigger_type\":\"" + triggerType + "\"," +
    "\"trigger_value\":" + str.tostring(triggerValue) + "," +
    "\"event_timestamp\":\"" + formatTimestamp(eventTime) + "\"," +
    "\"btc_price\":" + str.tostring(btcPrice) + "," +
    extraFields + "," +
    buildMetadata(alertName) +
    "}"

buildIntradayCrashJson(float threshold, float btcPrice, float referenceOpen, float changePct, int eventTime) =>
    extraFields =
         "\"reference_open\":" + str.tostring(referenceOpen) + "," +
         "\"change_pct\":" + str.tostring(changePct)
    buildBaseJson("intraday_crash", threshold, eventTime, btcPrice, extraFields, "BTC intraday crash " + str.tostring(threshold))

buildDailyCloseJson(float threshold, float btcPrice, float dailyOpen, float dailyClose, float dailyChangePct, int eventTime) =>
    extraFields =
         "\"daily_open\":" + str.tostring(dailyOpen) + "," +
         "\"daily_close\":" + str.tostring(dailyClose) + "," +
         "\"daily_change_pct\":" + str.tostring(dailyChangePct)
    buildBaseJson("daily_close", threshold, eventTime, btcPrice, extraFields, "BTC daily close down " + str.tostring(threshold))

buildThreeRedDaysJson(float btcPrice, float close0, float close1, float close2, float close3, float change1, float change2, float change3, int eventTime) =>
    extraFields =
         "\"consecutive_daily_closes\":[" + str.tostring(close0) + "," + str.tostring(close1) + "," + str.tostring(close2) + "," + str.tostring(close3) + "]," +
         "\"consecutive_daily_change_pcts\":[" + str.tostring(change1) + "," + str.tostring(change2) + "," + str.tostring(change3) + "]"
    buildBaseJson("three_red_daily_closes", 3.0, eventTime, btcPrice, extraFields, "BTC three red days")

buildPriceCrossDownJson(float level, float btcPrice, int eventTime) =>
    buildBaseJson("price_cross_down", level, eventTime, btcPrice, "\"change_pct\":null", "BTC cross down " + str.tostring(level))

// Intraday crash logic uses the current daily open as the reference point.
dailyOpenLive = request.security(syminfo.tickerid, "D", open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
intradayChangePct = ((currentBtcPrice - dailyOpenLive) / dailyOpenLive) * 100.0

for index = 0 to array.size(intradayThresholds) - 1
    threshold = array.get(intradayThresholds, index)
    intradayTriggered = ta.crossunder(intradayChangePct, -threshold)
    if barstate.isconfirmed and intradayTriggered
        alert(buildIntradayCrashJson(threshold, currentBtcPrice, dailyOpenLive, intradayChangePct, time_close), alert.freq_once_per_bar_close)

// Price cross-down ladder logic triggers once when price crosses through a configured level.
for index = 0 to array.size(crossDownLevels) - 1
    level = array.get(crossDownLevels, index)
    levelTriggered = ta.crossunder(currentBtcPrice, level)
    if barstate.isconfirmed and levelTriggered
        alert(buildPriceCrossDownJson(level, currentBtcPrice, time_close), alert.freq_once_per_bar_close)

// Daily logic is evaluated when a new daily bar begins, which means the previous daily bar just closed.
newDayStarted = ta.change(time("D")) != 0
prevDailyOpen = request.security(syminfo.tickerid, "D", open[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
prevDailyClose = request.security(syminfo.tickerid, "D", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
prevDailyChangePct = ((prevDailyClose - prevDailyOpen) / prevDailyOpen) * 100.0

close4 = request.security(syminfo.tickerid, "D", close[4], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
close3 = request.security(syminfo.tickerid, "D", close[3], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
close2 = request.security(syminfo.tickerid, "D", close[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
close1 = request.security(syminfo.tickerid, "D", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

redDayChange1 = ((close3 - close4) / close4) * 100.0
redDayChange2 = ((close2 - close3) / close3) * 100.0
redDayChange3 = ((close1 - close2) / close2) * 100.0

threeRedDays = close3 < close4 and close2 < close3 and close1 < close2
threeRedDaysClearOfDailyCloseRule = redDayChange1 > -dailyCloseThreshold and redDayChange2 > -dailyCloseThreshold and redDayChange3 > -dailyCloseThreshold

if newDayStarted
    if prevDailyChangePct <= -dailyCloseThreshold
        alert(buildDailyCloseJson(dailyCloseThreshold, prevDailyClose, prevDailyOpen, prevDailyClose, prevDailyChangePct, time), alert.freq_once_per_bar_close)

    if threeRedDays and threeRedDaysClearOfDailyCloseRule
        alert(buildThreeRedDaysJson(close1, close4, close3, close2, close1, redDayChange1, redDayChange2, redDayChange3, time), alert.freq_once_per_bar_close)

plot(intradayChangePct, title="Intraday Change From Daily Open (%)", color=color.new(color.orange, 0))
plot(-dailyCloseThreshold, title="Daily Close Threshold Marker", color=color.new(color.red, 40))
