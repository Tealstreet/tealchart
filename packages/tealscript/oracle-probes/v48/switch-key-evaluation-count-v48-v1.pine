//@version=6
indicator("V48 switch key evaluation count", precision=0)
selectKey(array<int> calls, int key) =>
    array.set(calls, 0, array.get(calls, 0) + 1)
    key
calls = array.new<int>(1, 0)
controlCalls = array.new<int>(1, 0)
key = bar_index % 5
selected = switch selectKey(calls, key)
    0 => 11
    1 => -7
    2 => 13
    3 => -5
    => 17
controlKey = selectKey(controlCalls, key)
controlSelected = switch controlKey
    0 => 11
    1 => -7
    2 => 13
    3 => -5
    => 17
plot(bar_index, "INDEX")
plot(key, "KEY")
plot(array.get(calls, 0), "KEY_CALLS")
plot(selected, "SELECTED")
plot(array.get(controlCalls, 0), "CONTROL_CALLS")
plot(controlSelected, "CONTROL_SELECTED")
plot(close, "CONTROL_CLOSE")
