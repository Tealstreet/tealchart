//@version=5
indicator("local-precedence local-control v5")
type Holder
    float value
method choose(Holder self) => self.value + 300
method choose(int self) => self + 200
method choose(float self) => self + 100
plot(float(3.0).choose(), "LOCAL_FLOAT")
plot(int(3).choose(), "LOCAL_INT")
plot(Holder.new(4).choose(), "LOCAL_UDT")
