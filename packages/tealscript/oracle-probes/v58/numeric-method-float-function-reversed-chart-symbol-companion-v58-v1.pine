//@version=6
indicator("1X method-float-function-reversed", dynamic_requests=false)
method sample(int self)=>request.security(syminfo.tickerid,"1D",close,lookahead=barmerge.lookahead_on)
method sample(float self)=>self
float selected = sample(close)
plot(selected,"Chart")
plot(request.security(syminfo.tickerid,"1D",selected,lookahead=barmerge.lookahead_on),"Result")