//@version=6
indicator("1X method-int-function-reversed", dynamic_requests=false)
method sample(float self)=>request.security("REMOTE","1D",close,lookahead=barmerge.lookahead_on)
method sample(int self)=>self
float selected = sample(int(close))
plot(selected,"Chart")
plot(request.security("REMOTE","1D",selected,lookahead=barmerge.lookahead_on),"Result")