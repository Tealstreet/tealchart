//@version=6
indicator("Omitted expression history")
seed = array.new_int(1,1)

method read(array<int> receiver, value = (close * 2)[1]) => value
observe() =>
    always = seed.read()
    occasional = bar_index % 2 == 0 ? seed.read() : na
    [always,occasional]
[always,occasional] = request.security("REMOTE:ALT","1",observe())
plot(always,"Always")
plot(occasional,"Occasional")