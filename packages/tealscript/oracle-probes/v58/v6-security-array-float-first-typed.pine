//@version=6
indicator("Forwarded regular collection overload")
score(array<int> xs) => 10
score(array<float> xs) => 20
relayInt(array<int> xs) =>
    copied = xs
    score(copied)
relayFloat(array<float> xs) =>
    copied = xs
    score(copied)
[x,y] = request.security("REMOTE:ALT","1",[relayFloat(array.new<float>(1,0)),relayInt(array.new<int>(1,0))])
plot(x)
plot(y)