//@version=6
indicator("G6 persistent alias state")
score(matrix<int> values) => 100+matrix.get(values,0,0)
score(matrix<float> values) => 200+matrix.get(values,0,0)
relay(xs,ys) =>
    out = close*0
    for i = 0 to 0
        var copied = xs
        out := score(copied)
    out
xs = matrix.new<int>(1,1,int(close))
ys = matrix.new<int>(1,1,int(close)+70)
plot(relay(xs,ys))
