//@version=6
indicator("Forwarded regular collection overload")
score(map<string,int> xs) => 10
score(map<string,float> xs) => 20
relayInt(map<string,int> xs) => score(xs)
relayFloat(map<string,float> xs) => score(xs)
[x,y] = [relayFloat(map.new<string,float>()),relayInt(map.new<string,int>())]
plot(x)
plot(y)