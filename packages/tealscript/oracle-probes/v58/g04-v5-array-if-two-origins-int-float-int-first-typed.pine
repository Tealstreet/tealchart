//@version=5
indicator("G6 adversarial alias")
score(array<int> xs) => 10
score(array<float> xs) => 20
relay(array<int> xs, array<float> ys) =>
    if bar_index % 2 == 0
        copied = xs
        score(copied)
    else
        copied = ys
        score(copied)
plot(relay(array.new<int>(1,3),array.new<float>(1,1.5)))