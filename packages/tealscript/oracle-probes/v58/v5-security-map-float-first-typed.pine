//@version=5
indicator("Forwarded regular collection overload")
score(map<string,int> xs) => 10
score(map<string,float> xs) => 20
relayInt(map<string,int> xs) =>
    copied = xs
    score(copied)
relayFloat(map<string,float> xs) =>
    copied = xs
    score(copied)
[x,y] = request.security("REMOTE:ALT","1",[relayFloat(map.new<string,float>()),relayInt(map.new<string,int>())])
plot(x)
plot(y)