//@version=6
indicator("Persistent collection alias overload")
score(map<string,int> xs) => 10
score(map<string,float> xs) => 20
relay(xs) =>
    var copied = xs
    score(copied)
[x,y] = request.security("REMOTE:ALT","1",[relay(map.new<string,float>()),relay(map.new<string,int>())])
plot(x)
plot(y)
