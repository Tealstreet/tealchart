//@version=5
indicator("Forwarded regular collection overload")
score(matrix<int> xs) => 10
score(matrix<float> xs) => 20
relayInt(matrix<int> xs) =>
    copied = xs
    score(copied)
relayFloat(matrix<float> xs) =>
    copied = xs
    score(copied)
[x,y] = request.security("REMOTE:ALT","1",[relayFloat(matrix.new<float>(1,1,0)),relayInt(matrix.new<int>(1,1,0))])
plot(x)
plot(y)