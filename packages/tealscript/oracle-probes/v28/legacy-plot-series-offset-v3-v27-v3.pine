//@version=3
study("Legacy plot offset v3 v27 v3", overlay=false)
sourceCode = n % 11 + 1
dynamicOffset = n % 5 - 2
plot(n % 55, title="SOURCE_INDEX_MOD55", transp=100)
plot(sourceCode, title="SOURCE_CODE", transp=100)
plot(dynamicOffset, title="DYNAMIC_OFFSET", transp=100)
plot(sourceCode, title="DYNAMIC_TARGET", color=red, style=circles, linewidth=3, offset=dynamicOffset)
plot(sourceCode + 20, title="ZERO_ANCHOR", color=blue, style=circles, linewidth=2, offset=0)
plot(sourceCode + 40, title="PLUS2_CONTROL", color=green, style=circles, linewidth=2, offset=2)
plot(sourceCode + 60, title="MINUS2_CONTROL", color=purple, style=circles, linewidth=2, offset=-2)
