//@version=6
indicator("array-sort-na-tie-identity-bbi-v1")
a = array.from(2.0, float(na), 1.0, 2.0, float(na), 1.0, 2.0)
ties = array.from(2.0, 1.0, 2.0, 1.0, 2.0, 1.0, 2.0)
naAsc = array.sort_indices(a, order.ascending)
naDesc = array.sort_indices(a, order.descending)
tieAsc = array.sort_indices(ties, order.ascending)
tieDesc = array.sort_indices(ties, order.descending)
array.sort(a, order.ascending)
plot(bar_index, "BAR_INDEX")
