//@version=6
indicator("V27 pivot and stochastic operand holes CNF v1")
frame = bar_index % 70
slot = frame % 7
block = int(frame / 7)
bottom = slot == 0 ? 5.0 : slot == 1 ? 3.0 : slot == 2 ? 1.0 : slot == 3 ? 0.0 : slot == 4 ? 1.0 : slot == 5 ? 3.0 : 5.0
hole = (block == 1 and slot == 0) or (block == 2 and slot == 1) or (block == 3 and slot == 2) or (block == 4 and slot == 3) or (block == 5 and slot == 4) or (block == 6 and slot == 5) or (block == 7 and slot == 6) or (block == 8 and (slot == 1 or slot == 5)) or (block == 9 and (slot == 2 or slot == 4))
lowSource = hole ? na : bottom
highSource = hole ? na : -bottom
pivotLow = ta.pivotlow(lowSource, 2, 2)
pivotHigh = ta.pivothigh(highSource, 2, 2)
plot(bar_index, "ChartBarIndex", display=display.data_window)
plot(frame, "PivotFrame", display=display.data_window)
plot(pivotLow, "R452_PivotLow_LeftCandidateRightHoles", display=display.data_window)
plot(pivotHigh, "R456_PivotHigh_LeftCandidateRightHoles", display=display.data_window)
phase = bar_index % 12
price = phase == 0 ? na : 10.0 + bar_index % 5
hi = phase == 1 or (phase >= 4 and phase <= 7) ? na : phase == 9 ? price : 20.0 + bar_index % 3
lo = phase == 2 or phase == 3 ? na : phase == 9 ? price : bar_index % 3
if phase == 3
    hi := na
lowest = ta.lowest(lo, 3)
highest = ta.highest(hi, 3)
formula = highest == lowest ? na : 100.0 * (price - lowest) / (highest - lowest)
plot(phase, "StochPhase", display=display.data_window)
plot(ta.stoch(price, hi, lo, 3), "R588_Stoch_PriceHighLowHoleRecovery", display=display.data_window)
plot(formula, "Control_ExtremaFormula", display=display.data_window)
