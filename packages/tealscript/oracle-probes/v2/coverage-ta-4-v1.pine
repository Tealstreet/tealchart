//@version=6
indicator("TA coverage 4 v1", overlay=false, precision=12, max_bars_back=200)
// Capture on BINANCE:BTCUSDT standard 2-minute candles; export full history 0..at least 200.
// All calls execute on every bar. No changing lengths and no HMA length 1.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_hole40_41 = hole ? na : close
s_lead0_4 = bar_index < 5 ? na : close
plot(open, "input_open", display=display.data_window)
plot(high, "input_high", display=display.data_window)
plot(low, "input_low", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(volume, "input_volume", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(hole ? 1 : 0, "input_hole_bar40_41", display=display.data_window)
// Pivot levels read implicit OHLC. Anchor suppression is NOT an OHLC na injection.
a_regular = bar_index % 20 == 0
a_delayed40 = bar_index == 40
a_skip_hole = a_regular and not hole
a_never = false
p_trad = ta.pivot_point_levels("Traditional", a_regular, false)
p_fib_dev = ta.pivot_point_levels("Fibonacci", a_regular, true)
p_woodie = ta.pivot_point_levels("Woodie", a_delayed40, false)
p_skip = ta.pivot_point_levels("Traditional", a_skip_hole, false)
plot(array.size(p_trad) > 0 ? array.get(p_trad, 0) : na, "pivot_levels_traditional_anchor20_frozen_P", display=display.data_window)
plot(array.size(p_trad) > 1 ? array.get(p_trad, 1) : na, "pivot_levels_traditional_anchor20_frozen_R1", display=display.data_window)
plot(array.size(p_trad) > 2 ? array.get(p_trad, 2) : na, "pivot_levels_traditional_anchor20_frozen_S1", display=display.data_window)
plot(array.size(p_trad) > 3 ? array.get(p_trad, 3) : na, "pivot_levels_traditional_anchor20_frozen_R2", display=display.data_window)
plot(array.size(p_trad) > 4 ? array.get(p_trad, 4) : na, "pivot_levels_traditional_anchor20_frozen_S2", display=display.data_window)
plot(array.size(p_trad) > 5 ? array.get(p_trad, 5) : na, "pivot_levels_traditional_anchor20_frozen_R3", display=display.data_window)
plot(array.size(p_trad) > 6 ? array.get(p_trad, 6) : na, "pivot_levels_traditional_anchor20_frozen_S3", display=display.data_window)
plot(array.size(p_trad) > 7 ? array.get(p_trad, 7) : na, "pivot_levels_traditional_anchor20_frozen_R4", display=display.data_window)
plot(array.size(p_trad) > 8 ? array.get(p_trad, 8) : na, "pivot_levels_traditional_anchor20_frozen_S4", display=display.data_window)
plot(array.size(p_trad) > 9 ? array.get(p_trad, 9) : na, "pivot_levels_traditional_anchor20_frozen_R5", display=display.data_window)
plot(array.size(p_trad) > 10 ? array.get(p_trad, 10) : na, "pivot_levels_traditional_anchor20_frozen_S5", display=display.data_window)
plot(array.size(p_trad), "pivot_levels_traditional_anchor20_frozen_size", display=display.data_window)
plot(array.size(p_fib_dev) > 0 ? array.get(p_fib_dev, 0) : na, "pivot_levels_fibonacci_anchor20_developing_P", display=display.data_window)
plot(array.size(p_fib_dev) > 1 ? array.get(p_fib_dev, 1) : na, "pivot_levels_fibonacci_anchor20_developing_R1", display=display.data_window)
plot(array.size(p_fib_dev) > 2 ? array.get(p_fib_dev, 2) : na, "pivot_levels_fibonacci_anchor20_developing_S1", display=display.data_window)
plot(array.size(p_fib_dev) > 3 ? array.get(p_fib_dev, 3) : na, "pivot_levels_fibonacci_anchor20_developing_R2", display=display.data_window)
plot(array.size(p_fib_dev) > 4 ? array.get(p_fib_dev, 4) : na, "pivot_levels_fibonacci_anchor20_developing_S2", display=display.data_window)
plot(array.size(p_fib_dev) > 5 ? array.get(p_fib_dev, 5) : na, "pivot_levels_fibonacci_anchor20_developing_R3", display=display.data_window)
plot(array.size(p_fib_dev) > 6 ? array.get(p_fib_dev, 6) : na, "pivot_levels_fibonacci_anchor20_developing_S3", display=display.data_window)
plot(array.size(p_fib_dev) > 7 ? array.get(p_fib_dev, 7) : na, "pivot_levels_fibonacci_anchor20_developing_R4", display=display.data_window)
plot(array.size(p_fib_dev) > 8 ? array.get(p_fib_dev, 8) : na, "pivot_levels_fibonacci_anchor20_developing_S4", display=display.data_window)
plot(array.size(p_fib_dev) > 9 ? array.get(p_fib_dev, 9) : na, "pivot_levels_fibonacci_anchor20_developing_R5", display=display.data_window)
plot(array.size(p_fib_dev) > 10 ? array.get(p_fib_dev, 10) : na, "pivot_levels_fibonacci_anchor20_developing_S5", display=display.data_window)
plot(array.size(p_fib_dev), "pivot_levels_fibonacci_anchor20_developing_size", display=display.data_window)
plot(array.size(p_woodie) > 0 ? array.get(p_woodie, 0) : na, "pivot_levels_woodie_delayed40_frozen_P", display=display.data_window)
plot(array.size(p_woodie) > 1 ? array.get(p_woodie, 1) : na, "pivot_levels_woodie_delayed40_frozen_R1", display=display.data_window)
plot(array.size(p_woodie) > 2 ? array.get(p_woodie, 2) : na, "pivot_levels_woodie_delayed40_frozen_S1", display=display.data_window)
plot(array.size(p_woodie) > 3 ? array.get(p_woodie, 3) : na, "pivot_levels_woodie_delayed40_frozen_R2", display=display.data_window)
plot(array.size(p_woodie) > 4 ? array.get(p_woodie, 4) : na, "pivot_levels_woodie_delayed40_frozen_S2", display=display.data_window)
plot(array.size(p_woodie) > 5 ? array.get(p_woodie, 5) : na, "pivot_levels_woodie_delayed40_frozen_R3", display=display.data_window)
plot(array.size(p_woodie) > 6 ? array.get(p_woodie, 6) : na, "pivot_levels_woodie_delayed40_frozen_S3", display=display.data_window)
plot(array.size(p_woodie) > 7 ? array.get(p_woodie, 7) : na, "pivot_levels_woodie_delayed40_frozen_R4", display=display.data_window)
plot(array.size(p_woodie) > 8 ? array.get(p_woodie, 8) : na, "pivot_levels_woodie_delayed40_frozen_S4", display=display.data_window)
plot(array.size(p_woodie) > 9 ? array.get(p_woodie, 9) : na, "pivot_levels_woodie_delayed40_frozen_R5", display=display.data_window)
plot(array.size(p_woodie) > 10 ? array.get(p_woodie, 10) : na, "pivot_levels_woodie_delayed40_frozen_S5", display=display.data_window)
plot(array.size(p_woodie), "pivot_levels_woodie_delayed40_frozen_size", display=display.data_window)
plot(array.size(p_skip) > 0 ? array.get(p_skip, 0) : na, "pivot_levels_traditional_anchor20_skip40_frozen_P", display=display.data_window)
plot(array.size(p_skip) > 1 ? array.get(p_skip, 1) : na, "pivot_levels_traditional_anchor20_skip40_frozen_R1", display=display.data_window)
plot(array.size(p_skip) > 2 ? array.get(p_skip, 2) : na, "pivot_levels_traditional_anchor20_skip40_frozen_S1", display=display.data_window)
plot(array.size(p_skip) > 3 ? array.get(p_skip, 3) : na, "pivot_levels_traditional_anchor20_skip40_frozen_R2", display=display.data_window)
plot(array.size(p_skip) > 4 ? array.get(p_skip, 4) : na, "pivot_levels_traditional_anchor20_skip40_frozen_S2", display=display.data_window)
plot(array.size(p_skip) > 5 ? array.get(p_skip, 5) : na, "pivot_levels_traditional_anchor20_skip40_frozen_R3", display=display.data_window)
plot(array.size(p_skip) > 6 ? array.get(p_skip, 6) : na, "pivot_levels_traditional_anchor20_skip40_frozen_S3", display=display.data_window)
plot(array.size(p_skip) > 7 ? array.get(p_skip, 7) : na, "pivot_levels_traditional_anchor20_skip40_frozen_R4", display=display.data_window)
plot(array.size(p_skip) > 8 ? array.get(p_skip, 8) : na, "pivot_levels_traditional_anchor20_skip40_frozen_S4", display=display.data_window)
plot(array.size(p_skip) > 9 ? array.get(p_skip, 9) : na, "pivot_levels_traditional_anchor20_skip40_frozen_R5", display=display.data_window)
plot(array.size(p_skip) > 10 ? array.get(p_skip, 10) : na, "pivot_levels_traditional_anchor20_skip40_frozen_S5", display=display.data_window)
plot(array.size(p_skip), "pivot_levels_traditional_anchor20_skip40_frozen_size", display=display.data_window)
plot(a_regular ? 1 : 0, "input_a_regular", display=display.data_window)
plot(a_delayed40 ? 1 : 0, "input_a_delayed40", display=display.data_window)
plot(a_skip_hole ? 1 : 0, "input_a_skip_hole", display=display.data_window)
plot(a_never ? 1 : 0, "input_a_never", display=display.data_window)
