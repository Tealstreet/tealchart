//@version=6
indicator("Register TA confirmation 1 v1", overlay=false, precision=16, max_bars_back=500)
// Exactly 60 numeric plots, all data_window. Export full history starting at bar_index 0.
// At least 256 historical bars; stimuli repeat every 64 bars to survive longer exports.
// IMPORTANT: ta.nvi/ta.pvi use native chart close/volume and accept no source inputs.
// Synthetic volume-index outputs below are EXPLICIT FORMULA CONTROLS, not native builtin witnesses.
phase = bar_index % 64
priceClean = 10.0 + phase % 7
priceZero = phase == 8 ? 0.0 : priceClean
priceHole = phase == 12 or phase == 13 ? na : priceClean
priceLeading = bar_index < 3 ? na : priceClean
volumeRiseZero = phase == 16 ? 0.0 : 100.0 + phase
volumeRiseHole = phase == 20 ? na : 100.0 + phase
volumeFallZero = phase == 16 ? 0.0 : 100.0 - phase
volumeFallHole = phase == 20 ? na : 100.0 - phase
flat = 5.0
recoverHigh = phase == 24 or phase == 25 ? 7.0 : flat
recoverLow = phase == 24 or phase == 25 ? 3.0 : flat

// Current official NVI/PVI equivalent, parameterized for synthetic controls.
f_vi(c, v, decrease) =>
    float value = 1.0
    float previous = nz(value[1], 0.0) == 0.0 ? 1.0 : value[1]
    if nz(c, 0.0) == 0.0 or nz(c[1], 0.0) == 0.0
        value := previous
    else
        value := (decrease ? v < nz(v[1], 0.0) : v > nz(v[1], 0.0)) ? previous + ((c - c[1]) / c[1]) * previous : previous
    value

// Pre-fix TealScript volume-index behavior, deliberately separate from the authority.
f_vi_legacy(c, v, decrease) =>
    var float value = 1.0
    if not na(c) and not na(c[1]) and c[1] != 0.0 and not na(v) and not na(v[1])
        if decrease ? v < v[1] : v > v[1]
            value := value + ((c - c[1]) / c[1]) * value
    value

// Independent contiguous-window controls, explicitly propagating NA.
f_linear(s) =>
    values = array.new_float(0)
    bool missing = false
    for i = 0 to 3
        missing := missing or na(s[i])
        array.push(values, s[i])
    array.sort(values, order.ascending)
    missing ? na : array.get(values, 2) + (array.get(values, 3) - array.get(values, 2)) * 0.25

f_rank(s) =>
    bool missing = false
    float count = 0.0
    for i = 0 to 3
        missing := missing or na(s[i])
        if s[i] <= s
            count += 1.0
    missing ? na : 100.0 * count / 4.0

// Separate written call sites for every stateful builtin/formula branch.
[kcBasis, kcUpper, kcLower] = ta.kc(priceHole, 4, 2.0, false)
kcBasisFormula = ta.ema(priceHole, 4)
kcRangeFormula = ta.ema(high - low, 4)
kcUpperFormula = kcBasisFormula + kcRangeFormula * 2.0
kcLowerFormula = kcBasisFormula - kcRangeFormula * 2.0
kcWidthFormula = (kcUpperFormula - kcLowerFormula) / kcBasisFormula
kcCleanBasis = ta.ema(priceClean, 4)
kcCleanRange = ta.ema(high - low, 4)
kcCleanWidthFormula = ((kcCleanBasis + 2.0 * kcCleanRange) - (kcCleanBasis - 2.0 * kcCleanRange)) / kcCleanBasis
// Offset transitions 1 -> 3 -> 1 -> 6 -> 1, every 64-bar cycle.
momLength = phase < 8 ? 1 : phase < 16 ? 3 : phase < 24 ? 1 : phase < 32 ? 6 : 1
stochFlatFormula = 100.0 * (flat - ta.lowest(flat, 4)) / (ta.highest(flat, 4) - ta.lowest(flat, 4))
stochRecoverFormula = 100.0 * (flat - ta.lowest(recoverLow, 4)) / (ta.highest(recoverHigh, 4) - ta.lowest(recoverLow, 4))
stochFlat1Formula = 100.0 * (flat - ta.lowest(flat, 1)) / (ta.highest(flat, 1) - ta.lowest(flat, 1))

// 60 explicit Data Window columns; titles identify builtin vs formula controls.
plot(open, title="input_open", display=display.data_window)
plot(high, title="input_high", display=display.data_window)
plot(low, title="input_low", display=display.data_window)
plot(close, title="input_close", display=display.data_window)
plot(volume, title="input_volume", display=display.data_window)
plot(bar_index, title="input_bar_index", display=display.data_window)
plot(priceClean, title="stimulus_priceClean", display=display.data_window)
plot(priceZero, title="stimulus_priceZero", display=display.data_window)
plot(priceHole, title="stimulus_priceHole", display=display.data_window)
plot(priceLeading, title="stimulus_priceLeading", display=display.data_window)
plot(volumeRiseZero, title="stimulus_volumeRiseZero", display=display.data_window)
plot(volumeRiseHole, title="stimulus_volumeRiseHole", display=display.data_window)
plot(volumeFallZero, title="stimulus_volumeFallZero", display=display.data_window)
plot(volumeFallHole, title="stimulus_volumeFallHole", display=display.data_window)
plot(flat, title="stimulus_flat", display=display.data_window)
plot(recoverHigh, title="stimulus_recoverHigh", display=display.data_window)
plot(recoverLow, title="stimulus_recoverLow", display=display.data_window)
plot(phase, title="stimulus_phase", display=display.data_window)
plot(ta.nvi, title="nvi_native_builtin", display=display.data_window)
plot(f_vi(close, volume, true), title="nvi_native_doc", display=display.data_window)
plot(ta.pvi, title="pvi_native_builtin", display=display.data_window)
plot(f_vi(close, volume, false), title="pvi_native_doc", display=display.data_window)
plot(f_vi(priceZero, volumeFallZero, true), title="nvi_zero_synthetic_doc", display=display.data_window)
plot(f_vi_legacy(priceZero, volumeFallZero, true), title="nvi_zero_synthetic_legacy", display=display.data_window)
plot(f_vi(priceHole, volumeFallHole, true), title="nvi_na_synthetic_doc", display=display.data_window)
plot(f_vi_legacy(priceHole, volumeFallHole, true), title="nvi_na_synthetic_legacy", display=display.data_window)
plot(f_vi(priceZero, volumeRiseZero, false), title="pvi_zero_synthetic_doc", display=display.data_window)
plot(f_vi_legacy(priceZero, volumeRiseZero, false), title="pvi_zero_synthetic_legacy", display=display.data_window)
plot(f_vi(priceClean, volumeRiseHole, false), title="pvi_prior_volume_na_synthetic_doc", display=display.data_window)
plot(f_vi_legacy(priceClean, volumeRiseHole, false), title="pvi_prior_volume_na_synthetic_legacy", display=display.data_window)
plot(kcBasis, title="kc_basis_hole_builtin", display=display.data_window)
plot(kcUpper, title="kc_upper_hole_builtin", display=display.data_window)
plot(kcLower, title="kc_lower_hole_builtin", display=display.data_window)
plot(kcBasisFormula, title="kc_basis_hole_doc", display=display.data_window)
plot(kcUpperFormula, title="kc_upper_hole_doc", display=display.data_window)
plot(kcLowerFormula, title="kc_lower_hole_doc", display=display.data_window)
plot(ta.kcw(priceHole, 4, 2.0, false), title="kcw_hole_builtin", display=display.data_window)
plot(kcWidthFormula, title="kcw_hole_doc", display=display.data_window)
plot(ta.kcw(priceClean, 4, 2.0, false), title="kcw_clean_builtin", display=display.data_window)
plot(kcCleanWidthFormula, title="kcw_clean_doc", display=display.data_window)
plot(ta.percentile_linear_interpolation(priceClean, 4, 75.0), title="linear_clean_builtin", display=display.data_window)
plot(ta.percentile_linear_interpolation(priceHole, 4, 75.0), title="linear_hole_builtin", display=display.data_window)
plot(f_linear(priceHole), title="linear_hole_manual", display=display.data_window)
plot(ta.percentile_linear_interpolation(priceLeading, 4, 75.0), title="linear_leading_builtin", display=display.data_window)
plot(ta.percentrank(priceClean, 4), title="rank_clean_builtin", display=display.data_window)
plot(ta.percentrank(priceHole, 4), title="rank_hole_builtin", display=display.data_window)
plot(f_rank(priceHole), title="rank_hole_manual", display=display.data_window)
plot(ta.percentrank(priceLeading, 4), title="rank_leading_builtin", display=display.data_window)
plot(momLength, title="mom_length", display=display.data_window)
plot(priceHole, title="mom_source", display=display.data_window)
plot(ta.mom(priceHole, momLength), title="mom_dynamic_builtin", display=display.data_window)
plot(priceHole - priceHole[momLength], title="mom_dynamic_manual", display=display.data_window)
plot(ta.mom(priceHole * 2.0, momLength), title="mom_expression_builtin", display=display.data_window)
plot((priceHole * 2.0) - (priceHole[momLength] * 2.0), title="mom_expression_manual", display=display.data_window)
plot(ta.stoch(flat, flat, flat, 4), title="stoch_flat_len4_builtin", display=display.data_window)
plot(stochFlatFormula, title="stoch_flat_len4_manual", display=display.data_window)
plot(ta.stoch(flat, recoverHigh, recoverLow, 4), title="stoch_recovery_len4_builtin", display=display.data_window)
plot(stochRecoverFormula, title="stoch_recovery_len4_manual", display=display.data_window)
plot(ta.stoch(flat, flat, flat, 1), title="stoch_flat_len1_builtin", display=display.data_window)
plot(stochFlat1Formula, title="stoch_flat_len1_manual", display=display.data_window)
