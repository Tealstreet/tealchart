//@version=6
indicator("TA coverage 3 v1", overlay=false, precision=12, max_bars_back=200)
// Capture on BINANCE:BTCUSDT standard 2-minute candles; export full history 0..at least 200.
// All calls execute on every bar. No changing lengths and no HMA length 1.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_hole40_41 = hole ? na : close
s_lead0_4 = bar_index < 5 ? na : close
plot(open, "input_open", display=display.data_window)
plot(high, "input_high", display=display.data_window)
plot(low, "input_low", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(volume, "input_volume", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(hole ? 1 : 0, "input_hole_bar40_41", display=display.data_window)
// DMI/Supertrend/SAR and TA variables read implicit chart OHLC: cannot inject caller OHLC holes.
// Parameter variants expose natural startup. Explicit-input controls below probe formula holes only.
[dmi_plus_5, dmi_minus_5, dmi_adx_5] = ta.dmi(5, 5)
plot(dmi_plus_5, "dmi_plus_di5_adx5_chart_clean", display=display.data_window)
plot(dmi_minus_5, "dmi_minus_di5_adx5_chart_clean", display=display.data_window)
plot(dmi_adx_5, "dmi_adx_di5_adx5_chart_clean", display=display.data_window)
[dmi_plus_14, dmi_minus_14, dmi_adx_14] = ta.dmi(14, 14)
plot(dmi_plus_14, "dmi_plus_di14_adx14_chart_clean", display=display.data_window)
plot(dmi_minus_14, "dmi_minus_di14_adx14_chart_clean", display=display.data_window)
plot(dmi_adx_14, "dmi_adx_di14_adx14_chart_clean", display=display.data_window)
[dmi_plus_28, dmi_minus_28, dmi_adx_28] = ta.dmi(28, 28)
plot(dmi_plus_28, "dmi_plus_di28_adx28_chart_clean", display=display.data_window)
plot(dmi_minus_28, "dmi_minus_di28_adx28_chart_clean", display=display.data_window)
plot(dmi_adx_28, "dmi_adx_di28_adx28_chart_clean", display=display.data_window)
[st_5, direction_5] = ta.supertrend(3.0, 5)
plot(st_5, "supertrend_line_factor3_atr5_chart_clean", display=display.data_window)
plot(direction_5, "supertrend_direction_factor3_atr5_chart_clean", display=display.data_window)
[st_14, direction_14] = ta.supertrend(3.0, 14)
plot(st_14, "supertrend_line_factor3_atr14_chart_clean", display=display.data_window)
plot(direction_14, "supertrend_direction_factor3_atr14_chart_clean", display=display.data_window)
[st_28, direction_28] = ta.supertrend(3.0, 28)
plot(st_28, "supertrend_line_factor3_atr28_chart_clean", display=display.data_window)
plot(direction_28, "supertrend_direction_factor3_atr28_chart_clean", display=display.data_window)
plot(ta.sar(0.02, 0.02, 0.2), "sar_start_inc_max_002_002_02_chart_clean", display=display.data_window)
plot(ta.sar(0.01, 0.01, 0.1), "sar_start_inc_max_001_001_01_chart_clean", display=display.data_window)
plot(ta.sar(0.05, 0.05, 0.5), "sar_start_inc_max_005_005_05_chart_clean", display=display.data_window)
plot(ta.iii, "iii_variable_chart_clean", display=display.data_window)
plot(ta.wvad, "wvad_variable_chart_clean", display=display.data_window)
plot(ta.wad, "wad_variable_chart_clean", display=display.data_window)
vh_clean = false ? na : high
vl_clean = false ? na : low
vo_clean = false ? na : open
vc_clean = false ? na : close
vv_clean = false ? na : volume
plot((2.0 * vc_clean - vh_clean - vl_clean) / (vh_clean - vl_clean) * vv_clean, "iii_formula_clean", display=display.data_window)
plot((vc_clean - vo_clean) / (vh_clean - vl_clean) * vv_clean, "wvad_formula_clean", display=display.data_window)
wad_mom_clean = ta.change(vc_clean)
wad_gain_clean = wad_mom_clean > 0 ? vc_clean - math.min(vl_clean, vc_clean[1]) : (wad_mom_clean < 0 ? vc_clean - math.max(vh_clean, vc_clean[1]) : 0.0)
plot(ta.cum(wad_gain_clean), "wad_formula_clean", display=display.data_window)
vh_hole40_41 = hole ? na : high
vl_hole40_41 = hole ? na : low
vo_hole40_41 = hole ? na : open
vc_hole40_41 = hole ? na : close
vv_hole40_41 = hole ? na : volume
plot((2.0 * vc_hole40_41 - vh_hole40_41 - vl_hole40_41) / (vh_hole40_41 - vl_hole40_41) * vv_hole40_41, "iii_formula_hole40_41", display=display.data_window)
plot((vc_hole40_41 - vo_hole40_41) / (vh_hole40_41 - vl_hole40_41) * vv_hole40_41, "wvad_formula_hole40_41", display=display.data_window)
wad_mom_hole40_41 = ta.change(vc_hole40_41)
wad_gain_hole40_41 = wad_mom_hole40_41 > 0 ? vc_hole40_41 - math.min(vl_hole40_41, vc_hole40_41[1]) : (wad_mom_hole40_41 < 0 ? vc_hole40_41 - math.max(vh_hole40_41, vc_hole40_41[1]) : 0.0)
plot(ta.cum(wad_gain_hole40_41), "wad_formula_hole40_41", display=display.data_window)
vh_lead0_4 = bar_index < 5 ? na : high
vl_lead0_4 = bar_index < 5 ? na : low
vo_lead0_4 = bar_index < 5 ? na : open
vc_lead0_4 = bar_index < 5 ? na : close
vv_lead0_4 = bar_index < 5 ? na : volume
plot((2.0 * vc_lead0_4 - vh_lead0_4 - vl_lead0_4) / (vh_lead0_4 - vl_lead0_4) * vv_lead0_4, "iii_formula_lead0_4", display=display.data_window)
plot((vc_lead0_4 - vo_lead0_4) / (vh_lead0_4 - vl_lead0_4) * vv_lead0_4, "wvad_formula_lead0_4", display=display.data_window)
wad_mom_lead0_4 = ta.change(vc_lead0_4)
wad_gain_lead0_4 = wad_mom_lead0_4 > 0 ? vc_lead0_4 - math.min(vl_lead0_4, vc_lead0_4[1]) : (wad_mom_lead0_4 < 0 ? vc_lead0_4 - math.max(vh_lead0_4, vc_lead0_4[1]) : 0.0)
plot(ta.cum(wad_gain_lead0_4), "wad_formula_lead0_4", display=display.data_window)
plot(ta.tr, "tr_variable_chart_clean", display=display.data_window)
plot(ta.tr(true), "tr_function_handle_na_true", display=display.data_window)
plot(ta.tr(false), "tr_function_handle_na_false", display=display.data_window)
plot(math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1]))), "tr_formula_chart_clean", display=display.data_window)
plot(hole ? na : ta.tr(true), "tr_formula_outputhole40_41", display=display.data_window)
f_dmi_explicit(h, l, c) =>
    up = ta.change(h)
    down = -ta.change(l)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0.0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0.0)
    trValue = na(c[1]) ? h - l : math.max(h - l, math.max(math.abs(h - c[1]), math.abs(l - c[1])))
    trSmooth = ta.rma(trValue, 14)
    plus = 100.0 * ta.rma(plusDM, 14) / trSmooth
    minus = 100.0 * ta.rma(minusDM, 14) / trSmooth
    diSum = plus + minus
    adx = 100.0 * ta.rma(math.abs(plus - minus) / (diSum == 0 ? 1.0 : diSum), 14)
    [plus, minus, adx]
[manual_dmi_plus_clean, manual_dmi_minus_clean, manual_dmi_adx_clean] = f_dmi_explicit(vh_clean, vl_clean, vc_clean)
plot(manual_dmi_plus_clean, "dmi_explicit_formula_plus_len14_clean", display=display.data_window)
plot(manual_dmi_minus_clean, "dmi_explicit_formula_minus_len14_clean", display=display.data_window)
plot(manual_dmi_adx_clean, "dmi_explicit_formula_adx_len14_clean", display=display.data_window)
[manual_dmi_plus_hole40_41, manual_dmi_minus_hole40_41, manual_dmi_adx_hole40_41] = f_dmi_explicit(vh_hole40_41, vl_hole40_41, vc_hole40_41)
plot(manual_dmi_plus_hole40_41, "dmi_explicit_formula_plus_len14_hole40_41", display=display.data_window)
plot(manual_dmi_minus_hole40_41, "dmi_explicit_formula_minus_len14_hole40_41", display=display.data_window)
plot(manual_dmi_adx_hole40_41, "dmi_explicit_formula_adx_len14_hole40_41", display=display.data_window)
[manual_dmi_plus_lead0_4, manual_dmi_minus_lead0_4, manual_dmi_adx_lead0_4] = f_dmi_explicit(vh_lead0_4, vl_lead0_4, vc_lead0_4)
plot(manual_dmi_plus_lead0_4, "dmi_explicit_formula_plus_len14_lead0_4", display=display.data_window)
plot(manual_dmi_minus_lead0_4, "dmi_explicit_formula_minus_len14_lead0_4", display=display.data_window)
plot(manual_dmi_adx_lead0_4, "dmi_explicit_formula_adx_len14_lead0_4", display=display.data_window)
plot(ta.rma(false ? na : ta.tr(true), 14), "supertrend_atr_dependency_rma14_clean", display=display.data_window)
plot(ta.rma(hole ? na : ta.tr(true), 14), "supertrend_atr_dependency_rma14_hole40_41", display=display.data_window)
plot(ta.rma(bar_index < 5 ? na : ta.tr(true), 14), "supertrend_atr_dependency_rma14_lead0_4", display=display.data_window)
plot(ta.sar(0.03, 0.03, 0.2), "sar_start_inc_03_max02_chart_clean", display=display.data_window)
plot(ta.sar(0.04, 0.04, 0.2), "sar_start_inc_04_max02_chart_clean", display=display.data_window)
plot(dmi_plus_5 + dmi_minus_5, "control_dmi_di_sum_len5", display=display.data_window)
plot(dmi_plus_14 + dmi_minus_14, "control_dmi_di_sum_len14", display=display.data_window)
plot(dmi_plus_28 + dmi_minus_28, "control_dmi_di_sum_len28", display=display.data_window)
