//@version=6
indicator("TA coverage 1 v1", overlay=false, precision=12, max_bars_back=200)
// Capture on BINANCE:BTCUSDT standard 2-minute candles; export full history 0..at least 200.
// All calls execute on every bar. No changing lengths and no HMA length 1.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_hole40_41 = hole ? na : close
s_lead0_4 = bar_index < 5 ? na : close
plot(open, "input_open", display=display.data_window)
plot(high, "input_high", display=display.data_window)
plot(low, "input_low", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(volume, "input_volume", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(hole ? 1 : 0, "input_hole_bar40_41", display=display.data_window)
plot(ta.median(s_clean, 14), "median_len14_clean", display=display.data_window)
plot(ta.median(s_hole40_41, 14), "median_len14_hole40_41", display=display.data_window)
plot(ta.median(s_lead0_4, 14), "median_len14_lead0_4", display=display.data_window)
plot(ta.mode(s_clean, 14), "mode_len14_clean", display=display.data_window)
plot(ta.mode(s_hole40_41, 14), "mode_len14_hole40_41", display=display.data_window)
plot(ta.mode(s_lead0_4, 14), "mode_len14_lead0_4", display=display.data_window)
plot(ta.range(s_clean, 14), "range_len14_clean", display=display.data_window)
plot(ta.range(s_hole40_41, 14), "range_len14_hole40_41", display=display.data_window)
plot(ta.range(s_lead0_4, 14), "range_len14_lead0_4", display=display.data_window)
plot(ta.dev(s_clean, 14), "dev_len14_clean", display=display.data_window)
plot(ta.dev(s_hole40_41, 14), "dev_len14_hole40_41", display=display.data_window)
plot(ta.dev(s_lead0_4, 14), "dev_len14_lead0_4", display=display.data_window)
plot(ta.stdev(s_clean, 14), "stdev_len14_clean", display=display.data_window)
plot(ta.stdev(s_hole40_41, 14), "stdev_len14_hole40_41", display=display.data_window)
plot(ta.stdev(s_lead0_4, 14), "stdev_len14_lead0_4", display=display.data_window)
plot(ta.variance(s_clean, 14), "variance_len14_clean", display=display.data_window)
plot(ta.variance(s_hole40_41, 14), "variance_len14_hole40_41", display=display.data_window)
plot(ta.variance(s_lead0_4, 14), "variance_len14_lead0_4", display=display.data_window)
plot(ta.percentrank(s_clean, 14), "percentrank_len14_clean", display=display.data_window)
plot(ta.percentrank(s_hole40_41, 14), "percentrank_len14_hole40_41", display=display.data_window)
plot(ta.percentrank(s_lead0_4, 14), "percentrank_len14_lead0_4", display=display.data_window)
plot(ta.percentile_nearest_rank(s_clean, 14, 75.0), "percentile_nearest_rank_len14_pct75_clean", display=display.data_window)
plot(ta.percentile_nearest_rank(s_hole40_41, 14, 75.0), "percentile_nearest_rank_len14_pct75_hole40_41", display=display.data_window)
plot(ta.percentile_nearest_rank(s_lead0_4, 14, 75.0), "percentile_nearest_rank_len14_pct75_lead0_4", display=display.data_window)
plot(ta.percentile_linear_interpolation(s_clean, 14, 75.0), "percentile_linear_interpolation_len14_pct75_clean", display=display.data_window)
plot(ta.percentile_linear_interpolation(s_hole40_41, 14, 75.0), "percentile_linear_interpolation_len14_pct75_hole40_41", display=display.data_window)
plot(ta.percentile_linear_interpolation(s_lead0_4, 14, 75.0), "percentile_linear_interpolation_len14_pct75_lead0_4", display=display.data_window)
plot(ta.max(s_clean), "max_running_clean", display=display.data_window)
plot(ta.max(s_hole40_41), "max_running_hole40_41", display=display.data_window)
plot(ta.max(s_lead0_4), "max_running_lead0_4", display=display.data_window)
plot(ta.min(s_clean), "min_running_clean", display=display.data_window)
plot(ta.min(s_hole40_41), "min_running_hole40_41", display=display.data_window)
plot(ta.min(s_lead0_4), "min_running_lead0_4", display=display.data_window)
q_clean = bar_index % 5
q_hole40_41 = hole ? na : q_clean
q_lead0_4 = bar_index < 5 ? na : q_clean
plot(ta.median(q_clean, 14), "median_intcycle5_len14_clean", display=display.data_window)
plot(ta.median(q_hole40_41, 14), "median_intcycle5_len14_hole40_41", display=display.data_window)
plot(ta.median(q_lead0_4, 14), "median_intcycle5_len14_lead0_4", display=display.data_window)
plot(ta.mode(q_clean, 14), "mode_intcycle5_len14_clean", display=display.data_window)
plot(ta.mode(q_hole40_41, 14), "mode_intcycle5_len14_hole40_41", display=display.data_window)
plot(ta.mode(q_lead0_4, 14), "mode_intcycle5_len14_lead0_4", display=display.data_window)
plot(ta.range(q_clean, 14), "range_intcycle5_len14_clean", display=display.data_window)
plot(ta.range(q_hole40_41, 14), "range_intcycle5_len14_hole40_41", display=display.data_window)
plot(ta.range(q_lead0_4, 14), "range_intcycle5_len14_lead0_4", display=display.data_window)
plot(ta.stdev(s_clean, 14, false), "stdev_len14_unbiased_clean", display=display.data_window)
plot(ta.stdev(s_hole40_41, 14, false), "stdev_len14_unbiased_hole40_41", display=display.data_window)
plot(ta.stdev(s_lead0_4, 14, false), "stdev_len14_unbiased_lead0_4", display=display.data_window)
plot(ta.variance(s_clean, 14, false), "variance_len14_unbiased_clean", display=display.data_window)
plot(ta.variance(s_hole40_41, 14, false), "variance_len14_unbiased_hole40_41", display=display.data_window)
plot(ta.variance(s_lead0_4, 14, false), "variance_len14_unbiased_lead0_4", display=display.data_window)
plot(ta.percentile_nearest_rank(s_hole40_41, 14, 25.0), "percentile_nearest_rank_len14_pct25_hole40_41", display=display.data_window)
plot(ta.percentile_linear_interpolation(s_hole40_41, 14, 25.0), "percentile_linear_interpolation_len14_pct25_hole40_41", display=display.data_window)
f_running(s, useMax) =>
    var float value = na
    if not na(s)
        value := na(value) ? s : (useMax ? math.max(value, s) : math.min(value, s))
    value
plot(f_running(s_hole40_41, true), "control_running_max_hole40_41", display=display.data_window)
plot(f_running(s_hole40_41, false), "control_running_min_hole40_41", display=display.data_window)
