//@version=6
indicator("TA coverage 2 v1", overlay=false, precision=12, max_bars_back=200)
// Capture on BINANCE:BTCUSDT standard 2-minute candles; export full history 0..at least 200.
// All calls execute on every bar. No changing lengths and no HMA length 1.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_hole40_41 = hole ? na : close
s_lead0_4 = bar_index < 5 ? na : close
plot(open, "input_open", display=display.data_window)
plot(high, "input_high", display=display.data_window)
plot(low, "input_low", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(volume, "input_volume", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(hole ? 1 : 0, "input_hole_bar40_41", display=display.data_window)
[macd_line_clean, macd_signal_clean, macd_hist_clean] = ta.macd(s_clean, 12, 26, 9)
plot(macd_line_clean, "macd_line_12_26_9_clean", display=display.data_window)
plot(macd_signal_clean, "macd_signal_12_26_9_clean", display=display.data_window)
plot(macd_hist_clean, "macd_hist_12_26_9_clean", display=display.data_window)
[macd_line_hole40_41, macd_signal_hole40_41, macd_hist_hole40_41] = ta.macd(s_hole40_41, 12, 26, 9)
plot(macd_line_hole40_41, "macd_line_12_26_9_hole40_41", display=display.data_window)
plot(macd_signal_hole40_41, "macd_signal_12_26_9_hole40_41", display=display.data_window)
plot(macd_hist_hole40_41, "macd_hist_12_26_9_hole40_41", display=display.data_window)
[macd_line_lead0_4, macd_signal_lead0_4, macd_hist_lead0_4] = ta.macd(s_lead0_4, 12, 26, 9)
plot(macd_line_lead0_4, "macd_line_12_26_9_lead0_4", display=display.data_window)
plot(macd_signal_lead0_4, "macd_signal_12_26_9_lead0_4", display=display.data_window)
plot(macd_hist_lead0_4, "macd_hist_12_26_9_lead0_4", display=display.data_window)
plot(ta.tsi(s_clean, 5, 14), "tsi_short5_long14_clean", display=display.data_window)
plot(ta.tsi(s_hole40_41, 5, 14), "tsi_short5_long14_hole40_41", display=display.data_window)
plot(ta.tsi(s_lead0_4, 5, 14), "tsi_short5_long14_lead0_4", display=display.data_window)
plot(ta.correlation(s_clean, open, 14), "correlation_close_open_len14_clean", display=display.data_window)
plot(ta.correlation(s_hole40_41, open, 14), "correlation_close_open_len14_hole40_41", display=display.data_window)
plot(ta.correlation(s_lead0_4, open, 14), "correlation_close_open_len14_lead0_4", display=display.data_window)
plot(ta.rci(s_clean, 14), "rci_len14_clean", display=display.data_window)
plot(ta.rci(s_hole40_41, 14), "rci_len14_hole40_41", display=display.data_window)
plot(ta.rci(s_lead0_4, 14), "rci_len14_lead0_4", display=display.data_window)
plot(ta.mom(s_clean, 14), "mom_len14_clean", display=display.data_window)
plot(ta.mom(s_hole40_41, 14), "mom_len14_hole40_41", display=display.data_window)
plot(ta.mom(s_lead0_4, 14), "mom_len14_lead0_4", display=display.data_window)
plot(ta.roc(s_clean, 14), "roc_len14_clean", display=display.data_window)
plot(ta.roc(s_hole40_41, 14), "roc_len14_hole40_41", display=display.data_window)
plot(ta.roc(s_lead0_4, 14), "roc_len14_lead0_4", display=display.data_window)
plot(ta.cog(s_clean, 14), "cog_len14_clean", display=display.data_window)
plot(ta.cog(s_hole40_41, 14), "cog_len14_hole40_41", display=display.data_window)
plot(ta.cog(s_lead0_4, 14), "cog_len14_lead0_4", display=display.data_window)
plot(ta.sma(s_clean, 14), "sma_len14_clean", display=display.data_window)
plot(ta.sma(s_hole40_41, 14), "sma_len14_hole40_41", display=display.data_window)
plot(ta.sma(s_lead0_4, 14), "sma_len14_lead0_4", display=display.data_window)
plot(ta.ema(s_clean, 14), "ema_len14_clean", display=display.data_window)
plot(ta.ema(s_hole40_41, 14), "ema_len14_hole40_41", display=display.data_window)
plot(ta.ema(s_lead0_4, 14), "ema_len14_lead0_4", display=display.data_window)
plot(ta.hma(s_clean, 14), "hma_len14_clean", display=display.data_window)
plot(ta.hma(s_hole40_41, 14), "hma_len14_hole40_41", display=display.data_window)
plot(ta.hma(s_lead0_4, 14), "hma_len14_lead0_4", display=display.data_window)
plot(ta.wma(s_clean, 14), "wma_len14_clean", display=display.data_window)
plot(ta.wma(s_hole40_41, 14), "wma_len14_hole40_41", display=display.data_window)
plot(ta.wma(s_lead0_4, 14), "wma_len14_lead0_4", display=display.data_window)
plot(ta.vwma(s_clean, 14), "vwma_len14_clean", display=display.data_window)
plot(ta.vwma(s_hole40_41, 14), "vwma_len14_hole40_41", display=display.data_window)
plot(ta.vwma(s_lead0_4, 14), "vwma_len14_lead0_4", display=display.data_window)
plot(ta.swma(s_clean), "swma_len4_clean", display=display.data_window)
plot(ta.swma(s_hole40_41), "swma_len4_hole40_41", display=display.data_window)
plot(ta.swma(s_lead0_4), "swma_len4_lead0_4", display=display.data_window)
plot(ta.alma(s_clean, 14, 0.85, 6.0, false), "alma_len14_clean", display=display.data_window)
plot(ta.alma(s_hole40_41, 14, 0.85, 6.0, false), "alma_len14_hole40_41", display=display.data_window)
plot(ta.alma(s_lead0_4, 14, 0.85, 6.0, false), "alma_len14_lead0_4", display=display.data_window)
plot(ta.linreg(s_clean, 14, 0), "linreg_len14_clean", display=display.data_window)
plot(ta.linreg(s_hole40_41, 14, 0), "linreg_len14_hole40_41", display=display.data_window)
plot(ta.linreg(s_lead0_4, 14, 0), "linreg_len14_lead0_4", display=display.data_window)
plot(macd_line_hole40_41 - macd_signal_hole40_41, "control_macd_hist_identity_hole40_41", display=display.data_window)
