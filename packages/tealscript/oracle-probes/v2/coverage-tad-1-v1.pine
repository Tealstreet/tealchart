//@version=6
indicator("TA-D unresolved coverage 1 v1", overlay=false, precision=16, max_bars_back=100)
// All arguments are valid Pine v6 contracts. Invalid-call rows require separate
// compiler/runtime diagnostic captures; valid controls below cannot settle them.
f_sma_reference(s, n) =>
    total = 0.0
    for i = 0 to n - 1
        total := total + s[i] / n
    total
f_wma_reference(s, n) =>
    total = 0.0
    norm = 0.0
    for i = 0 to n - 1
        weight = (n - i) * n
        total := total + s[i] * weight
        norm := norm + weight
    total / norm
f_non_na_mean(s, n) =>
    total = 0.0
    count = 0
    for i = 0 to 15
        if count < n and not na(s[i])
            total := total + s[i]
            count := count + 1
    count == n ? total / n : na
f_non_na_wma(s, n) =>
    total = 0.0
    count = 0
    norm = 0.0
    for i = 0 to 15
        if count < n and not na(s[i])
            weight = n - count
            total := total + s[i] * weight
            norm := norm + weight
            count := count + 1
    count == n ? total / norm : na
f_rma_reference(s, n) =>
    alpha = 1.0 / n
    sum = 0.0
    sum := na(sum[1]) ? ta.sma(s, n) : alpha * s + (1.0 - alpha) * nz(sum[1])
    sum
f_rma_hold(s, n) =>
    var float value = na
    var float total = 0.0
    var int count = 0
    if not na(s)
        if count < n
            total := total + s
            count := count + 1
            if count == n
                value := total / n
        else
            value := s / n + (1.0 - 1.0 / n) * value
    value
// Equivalent explicit return for the reference SUM helper, including literal15.
f_reference_SUM(a, b) =>
    res = a + b
    if math.abs(res) <= 1e-10
        res := 0.0
    else if math.abs(res) <= 1e-4
        res := 15.0
    res
f_stdev_SUM(s, n) =>
    avg = ta.sma(s, n)
    squares = 0.0
    for i = 0 to n - 1
        delta = f_reference_SUM(s[i], -avg)
        squares := squares + delta * delta
    math.sqrt(squares / n)
f_supertrend_reference(factor, atrPeriod) =>
    src = hl2
    atr = ta.atr(atrPeriod)
    upperBand = src + factor * atr
    lowerBand = src - factor * atr
    prevLowerBand = nz(lowerBand[1])
    prevUpperBand = nz(upperBand[1])
    lowerBand := lowerBand > prevLowerBand or close[1] < prevLowerBand ? lowerBand : prevLowerBand
    upperBand := upperBand < prevUpperBand or close[1] > prevUpperBand ? upperBand : prevUpperBand
    int direction = na
    float superTrend = na
    prevSuperTrend = superTrend[1]
    if na(atr[1])
        direction := 1
    else if prevSuperTrend == prevUpperBand
        direction := close > upperBand ? -1 : 1
    else
        direction := close < lowerBand ? 1 : -1
    superTrend := direction == -1 ? lowerBand : upperBand
    [superTrend, direction]
f_sar_reference(start, inc, max) =>
    var float result = na
    var float maxMin = na
    var float acceleration = na
    var bool isBelow = false
    bool isFirstTrendBar = false
    if bar_index == 1
        if close > close[1]
            isBelow := true
            maxMin := high
            result := low[1]
        else
            isBelow := false
            maxMin := low
            result := high[1]
        isFirstTrendBar := true
        acceleration := start
    result := result + acceleration * (maxMin - result)
    if isBelow
        if result > low
            isFirstTrendBar := true
            isBelow := false
            result := math.max(high, maxMin)
            maxMin := low
            acceleration := start
    else
        if result < high
            isFirstTrendBar := true
            isBelow := true
            result := math.min(low, maxMin)
            maxMin := high
            acceleration := start
    if not isFirstTrendBar
        if isBelow
            if high > maxMin
                maxMin := high
                acceleration := math.min(acceleration + inc, max)
        else
            if low < maxMin
                maxMin := low
                acceleration := math.min(acceleration + inc, max)
    if isBelow
        result := math.min(result, low[1])
        if bar_index > 1
            result := math.min(result, low[2])
    else
        result := math.max(result, high[1])
        if bar_index > 1
            result := math.max(result, high[2])
    result
wave = 50.0 + (bar_index % 11) * 2.0 + (bar_index % 3 == 0 ? 7.0 : -3.0)
hole = bar_index == 40 or bar_index == 41 ? na : wave
n = bar_index % 2 == 0 ? 2 : 3
biased = bar_index % 2 == 0
factor = bar_index % 2 == 0 ? 2.0 : 3.0
tiny = 1.0 + (bar_index % 5) * 0.00001
altSource = close + 100.0
delayed = bar_index == 40
mean3 = (wave + wave[1] + wave[2]) / 3.0
sq3 = math.pow(wave - mean3, 2) + math.pow(wave[1] - mean3, 2) + math.pow(wave[2] - mean3, 2)
varExpected = sq3 / (biased ? 3.0 : 2.0)
[stDyn, dirDyn] = ta.supertrend(factor, 3)
[stDynRef, dirDynRef] = f_supertrend_reference(factor, 3)
[stFixed, dirFixed] = ta.supertrend(2.0, 3)
[stFixedRef, dirFixedRef] = f_supertrend_reference(2.0, 3)
[vDelay, uDelay, lDelay] = ta.vwap(close, delayed, 2.0)
[vNever, uNever, lNever] = ta.vwap(close, false, 2.0)
plot(time, "input_time_ms", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(open, "input_open", display=display.data_window)
plot(high, "input_high", display=display.data_window)
plot(low, "input_low", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(volume, "input_volume", display=display.data_window)
plot(wave, "input_wave", display=display.data_window)
plot(hole, "input_hole40_41", display=display.data_window)
plot(n, "input_length_alt2_3", display=display.data_window)
plot(biased ? 1 : 0, "input_biased_alt", display=display.data_window)
plot(factor, "input_factor_alt2_3", display=display.data_window)
plot(tiny, "input_tiny_cycle5", display=display.data_window)
plot(altSource, "input_stoch_nonclose", display=display.data_window)
plot(delayed ? 1 : 0, "input_anchor40", display=display.data_window)
plot(ta.range(wave, n), "range_dyn_builtin", display=display.data_window)
plot(n == 2 ? math.max(wave, wave[1]) - math.min(wave, wave[1]) : math.max(wave, math.max(wave[1], wave[2])) - math.min(wave, math.min(wave[1], wave[2])), "range_dyn_manual", display=display.data_window)
plot(ta.wma(wave, n), "wma_dyn_builtin", display=display.data_window)
plot(n == 2 ? (2.0 * wave + wave[1]) / 3.0 : (3.0 * wave + 2.0 * wave[1] + wave[2]) / 6.0, "wma_dyn_manual", display=display.data_window)
plot(ta.variance(wave, 3, biased), "variance_dyn_biased_builtin", display=display.data_window)
plot(varExpected, "variance_dyn_biased_manual", display=display.data_window)
plot(ta.stdev(wave, 3, biased), "stdev_dyn_biased_builtin", display=display.data_window)
plot(math.sqrt(varExpected), "stdev_dyn_biased_manual", display=display.data_window)
plot(stDyn, "supertrend_dyn_line", display=display.data_window)
plot(dirDyn, "supertrend_dyn_direction", display=display.data_window)
plot(stDynRef, "supertrend_dyn_ref_line", display=display.data_window)
plot(dirDynRef, "supertrend_dyn_ref_direction", display=display.data_window)
plot(stFixed, "supertrend_fixed_line", display=display.data_window)
plot(dirFixed, "supertrend_fixed_direction", display=display.data_window)
plot(stFixedRef, "supertrend_fixed_ref_line", display=display.data_window)
plot(dirFixedRef, "supertrend_fixed_ref_direction", display=display.data_window)
plot(ta.sar(0.02, 0.02, 0.2), "sar_builtin", display=display.data_window)
plot(f_sar_reference(0.02, 0.02, 0.2), "sar_reference", display=display.data_window)
plot(vDelay, "vwap_tuple_delayed_basis", display=display.data_window)
plot(uDelay, "vwap_tuple_delayed_upper2", display=display.data_window)
plot(lDelay, "vwap_tuple_delayed_lower2", display=display.data_window)
plot(vNever, "vwap_tuple_never_basis", display=display.data_window)
plot(uNever, "vwap_tuple_never_upper2", display=display.data_window)
plot(lNever, "vwap_tuple_never_lower2", display=display.data_window)
plot(ta.sma(hole, 3), "sma_hole_builtin", display=display.data_window)
plot(f_sma_reference(hole, 3), "sma_hole_fixed_reference", display=display.data_window)
plot(f_non_na_mean(hole, 3), "sma_hole_non_na_manual", display=display.data_window)
plot(ta.wma(hole, 3), "wma_hole_builtin", display=display.data_window)
plot(f_wma_reference(hole, 3), "wma_hole_fixed_reference", display=display.data_window)
plot(f_non_na_wma(hole, 3), "wma_hole_non_na_manual", display=display.data_window)
plot(ta.rma(hole, 3), "rma_hole_builtin", display=display.data_window)
plot(f_rma_reference(hole, 3), "rma_hole_reference", display=display.data_window)
plot(f_rma_hold(hole, 3), "rma_hole_hold_manual", display=display.data_window)
plot(ta.stdev(tiny, 5), "stdev_tiny_builtin", display=display.data_window)
plot(f_stdev_SUM(tiny, 5), "stdev_tiny_reference_SUM", display=display.data_window)
plot(bar_index >= 4 ? math.sqrt(2.0) * 0.00001 : na, "stdev_tiny_mathematical", display=display.data_window)
plot(ta.stoch(altSource, high, low, 3), "stoch_nonclose_builtin", display=display.data_window)
plot(100.0 * (altSource - ta.lowest(low, 3)) / (ta.highest(high, 3) - ta.lowest(low, 3)), "stoch_nonclose_source_formula", display=display.data_window)
plot(100.0 * (close - ta.lowest(low, 3)) / (ta.highest(high, 3) - ta.lowest(low, 3)), "stoch_nonclose_close_formula", display=display.data_window)
plot(ta.tr(true), "tr_simple_true_control", display=display.data_window)
plot(ta.tr(false), "tr_simple_false_control", display=display.data_window)
plot(ta.valuewhen(bar_index % 3 == 0, wave, 0), "valuewhen_occ0_control", display=display.data_window)
plot(ta.valuewhen(bar_index % 3 == 0, wave, 1), "valuewhen_occ1_control", display=display.data_window)
plot(ta.valuewhen(bar_index % 3 == 0, wave > 60, 1) ? 1 : 0, "valuewhen_bool_control", display=display.data_window)
plot(wave, "valuewhen_color_control", color=ta.valuewhen(bar_index % 3 == 0, color.red, 1), display=display.data_window)
