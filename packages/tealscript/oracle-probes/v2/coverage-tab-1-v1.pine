//@version=6
indicator("Coverage ta-b 1 v1 (60 plots)", overlay=false, precision=10, max_bars_back=200)
// Export all loaded chart rows starting at bar_index 0; minimum 80 historical bars.
// All 60 plots are data-window-only. No HMA length1, float period, or series-simple argument.
// Explicit int casts are LEGAL CONTROLS, not tests of the original forbidden argument.

p = bar_index % 16
dyn_source = p == 0 ? 1.0 : p == 1 ? 3.0 : p == 2 ? 2.0 : p == 3 ? 8.0 : p == 4 ? 4.0 : p == 5 ? 9.0 : p == 6 ? 5.0 : p == 7 ? 11.0 : p == 8 ? 7.0 : p == 9 ? 13.0 : p == 10 ? 6.0 : p == 11 ? 15.0 : p == 12 ? 4.0 : p == 13 ? 17.0 : p == 14 ? 10.0 : 19.0
q = bar_index % 8
fall_source = q == 0 ? 8.0 : q == 1 ? 6.0 : q == 2 ? 7.0 : q == 3 ? 5.0 : q == 4 ? 5.0 : q == 5 ? 4.0 : q == 6 ? 3.0 : 2.0
dynamic_length = p < 5 ? 2 : int(3.0)
hole_source = bar_index == 40 or bar_index == 41 ? float(na) : close
plot(open, title="input_open", display=display.data_window)
plot(high, title="input_high", display=display.data_window)
plot(low, title="input_low", display=display.data_window)
plot(close, title="input_close", display=display.data_window)
plot(volume, title="input_volume", display=display.data_window)
plot(bar_index, title="input_bar_index", display=display.data_window)
plot(dyn_source, title="input_dynamic_source", display=display.data_window)
plot(fall_source, title="input_falling_source", display=display.data_window)
plot(dynamic_length, title="input_dynamic_length", display=display.data_window)
plot(hole_source, title="input_ema_hole_source", display=display.data_window)
f_manual_dev(src, n) =>
    result = float(na)
    if bar_index >= n - 1
        total = 0.0
        for i = 0 to n - 1
            total := total + src[i]
        mean = total / n
        deviation = 0.0
        for i = 0 to n - 1
            deviation := deviation + math.abs(src[i] - mean)
        result := deviation / n
    result
f_manual_extreme(src, n, upper) =>
    result = float(na)
    offset = float(na)
    if bar_index >= n - 1
        result := src
        offset := 0.0
        for i = 1 to n - 1
            value = src[i]
            better = upper ? value > result : value < result
            if better
                result := value
                offset := -i
    [result, offset]
f_manual_linreg(src, n) =>
    result = float(na)
    if bar_index >= n - 1
        sx = 0.0
        sy = 0.0
        sxy = 0.0
        sxx = 0.0
        for i = 0 to n - 1
            x = float(i)
            y = src[n - 1 - i]
            sx := sx + x
            sy := sy + y
            sxy := sxy + x * y
            sxx := sxx + x * x
        slope = (n * sxy - sx * sy) / (n * sxx - sx * sx)
        intercept = (sy - slope * sx) / n
        result := intercept + slope * (n - 1)
    result
f_manual_falling(src, n) =>
    result = false
    if bar_index >= n
        result := true
        for i = 1 to n
            if src >= src[i]
                result := false
    result
[manual_hi, manual_hibars] = f_manual_extreme(dyn_source, dynamic_length, true)
[manual_lo, manual_lobars] = f_manual_extreme(dyn_source, dynamic_length, false)
plot(ta.dev(dyn_source, dynamic_length), title="dev_dynamic_builtin", display=display.data_window)
plot(f_manual_dev(dyn_source,dynamic_length), title="dev_dynamic_manual", display=display.data_window)
plot(ta.highest(dyn_source, dynamic_length), title="highest_dynamic_builtin", display=display.data_window)
plot(manual_hi, title="highest_dynamic_manual", display=display.data_window)
plot(ta.lowest(dyn_source, dynamic_length), title="lowest_dynamic_builtin", display=display.data_window)
plot(manual_lo, title="lowest_dynamic_manual", display=display.data_window)
plot(ta.linreg(dyn_source, dynamic_length, 0), title="linreg_dynamic_builtin", display=display.data_window)
plot(f_manual_linreg(dyn_source,dynamic_length), title="linreg_dynamic_manual", display=display.data_window)
plot(ta.highestbars(dyn_source, dynamic_length), title="highestbars_dynamic_builtin", display=display.data_window)
plot(manual_hibars, title="highestbars_dynamic_manual", display=display.data_window)
plot(ta.lowestbars(dyn_source, dynamic_length), title="lowestbars_dynamic_builtin", display=display.data_window)
plot(manual_lobars, title="lowestbars_dynamic_manual", display=display.data_window)
plot(ta.falling(fall_source, dynamic_length) ? 1 : 0, title="falling_dynamic_builtin", display=display.data_window)
plot(f_manual_falling(fall_source,dynamic_length) ? 1 : 0, title="falling_dynamic_manual", display=display.data_window)
pine_dev(source, length) =>
    mean = ta.sma(source, length)
    sum = 0.0
    for i = 0 to length - 1
        val = source[i]
        sum := sum + math.abs(val - mean)
    dev = sum/length
pine_ema(src, length) =>
    alpha = 2 / (length + 1)
    sum = 0.0
    sum := na(sum[1]) ? src : alpha * src + (1 - alpha) * nz(sum[1])
f_kc(src, length, mult, useTrueRange) =>
    float basis = ta.ema(src, length)
    float span = (useTrueRange) ? ta.tr : (high - low)
    float rangeEma = ta.ema(span, length)
    [basis, basis + rangeEma * mult, basis - rangeEma * mult]
f_kcw(src, length, mult, useTrueRange) =>
    float basis = ta.ema(src, length)
    float span = (useTrueRange) ? ta.tr : (high - low)
    float rangeEma = ta.ema(span, length)

    ((basis + rangeEma * mult) - (basis - rangeEma * mult)) / basis
plot(ta.dev(close,10), title="dev_official_builtin_len10", display=display.data_window)
plot(pine_dev(close,10), title="dev_official_terminal_declaration", display=display.data_window)
plot(f_manual_dev(close,10), title="dev_manual_mad_len10", display=display.data_window)
ema15_alpha = 2.0 / 16
ema15_inline = 0.0
ema15_inline := na(ema15_inline[1]) ? close : ema15_alpha * close + (1 - ema15_alpha) * nz(ema15_inline[1])
plot(ta.ema(close,15), title="ema_official_builtin_len15", display=display.data_window)
plot(pine_ema(close,15), title="ema_official_terminal_assignment", display=display.data_window)
plot(ema15_inline, title="ema_inline_first_source_len15", display=display.data_window)
[kc_omit_mid, kc_omit_up, kc_omit_lo] = ta.kc(close,5,4)
[kc_true_mid, kc_true_up, kc_true_lo] = ta.kc(close,5,4,true)
[kc_false_mid, kc_false_up, kc_false_lo] = ta.kc(close,5,4,false)
[kc_doc_mid, kc_doc_up, kc_doc_lo] = f_kc(close,5,4,true)
plot(kc_omit_mid, title="kc_len5_mult4_omit_mid", display=display.data_window)
plot(kc_omit_up, title="kc_len5_mult4_omit_up", display=display.data_window)
plot(kc_omit_lo, title="kc_len5_mult4_omit_lo", display=display.data_window)
plot(kc_true_mid, title="kc_len5_mult4_true_mid", display=display.data_window)
plot(kc_true_up, title="kc_len5_mult4_true_up", display=display.data_window)
plot(kc_true_lo, title="kc_len5_mult4_true_lo", display=display.data_window)
plot(kc_false_mid, title="kc_len5_mult4_false_mid", display=display.data_window)
plot(kc_false_up, title="kc_len5_mult4_false_up", display=display.data_window)
plot(kc_false_lo, title="kc_len5_mult4_false_lo", display=display.data_window)
plot(kc_doc_mid, title="kc_len5_mult4_doc_mid", display=display.data_window)
plot(kc_doc_up, title="kc_len5_mult4_doc_up", display=display.data_window)
plot(kc_doc_lo, title="kc_len5_mult4_doc_lo", display=display.data_window)
plot(ta.ema(ta.tr,5), title="kc_doc_range_ema_tr_len5", display=display.data_window)
plot(ta.ema(close,5), title="kc_doc_basis_ema_len5", display=display.data_window)
plot(ta.kcw(close,5,4), title="kcw_len5_mult4_omit", display=display.data_window)
plot(ta.kcw(close,5,4,true), title="kcw_len5_mult4_true", display=display.data_window)
plot(ta.kcw(close,5,4,false), title="kcw_len5_mult4_false", display=display.data_window)
plot(f_kcw(close,5,4,true), title="kcw_len5_mult4_doc", display=display.data_window)
f_ema_reseed_control(src, n) =>
    alpha = 2.0 / (n + 1)
    result = 0.0
    result := na(result[1]) ? src : alpha * src + (1 - alpha) * nz(result[1])
    result
var float hole_hold_state = na
var float hole_sma_state = na
var float hole_seed_sum = 0.0
var int hole_seed_count = 0
if not na(hole_source)
    hole_hold_state := na(hole_hold_state) ? hole_source : (2.0 / 15) * hole_source + (13.0 / 15) * hole_hold_state
    if hole_seed_count < 14
        hole_seed_count := hole_seed_count + 1
        hole_seed_sum := hole_seed_sum + hole_source
        if hole_seed_count == 14
            hole_sma_state := hole_seed_sum / 14
    else
        hole_sma_state := (2.0 / 15) * hole_source + (13.0 / 15) * hole_sma_state
plot(ta.ema(hole_source,14), title="ema_hole_builtin_len14", display=display.data_window)
plot(pine_ema(hole_source,14), title="ema_hole_literal_official_function", display=display.data_window)
plot(na(hole_source) ? float(na) : hole_hold_state, title="ema_hole_first_seed_hold_state_emit_na", display=display.data_window)
plot(f_ema_reseed_control(hole_source,14), title="ema_hole_reseed_control", display=display.data_window)
plot(na(hole_source) ? float(na) : hole_sma_state, title="ema_hole_sma_seed_hold_state_emit_na", display=display.data_window)
[dmi_cast_plus, dmi_cast_minus, dmi_cast_adx] = ta.dmi(int(3.0),int(3.0))
[kc_cast_mid, kc_cast_up, kc_cast_lo] = ta.kc(close,int(3.0),2.0,true)
[macd_cast_line, macd_cast_signal, macd_cast_hist] = ta.macd(close,int(3.0),int(5.0),int(3.0))
plot(dmi_cast_plus, title="dmi_legal_explicit_int_cast_control", display=display.data_window)
plot(ta.ema(close,int(3.0)), title="ema_legal_explicit_int_cast_control", display=display.data_window)
plot(ta.hma(close,int(3.0)), title="hma_legal_explicit_int_cast_control", display=display.data_window)
plot(kc_cast_mid, title="kc_legal_explicit_int_cast_control", display=display.data_window)
plot(ta.kcw(close,int(3.0),2.0,true), title="kcw_legal_explicit_int_cast_control", display=display.data_window)
plot(macd_cast_line, title="macd_legal_explicit_int_cast_control", display=display.data_window)
plot(ta.linreg(close,3,int(3.0)), title="linreg_offset_legal_explicit_int_cast_control", display=display.data_window)
