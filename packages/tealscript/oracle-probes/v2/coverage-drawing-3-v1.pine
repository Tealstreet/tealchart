//@version=6
indicator("Drawing mutations v1 — BTCUSDT 2m", overlay=true, precision=10, max_lines_count=50, max_boxes_count=50, max_labels_count=50)
b = bar_index
hole = b % 97 >= 40 and b % 97 <= 42
s = close
l = line.new(b, s, b + 1, s + 2)
q = box.new(b, s + 3, b + 1, s - 3)
t = label.new(b, s)
lc = line.copy(l)
qc = box.copy(q)
tc = label.copy(t)
line.set_xy1(l, b - 1, s - 1)
line.set_xy2(l, b + 2, s + 5)
box.set_lefttop(q, b - 1, s + 4)
box.set_rightbottom(q, b + 2, s - 4)
label.set_xy(t, b + 2, s + 6)
plot(line.get_x1(l), "clean_mutated_get_x1", display=display.data_window)
plot(line.get_y2(l), "clean_mutated_get_y2", display=display.data_window)
plot(line.get_price(l, b + 3), "clean_mutated_get_price", display=display.data_window)
plot(box.get_left(q), "clean_mutated_get_left", display=display.data_window)
plot(box.get_top(q), "clean_mutated_get_top", display=display.data_window)
plot(box.get_right(q), "clean_mutated_get_right", display=display.data_window)
plot(box.get_bottom(q), "clean_mutated_get_bottom", display=display.data_window)
plot(label.get_x(t), "clean_mutated_get_x", display=display.data_window)
plot(label.get_y(t), "clean_mutated_get_y", display=display.data_window)
plot(line.get_x1(lc), "clean_copy_get_x1", display=display.data_window)
plot(line.get_y2(lc), "clean_copy_get_y2", display=display.data_window)
plot(box.get_top(qc), "clean_copy_get_top", display=display.data_window)
plot(box.get_bottom(qc), "clean_copy_get_bottom", display=display.data_window)
plot(label.get_x(tc), "clean_copy_get_x", display=display.data_window)
plot(label.get_y(tc), "clean_copy_get_y", display=display.data_window)
line.set_xloc(l, time, time + 120000, xloc.bar_time)
box.set_xloc(q, time, time + 120000, xloc.bar_time)
label.set_xloc(t, time, xloc.bar_time)
plot(line.get_x1(l), "clean_time_get_x1", display=display.data_window)
plot(line.get_x2(l), "clean_time_get_x2", display=display.data_window)
plot(box.get_left(q), "clean_time_get_left", display=display.data_window)
plot(box.get_right(q), "clean_time_get_right", display=display.data_window)
plot(label.get_x(t), "clean_time_get_x", display=display.data_window)
line.delete(l)
line.delete(lc)
box.delete(q)
box.delete(qc)
label.delete(t)
label.delete(tc)
s := hole ? na : close
l := line.new(b, s, b + 1, s + 2)
q := box.new(b, s + 3, b + 1, s - 3)
t := label.new(b, s)
lc := line.copy(l)
qc := box.copy(q)
tc := label.copy(t)
line.set_xy1(l, b - 1, s - 1)
line.set_xy2(l, b + 2, s + 5)
box.set_lefttop(q, b - 1, s + 4)
box.set_rightbottom(q, b + 2, s - 4)
label.set_xy(t, b + 2, s + 6)
plot(line.get_x1(l), "holes_mutated_get_x1", display=display.data_window)
plot(line.get_y2(l), "holes_mutated_get_y2", display=display.data_window)
plot(line.get_price(l, b + 3), "holes_mutated_get_price", display=display.data_window)
plot(box.get_left(q), "holes_mutated_get_left", display=display.data_window)
plot(box.get_top(q), "holes_mutated_get_top", display=display.data_window)
plot(box.get_right(q), "holes_mutated_get_right", display=display.data_window)
plot(box.get_bottom(q), "holes_mutated_get_bottom", display=display.data_window)
plot(label.get_x(t), "holes_mutated_get_x", display=display.data_window)
plot(label.get_y(t), "holes_mutated_get_y", display=display.data_window)
plot(line.get_x1(lc), "holes_copy_get_x1", display=display.data_window)
plot(line.get_y2(lc), "holes_copy_get_y2", display=display.data_window)
plot(box.get_top(qc), "holes_copy_get_top", display=display.data_window)
plot(box.get_bottom(qc), "holes_copy_get_bottom", display=display.data_window)
plot(label.get_x(tc), "holes_copy_get_x", display=display.data_window)
plot(label.get_y(tc), "holes_copy_get_y", display=display.data_window)
line.set_xloc(l, time, time + 120000, xloc.bar_time)
box.set_xloc(q, time, time + 120000, xloc.bar_time)
label.set_xloc(t, time, xloc.bar_time)
plot(line.get_x1(l), "holes_time_get_x1", display=display.data_window)
plot(line.get_x2(l), "holes_time_get_x2", display=display.data_window)
plot(box.get_left(q), "holes_time_get_left", display=display.data_window)
plot(box.get_right(q), "holes_time_get_right", display=display.data_window)
plot(label.get_x(t), "holes_time_get_x", display=display.data_window)
line.delete(l)
line.delete(lc)
box.delete(q)
box.delete(qc)
label.delete(t)
label.delete(tc)
s := b < 5 ? na : close
l := line.new(b, s, b + 1, s + 2)
q := box.new(b, s + 3, b + 1, s - 3)
t := label.new(b, s)
lc := line.copy(l)
qc := box.copy(q)
tc := label.copy(t)
line.set_xy1(l, b - 1, s - 1)
line.set_xy2(l, b + 2, s + 5)
box.set_lefttop(q, b - 1, s + 4)
box.set_rightbottom(q, b + 2, s - 4)
label.set_xy(t, b + 2, s + 6)
plot(line.get_x1(l), "warmup_mutated_get_x1", display=display.data_window)
plot(line.get_y2(l), "warmup_mutated_get_y2", display=display.data_window)
plot(line.get_price(l, b + 3), "warmup_mutated_get_price", display=display.data_window)
plot(box.get_left(q), "warmup_mutated_get_left", display=display.data_window)
plot(box.get_top(q), "warmup_mutated_get_top", display=display.data_window)
plot(box.get_right(q), "warmup_mutated_get_right", display=display.data_window)
plot(box.get_bottom(q), "warmup_mutated_get_bottom", display=display.data_window)
plot(label.get_x(t), "warmup_mutated_get_x", display=display.data_window)
plot(label.get_y(t), "warmup_mutated_get_y", display=display.data_window)
plot(line.get_x1(lc), "warmup_copy_get_x1", display=display.data_window)
plot(line.get_y2(lc), "warmup_copy_get_y2", display=display.data_window)
plot(box.get_top(qc), "warmup_copy_get_top", display=display.data_window)
plot(box.get_bottom(qc), "warmup_copy_get_bottom", display=display.data_window)
plot(label.get_x(tc), "warmup_copy_get_x", display=display.data_window)
plot(label.get_y(tc), "warmup_copy_get_y", display=display.data_window)
line.set_xloc(l, time, time + 120000, xloc.bar_time)
box.set_xloc(q, time, time + 120000, xloc.bar_time)
label.set_xloc(t, time, xloc.bar_time)
plot(line.get_x1(l), "warmup_time_get_x1", display=display.data_window)
plot(line.get_x2(l), "warmup_time_get_x2", display=display.data_window)
plot(box.get_left(q), "warmup_time_get_left", display=display.data_window)
plot(box.get_right(q), "warmup_time_get_right", display=display.data_window)
plot(label.get_x(t), "warmup_time_get_x", display=display.data_window)
line.delete(l)
line.delete(lc)
box.delete(q)
box.delete(qc)
label.delete(t)
label.delete(tc)
