//@version=6
indicator("coverage-history-na-1-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean
var float held = na
if not na(holes)
    held := holes
varip float heldIp = na
if not na(holes)
    heldIp := holes
var float total = 0.0
total += nz(holes)

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(fixnan(clean), title="fixnan_clean", color=color.blue, display=display.data_window)
plot(fixnan(holes), title="fixnan_hole97", color=color.blue, display=display.data_window)
plot(fixnan(warm), title="fixnan_warm0_7", color=color.blue, display=display.data_window)
plot(nz(clean), title="nz_default_clean", color=color.blue, display=display.data_window)
plot(nz(holes), title="nz_default_hole97", color=color.blue, display=display.data_window)
plot(nz(warm), title="nz_default_warm0_7", color=color.blue, display=display.data_window)
plot(nz(clean,-999), title="nz_marker_clean", color=color.blue, display=display.data_window)
plot(nz(holes,-999), title="nz_marker_hole97", color=color.blue, display=display.data_window)
plot(nz(warm,-999), title="nz_marker_warm0_7", color=color.blue, display=display.data_window)
plot(na(clean) ? 1 : 0, title="na_predicate_clean", color=color.blue, display=display.data_window)
plot(na(holes) ? 1 : 0, title="na_predicate_hole97", color=color.blue, display=display.data_window)
plot(na(warm) ? 1 : 0, title="na_predicate_warm0_7", color=color.blue, display=display.data_window)
plot(int(clean), title="int_cast_clean", color=color.blue, display=display.data_window)
plot(int(holes), title="int_cast_hole97", color=color.blue, display=display.data_window)
plot(int(warm), title="int_cast_warm0_7", color=color.blue, display=display.data_window)
plot(float(clean), title="float_cast_clean", color=color.blue, display=display.data_window)
plot(float(holes), title="float_cast_hole97", color=color.blue, display=display.data_window)
plot(float(warm), title="float_cast_warm0_7", color=color.blue, display=display.data_window)
plot(bool(clean) ? 1 : 0, title="bool_cast_clean", color=color.blue, display=display.data_window)
plot(bool(holes) ? 1 : 0, title="bool_cast_hole97", color=color.blue, display=display.data_window)
plot(bool(warm) ? 1 : 0, title="bool_cast_warm0_7", color=color.blue, display=display.data_window)
plot(clean == 0 ? 1 : 0, title="compare_eq_clean", color=color.blue, display=display.data_window)
plot(holes == 0 ? 1 : 0, title="compare_eq_hole97", color=color.blue, display=display.data_window)
plot(warm == 0 ? 1 : 0, title="compare_eq_warm0_7", color=color.blue, display=display.data_window)
plot(clean != 0 ? 1 : 0, title="compare_ne_clean", color=color.blue, display=display.data_window)
plot(holes != 0 ? 1 : 0, title="compare_ne_hole97", color=color.blue, display=display.data_window)
plot(warm != 0 ? 1 : 0, title="compare_ne_warm0_7", color=color.blue, display=display.data_window)
plot(clean > 0 ? 1 : 0, title="compare_gt_clean", color=color.blue, display=display.data_window)
plot(holes > 0 ? 1 : 0, title="compare_gt_hole97", color=color.blue, display=display.data_window)
plot(warm > 0 ? 1 : 0, title="compare_gt_warm0_7", color=color.blue, display=display.data_window)
plot(clean >= 0 ? 1 : 0, title="compare_ge_clean", color=color.blue, display=display.data_window)
plot(holes >= 0 ? 1 : 0, title="compare_ge_hole97", color=color.blue, display=display.data_window)
plot(warm >= 0 ? 1 : 0, title="compare_ge_warm0_7", color=color.blue, display=display.data_window)
plot(clean < 0 ? 1 : 0, title="compare_lt_clean", color=color.blue, display=display.data_window)
plot(holes < 0 ? 1 : 0, title="compare_lt_hole97", color=color.blue, display=display.data_window)
plot(warm < 0 ? 1 : 0, title="compare_lt_warm0_7", color=color.blue, display=display.data_window)
plot(clean <= 0 ? 1 : 0, title="compare_le_clean", color=color.blue, display=display.data_window)
plot(holes <= 0 ? 1 : 0, title="compare_le_hole97", color=color.blue, display=display.data_window)
plot(warm <= 0 ? 1 : 0, title="compare_le_warm0_7", color=color.blue, display=display.data_window)
plot(holes+1, title="hole_add", color=color.blue, display=display.data_window)
plot(holes/2, title="hole_divide", color=color.blue, display=display.data_window)
plot(holes*0, title="hole_multiply_zero", color=color.blue, display=display.data_window)
plot(held, title="held_var", color=color.blue, display=display.data_window)
plot(held[1], title="held_var_history1", color=color.blue, display=display.data_window)
plot(heldIp, title="held_varip_historical", color=color.blue, display=display.data_window)
plot(total, title="sum_var_nz", color=color.blue, display=display.data_window)
plot((holes+1)[1], title="expr_history_sum1", color=color.blue, display=display.data_window)
plot(fixnan(holes)[1], title="fixnan_history1", color=color.blue, display=display.data_window)
plot(nz(holes,-999)[1], title="nz_before_history1", color=color.blue, display=display.data_window)
plot(nz(holes[1],-999), title="nz_after_history1", color=color.blue, display=display.data_window)
plot(bool(holes) ? 1 : 0, title="bool_false_na_cannot_exist", color=color.blue, display=display.data_window)
plot(na(holes) ? held[1] : holes, title="held_primitive_control", color=color.blue, display=display.data_window)
plot(1, title="regular_reset_control", color=color.blue, display=display.data_window)
