//@version=6
indicator("Drawing points v1 — BTCUSDT 2m", overlay=true, precision=10, max_lines_count=50, max_boxes_count=50, max_labels_count=50)
b = bar_index
hole = b % 97 >= 40 and b % 97 <= 42
s = close
p = chart.point.new(time, b, s)
r = chart.point.new(time + 120000, b + 1, s + 2)
l = line.new(p, r, xloc=xloc.bar_time)
q = box.new(r, p, xloc=xloc.bar_time)
t = label.new(p, xloc=xloc.bar_time)
changed = chart.point.new(time + 240000, b + 2, s - 19)
plot(line.get_x1(l), "clean_constructed_get_x1", display=display.data_window)
plot(line.get_y2(l), "clean_constructed_get_y2", display=display.data_window)
plot(box.get_top(q), "clean_constructed_get_top", display=display.data_window)
plot(box.get_left(q), "clean_constructed_get_left", display=display.data_window)
plot(label.get_x(t), "clean_constructed_get_x", display=display.data_window)
plot(label.get_y(t), "clean_constructed_get_y", display=display.data_window)
line.set_first_point(l, changed)
box.set_top_left_point(q, changed)
label.set_point(t, changed)
plot(line.get_x1(l), "clean_point_set_get_x1", display=display.data_window)
plot(line.get_y1(l), "clean_point_set_get_y1", display=display.data_window)
plot(line.get_x2(l), "clean_point_set_get_x2", display=display.data_window)
plot(box.get_left(q), "clean_point_set_get_left", display=display.data_window)
plot(box.get_top(q), "clean_point_set_get_top", display=display.data_window)
plot(box.get_right(q), "clean_point_set_get_right", display=display.data_window)
plot(label.get_x(t), "clean_point_set_get_x", display=display.data_window)
plot(label.get_y(t), "clean_point_set_get_y", display=display.data_window)
line.set_xloc(l, b + 3, b + 2, xloc.bar_index)
box.set_xloc(q, b + 3, b + 2, xloc.bar_index)
label.set_xloc(t, b + 3, xloc.bar_index)
plot(line.get_x1(l), "clean_switch_back_get_x1", display=display.data_window)
plot(line.get_x2(l), "clean_switch_back_get_x2", display=display.data_window)
plot(box.get_left(q), "clean_switch_back_get_left", display=display.data_window)
plot(box.get_right(q), "clean_switch_back_get_right", display=display.data_window)
plot(label.get_x(t), "clean_switch_back_get_x", display=display.data_window)
plot(line.get_price(l, b + 4), "clean_reverse_price", display=display.data_window)
line.delete(l)
box.delete(q)
label.delete(t)
s := hole ? na : close
p := chart.point.new(time, b, s)
r := chart.point.new(time + 120000, b + 1, s + 2)
l := line.new(p, r, xloc=xloc.bar_time)
q := box.new(r, p, xloc=xloc.bar_time)
t := label.new(p, xloc=xloc.bar_time)
changed := chart.point.new(time + 240000, b + 2, s - 19)
plot(line.get_x1(l), "holes_constructed_get_x1", display=display.data_window)
plot(line.get_y2(l), "holes_constructed_get_y2", display=display.data_window)
plot(box.get_top(q), "holes_constructed_get_top", display=display.data_window)
plot(box.get_left(q), "holes_constructed_get_left", display=display.data_window)
plot(label.get_x(t), "holes_constructed_get_x", display=display.data_window)
plot(label.get_y(t), "holes_constructed_get_y", display=display.data_window)
line.set_first_point(l, changed)
box.set_top_left_point(q, changed)
label.set_point(t, changed)
plot(line.get_x1(l), "holes_point_set_get_x1", display=display.data_window)
plot(line.get_y1(l), "holes_point_set_get_y1", display=display.data_window)
plot(line.get_x2(l), "holes_point_set_get_x2", display=display.data_window)
plot(box.get_left(q), "holes_point_set_get_left", display=display.data_window)
plot(box.get_top(q), "holes_point_set_get_top", display=display.data_window)
plot(box.get_right(q), "holes_point_set_get_right", display=display.data_window)
plot(label.get_x(t), "holes_point_set_get_x", display=display.data_window)
plot(label.get_y(t), "holes_point_set_get_y", display=display.data_window)
line.set_xloc(l, b + 3, b + 2, xloc.bar_index)
box.set_xloc(q, b + 3, b + 2, xloc.bar_index)
label.set_xloc(t, b + 3, xloc.bar_index)
plot(line.get_x1(l), "holes_switch_back_get_x1", display=display.data_window)
plot(line.get_x2(l), "holes_switch_back_get_x2", display=display.data_window)
plot(box.get_left(q), "holes_switch_back_get_left", display=display.data_window)
plot(box.get_right(q), "holes_switch_back_get_right", display=display.data_window)
plot(label.get_x(t), "holes_switch_back_get_x", display=display.data_window)
plot(line.get_price(l, b + 4), "holes_reverse_price", display=display.data_window)
line.delete(l)
box.delete(q)
label.delete(t)
s := b < 5 ? na : close
p := chart.point.new(time, b, s)
r := chart.point.new(time + 120000, b + 1, s + 2)
l := line.new(p, r, xloc=xloc.bar_time)
q := box.new(r, p, xloc=xloc.bar_time)
t := label.new(p, xloc=xloc.bar_time)
changed := chart.point.new(time + 240000, b + 2, s - 19)
plot(line.get_x1(l), "warmup_constructed_get_x1", display=display.data_window)
plot(line.get_y2(l), "warmup_constructed_get_y2", display=display.data_window)
plot(box.get_top(q), "warmup_constructed_get_top", display=display.data_window)
plot(box.get_left(q), "warmup_constructed_get_left", display=display.data_window)
plot(label.get_x(t), "warmup_constructed_get_x", display=display.data_window)
plot(label.get_y(t), "warmup_constructed_get_y", display=display.data_window)
line.set_first_point(l, changed)
box.set_top_left_point(q, changed)
label.set_point(t, changed)
plot(line.get_x1(l), "warmup_point_set_get_x1", display=display.data_window)
plot(line.get_y1(l), "warmup_point_set_get_y1", display=display.data_window)
plot(line.get_x2(l), "warmup_point_set_get_x2", display=display.data_window)
plot(box.get_left(q), "warmup_point_set_get_left", display=display.data_window)
plot(box.get_top(q), "warmup_point_set_get_top", display=display.data_window)
plot(box.get_right(q), "warmup_point_set_get_right", display=display.data_window)
plot(label.get_x(t), "warmup_point_set_get_x", display=display.data_window)
plot(label.get_y(t), "warmup_point_set_get_y", display=display.data_window)
line.set_xloc(l, b + 3, b + 2, xloc.bar_index)
box.set_xloc(q, b + 3, b + 2, xloc.bar_index)
label.set_xloc(t, b + 3, xloc.bar_index)
plot(line.get_x1(l), "warmup_switch_back_get_x1", display=display.data_window)
plot(line.get_x2(l), "warmup_switch_back_get_x2", display=display.data_window)
plot(box.get_left(q), "warmup_switch_back_get_left", display=display.data_window)
plot(box.get_right(q), "warmup_switch_back_get_right", display=display.data_window)
plot(label.get_x(t), "warmup_switch_back_get_x", display=display.data_window)
plot(line.get_price(l, b + 4), "warmup_reverse_price", display=display.data_window)
line.delete(l)
box.delete(q)
label.delete(t)
