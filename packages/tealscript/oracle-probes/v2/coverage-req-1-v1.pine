//@version=6
indicator("Coverage req 1 v1", overlay=false, precision=10)
if timeframe.period != "2"
    runtime.error("Use BINANCE:BTCUSDT on a standard 2-minute chart")
holeLtf() =>
    phase = int(time / 60000) % 29
    phase == 5 or phase == 6 ? na : close
warmLtf() =>
    value = ta.sma(close, 7)
    int(time / 60000) % 47 < 7 ? na : value
holeHtf() =>
    phase = int(time / 360000) % 11
    phase == 3 or phase == 4 ? na : close
stats(array<float> values) =>
    count = array.size(values)
    valid = 0
    total = 0.0
    if count > 0
        for i = 0 to count - 1
            value = array.get(values, i)
            if not na(value)
                valid += 1
                total += value
    first = count > 0 ? array.get(values, 0) : na
    last = count > 0 ? array.get(values, count - 1) : na
    [float(count), float(valid), first, last, valid > 0 ? total : na, valid > 0 ? total / valid : na]
[lowerClean, lowerHole, lowerWarm] = request.security_lower_tf(syminfo.tickerid, "1", [close, holeLtf(), warmLtf()])
[lcCount, lcValid, lcFirst, lcLast, lcSum, lcMean] = stats(lowerClean)
[lhCount, lhValid, lhFirst, lhLast, lhSum, lhMean] = stats(lowerHole)
[lwCount, lwValid, lwFirst, lwLast, lwSum, lwMean] = stats(lowerWarm)
[ooClose, ooHole, ooSma, ooRma, ooTime] = request.security(syminfo.tickerid, "6", [close, holeHtf(), ta.sma(close, 4), ta.rma(close, 4), float(time)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[onClose, onHole, onSma, onRma, onTime] = request.security(syminfo.tickerid, "6", [close, holeHtf(), ta.sma(close, 4), ta.rma(close, 4), float(time)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[noClose, noHole, noSma, noRma, noTime] = request.security(syminfo.tickerid, "6", [close, holeHtf(), ta.sma(close, 4), ta.rma(close, 4), float(time)], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
[nnClose, nnHole, nnSma, nnRma, nnTime] = request.security(syminfo.tickerid, "6", [close, holeHtf(), ta.sma(close, 4), ta.rma(close, 4), float(time)], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
var panel = table.new(position.top_right, 3, 2)
var bool merged = false
if barstate.isfirst
    table.cell(panel, 0, 0, "req-1 coverage v1")
    table.merge_cells(panel, 0, 0, 2, 0)
    merged := true
beforeScratch = float(array.size(table.all))
scratch = table.new(position.bottom_right, 1, 1)
table.cell(scratch, 0, 0, "scratch")
withScratch = float(array.size(table.all))
table.clear(scratch, 0, 0, 0, 0)
afterClear = float(array.size(table.all))
table.delete(scratch)
afterDelete = float(array.size(table.all))
cellClean = close
cellHole = int(time / 60000) % 29 == 5 ? na : close
cellWarm = bar_index < 7 ? na : close
cleanText = str.tostring(cellClean, "0.000000")
holeText = str.tostring(cellHole, "0.000000")
warmText = str.tostring(cellWarm, "0.000000")
table.cell(panel, 0, 1, cleanText)
table.cell(panel, 1, 1, holeText)
table.cell(panel, 2, 1, warmText)
cellsReached = float(bar_index + 1)
table.cell_set_text(panel, 0, 1, cleanText)
table.cell_set_tooltip(panel, 0, 1, "clean close input")
textReached = float(bar_index + 1)
table.cell_set_width(panel, 0, 1, 20)
table.cell_set_height(panel, 0, 1, 10)
geometryReached = float(bar_index + 1)
table.cell_set_text_color(panel, 0, 1, color.white)
table.cell_set_bgcolor(panel, 0, 1, color.navy)
table.cell_set_text_halign(panel, 0, 1, text.align_center)
table.cell_set_text_valign(panel, 0, 1, text.align_center)
table.cell_set_text_size(panel, 0, 1, size.normal)
table.cell_set_text_font_family(panel, 0, 1, font.family_monospace)
table.cell_set_text_formatting(panel, 0, 1, text.format_bold)
appearanceReached = float(bar_index + 1)
plot(open, "open", display=display.data_window)
plot(high, "high", display=display.data_window)
plot(low, "low", display=display.data_window)
plot(close, "close", display=display.data_window)
plot(volume, "volume", display=display.data_window)
plot(time, "time", display=display.data_window)
plot(bar_index, "bar_index", display=display.data_window)
plot(lcCount, "ltf1_clean_count", display=display.data_window)
plot(lcValid, "ltf1_clean_non_na_count", display=display.data_window)
plot(lcFirst, "ltf1_clean_first", display=display.data_window)
plot(lcLast, "ltf1_clean_last", display=display.data_window)
plot(lcSum, "ltf1_clean_non_na_sum", display=display.data_window)
plot(lcMean, "ltf1_clean_non_na_mean", display=display.data_window)
plot(lhCount, "ltf1_hole_count", display=display.data_window)
plot(lhValid, "ltf1_hole_non_na_count", display=display.data_window)
plot(lhFirst, "ltf1_hole_first", display=display.data_window)
plot(lhLast, "ltf1_hole_last", display=display.data_window)
plot(lhSum, "ltf1_hole_non_na_sum", display=display.data_window)
plot(lhMean, "ltf1_hole_non_na_mean", display=display.data_window)
plot(lwCount, "ltf1_warm_count", display=display.data_window)
plot(lwValid, "ltf1_warm_non_na_count", display=display.data_window)
plot(lwFirst, "ltf1_warm_first", display=display.data_window)
plot(lwLast, "ltf1_warm_last", display=display.data_window)
plot(lwSum, "ltf1_warm_non_na_sum", display=display.data_window)
plot(lwMean, "ltf1_warm_non_na_mean", display=display.data_window)
plot(ooClose, "htf6_clean_gapsoff_lookaheadoff", display=display.data_window)
plot(ooHole, "htf6_hole_gapsoff_lookaheadoff", display=display.data_window)
plot(ooSma, "htf6_sma4_warm_gapsoff_lookaheadoff", display=display.data_window)
plot(ooRma, "htf6_rma4_warm_gapsoff_lookaheadoff", display=display.data_window)
plot(ooTime, "htf6_time_gapsoff_lookaheadoff", display=display.data_window)
plot(onClose, "htf6_clean_gapsoff_lookaheadon", display=display.data_window)
plot(onHole, "htf6_hole_gapsoff_lookaheadon", display=display.data_window)
plot(onSma, "htf6_sma4_warm_gapsoff_lookaheadon", display=display.data_window)
plot(onRma, "htf6_rma4_warm_gapsoff_lookaheadon", display=display.data_window)
plot(onTime, "htf6_time_gapsoff_lookaheadon", display=display.data_window)
plot(noClose, "htf6_clean_gapson_lookaheadoff", display=display.data_window)
plot(noHole, "htf6_hole_gapson_lookaheadoff", display=display.data_window)
plot(noSma, "htf6_sma4_warm_gapson_lookaheadoff", display=display.data_window)
plot(noRma, "htf6_rma4_warm_gapson_lookaheadoff", display=display.data_window)
plot(noTime, "htf6_time_gapson_lookaheadoff", display=display.data_window)
plot(nnClose, "htf6_clean_gapson_lookaheadon", display=display.data_window)
plot(nnHole, "htf6_hole_gapson_lookaheadon", display=display.data_window)
plot(nnSma, "htf6_sma4_warm_gapson_lookaheadon", display=display.data_window)
plot(nnRma, "htf6_rma4_warm_gapson_lookaheadon", display=display.data_window)
plot(nnTime, "htf6_time_gapson_lookaheadon", display=display.data_window)
plot(beforeScratch, "table_count_before_scratch", display=display.data_window)
plot(withScratch, "table_count_with_scratch", display=display.data_window)
plot(afterClear, "table_count_after_clear", display=display.data_window)
plot(afterDelete, "table_count_after_delete", display=display.data_window)
plot(cellClean, "cell_clean_arg", display=display.data_window)
plot(cellHole, "cell_hole_arg", display=display.data_window)
plot(cellWarm, "cell_warm_arg", display=display.data_window)
plot(str.length(cleanText), "cell_clean_text_length", display=display.data_window)
plot(str.length(holeText), "cell_hole_text_length", display=display.data_window)
plot(str.length(warmText), "cell_warm_text_length", display=display.data_window)
plot(cellsReached, "cell_calls_reached", display=display.data_window)
plot(textReached, "cell_text_setters_reached", display=display.data_window)
plot(geometryReached, "cell_geometry_setters_reached", display=display.data_window)
plot(appearanceReached, "cell_appearance_setters_reached", display=display.data_window)
plot(merged ? 1.0 : 0.0, "merge_initialized", display=display.data_window)
