//@version=6
indicator("coverage-collections-2-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean
arrayOp(float x, int which) =>
    a = array.from(x,x+1,x-1)
    float r = na
    if which == 0
        a := array.copy(a)
        r := array.get(a,1)
    else if which == 1
        a := array.concat(a,array.from(7.0,8.0))
        r := array.size(a)*100+array.get(a,3)
    else if which == 2
        a := array.abs(a)
        r := array.get(a,2)
    else if which == 3
        a := array.slice(a,0,2)
        r := array.size(a)*100+array.get(a,1)
    else if which == 4
        array.reverse(a)
        r := array.get(a,0)
    else if which == 5
        array.sort(a,order.ascending)
        r := array.get(a,0)
    else if which == 6
        ai = array.sort_indices(a,order.ascending)
        r := array.get(ai,0)
    else if which == 7
        a := array.standardize(a)
        r := array.size(a)*1000 + (array.size(a) > 1 ? nz(array.get(a,1),-999) : -999)
    else if which == 8
        array.fill(a,9.0,1,3)
        r := array.get(a,2)
    else if which == 9
        array.set(a,1,9.0)
        r := array.get(a,1)
    else if which == 10
        array.push(a,9.0)
        r := array.size(a)*100+array.get(a,3)
    else if which == 11
        r := array.pop(a)
    else if which == 12
        r := array.shift(a)
    else if which == 13
        array.unshift(a,9.0)
        r := array.get(a,0)
    else if which == 14
        array.insert(a,-1,9.0)
        r := array.get(a,2)
    else if which == 15
        r := array.remove(a,1)
    else
        array.clear(a)
        r := array.size(a)
    r

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(arrayOp(clean,0), title="array_copy_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,0), title="array_copy_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,0), title="array_copy_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,1), title="array_concat_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,1), title="array_concat_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,1), title="array_concat_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,2), title="array_abs_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,2), title="array_abs_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,2), title="array_abs_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,3), title="array_slice_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,3), title="array_slice_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,3), title="array_slice_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,4), title="array_reverse_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,4), title="array_reverse_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,4), title="array_reverse_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,5), title="array_sort_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,5), title="array_sort_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,5), title="array_sort_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,6), title="array_sort_indices_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,6), title="array_sort_indices_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,6), title="array_sort_indices_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,7), title="array_standardize_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,7), title="array_standardize_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,7), title="array_standardize_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,8), title="array_fill_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,8), title="array_fill_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,8), title="array_fill_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,9), title="array_set_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,9), title="array_set_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,9), title="array_set_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,10), title="array_push_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,10), title="array_push_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,10), title="array_push_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,11), title="array_pop_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,11), title="array_pop_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,11), title="array_pop_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,12), title="array_shift_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,12), title="array_shift_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,12), title="array_shift_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,13), title="array_unshift_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,13), title="array_unshift_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,13), title="array_unshift_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,14), title="array_insert_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,14), title="array_insert_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,14), title="array_insert_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,15), title="array_remove_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,15), title="array_remove_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,15), title="array_remove_warm0_7", color=color.blue, display=display.data_window)
plot(arrayOp(clean,16), title="array_clear_clean", color=color.blue, display=display.data_window)
plot(arrayOp(holes,16), title="array_clear_hole97", color=color.blue, display=display.data_window)
plot(arrayOp(warm,16), title="array_clear_warm0_7", color=color.blue, display=display.data_window)
plot(array.includes(array.from(clean,clean+1),clean) ? 1 : 0, title="array_includes_control", color=color.blue, display=display.data_window)
plot(array.indexof(array.from(clean,clean+1),clean+1), title="array_indexof_control", color=color.blue, display=display.data_window)
