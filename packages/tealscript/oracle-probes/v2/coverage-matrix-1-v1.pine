//@version=6
indicator("coverage-matrix-1-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean
m = matrix.new<float>(2,2,0.0)
matrix.set(m,0,0,clean+5)
matrix.set(m,0,1,1.0)
matrix.set(m,1,0,1.0)
matrix.set(m,1,1,4.0)

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(false ? na : matrix.det(m), title="matrix_det_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.det(m), title="matrix_det_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.det(m), title="matrix_det_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.trace(m), title="matrix_trace_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.trace(m), title="matrix_trace_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.trace(m), title="matrix_trace_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.rank(m), title="matrix_rank_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.rank(m), title="matrix_rank_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.rank(m), title="matrix_rank_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.inv(m),0,0), title="matrix_inv00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.inv(m),0,0), title="matrix_inv00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.inv(m),0,0), title="matrix_inv00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.pinv(m),0,0), title="matrix_pinv00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.pinv(m),0,0), title="matrix_pinv00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.pinv(m),0,0), title="matrix_pinv00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.pow(m,2),0,0), title="matrix_pow2_00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.pow(m,2),0,0), title="matrix_pow2_00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.pow(m,2),0,0), title="matrix_pow2_00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.sum(m,m),0,0), title="matrix_sum00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.sum(m,m),0,0), title="matrix_sum00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.sum(m,m),0,0), title="matrix_sum00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.diff(m,m),0,0), title="matrix_diff00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.diff(m,m),0,0), title="matrix_diff00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.diff(m,m),0,0), title="matrix_diff00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.mult(m,m),0,0), title="matrix_mult00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.mult(m,m),0,0), title="matrix_mult00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.mult(m,m),0,0), title="matrix_mult00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.kron(m,m),0,0), title="matrix_kron00_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.kron(m,m),0,0), title="matrix_kron00_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.kron(m,m),0,0), title="matrix_kron00_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.get(matrix.transpose(m),0,1), title="matrix_transpose01_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.get(matrix.transpose(m),0,1), title="matrix_transpose01_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.get(matrix.transpose(m),0,1), title="matrix_transpose01_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : array.get(matrix.row(m,1),0), title="matrix_row1first_clean", color=color.blue, display=display.data_window)
plot(hole ? na : array.get(matrix.row(m,1),0), title="matrix_row1first_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : array.get(matrix.row(m,1),0), title="matrix_row1first_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : array.get(matrix.col(m,1),0), title="matrix_col1first_clean", color=color.blue, display=display.data_window)
plot(hole ? na : array.get(matrix.col(m,1),0), title="matrix_col1first_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : array.get(matrix.col(m,1),0), title="matrix_col1first_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.avg(m), title="matrix_avg_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.avg(m), title="matrix_avg_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.avg(m), title="matrix_avg_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.median(m), title="matrix_median_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.median(m), title="matrix_median_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.median(m), title="matrix_median_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.min(m), title="matrix_min_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.min(m), title="matrix_min_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.min(m), title="matrix_min_warm0_7", color=color.blue, display=display.data_window)
plot(false ? na : matrix.max(m), title="matrix_max_clean", color=color.blue, display=display.data_window)
plot(hole ? na : matrix.max(m), title="matrix_max_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : matrix.max(m), title="matrix_max_warm0_7", color=color.blue, display=display.data_window)
plot(matrix.rows(m), title="matrix_rows", color=color.blue, display=display.data_window)
plot(matrix.columns(m), title="matrix_columns", color=color.blue, display=display.data_window)
