//@version=6
indicator("coverage-collections-1-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean
arrClean = array.from(clean[2], clean[1], clean)
arrHole = array.from(holes[2], holes[1], holes)
arrWarm = array.from(warm[2], warm[1], warm)
matOf(float x) =>
    m = matrix.new<float>(2,2,0.0)
    matrix.set(m,0,0,x)
    matrix.set(m,0,1,x+1)
    matrix.set(m,1,0,x-1)
    matrix.set(m,1,1,x)
    m
mc = matOf(clean)
mh = matOf(holes)
mw = matOf(warm)
var m = map.new<int,float>()
if not na(holes)
    map.put(m, b % 3, holes)

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(array.avg(arrClean), title="array_avg_clean", color=color.blue, display=display.data_window)
plot(array.avg(arrHole), title="array_avg_hole97", color=color.blue, display=display.data_window)
plot(array.avg(arrWarm), title="array_avg_warm0_7", color=color.blue, display=display.data_window)
plot(array.sum(arrClean), title="array_sum_clean", color=color.blue, display=display.data_window)
plot(array.sum(arrHole), title="array_sum_hole97", color=color.blue, display=display.data_window)
plot(array.sum(arrWarm), title="array_sum_warm0_7", color=color.blue, display=display.data_window)
plot(array.min(arrClean), title="array_min_clean", color=color.blue, display=display.data_window)
plot(array.min(arrHole), title="array_min_hole97", color=color.blue, display=display.data_window)
plot(array.min(arrWarm), title="array_min_warm0_7", color=color.blue, display=display.data_window)
plot(array.max(arrClean), title="array_max_clean", color=color.blue, display=display.data_window)
plot(array.max(arrHole), title="array_max_hole97", color=color.blue, display=display.data_window)
plot(array.max(arrWarm), title="array_max_warm0_7", color=color.blue, display=display.data_window)
plot(array.median(arrClean), title="array_median_clean", color=color.blue, display=display.data_window)
plot(array.median(arrHole), title="array_median_hole97", color=color.blue, display=display.data_window)
plot(array.median(arrWarm), title="array_median_warm0_7", color=color.blue, display=display.data_window)
plot(array.mode(arrClean), title="array_mode_clean", color=color.blue, display=display.data_window)
plot(array.mode(arrHole), title="array_mode_hole97", color=color.blue, display=display.data_window)
plot(array.mode(arrWarm), title="array_mode_warm0_7", color=color.blue, display=display.data_window)
plot(array.variance(arrClean), title="array_variance_clean", color=color.blue, display=display.data_window)
plot(array.variance(arrHole), title="array_variance_hole97", color=color.blue, display=display.data_window)
plot(array.variance(arrWarm), title="array_variance_warm0_7", color=color.blue, display=display.data_window)
plot(array.stdev(arrClean), title="array_stdev_clean", color=color.blue, display=display.data_window)
plot(array.stdev(arrHole), title="array_stdev_hole97", color=color.blue, display=display.data_window)
plot(array.stdev(arrWarm), title="array_stdev_warm0_7", color=color.blue, display=display.data_window)
plot(array.range(arrClean), title="array_range_clean", color=color.blue, display=display.data_window)
plot(array.range(arrHole), title="array_range_hole97", color=color.blue, display=display.data_window)
plot(array.range(arrWarm), title="array_range_warm0_7", color=color.blue, display=display.data_window)
plot(array.percentile_linear_interpolation(arrClean,50), title="array_percentile_linear_interpolation_clean", color=color.blue, display=display.data_window)
plot(array.percentile_linear_interpolation(arrHole,50), title="array_percentile_linear_interpolation_hole97", color=color.blue, display=display.data_window)
plot(array.percentile_linear_interpolation(arrWarm,50), title="array_percentile_linear_interpolation_warm0_7", color=color.blue, display=display.data_window)
plot(array.percentile_nearest_rank(arrClean,50), title="array_percentile_nearest_rank_clean", color=color.blue, display=display.data_window)
plot(array.percentile_nearest_rank(arrHole,50), title="array_percentile_nearest_rank_hole97", color=color.blue, display=display.data_window)
plot(array.percentile_nearest_rank(arrWarm,50), title="array_percentile_nearest_rank_warm0_7", color=color.blue, display=display.data_window)
plot(matrix.avg(mc), title="matrix_avg_clean", color=color.blue, display=display.data_window)
plot(matrix.avg(mh), title="matrix_avg_hole97", color=color.blue, display=display.data_window)
plot(matrix.avg(mw), title="matrix_avg_warm0_7", color=color.blue, display=display.data_window)
plot(matrix.median(mc), title="matrix_median_clean", color=color.blue, display=display.data_window)
plot(matrix.median(mh), title="matrix_median_hole97", color=color.blue, display=display.data_window)
plot(matrix.median(mw), title="matrix_median_warm0_7", color=color.blue, display=display.data_window)
plot(matrix.mode(mc), title="matrix_mode_clean", color=color.blue, display=display.data_window)
plot(matrix.mode(mh), title="matrix_mode_hole97", color=color.blue, display=display.data_window)
plot(matrix.mode(mw), title="matrix_mode_warm0_7", color=color.blue, display=display.data_window)
plot(matrix.min(mc), title="matrix_min_clean", color=color.blue, display=display.data_window)
plot(matrix.min(mh), title="matrix_min_hole97", color=color.blue, display=display.data_window)
plot(matrix.min(mw), title="matrix_min_warm0_7", color=color.blue, display=display.data_window)
plot(matrix.max(mc), title="matrix_max_clean", color=color.blue, display=display.data_window)
plot(matrix.max(mh), title="matrix_max_hole97", color=color.blue, display=display.data_window)
plot(matrix.max(mw), title="matrix_max_warm0_7", color=color.blue, display=display.data_window)
plot(map.size(m), title="map_size", color=color.blue, display=display.data_window)
plot(map.contains(m,b%3) ? 1 : 0, title="map_contains_current", color=color.blue, display=display.data_window)
plot(map.get(m,b%3), title="map_get_current", color=color.blue, display=display.data_window)
plot(array.size(arrClean), title="array_size_clean", color=color.blue, display=display.data_window)
plot(array.get(arrHole,2), title="array_get_current_hole", color=color.blue, display=display.data_window)
