//@version=6
indicator("coverage-time-2-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("1S"), title="in_seconds_1s", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("5S"), title="in_seconds_5s", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("15S"), title="in_seconds_15s", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("30S"), title="in_seconds_30s", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("1"), title="in_seconds_1", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("2"), title="in_seconds_2", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("6"), title="in_seconds_6", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("30"), title="in_seconds_30", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("1D"), title="in_seconds_1d", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("1W"), title="in_seconds_1w", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("1M"), title="in_seconds_1m", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds("12M"), title="in_seconds_12m", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(1)), title="from_seconds_roundtrip_1", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(59)), title="from_seconds_roundtrip_59", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(60)), title="from_seconds_roundtrip_60", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(61)), title="from_seconds_roundtrip_61", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(120)), title="from_seconds_roundtrip_120", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(3599)), title="from_seconds_roundtrip_3599", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(3600)), title="from_seconds_roundtrip_3600", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(86400)), title="from_seconds_roundtrip_86400", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(604800)), title="from_seconds_roundtrip_604800", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(2592000)), title="from_seconds_roundtrip_2592000", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(2628003)), title="from_seconds_roundtrip_2628003", color=color.blue, display=display.data_window)
plot(timeframe.in_seconds(timeframe.from_seconds(31536036)), title="from_seconds_roundtrip_31536036", color=color.blue, display=display.data_window)
plot(timeframe.change("2") ? 1 : 0, title="change_2", color=color.blue, display=display.data_window)
plot(timeframe.change("6") ? 1 : 0, title="change_6", color=color.blue, display=display.data_window)
plot(timeframe.change("30") ? 1 : 0, title="change_30", color=color.blue, display=display.data_window)
plot(timeframe.change("1D") ? 1 : 0, title="change_1d", color=color.blue, display=display.data_window)
plot(timeframe.change("1W") ? 1 : 0, title="change_1w", color=color.blue, display=display.data_window)
plot(timeframe.change("1M") ? 1 : 0, title="change_1m", color=color.blue, display=display.data_window)
plot(timestamp("UTC",2024,2,29,12,30,15), title="timestamp_utc_leapday", color=color.blue, display=display.data_window)
plot(timestamp("America/New_York",2026,3,8,1,30,0), title="timestamp_ny_spring_before", color=color.blue, display=display.data_window)
plot(timestamp("America/New_York",2026,3,8,3,30,0), title="timestamp_ny_spring_after", color=color.blue, display=display.data_window)
plot(timestamp("America/New_York",2026,11,1,1,30,0), title="timestamp_ny_fall_fold", color=color.blue, display=display.data_window)
plot(timestamp("2026-01-01T00:00:00Z"), title="timestamp_iso_string", color=color.blue, display=display.data_window)
plot(timestamp("UTC",year,month,dayofmonth,0,0,0), title="timestamp_current_calendar_midnight", color=color.blue, display=display.data_window)
plot(barstate.isfirst ? 1 : 0, title="barstate_isfirst", color=color.blue, display=display.data_window)
plot(barstate.islast ? 1 : 0, title="barstate_islast", color=color.blue, display=display.data_window)
plot(barstate.ishistory ? 1 : 0, title="barstate_ishistory", color=color.blue, display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, title="barstate_isrealtime", color=color.blue, display=display.data_window)
plot(barstate.isnew ? 1 : 0, title="barstate_isnew", color=color.blue, display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, title="barstate_isconfirmed", color=color.blue, display=display.data_window)
plot(barstate.islastconfirmedhistory ? 1 : 0, title="barstate_islastconfirmedhistory", color=color.blue, display=display.data_window)
plot(session.ismarket ? 1 : 0, title="session_ismarket", color=color.blue, display=display.data_window)
plot(session.ispremarket ? 1 : 0, title="session_ispremarket", color=color.blue, display=display.data_window)
plot(session.ispostmarket ? 1 : 0, title="session_ispostmarket", color=color.blue, display=display.data_window)
plot(syminfo.mintick, title="syminfo_mintick", color=color.blue, display=display.data_window)
plot(syminfo.pricescale, title="syminfo_pricescale", color=color.blue, display=display.data_window)
plot(syminfo.mincontract, title="syminfo_mincontract", color=color.blue, display=display.data_window)
plot(syminfo.pointvalue, title="syminfo_pointvalue", color=color.blue, display=display.data_window)
plot(timeframe.multiplier, title="timeframe_multiplier", color=color.blue, display=display.data_window)
plot(timeframe.isminutes ? 1 : 0, title="timeframe_isminutes", color=color.blue, display=display.data_window)
plot(timeframe.isintraday ? 1 : 0, title="timeframe_isintraday", color=color.blue, display=display.data_window)
