//@version=6
indicator("Drawing coverage 2 v1 — BTCUSDT 2m", overlay=true, precision=10, max_lines_count=7, max_labels_count=7, max_boxes_count=7)
b = bar_index
hole = b % 97 >= 40 and b % 97 <= 42
clean = close
holes = hole ? na : close
warmup = b < 5 ? na : close
plot(b, "b", display=display.data_window)
plot(time, "time", display=display.data_window)
plot(open, "open", display=display.data_window)
plot(high, "high", display=display.data_window)
plot(low, "low", display=display.data_window)
plot(close, "close", display=display.data_window)
plot(volume, "volume", display=display.data_window)
plot(hole ? 1 : 0, "hole", display=display.data_window)
l_clean = line.new(b, clean, b + 1, clean + 2)
q_clean = box.new(b, clean + 3, b + 1, clean - 3)
t_clean = label.new(b, clean)
l_holes = line.new(b, holes, b + 1, holes + 2)
q_holes = box.new(b, holes + 3, b + 1, holes - 3)
t_holes = label.new(b, holes)
l_warmup = line.new(b, warmup, b + 1, warmup + 2)
q_warmup = box.new(b, warmup + 3, b + 1, warmup - 3)
t_warmup = label.new(b, warmup)
plot(array.size(line.all), "line_count", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_x1(array.get(line.all, 0)) : na, "line_0_get_x1", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_x2(array.get(line.all, 0)) : na, "line_0_get_x2", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_y1(array.get(line.all, 0)) : na, "line_0_get_y1", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_y2(array.get(line.all, 0)) : na, "line_0_get_y2", display=display.data_window)
plot(array.size(line.all) > 1 ? line.get_x1(array.get(line.all, 1)) : na, "line_1_get_x1", display=display.data_window)
plot(array.size(line.all) > 1 ? line.get_x2(array.get(line.all, 1)) : na, "line_1_get_x2", display=display.data_window)
plot(array.size(line.all) > 1 ? line.get_y1(array.get(line.all, 1)) : na, "line_1_get_y1", display=display.data_window)
plot(array.size(line.all) > 1 ? line.get_y2(array.get(line.all, 1)) : na, "line_1_get_y2", display=display.data_window)
plot(array.size(line.all) > 3 ? line.get_x1(array.get(line.all, 3)) : na, "line_3_get_x1", display=display.data_window)
plot(array.size(line.all) > 3 ? line.get_x2(array.get(line.all, 3)) : na, "line_3_get_x2", display=display.data_window)
plot(array.size(line.all) > 3 ? line.get_y1(array.get(line.all, 3)) : na, "line_3_get_y1", display=display.data_window)
plot(array.size(line.all) > 3 ? line.get_y2(array.get(line.all, 3)) : na, "line_3_get_y2", display=display.data_window)
plot(array.size(line.all) > 6 ? line.get_x1(array.get(line.all, 6)) : na, "line_6_get_x1", display=display.data_window)
plot(array.size(line.all) > 6 ? line.get_x2(array.get(line.all, 6)) : na, "line_6_get_x2", display=display.data_window)
plot(array.size(line.all) > 6 ? line.get_y1(array.get(line.all, 6)) : na, "line_6_get_y1", display=display.data_window)
plot(array.size(line.all) > 6 ? line.get_y2(array.get(line.all, 6)) : na, "line_6_get_y2", display=display.data_window)
plot(array.size(box.all), "box_count", display=display.data_window)
plot(array.size(box.all) > 0 ? box.get_left(array.get(box.all, 0)) : na, "box_0_get_left", display=display.data_window)
plot(array.size(box.all) > 0 ? box.get_right(array.get(box.all, 0)) : na, "box_0_get_right", display=display.data_window)
plot(array.size(box.all) > 0 ? box.get_top(array.get(box.all, 0)) : na, "box_0_get_top", display=display.data_window)
plot(array.size(box.all) > 0 ? box.get_bottom(array.get(box.all, 0)) : na, "box_0_get_bottom", display=display.data_window)
plot(array.size(box.all) > 1 ? box.get_left(array.get(box.all, 1)) : na, "box_1_get_left", display=display.data_window)
plot(array.size(box.all) > 1 ? box.get_right(array.get(box.all, 1)) : na, "box_1_get_right", display=display.data_window)
plot(array.size(box.all) > 1 ? box.get_top(array.get(box.all, 1)) : na, "box_1_get_top", display=display.data_window)
plot(array.size(box.all) > 1 ? box.get_bottom(array.get(box.all, 1)) : na, "box_1_get_bottom", display=display.data_window)
plot(array.size(box.all) > 3 ? box.get_left(array.get(box.all, 3)) : na, "box_3_get_left", display=display.data_window)
plot(array.size(box.all) > 3 ? box.get_right(array.get(box.all, 3)) : na, "box_3_get_right", display=display.data_window)
plot(array.size(box.all) > 3 ? box.get_top(array.get(box.all, 3)) : na, "box_3_get_top", display=display.data_window)
plot(array.size(box.all) > 3 ? box.get_bottom(array.get(box.all, 3)) : na, "box_3_get_bottom", display=display.data_window)
plot(array.size(box.all) > 6 ? box.get_left(array.get(box.all, 6)) : na, "box_6_get_left", display=display.data_window)
plot(array.size(box.all) > 6 ? box.get_right(array.get(box.all, 6)) : na, "box_6_get_right", display=display.data_window)
plot(array.size(box.all) > 6 ? box.get_top(array.get(box.all, 6)) : na, "box_6_get_top", display=display.data_window)
plot(array.size(box.all) > 6 ? box.get_bottom(array.get(box.all, 6)) : na, "box_6_get_bottom", display=display.data_window)
plot(array.size(label.all), "label_count", display=display.data_window)
plot(array.size(label.all) > 0 ? label.get_x(array.get(label.all, 0)) : na, "label_0_get_x", display=display.data_window)
plot(array.size(label.all) > 0 ? label.get_y(array.get(label.all, 0)) : na, "label_0_get_y", display=display.data_window)
plot(array.size(label.all) > 1 ? label.get_x(array.get(label.all, 1)) : na, "label_1_get_x", display=display.data_window)
plot(array.size(label.all) > 1 ? label.get_y(array.get(label.all, 1)) : na, "label_1_get_y", display=display.data_window)
plot(array.size(label.all) > 3 ? label.get_x(array.get(label.all, 3)) : na, "label_3_get_x", display=display.data_window)
plot(array.size(label.all) > 3 ? label.get_y(array.get(label.all, 3)) : na, "label_3_get_y", display=display.data_window)
plot(array.size(label.all) > 6 ? label.get_x(array.get(label.all, 6)) : na, "label_6_get_x", display=display.data_window)
plot(array.size(label.all) > 6 ? label.get_y(array.get(label.all, 6)) : na, "label_6_get_y", display=display.data_window)
a = line.new(b, close, b + 1, close + 1)
z = line.new(b, close + 2, b + 1, close + 3)
f = linefill.new(a, z, color.blue)
u = line.new(b, close + 10, b + 1, close + 11)
v = line.new(b, close + 20, b + 1, close + 21)
other = linefill.new(u, v, color.red)
plot(array.size(linefill.all), "fill_before_delete", display=display.data_window)
line.delete(a)
plot(array.size(linefill.all), "fill_after_parent_delete", display=display.data_window)
plot(array.size(line.all), "lines_after_parent_delete", display=display.data_window)
plot(array.size(linefill.all) > 0 ? array.get(linefill.all, array.size(linefill.all) - 1) == other ? 1 : 0 : na, "survivor_is_other", display=display.data_window)
plot(line.get_y1(linefill.get_line1(other)), "survivor_parent1_y", display=display.data_window)
plot(line.get_y1(linefill.get_line2(other)), "survivor_parent2_y", display=display.data_window)
plot(line.get_y1(z), "deleted_fill_surviving_parent_y", display=display.data_window)
linefill.delete(f)
plot(array.size(linefill.all), "fill_after_explicit_delete", display=display.data_window)
line.delete(z)
linefill.delete(other)
line.delete(u)
line.delete(v)
plot(array.size(linefill.all), "fill_after_cleanup", display=display.data_window)
