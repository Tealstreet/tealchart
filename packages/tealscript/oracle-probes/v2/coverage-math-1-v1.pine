//@version=6
indicator("coverage-math-1-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(math.abs(clean), title="abs_clean", color=color.blue, display=display.data_window)
plot(math.abs(holes), title="abs_hole97", color=color.blue, display=display.data_window)
plot(math.abs(warm), title="abs_warm0_7", color=color.blue, display=display.data_window)
plot(math.sign(clean), title="sign_clean", color=color.blue, display=display.data_window)
plot(math.sign(holes), title="sign_hole97", color=color.blue, display=display.data_window)
plot(math.sign(warm), title="sign_warm0_7", color=color.blue, display=display.data_window)
plot(math.ceil(clean), title="ceil_clean", color=color.blue, display=display.data_window)
plot(math.ceil(holes), title="ceil_hole97", color=color.blue, display=display.data_window)
plot(math.ceil(warm), title="ceil_warm0_7", color=color.blue, display=display.data_window)
plot(math.floor(clean), title="floor_clean", color=color.blue, display=display.data_window)
plot(math.floor(holes), title="floor_hole97", color=color.blue, display=display.data_window)
plot(math.floor(warm), title="floor_warm0_7", color=color.blue, display=display.data_window)
plot(math.round(clean), title="round_clean", color=color.blue, display=display.data_window)
plot(math.round(holes), title="round_hole97", color=color.blue, display=display.data_window)
plot(math.round(warm), title="round_warm0_7", color=color.blue, display=display.data_window)
plot(math.round_to_mintick(100 + clean / 100), title="round_to_mintick_clean", color=color.blue, display=display.data_window)
plot(math.round_to_mintick(100 + holes / 100), title="round_to_mintick_hole97", color=color.blue, display=display.data_window)
plot(math.round_to_mintick(100 + warm / 100), title="round_to_mintick_warm0_7", color=color.blue, display=display.data_window)
plot(math.sqrt(math.abs(clean) + 1), title="sqrt_clean", color=color.blue, display=display.data_window)
plot(math.sqrt(math.abs(holes) + 1), title="sqrt_hole97", color=color.blue, display=display.data_window)
plot(math.sqrt(math.abs(warm) + 1), title="sqrt_warm0_7", color=color.blue, display=display.data_window)
plot(math.pow(math.abs(clean) + 1, 0.5), title="pow_clean", color=color.blue, display=display.data_window)
plot(math.pow(math.abs(holes) + 1, 0.5), title="pow_hole97", color=color.blue, display=display.data_window)
plot(math.pow(math.abs(warm) + 1, 0.5), title="pow_warm0_7", color=color.blue, display=display.data_window)
plot(math.log(math.abs(clean) + 1), title="log_clean", color=color.blue, display=display.data_window)
plot(math.log(math.abs(holes) + 1), title="log_hole97", color=color.blue, display=display.data_window)
plot(math.log(math.abs(warm) + 1), title="log_warm0_7", color=color.blue, display=display.data_window)
plot(math.log10(math.abs(clean) + 1), title="log10_clean", color=color.blue, display=display.data_window)
plot(math.log10(math.abs(holes) + 1), title="log10_hole97", color=color.blue, display=display.data_window)
plot(math.log10(math.abs(warm) + 1), title="log10_warm0_7", color=color.blue, display=display.data_window)
plot(math.exp(clean / 4), title="exp_clean", color=color.blue, display=display.data_window)
plot(math.exp(holes / 4), title="exp_hole97", color=color.blue, display=display.data_window)
plot(math.exp(warm / 4), title="exp_warm0_7", color=color.blue, display=display.data_window)
plot(math.sin(clean), title="sin_clean", color=color.blue, display=display.data_window)
plot(math.sin(holes), title="sin_hole97", color=color.blue, display=display.data_window)
plot(math.sin(warm), title="sin_warm0_7", color=color.blue, display=display.data_window)
plot(math.cos(clean), title="cos_clean", color=color.blue, display=display.data_window)
plot(math.cos(holes), title="cos_hole97", color=color.blue, display=display.data_window)
plot(math.cos(warm), title="cos_warm0_7", color=color.blue, display=display.data_window)
plot(math.tan(clean), title="tan_clean", color=color.blue, display=display.data_window)
plot(math.tan(holes), title="tan_hole97", color=color.blue, display=display.data_window)
plot(math.tan(warm), title="tan_warm0_7", color=color.blue, display=display.data_window)
plot(math.asin(clean / 3), title="asin_clean", color=color.blue, display=display.data_window)
plot(math.asin(holes / 3), title="asin_hole97", color=color.blue, display=display.data_window)
plot(math.asin(warm / 3), title="asin_warm0_7", color=color.blue, display=display.data_window)
plot(math.acos(clean / 3), title="acos_clean", color=color.blue, display=display.data_window)
plot(math.acos(holes / 3), title="acos_hole97", color=color.blue, display=display.data_window)
plot(math.acos(warm / 3), title="acos_warm0_7", color=color.blue, display=display.data_window)
plot(math.atan(clean), title="atan_clean", color=color.blue, display=display.data_window)
plot(math.atan(holes), title="atan_hole97", color=color.blue, display=display.data_window)
plot(math.atan(warm), title="atan_warm0_7", color=color.blue, display=display.data_window)
plot(math.sqrt(math.abs(clean)+1)-math.pow(math.abs(clean)+1,0.5), title="sqrt_pow_control_delta", color=color.blue, display=display.data_window)
plot(math.round(clean)-math.floor(clean+0.5), title="round_floor_control_delta", color=color.blue, display=display.data_window)
