//@version=6
indicator("TealScript MFI flat-flow oracle v2", overlay=false, precision=16, max_bars_back=500)
// Export all loaded bars beginning at input_bar_index 0 on standard 2-minute candles.
// This probe exposes both sums: MFI alone determines their ratio, not their scale.
// No captured values are embedded; keep CSVs and replay results in the external archive.
oneHole = bar_index == 40 ? na : close

f_exact2(src) =>
    var float older = na
    var float newest = na
    var int count = 0
    if not na(src)
        older := newest
        newest := src
        count += 1
    count >= 2 ? older + newest : na

f_rolling2(src, mode) =>
    var float older = na
    var float newest = na
    var float total = 0.0
    var int count = 0
    if not na(src)
        removed = count >= 2 ? older : 0.0
        if mode == 0
            total := (total - removed) + src
        else if mode == 1
            total := (total + src) - removed
        else
            total += src - removed
        older := newest
        newest := src
        count += 1
    count >= 2 ? total : na

cleanChange = ta.change(close)
cleanUp = volume * (cleanChange <= 0.0 ? 0.0 : close)
cleanDown = volume * (cleanChange >= 0.0 ? 0.0 : close)
cleanUpSum = math.sum(cleanUp, 2)
cleanDownSum = math.sum(cleanDown, 2)
cleanExactUp = f_exact2(cleanUp)
cleanExactDown = f_exact2(cleanDown)

hole40Change = ta.change(oneHole)
hole40Up = volume * (hole40Change <= 0.0 ? 0.0 : oneHole)
hole40Down = volume * (hole40Change >= 0.0 ? 0.0 : oneHole)
hole40UpSum = math.sum(hole40Up, 2)
hole40DownSum = math.sum(hole40Down, 2)
hole40ExactUp = f_exact2(hole40Up)
hole40ExactDown = f_exact2(hole40Down)

hlc3Up = volume * (ta.change(hlc3) <= 0.0 ? 0.0 : hlc3)
hlc3Down = volume * (ta.change(hlc3) >= 0.0 ? 0.0 : hlc3)
hlc3UpSum = math.sum(hlc3Up, 2)
hlc3DownSum = math.sum(hlc3Down, 2)

previous_volumeUp = volume[1] * (cleanChange <= 0.0 ? 0.0 : close)
previous_volumeDown = volume[1] * (cleanChange >= 0.0 ? 0.0 : close)
previous_volumeUpSum = math.sum(previous_volumeUp, 2)
previous_volumeDownSum = math.sum(previous_volumeDown, 2)

previous_priceUp = volume * (cleanChange <= 0.0 ? 0.0 : close[1])
previous_priceDown = volume * (cleanChange >= 0.0 ? 0.0 : close[1])
previous_priceUpSum = math.sum(previous_priceUp, 2)
previous_priceDownSum = math.sum(previous_priceDown, 2)

// Sixty stable titles include every required replay input and each intermediate.
plot(open, "input_open", display=display.data_window, editable=false)
plot(high, "input_high", display=display.data_window, editable=false)
plot(low, "input_low", display=display.data_window, editable=false)
plot(close, "input_close", display=display.data_window, editable=false)
plot(volume, "input_volume", display=display.data_window, editable=false)
plot(time, "input_time", display=display.data_window, editable=false)
plot(bar_index, "input_bar_index", display=display.data_window, editable=false)
plot(oneHole, "input_one_hole", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(close) <= 0.0 ? 0.0 : close), 2) / math.sum(volume * (ta.change(close) >= 0.0 ? 0.0 : close), 2)), "clean_mfi_inline_reference", display=display.data_window, editable=false)
plot(cleanChange, "clean_change", display=display.data_window, editable=false)
plot(cleanUp, "clean_up_flow", display=display.data_window, editable=false)
plot(cleanDown, "clean_down_flow", display=display.data_window, editable=false)
plot(cleanUpSum, "clean_up_sum2", display=display.data_window, editable=false)
plot(cleanDownSum, "clean_down_sum2", display=display.data_window, editable=false)
plot(cleanUpSum[1], "clean_up_sum2_previous", display=display.data_window, editable=false)
plot(cleanDownSum[1], "clean_down_sum2_previous", display=display.data_window, editable=false)
plot(cleanExactUp, "clean_up_exact2", display=display.data_window, editable=false)
plot(cleanExactDown, "clean_down_exact2", display=display.data_window, editable=false)
plot(ta.mfi(close, 2), "clean_mfi_builtin", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + cleanUpSum / cleanDownSum), "clean_mfi_reference", display=display.data_window, editable=false)
plot(cleanUpSum / cleanDownSum, "clean_ratio", display=display.data_window, editable=false)
plot(cleanChange == 0.0 and cleanChange[1] == 0.0 ? 1 : 0, "clean_flat_window", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(oneHole) <= 0.0 ? 0.0 : oneHole), 2) / math.sum(volume * (ta.change(oneHole) >= 0.0 ? 0.0 : oneHole), 2)), "hole40_mfi_inline_reference", display=display.data_window, editable=false)
plot(hole40Change, "hole40_change", display=display.data_window, editable=false)
plot(hole40Up, "hole40_up_flow", display=display.data_window, editable=false)
plot(hole40Down, "hole40_down_flow", display=display.data_window, editable=false)
plot(hole40UpSum, "hole40_up_sum2", display=display.data_window, editable=false)
plot(hole40DownSum, "hole40_down_sum2", display=display.data_window, editable=false)
plot(hole40UpSum[1], "hole40_up_sum2_previous", display=display.data_window, editable=false)
plot(hole40DownSum[1], "hole40_down_sum2_previous", display=display.data_window, editable=false)
plot(hole40ExactUp, "hole40_up_exact2", display=display.data_window, editable=false)
plot(hole40ExactDown, "hole40_down_exact2", display=display.data_window, editable=false)
plot(ta.mfi(oneHole, 2), "hole40_mfi_builtin", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + hole40UpSum / hole40DownSum), "hole40_mfi_reference", display=display.data_window, editable=false)
plot(hole40UpSum / hole40DownSum, "hole40_ratio", display=display.data_window, editable=false)
plot(hole40Change == 0.0 and hole40Change[1] == 0.0 ? 1 : 0, "hole40_flat_window", display=display.data_window, editable=false)
plot(hlc3Up, "hlc3_up_flow", display=display.data_window, editable=false)
plot(hlc3Down, "hlc3_down_flow", display=display.data_window, editable=false)
plot(hlc3UpSum, "hlc3_up_sum2", display=display.data_window, editable=false)
plot(hlc3DownSum, "hlc3_down_sum2", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + hlc3UpSum / hlc3DownSum), "hlc3_mfi_reference", display=display.data_window, editable=false)
plot(hlc3UpSum / hlc3DownSum, "hlc3_ratio", display=display.data_window, editable=false)
plot(previous_volumeUp, "previous_volume_up_flow", display=display.data_window, editable=false)
plot(previous_volumeDown, "previous_volume_down_flow", display=display.data_window, editable=false)
plot(previous_volumeUpSum, "previous_volume_up_sum2", display=display.data_window, editable=false)
plot(previous_volumeDownSum, "previous_volume_down_sum2", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + previous_volumeUpSum / previous_volumeDownSum), "previous_volume_mfi_reference", display=display.data_window, editable=false)
plot(previous_volumeUpSum / previous_volumeDownSum, "previous_volume_ratio", display=display.data_window, editable=false)
plot(previous_priceUp, "previous_price_up_flow", display=display.data_window, editable=false)
plot(previous_priceDown, "previous_price_down_flow", display=display.data_window, editable=false)
plot(previous_priceUpSum, "previous_price_up_sum2", display=display.data_window, editable=false)
plot(previous_priceDownSum, "previous_price_down_sum2", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + previous_priceUpSum / previous_priceDownSum), "previous_price_mfi_reference", display=display.data_window, editable=false)
plot(previous_priceUpSum / previous_priceDownSum, "previous_price_ratio", display=display.data_window, editable=false)
plot(f_rolling2(cleanUp, 0), "rolling_subtract_add_up", display=display.data_window, editable=false)
plot(f_rolling2(cleanDown, 0), "rolling_subtract_add_down", display=display.data_window, editable=false)
plot(f_rolling2(cleanUp, 1), "rolling_add_subtract_up", display=display.data_window, editable=false)
plot(f_rolling2(cleanDown, 1), "rolling_add_subtract_down", display=display.data_window, editable=false)
plot(f_rolling2(cleanUp, 2), "rolling_difference_up", display=display.data_window, editable=false)
plot(f_rolling2(cleanDown, 2), "rolling_difference_down", display=display.data_window, editable=false)
