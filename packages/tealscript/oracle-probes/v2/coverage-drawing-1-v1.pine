//@version=6
indicator("Drawing coverage 1 v1 — BTCUSDT 2m", overlay=true, precision=10, max_lines_count=7, max_labels_count=7, max_boxes_count=7)
b = bar_index
hole = b % 97 >= 40 and b % 97 <= 42
clean = close
holes = hole ? na : close
warmup = b < 5 ? na : close
plot(b, "b", display=display.data_window)
plot(time, "time", display=display.data_window)
plot(open, "open", display=display.data_window)
plot(high, "high", display=display.data_window)
plot(low, "low", display=display.data_window)
plot(close, "close", display=display.data_window)
plot(volume, "volume", display=display.data_window)
plot(hole ? 1 : 0, "hole", display=display.data_window)
l_clean_index = line.new(b, clean, b + 1, clean + 2, xloc=xloc.bar_index)
q_clean_index = box.new(b, clean + 3, b + 1, clean - 3, xloc=xloc.bar_index)
t_clean_index = label.new(b, clean, xloc=xloc.bar_index, yloc=yloc.price)
plot(line.get_x1(l_clean_index), "clean_index_get_x1", display=display.data_window)
plot(line.get_x2(l_clean_index), "clean_index_get_x2", display=display.data_window)
plot(line.get_y1(l_clean_index), "clean_index_get_y1", display=display.data_window)
plot(line.get_y2(l_clean_index), "clean_index_get_y2", display=display.data_window)
plot(box.get_left(q_clean_index), "clean_index_get_left", display=display.data_window)
plot(box.get_right(q_clean_index), "clean_index_get_right", display=display.data_window)
plot(box.get_top(q_clean_index), "clean_index_get_top", display=display.data_window)
plot(box.get_bottom(q_clean_index), "clean_index_get_bottom", display=display.data_window)
plot(label.get_x(t_clean_index), "clean_index_get_x", display=display.data_window)
plot(label.get_y(t_clean_index), "clean_index_get_y", display=display.data_window)
plot(line.get_price(l_clean_index, b + 2), "clean_index_price_forward", display=display.data_window)
line.delete(l_clean_index)
box.delete(q_clean_index)
label.delete(t_clean_index)
l_clean_time = line.new(time, clean, time + 120000, clean + 2, xloc=xloc.bar_time)
q_clean_time = box.new(time, clean + 3, time + 120000, clean - 3, xloc=xloc.bar_time)
t_clean_time = label.new(time, clean, xloc=xloc.bar_time, yloc=yloc.price)
plot(line.get_x1(l_clean_time), "clean_time_get_x1", display=display.data_window)
plot(line.get_x2(l_clean_time), "clean_time_get_x2", display=display.data_window)
plot(line.get_y1(l_clean_time), "clean_time_get_y1", display=display.data_window)
plot(line.get_y2(l_clean_time), "clean_time_get_y2", display=display.data_window)
plot(box.get_left(q_clean_time), "clean_time_get_left", display=display.data_window)
plot(box.get_right(q_clean_time), "clean_time_get_right", display=display.data_window)
plot(box.get_top(q_clean_time), "clean_time_get_top", display=display.data_window)
plot(box.get_bottom(q_clean_time), "clean_time_get_bottom", display=display.data_window)
plot(label.get_x(t_clean_time), "clean_time_get_x", display=display.data_window)
plot(label.get_y(t_clean_time), "clean_time_get_y", display=display.data_window)
line.delete(l_clean_time)
box.delete(q_clean_time)
label.delete(t_clean_time)
l_holes_index = line.new(b, holes, b + 1, holes + 2, xloc=xloc.bar_index)
q_holes_index = box.new(b, holes + 3, b + 1, holes - 3, xloc=xloc.bar_index)
