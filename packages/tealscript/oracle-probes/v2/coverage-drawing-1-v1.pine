plot(box.get_left(q_holes_time), "holes_time_get_left", display=display.data_window)
plot(box.get_right(q_holes_time), "holes_time_get_right", display=display.data_window)
plot(box.get_top(q_holes_time), "holes_time_get_top", display=display.data_window)
plot(box.get_bottom(q_holes_time), "holes_time_get_bottom", display=display.data_window)
plot(label.get_x(t_holes_time), "holes_time_get_x", display=display.data_window)
plot(label.get_y(t_holes_time), "holes_time_get_y", display=display.data_window)
line.delete(l_holes_time)
box.delete(q_holes_time)
label.delete(t_holes_time)
l_warmup_index = line.new(b, warmup, b + 1, warmup + 2, xloc=xloc.bar_index)
