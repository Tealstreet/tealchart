//@version=6
indicator("coverage-math-2-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean
float randomClean = math.random(0.0, 1.0, 42)
float randomHole = hole ? na : randomClean
float randomWarm = b < 8 ? na : randomClean

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
plot(math.avg(clean, 2.0, -1.0), title="avg_clean", color=color.blue, display=display.data_window)
plot(math.avg(holes, 2.0, -1.0), title="avg_hole97", color=color.blue, display=display.data_window)
plot(math.avg(warm, 2.0, -1.0), title="avg_warm0_7", color=color.blue, display=display.data_window)
plot(math.max(clean, -1.0, 1.0), title="max_clean", color=color.blue, display=display.data_window)
plot(math.max(holes, -1.0, 1.0), title="max_hole97", color=color.blue, display=display.data_window)
plot(math.max(warm, -1.0, 1.0), title="max_warm0_7", color=color.blue, display=display.data_window)
plot(math.min(clean, -1.0, 1.0), title="min_clean", color=color.blue, display=display.data_window)
plot(math.min(holes, -1.0, 1.0), title="min_hole97", color=color.blue, display=display.data_window)
plot(math.min(warm, -1.0, 1.0), title="min_warm0_7", color=color.blue, display=display.data_window)
plot(math.todegrees(clean), title="todegrees_clean", color=color.blue, display=display.data_window)
plot(math.todegrees(holes), title="todegrees_hole97", color=color.blue, display=display.data_window)
plot(math.todegrees(warm), title="todegrees_warm0_7", color=color.blue, display=display.data_window)
plot(math.toradians(clean), title="toradians_clean", color=color.blue, display=display.data_window)
plot(math.toradians(holes), title="toradians_hole97", color=color.blue, display=display.data_window)
plot(math.toradians(warm), title="toradians_warm0_7", color=color.blue, display=display.data_window)
plot(math.sum(clean, 5), title="sum_len5_clean", color=color.blue, display=display.data_window)
plot(math.sum(holes, 5), title="sum_len5_hole97", color=color.blue, display=display.data_window)
plot(math.sum(warm, 5), title="sum_len5_warm0_7", color=color.blue, display=display.data_window)
plot(randomClean, title="random_seed42_clean", color=color.blue, display=display.data_window)
plot(randomHole, title="random_seed42_hole97", color=color.blue, display=display.data_window)
plot(randomWarm, title="random_seed42_warm0_7", color=color.blue, display=display.data_window)
plot(math.pi, title="constant_pi", color=color.blue, display=display.data_window)
plot(math.e, title="constant_e", color=color.blue, display=display.data_window)
plot(math.phi, title="constant_phi", color=color.blue, display=display.data_window)
plot(math.rphi, title="constant_rphi", color=color.blue, display=display.data_window)
plot(math.sum(clean, 1), title="sum_len1_clean", color=color.blue, display=display.data_window)
plot(math.sum(holes, 1), title="sum_len1_hole97", color=color.blue, display=display.data_window)
plot(math.sum(warm, 1), title="sum_len1_warm0_7", color=color.blue, display=display.data_window)
plot(math.sum(clean, 3), title="sum_len3_clean", color=color.blue, display=display.data_window)
plot(math.sum(holes, 3), title="sum_len3_hole97", color=color.blue, display=display.data_window)
plot(math.sum(warm, 3), title="sum_len3_warm0_7", color=color.blue, display=display.data_window)
plot(math.sum(clean, b % 5 + 1), title="sum_dynamic_len1to5_clean", color=color.blue, display=display.data_window)
plot(math.sum(holes, b % 5 + 1), title="sum_dynamic_len1to5_hole97", color=color.blue, display=display.data_window)
plot(math.sum(warm, b % 5 + 1), title="sum_dynamic_len1to5_warm0_7", color=color.blue, display=display.data_window)
plot(math.round(0.5), title="round_p050", color=color.blue, display=display.data_window)
plot(math.round(-0.5), title="round_m050", color=color.blue, display=display.data_window)
plot(math.round(1.5), title="round_p150", color=color.blue, display=display.data_window)
plot(math.round(-1.5), title="round_m150", color=color.blue, display=display.data_window)
plot(math.round(clean,0), title="round_prec0", color=color.blue, display=display.data_window)
plot(math.round(clean/3,2), title="round_prec2", color=color.blue, display=display.data_window)
plot(math.round(clean/3,b%3), title="round_prec_dynamic", color=color.blue, display=display.data_window)
plot(b < 4 ? na : clean+clean[1]+clean[2]+clean[3]+clean[4], title="sum_clean_len5_history_control", color=color.blue, display=display.data_window)
plot((clean+2.0-1.0)/3.0, title="avg_primitive_control", color=color.blue, display=display.data_window)
plot(math.todegrees(math.toradians(clean)), title="degree_radian_roundtrip", color=color.blue, display=display.data_window)
plot(false ? na : request.currency_rate("USD", "USD"), title="currency_rate_usd_usd_clean", color=color.blue, display=display.data_window)
plot(hole ? na : request.currency_rate("USD", "USD"), title="currency_rate_usd_usd_hole97", color=color.blue, display=display.data_window)
plot(b < 8 ? na : request.currency_rate("USD", "USD"), title="currency_rate_usd_usd_warm0_7", color=color.blue, display=display.data_window)
plot(int(clean), title="int_cast_clean", color=color.blue, display=display.data_window)
plot(int(holes), title="int_cast_hole97", color=color.blue, display=display.data_window)
plot(int(warm), title="int_cast_warm0_7", color=color.blue, display=display.data_window)
plot(float(clean), title="float_cast_clean", color=color.blue, display=display.data_window)
plot(float(holes), title="float_cast_hole97", color=color.blue, display=display.data_window)
plot(float(warm), title="float_cast_warm0_7", color=color.blue, display=display.data_window)
