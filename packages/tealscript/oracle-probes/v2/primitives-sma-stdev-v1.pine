plot(ta.sma(shifted, 14), "sma_len14_shifted_wave_clean", display=display.data_window)
plot(math.sum(shifted, 14), "sum_len14_shifted_wave_clean", display=display.data_window)
plot(ta.stdev(shifted, 14, true), "stdev_population_len14_shifted_wave_clean", display=display.data_window)
plot(ta.stdev(shifted, 14, false), "stdev_sample_len14_shifted_wave_clean", display=display.data_window)
plot(f_sum(close, 14, false, false), "mean_sum_newest_first_len14_close_clean", display=display.data_window)
plot(f_sum(close, 14, true, false), "mean_sum_oldest_first_len14_close_clean", display=display.data_window)
plot(f_sum(close, 14, false, true), "mean_divide_each_newest_first_len14_close_clean", display=display.data_window)
