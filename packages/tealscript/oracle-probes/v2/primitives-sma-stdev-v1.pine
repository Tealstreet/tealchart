plot(f_running(close, 14, 1), "mean_running_add_subtract_len14_close_clean", display=display.data_window)
plot(f_running(close, 14, 2), "mean_running_difference_len14_close_clean", display=display.data_window)
plot(f_kahan(close, 14), "mean_running_kahan_subtract_add_len14_close_clean", display=display.data_window)
plot(f_centered(close, 14, false), "stdev_centered_ownmean_len14_close_clean", display=display.data_window)
plot(f_moment(close, 14, false), "stdev_fresh_moment_ownmean_len14_close_clean", display=display.data_window)
plot(f_centered(wave, 14, false), "stdev_centered_ownmean_len14_wave_clean", display=display.data_window)
plot(f_centered(wave, 14, true), "stdev_centered_nativemean_len14_wave_clean", display=display.data_window)
plot(f_moment(shifted, 14, false), "stdev_moment_ownmean_len14_shifted_wave_clean", display=display.data_window)
plot(f_moment(shifted, 14, true), "stdev_moment_nativemean_len14_shifted_wave_clean", display=display.data_window)
plot(bbBasis, "bb_basis_len14_mult2_close_clean", display=display.data_window)
plot(bbUpper, "bb_upper_len14_mult2_close_clean", display=display.data_window)
plot(bbLower, "bb_lower_len14_mult2_close_clean", display=display.data_window)
plot(ta.bbw(close, 14, 2.0), "bbw_len14_mult2_close_clean", display=display.data_window)
