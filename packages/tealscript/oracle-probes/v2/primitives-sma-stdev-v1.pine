plot(math.sum(close, 14), "sum_len14_close_clean", display=display.data_window)
plot(ta.stdev(close, 14, true), "stdev_population_len14_close_clean", display=display.data_window)
plot(ta.stdev(close, 14, false), "stdev_sample_len14_close_clean", display=display.data_window)
plot(ta.sma(close, 31), "sma_len31_close_clean", display=display.data_window)
plot(math.sum(close, 31), "sum_len31_close_clean", display=display.data_window)
plot(ta.stdev(close, 31, true), "stdev_population_len31_close_clean", display=display.data_window)
plot(ta.stdev(close, 31, false), "stdev_sample_len31_close_clean", display=display.data_window)
plot(ta.sma(hole, 14), "sma_len14_close_hole40_41", display=display.data_window)
plot(math.sum(hole, 14), "sum_len14_close_hole40_41", display=display.data_window)
plot(ta.stdev(hole, 14, true), "stdev_population_len14_close_hole40_41", display=display.data_window)
plot(ta.stdev(hole, 14, false), "stdev_sample_len14_close_hole40_41", display=display.data_window)
plot(ta.sma(leading, 14), "sma_len14_close_lead0_2", display=display.data_window)
