//@version=6
indicator("Standalone SMA stdev primitives v1", overlay=false, precision=16, max_bars_back=100)
f_sum(s, n, reverse, divideEach) =>
    total = 0.0
    for j = 0 to n - 1
        i = reverse ? n - 1 - j : j
        total := total + (divideEach ? s[i] / n : s[i])
    divideEach ? total : total / n
f_running(s, n, order) =>
    var float total = 0.0
    if bar_index < n
        total := total + s
    else
        if order == 0
            total := (total - s[n]) + s
        else if order == 1
            total := (total + s) - s[n]
        else
            total := total + (s - s[n])
    bar_index >= n - 1 ? total / n : na
f_kahan(s, n) =>
    var float total = 0.0
    var float compensation = 0.0
    if bar_index >= n
        y = -s[n] - compensation
        t = total + y
        compensation := (t - total) - y
        total := t
    y = s - compensation
    t = total + y
    compensation := (t - total) - y
    total := t
    bar_index >= n - 1 ? total / n : na
f_centered(s, n, useNativeMean) =>
    nativeMean = ta.sma(s, n)
    total = 0.0
    for j = 0 to n - 1
        total := total + s[j]
    ownMean = total / n
    mean = useNativeMean ? nativeMean : ownMean
    squares = 0.0
    for i = 0 to n - 1
        delta = s[i] - mean
        squares := squares + delta * delta
    math.sqrt(squares / n)
f_moment(s, n, useNativeMean) =>
    nativeMean = ta.sma(s, n)
    total = 0.0
    for j = 0 to n - 1
        total := total + s[j]
    ownMean = total / n
    mean = useNativeMean ? nativeMean : ownMean
    squares = 0.0
    for i = 0 to n - 1
        squares := squares + s[i] * s[i]
    variance = squares / n - mean * mean
    variance >= 0.0 ? math.sqrt(variance) : na
wave = 50.0 + (bar_index % 11) * 0.25 + (bar_index % 3 == 0 ? 0.125 : -0.375)
shifted = 100000000.0 + wave
hole = bar_index == 40 or bar_index == 41 ? na : close
leading = bar_index < 3 ? na : close
[bbBasis, bbUpper, bbLower] = ta.bb(close, 14, 2.0)
plot(time, "input_time_ms", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(wave, "input_wave", display=display.data_window)
plot(shifted, "input_shifted_wave", display=display.data_window)
plot(hole, "input_close_hole40_41", display=display.data_window)
plot(ta.sma(close, 2), "sma_len2_close_clean", display=display.data_window)
plot(math.sum(close, 2), "sum_len2_close_clean", display=display.data_window)
plot(ta.stdev(close, 2, true), "stdev_population_len2_close_clean", display=display.data_window)
plot(ta.stdev(close, 2, false), "stdev_sample_len2_close_clean", display=display.data_window)
plot(ta.sma(close, 3), "sma_len3_close_clean", display=display.data_window)
plot(math.sum(close, 3), "sum_len3_close_clean", display=display.data_window)
plot(ta.stdev(close, 3, true), "stdev_population_len3_close_clean", display=display.data_window)
plot(ta.stdev(close, 3, false), "stdev_sample_len3_close_clean", display=display.data_window)
plot(ta.sma(close, 7), "sma_len7_close_clean", display=display.data_window)
plot(math.sum(close, 7), "sum_len7_close_clean", display=display.data_window)
plot(ta.stdev(close, 7, true), "stdev_population_len7_close_clean", display=display.data_window)
plot(ta.stdev(close, 7, false), "stdev_sample_len7_close_clean", display=display.data_window)
