//@version=6
indicator("Request native 10m snapshot on 2m companion v21 v1", precision=16)
if timeframe.period != "2"
    runtime.error("Use standard 2-minute candles")
var int chartOrigin = time
firstRequestedTime() =>
    var int origin = time
    origin
requestPack() =>
    float indexHole97Two = bar_index % 97 == 40 or bar_index % 97 == 41 ? na : close
    float indexHole97Three = bar_index % 97 == 40 or bar_index % 97 == 41 or bar_index % 97 == 42 ? na : close
    int phase11 = int(time / 360000) % 11
    float utcHole11 = phase11 == 3 or phase11 == 4 ? na : close
    [time, time_close, bar_index, firstRequestedTime(), last_bar_index, open, high, low, close, volume, close[1], close[2], dayofweek, time("1D"), math.sum(close, 3), math.sum(indexHole97Three, 3), indexHole97Two, indexHole97Three, utcHole11, ta.sma(close, 4), ta.rma(close, 4)]
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(last_bar_index, "CHART_LAST_INDEX", display=display.data_window)
plot(chartOrigin, "CHART_FIRST_EXECUTION_MS", display=display.data_window)
plot(open, "CHART_OPEN", display=display.data_window)
plot(high, "CHART_HIGH", display=display.data_window)
plot(low, "CHART_LOW", display=display.data_window)
plot(close, "CHART_CLOSE", display=display.data_window)
plot(volume, "CHART_VOLUME", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(timenow, "EXECUTION_NOW_MS", display=display.data_window)
plot(barstate.islastconfirmedhistory ? 1 : 0, "CHART_LAST_CONFIRMED_HISTORY", display=display.data_window)
[GOFF_LON_TIME_MS, GOFF_LON_END_MS, GOFF_LON_INDEX, GOFF_LON_FIRST_EXECUTION_MS, GOFF_LON_LAST_INDEX, GOFF_LON_OPEN, GOFF_LON_HIGH, GOFF_LON_LOW, GOFF_LON_CLOSE, GOFF_LON_VOLUME, GOFF_LON_PREVIOUS_CLOSE, GOFF_LON_HISTORY2_CLOSE, GOFF_LON_DAYOFWEEK, GOFF_LON_DAILY_OPEN_MS, GOFF_LON_SUM3_CLOSE, GOFF_LON_SUM3_HOLE97_THREE, GOFF_LON_HOLE_INDEX97_TWO, GOFF_LON_HOLE_INDEX97_THREE, GOFF_LON_HOLE_UTC11, GOFF_LON_SMA4, GOFF_LON_RMA4] = request.security(syminfo.tickerid, "10", requestPack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(GOFF_LON_TIME_MS, "GOFF_LON_TIME_MS", display=display.data_window)
plot(GOFF_LON_END_MS, "GOFF_LON_END_MS", display=display.data_window)
plot(GOFF_LON_INDEX, "GOFF_LON_INDEX", display=display.data_window)
plot(GOFF_LON_FIRST_EXECUTION_MS, "GOFF_LON_FIRST_EXECUTION_MS", display=display.data_window)
plot(GOFF_LON_LAST_INDEX, "GOFF_LON_LAST_INDEX", display=display.data_window)
plot(GOFF_LON_OPEN, "GOFF_LON_OPEN", display=display.data_window)
plot(GOFF_LON_HIGH, "GOFF_LON_HIGH", display=display.data_window)
plot(GOFF_LON_LOW, "GOFF_LON_LOW", display=display.data_window)
plot(GOFF_LON_CLOSE, "GOFF_LON_CLOSE", display=display.data_window)
plot(GOFF_LON_VOLUME, "GOFF_LON_VOLUME", display=display.data_window)
plot(GOFF_LON_PREVIOUS_CLOSE, "GOFF_LON_PREVIOUS_CLOSE", display=display.data_window)
plot(GOFF_LON_HISTORY2_CLOSE, "GOFF_LON_HISTORY2_CLOSE", display=display.data_window)
plot(GOFF_LON_DAYOFWEEK, "GOFF_LON_DAYOFWEEK", display=display.data_window)
plot(GOFF_LON_DAILY_OPEN_MS, "GOFF_LON_DAILY_OPEN_MS", display=display.data_window)
plot(GOFF_LON_SUM3_CLOSE, "GOFF_LON_SUM3_CLOSE", display=display.data_window)
plot(GOFF_LON_SUM3_HOLE97_THREE, "GOFF_LON_SUM3_HOLE97_THREE", display=display.data_window)
plot(GOFF_LON_HOLE_INDEX97_TWO, "GOFF_LON_HOLE_INDEX97_TWO", display=display.data_window)
plot(GOFF_LON_HOLE_INDEX97_THREE, "GOFF_LON_HOLE_INDEX97_THREE", display=display.data_window)
plot(GOFF_LON_HOLE_UTC11, "GOFF_LON_HOLE_UTC11", display=display.data_window)
plot(GOFF_LON_SMA4, "GOFF_LON_SMA4", display=display.data_window)
plot(GOFF_LON_RMA4, "GOFF_LON_RMA4", display=display.data_window)
[GON_LON_TIME_MS, GON_LON_END_MS, GON_LON_INDEX, GON_LON_FIRST_EXECUTION_MS, GON_LON_LAST_INDEX, GON_LON_OPEN, GON_LON_HIGH, GON_LON_LOW, GON_LON_CLOSE, GON_LON_VOLUME, GON_LON_PREVIOUS_CLOSE, GON_LON_HISTORY2_CLOSE, GON_LON_DAYOFWEEK, GON_LON_DAILY_OPEN_MS, GON_LON_SUM3_CLOSE, GON_LON_SUM3_HOLE97_THREE, GON_LON_HOLE_INDEX97_TWO, GON_LON_HOLE_INDEX97_THREE, GON_LON_HOLE_UTC11, GON_LON_SMA4, GON_LON_RMA4] = request.security(syminfo.tickerid, "10", requestPack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
plot(GON_LON_TIME_MS, "GON_LON_TIME_MS", display=display.data_window)
plot(GON_LON_END_MS, "GON_LON_END_MS", display=display.data_window)
plot(GON_LON_INDEX, "GON_LON_INDEX", display=display.data_window)
plot(GON_LON_OPEN, "GON_LON_OPEN", display=display.data_window)
plot(GON_LON_HIGH, "GON_LON_HIGH", display=display.data_window)
plot(GON_LON_LOW, "GON_LON_LOW", display=display.data_window)
plot(GON_LON_CLOSE, "GON_LON_CLOSE", display=display.data_window)
plot(GON_LON_VOLUME, "GON_LON_VOLUME", display=display.data_window)
plot(GON_LON_HOLE_INDEX97_TWO, "GON_LON_HOLE_INDEX97_TWO", display=display.data_window)
plot(GON_LON_HOLE_INDEX97_THREE, "GON_LON_HOLE_INDEX97_THREE", display=display.data_window)
[GOFF_LOFF_TIME_MS, GOFF_LOFF_END_MS, GOFF_LOFF_INDEX, GOFF_LOFF_FIRST_EXECUTION_MS, GOFF_LOFF_LAST_INDEX, GOFF_LOFF_OPEN, GOFF_LOFF_HIGH, GOFF_LOFF_LOW, GOFF_LOFF_CLOSE, GOFF_LOFF_VOLUME, GOFF_LOFF_PREVIOUS_CLOSE, GOFF_LOFF_HISTORY2_CLOSE, GOFF_LOFF_DAYOFWEEK, GOFF_LOFF_DAILY_OPEN_MS, GOFF_LOFF_SUM3_CLOSE, GOFF_LOFF_SUM3_HOLE97_THREE, GOFF_LOFF_HOLE_INDEX97_TWO, GOFF_LOFF_HOLE_INDEX97_THREE, GOFF_LOFF_HOLE_UTC11, GOFF_LOFF_SMA4, GOFF_LOFF_RMA4] = request.security(syminfo.tickerid, "10", requestPack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(GOFF_LOFF_TIME_MS, "GOFF_LOFF_TIME_MS", display=display.data_window)
plot(GOFF_LOFF_CLOSE, "GOFF_LOFF_CLOSE", display=display.data_window)
plot(GOFF_LOFF_HOLE_INDEX97_TWO, "GOFF_LOFF_HOLE_INDEX97_TWO", display=display.data_window)
plot(GOFF_LOFF_HOLE_INDEX97_THREE, "GOFF_LOFF_HOLE_INDEX97_THREE", display=display.data_window)
[GON_LOFF_TIME_MS, GON_LOFF_END_MS, GON_LOFF_INDEX, GON_LOFF_FIRST_EXECUTION_MS, GON_LOFF_LAST_INDEX, GON_LOFF_OPEN, GON_LOFF_HIGH, GON_LOFF_LOW, GON_LOFF_CLOSE, GON_LOFF_VOLUME, GON_LOFF_PREVIOUS_CLOSE, GON_LOFF_HISTORY2_CLOSE, GON_LOFF_DAYOFWEEK, GON_LOFF_DAILY_OPEN_MS, GON_LOFF_SUM3_CLOSE, GON_LOFF_SUM3_HOLE97_THREE, GON_LOFF_HOLE_INDEX97_TWO, GON_LOFF_HOLE_INDEX97_THREE, GON_LOFF_HOLE_UTC11, GON_LOFF_SMA4, GON_LOFF_RMA4] = request.security(syminfo.tickerid, "10", requestPack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
plot(GON_LOFF_TIME_MS, "GON_LOFF_TIME_MS", display=display.data_window)
plot(GON_LOFF_CLOSE, "GON_LOFF_CLOSE", display=display.data_window)
plot(GON_LOFF_HOLE_INDEX97_TWO, "GON_LOFF_HOLE_INDEX97_TWO", display=display.data_window)
plot(GON_LOFF_HOLE_INDEX97_THREE, "GON_LOFF_HOLE_INDEX97_THREE", display=display.data_window)
plot(10, "REQUEST_TIMEFRAME_MINUTES", display=display.data_window)
plot(GOFF_LON_END_MS <= timenow ? 1 : 0, "REQUEST_BUCKET_COMPLETED_AT_EXECUTION", display=display.data_window)
plot(na(GOFF_LON_CLOSE) ? 1 : 0, "REQUEST_CLOSE_NA", display=display.data_window)
if barstate.islastconfirmedhistory
    log.info("CONTEXT ticker=" + syminfo.tickerid + " tf=" + timeframe.period + " timezone=" + syminfo.timezone + " session=" + syminfo.session + " currency=" + syminfo.currency + " mintick=" + str.tostring(syminfo.mintick) + " origin=" + str.tostring(chartOrigin) + " now=" + str.tostring(timenow))
