[ri, rt, rp, re] = request.security(syminfo.tickerid,"6",[bar_index,time,close[1],time_close],gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)
plot(ri, title="htf6_requested_index", color=color.blue, display=display.data_window)
plot(rt, title="htf6_requested_time", color=color.blue, display=display.data_window)
plot(rp, title="htf6_requested_prev_close", color=color.blue, display=display.data_window)
plot(re, title="htf6_requested_end", color=color.blue, display=display.data_window)
plot(time_close == time_close("6") ? close : na, title="manual6_confirmed_chart_close", color=color.blue, display=display.data_window)
