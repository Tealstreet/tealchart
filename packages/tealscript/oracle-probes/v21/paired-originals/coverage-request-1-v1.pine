//@version=6
indicator("coverage-request-1-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean
reqPack() =>
    float srcHole = bar_index % 97 == 40 or bar_index % 97 == 41 or bar_index % 97 == 42 ? na : close
    [close, math.sum(close, 3), math.sum(srcHole, 3), high-low, hl2, hlc3, ohlc4, close[2], time_close, dayofweek, time("1D"), srcHole]

plot(open, title="input_open", color=color.blue, display=display.data_window)
plot(high, title="input_high", color=color.blue, display=display.data_window)
plot(low, title="input_low", color=color.blue, display=display.data_window)
plot(close, title="input_close", color=color.blue, display=display.data_window)
plot(volume, title="input_volume", color=color.blue, display=display.data_window)
plot(time, title="input_time", color=color.blue, display=display.data_window)
plot(bar_index, title="input_bar_index", color=color.blue, display=display.data_window)
[goff_loff_0, goff_loff_1, goff_loff_2, goff_loff_3, goff_loff_4, goff_loff_5, goff_loff_6, goff_loff_7, goff_loff_8, goff_loff_9, goff_loff_10, goff_loff_11] = request.security(syminfo.tickerid,"6",reqPack(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off)
plot(goff_loff_0, title="htf6_goff_loff_close_clean", color=color.blue, display=display.data_window)
plot(goff_loff_1, title="htf6_goff_loff_sum_close_len3_clean", color=color.blue, display=display.data_window)
plot(goff_loff_2, title="htf6_goff_loff_sum_close_len3_hole", color=color.blue, display=display.data_window)
plot(goff_loff_3, title="htf6_goff_loff_range", color=color.blue, display=display.data_window)
plot(goff_loff_4, title="htf6_goff_loff_hl2", color=color.blue, display=display.data_window)
plot(goff_loff_5, title="htf6_goff_loff_hlc3", color=color.blue, display=display.data_window)
plot(goff_loff_6, title="htf6_goff_loff_ohlc4", color=color.blue, display=display.data_window)
plot(goff_loff_7, title="htf6_goff_loff_close_history2", color=color.blue, display=display.data_window)
plot(goff_loff_8, title="htf6_goff_loff_time_close", color=color.blue, display=display.data_window)
plot(goff_loff_9, title="htf6_goff_loff_dayofweek", color=color.blue, display=display.data_window)
plot(goff_loff_10, title="htf6_goff_loff_daily_open", color=color.blue, display=display.data_window)
plot(goff_loff_11, title="htf6_goff_loff_close_hole97", color=color.blue, display=display.data_window)
[goff_lon_0, goff_lon_1, goff_lon_2, goff_lon_3, goff_lon_4, goff_lon_5, goff_lon_6, goff_lon_7, goff_lon_8, goff_lon_9, goff_lon_10, goff_lon_11] = request.security(syminfo.tickerid,"6",reqPack(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)
plot(goff_lon_0, title="htf6_goff_lon_close_clean", color=color.blue, display=display.data_window)
