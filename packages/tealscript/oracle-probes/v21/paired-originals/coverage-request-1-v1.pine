[gon_lon_0, gon_lon_1, gon_lon_2, gon_lon_3, gon_lon_4, gon_lon_5, gon_lon_6, gon_lon_7, gon_lon_8, gon_lon_9, gon_lon_10, gon_lon_11] = request.security(syminfo.tickerid,"6",reqPack(),gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_on)
plot(gon_lon_0, title="htf6_gon_lon_close_clean", color=color.blue, display=display.data_window)
plot(gon_lon_1, title="htf6_gon_lon_sum_close_len3_clean", color=color.blue, display=display.data_window)
