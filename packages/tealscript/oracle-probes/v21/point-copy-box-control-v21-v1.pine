//@version=6
indicator("Box point-copy control v21 v1", overlay=false, precision=16, max_boxes_count=3)
var float CREATION_INDEX = na
var float CALL_COMPLETED = 0
var float SOURCE_FIRST_X = na
var float SOURCE_FIRST_Y = na
var float SOURCE_SECOND_X = na
var float SOURCE_SECOND_Y = na
var float BEFORE_LEFT = na
var float AFTER_LEFT = na
var float BEFORE_TOP = na
var float AFTER_TOP = na
var float BEFORE_RIGHT = na
var float AFTER_RIGHT = na
var float BEFORE_BOTTOM = na
var float AFTER_BOTTOM = na
if barstate.islastconfirmedhistory and bar_index >= 32
    first = chart.point.from_index(bar_index - 24, 7.0)
    second = chart.point.from_index(bar_index, 2.0)
    target = box.new(first, second, xloc=xloc.bar_index, border_color=color.red, border_width=6, bgcolor=na)
    box.new(bar_index - 24, 7.0, bar_index, 2.0, border_color=color.green, border_width=2, bgcolor=na)
    CREATION_INDEX := bar_index
    BEFORE_LEFT := box.get_left(target)
    BEFORE_TOP := box.get_top(target)
    BEFORE_RIGHT := box.get_right(target)
    BEFORE_BOTTOM := box.get_bottom(target)
    first.index := bar_index - 12
    first.price := 10.0
    second.index := bar_index - 4
    second.price := 4.0
    SOURCE_FIRST_X := first.index
    SOURCE_FIRST_Y := first.price
    SOURCE_SECOND_X := second.index
    SOURCE_SECOND_Y := second.price
    AFTER_LEFT := box.get_left(target)
    AFTER_TOP := box.get_top(target)
    AFTER_RIGHT := box.get_right(target)
    AFTER_BOTTOM := box.get_bottom(target)
    box.new(first, second, xloc=xloc.bar_index, border_color=color.blue, border_width=2, bgcolor=na)
    CALL_COMPLETED := 1
plot(CREATION_INDEX, "CREATION_INDEX", display=display.data_window)
plot(CALL_COMPLETED, "CALL_COMPLETED", display=display.data_window)
plot(SOURCE_FIRST_X, "SOURCE_FIRST_X", display=display.data_window)
plot(SOURCE_FIRST_Y, "SOURCE_FIRST_Y", display=display.data_window)
plot(SOURCE_SECOND_X, "SOURCE_SECOND_X", display=display.data_window)
plot(SOURCE_SECOND_Y, "SOURCE_SECOND_Y", display=display.data_window)
plot(BEFORE_LEFT, "BEFORE_LEFT", display=display.data_window)
plot(AFTER_LEFT, "AFTER_LEFT", display=display.data_window)
plot(BEFORE_TOP, "BEFORE_TOP", display=display.data_window)
plot(AFTER_TOP, "AFTER_TOP", display=display.data_window)
plot(BEFORE_RIGHT, "BEFORE_RIGHT", display=display.data_window)
plot(AFTER_RIGHT, "AFTER_RIGHT", display=display.data_window)
plot(BEFORE_BOTTOM, "BEFORE_BOTTOM", display=display.data_window)
plot(AFTER_BOTTOM, "AFTER_BOTTOM", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(0, "PANE_ZERO", display=display.data_window)
plot(12, "PANE_TWELVE", display=display.data_window)
