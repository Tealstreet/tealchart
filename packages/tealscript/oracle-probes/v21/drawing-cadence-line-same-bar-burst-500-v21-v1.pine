//@version=6
indicator("Cadence line same-bar-burst quota 500 v21 v1", precision=16, max_lines_count=500)
var int serial = 0
var int afterQuota = na
var int afterFive = na
var int afterSix = na
var float oldestQuota = na
var float oldestFive = na
var float oldestSix = na
int beforeCount = array.size(line.all)
int creations = bar_index < 596 ? (bar_index == 0 ? 506 : bar_index >= 4 and not (bar_index >= 8 and bar_index < 12) ? 1 : 0) : 0
if creations > 0
    for i = 0 to creations - 1
        serial += 1
        line.new(bar_index, serial, bar_index + 1, serial + 0.5)
        if i == 499
            afterQuota := array.size(line.all)
            oldestQuota := line.get_y1(array.get(line.all, 0))
        if i == 504
            afterFive := array.size(line.all)
            oldestFive := line.get_y1(array.get(line.all, 0))
        if i == 505
            afterSix := array.size(line.all)
            oldestSix := line.get_y1(array.get(line.all, 0))
int afterCreationCount = array.size(line.all)
int deleted = 0
if bar_index == 6
    if array.size(line.all) > 0
        line.delete(array.get(line.all, 0))
        deleted := 1
plot(bar_index, "BAR_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(500, "DECLARED_QUOTA", display=display.data_window)
plot(0, "QUOTA_ARGUMENT_OMITTED", display=display.data_window)
plot(creations, "CREATIONS_THIS_BAR", display=display.data_window)
plot(serial, "TOTAL_CREATED", display=display.data_window)
plot(beforeCount, "PRE_SOURCE_COUNT", display=display.data_window)
plot(afterCreationCount, "POST_CREATION_COUNT", display=display.data_window)
plot(deleted, "EXPLICIT_DELETE_THIS_BAR", display=display.data_window)
plot(array.size(line.all), "VISIBLE_COUNT", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_x1(array.get(line.all, 0)) : na, "OLDEST_INDEX", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_x1(array.get(line.all, array.size(line.all) - 1)) : na, "NEWEST_INDEX", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_y1(array.get(line.all, 0)) : na, "OLDEST_SERIAL", display=display.data_window)
plot(array.size(line.all) > 0 ? line.get_y1(array.get(line.all, array.size(line.all) - 1)) : na, "NEWEST_SERIAL", display=display.data_window)
plot(afterQuota, "AFTER_QUOTA", display=display.data_window)
plot(afterFive, "AFTER_QUOTA_PLUS_FIVE", display=display.data_window)
plot(afterSix, "AFTER_QUOTA_PLUS_SIX", display=display.data_window)
plot(oldestQuota, "AT_QUOTA_OLDEST_SERIAL", display=display.data_window)
plot(oldestFive, "AT_PLUS_FIVE_OLDEST_SERIAL", display=display.data_window)
plot(oldestSix, "AT_PLUS_SIX_OLDEST_SERIAL", display=display.data_window)
