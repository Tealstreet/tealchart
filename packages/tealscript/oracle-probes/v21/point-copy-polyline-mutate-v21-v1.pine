//@version=6
indicator("Polyline point mutate isolation v21 v1", overlay=false, precision=16, max_polylines_count=3)
var float CREATION_INDEX = na
var float CALL_COMPLETED = 0
var float SOURCE_COUNT = na
var float POLYLINE_ALL_SIZE = na
var float BEFORE_P0_X = na
var float AFTER_P0_X = na
var float BEFORE_P0_Y = na
var float AFTER_P0_Y = na
var float BEFORE_P1_X = na
var float AFTER_P1_X = na
var float BEFORE_P1_Y = na
var float AFTER_P1_Y = na
var float BEFORE_P2_X = na
var float AFTER_P2_X = na
var float BEFORE_P2_Y = na
var float AFTER_P2_Y = na
var float BEFORE_P3_X = na
var float AFTER_P3_X = na
var float BEFORE_P3_Y = na
var float AFTER_P3_Y = na
if barstate.islastconfirmedhistory and bar_index >= 32
    p0 = chart.point.from_index(bar_index - 24, 1.0)
    p1 = chart.point.from_index(bar_index - 16, 4.0)
    p2 = chart.point.from_index(bar_index - 8, 2.0)
    p3 = chart.point.from_index(bar_index, 5.0)
    points = array.from(p0, p1, p2, p3)
    polyline.new(points, curved=false, closed=false, xloc=xloc.bar_index, line_color=color.red, line_width=6)
    reference = array.from(chart.point.from_index(bar_index - 24, 1.0), chart.point.from_index(bar_index - 16, 4.0), chart.point.from_index(bar_index - 8, 2.0), chart.point.from_index(bar_index, 5.0))
    polyline.new(reference, curved=false, closed=false, xloc=xloc.bar_index, line_color=color.green, line_width=2)
    CREATION_INDEX := bar_index
    BEFORE_P0_X := p0.index
    BEFORE_P0_Y := p0.price
    BEFORE_P1_X := p1.index
    BEFORE_P1_Y := p1.price
    BEFORE_P2_X := p2.index
    BEFORE_P2_Y := p2.price
    BEFORE_P3_X := p3.index
    BEFORE_P3_Y := p3.price
    p0.price := 6.0
    p1.index := bar_index - 12
    p1.price := 8.0
    p2.price := 7.0
    p3.price := 9.0
    after0 = array.get(points, 0)
    AFTER_P0_X := after0.index
    AFTER_P0_Y := after0.price
    after1 = array.get(points, 1)
    AFTER_P1_X := after1.index
    AFTER_P1_Y := after1.price
    after2 = array.get(points, 2)
    AFTER_P2_X := after2.index
    AFTER_P2_Y := after2.price
    after3 = array.get(points, 3)
    AFTER_P3_X := after3.index
    AFTER_P3_Y := after3.price
    polyline.new(points, curved=false, closed=false, xloc=xloc.bar_index, line_color=color.blue, line_width=2)
    SOURCE_COUNT := array.size(points)
    POLYLINE_ALL_SIZE := array.size(polyline.all)
    CALL_COMPLETED := 1
plot(CREATION_INDEX, "CREATION_INDEX", display=display.data_window)
plot(CALL_COMPLETED, "CALL_COMPLETED", display=display.data_window)
plot(SOURCE_COUNT, "SOURCE_COUNT", display=display.data_window)
plot(POLYLINE_ALL_SIZE, "POLYLINE_ALL_SIZE", display=display.data_window)
plot(BEFORE_P0_X, "BEFORE_P0_X", display=display.data_window)
plot(AFTER_P0_X, "AFTER_P0_X", display=display.data_window)
plot(BEFORE_P0_Y, "BEFORE_P0_Y", display=display.data_window)
plot(AFTER_P0_Y, "AFTER_P0_Y", display=display.data_window)
plot(BEFORE_P1_X, "BEFORE_P1_X", display=display.data_window)
plot(AFTER_P1_X, "AFTER_P1_X", display=display.data_window)
plot(BEFORE_P1_Y, "BEFORE_P1_Y", display=display.data_window)
plot(AFTER_P1_Y, "AFTER_P1_Y", display=display.data_window)
plot(BEFORE_P2_X, "BEFORE_P2_X", display=display.data_window)
plot(AFTER_P2_X, "AFTER_P2_X", display=display.data_window)
plot(BEFORE_P2_Y, "BEFORE_P2_Y", display=display.data_window)
plot(AFTER_P2_Y, "AFTER_P2_Y", display=display.data_window)
plot(BEFORE_P3_X, "BEFORE_P3_X", display=display.data_window)
plot(AFTER_P3_X, "AFTER_P3_X", display=display.data_window)
plot(BEFORE_P3_Y, "BEFORE_P3_Y", display=display.data_window)
plot(AFTER_P3_Y, "AFTER_P3_Y", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(0, "PANE_ZERO", display=display.data_window)
plot(10, "PANE_TEN", display=display.data_window)
