//@version=6
indicator("Cadence label creation-pause quota 50 v21 v1", precision=16)
var int serial = 0
var int afterQuota = na
var int afterFive = na
var int afterSix = na
var float oldestQuota = na
var float oldestFive = na
var float oldestSix = na
int beforeCount = array.size(label.all)
int creations = bar_index < 146 ? (bar_index == 70 ? 56 : bar_index >= 74 and bar_index < 78 ? 0 : bar_index < 4 or bar_index >= 8 ? 1 : 0) : 0
if creations > 0
    for i = 0 to creations - 1
        serial += 1
        label.new(bar_index, serial, str.tostring(serial), yloc=yloc.price)
        if i == 49
            afterQuota := array.size(label.all)
            oldestQuota := label.get_y(array.get(label.all, 0))
        if i == 54
            afterFive := array.size(label.all)
            oldestFive := label.get_y(array.get(label.all, 0))
        if i == 55
            afterSix := array.size(label.all)
            oldestSix := label.get_y(array.get(label.all, 0))
int afterCreationCount = array.size(label.all)
int deleted = 0
if bar_index == 72
    if array.size(label.all) > 0
        label.delete(array.get(label.all, 0))
        deleted := 1
plot(bar_index, "BAR_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(50, "DECLARED_QUOTA", display=display.data_window)
plot(1, "QUOTA_ARGUMENT_OMITTED", display=display.data_window)
plot(creations, "CREATIONS_THIS_BAR", display=display.data_window)
plot(serial, "TOTAL_CREATED", display=display.data_window)
plot(beforeCount, "PRE_SOURCE_COUNT", display=display.data_window)
plot(afterCreationCount, "POST_CREATION_COUNT", display=display.data_window)
plot(deleted, "EXPLICIT_DELETE_THIS_BAR", display=display.data_window)
plot(array.size(label.all), "VISIBLE_COUNT", display=display.data_window)
plot(array.size(label.all) > 0 ? label.get_x(array.get(label.all, 0)) : na, "OLDEST_INDEX", display=display.data_window)
plot(array.size(label.all) > 0 ? label.get_x(array.get(label.all, array.size(label.all) - 1)) : na, "NEWEST_INDEX", display=display.data_window)
plot(array.size(label.all) > 0 ? label.get_y(array.get(label.all, 0)) : na, "OLDEST_SERIAL", display=display.data_window)
plot(array.size(label.all) > 0 ? label.get_y(array.get(label.all, array.size(label.all) - 1)) : na, "NEWEST_SERIAL", display=display.data_window)
plot(afterQuota, "AFTER_QUOTA", display=display.data_window)
plot(afterFive, "AFTER_QUOTA_PLUS_FIVE", display=display.data_window)
plot(afterSix, "AFTER_QUOTA_PLUS_SIX", display=display.data_window)
plot(oldestQuota, "AT_QUOTA_OLDEST_SERIAL", display=display.data_window)
plot(oldestFive, "AT_PLUS_FIVE_OLDEST_SERIAL", display=display.data_window)
plot(oldestSix, "AT_PLUS_SIX_OLDEST_SERIAL", display=display.data_window)
