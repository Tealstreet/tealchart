//@version=6
indicator("Line point-copy control v21 v1", overlay=false, precision=16, max_lines_count=3)
var float CREATION_INDEX = na
var float CALL_COMPLETED = 0
var float SOURCE_FIRST_X = na
var float SOURCE_FIRST_Y = na
var float SOURCE_SECOND_X = na
var float SOURCE_SECOND_Y = na
var float BEFORE_X1 = na
var float AFTER_X1 = na
var float BEFORE_Y1 = na
var float AFTER_Y1 = na
var float BEFORE_X2 = na
var float AFTER_X2 = na
var float BEFORE_Y2 = na
var float AFTER_Y2 = na
if barstate.islastconfirmedhistory and bar_index >= 32
    first = chart.point.from_index(bar_index - 24, 1.0)
    second = chart.point.from_index(bar_index, 5.0)
    target = line.new(first, second, xloc=xloc.bar_index, color=color.red, width=6)
    line.new(bar_index - 24, 1.0, bar_index, 5.0, color=color.green, width=2)
    CREATION_INDEX := bar_index
    BEFORE_X1 := line.get_x1(target)
    BEFORE_Y1 := line.get_y1(target)
    BEFORE_X2 := line.get_x2(target)
    BEFORE_Y2 := line.get_y2(target)
    first.index := bar_index - 12
    first.price := 10.0
    second.index := bar_index - 4
    second.price := 4.0
    SOURCE_FIRST_X := first.index
    SOURCE_FIRST_Y := first.price
    SOURCE_SECOND_X := second.index
    SOURCE_SECOND_Y := second.price
    AFTER_X1 := line.get_x1(target)
    AFTER_Y1 := line.get_y1(target)
    AFTER_X2 := line.get_x2(target)
    AFTER_Y2 := line.get_y2(target)
    line.new(first, second, xloc=xloc.bar_index, color=color.blue, width=2)
    CALL_COMPLETED := 1
plot(CREATION_INDEX, "CREATION_INDEX", display=display.data_window)
plot(CALL_COMPLETED, "CALL_COMPLETED", display=display.data_window)
plot(SOURCE_FIRST_X, "SOURCE_FIRST_X", display=display.data_window)
plot(SOURCE_FIRST_Y, "SOURCE_FIRST_Y", display=display.data_window)
plot(SOURCE_SECOND_X, "SOURCE_SECOND_X", display=display.data_window)
plot(SOURCE_SECOND_Y, "SOURCE_SECOND_Y", display=display.data_window)
plot(BEFORE_X1, "BEFORE_X1", display=display.data_window)
plot(AFTER_X1, "AFTER_X1", display=display.data_window)
plot(BEFORE_Y1, "BEFORE_Y1", display=display.data_window)
plot(AFTER_Y1, "AFTER_Y1", display=display.data_window)
plot(BEFORE_X2, "BEFORE_X2", display=display.data_window)
plot(AFTER_X2, "AFTER_X2", display=display.data_window)
plot(BEFORE_Y2, "BEFORE_Y2", display=display.data_window)
plot(AFTER_Y2, "AFTER_Y2", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(0, "PANE_ZERO", display=display.data_window)
plot(12, "PANE_TWELVE", display=display.data_window)
