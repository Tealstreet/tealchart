//@version=6
indicator("CF020 distinct omitted col v3", precision=12)
m = matrix.new<int>(3, 3, 0)
matrix.set(m, 0, 0, 101)
matrix.set(m, 0, 1, 102)
matrix.set(m, 0, 2, 103)
matrix.set(m, 1, 0, 201)
matrix.set(m, 1, 1, 202)
matrix.set(m, 1, 2, 203)
matrix.set(m, 2, 0, 301)
matrix.set(m, 2, 1, 302)
matrix.set(m, 2, 2, 303)
removed = matrix.remove_col(m)
plot(array.get(removed, 0), "CF020_removed_0", display=display.data_window)
plot(array.get(removed, 1), "CF020_removed_1", display=display.data_window)
plot(array.get(removed, 2), "CF020_removed_2", display=display.data_window)
plot(matrix.rows(m), "CF020_rows", display=display.data_window)
plot(matrix.columns(m), "CF020_cols", display=display.data_window)
plot(matrix.get(m, 0, 0), "CF020_remaining_0_0", display=display.data_window)
plot(matrix.get(m, 0, 1), "CF020_remaining_0_1", display=display.data_window)
plot(matrix.get(m, 1, 0), "CF020_remaining_1_0", display=display.data_window)
plot(matrix.get(m, 1, 1), "CF020_remaining_1_1", display=display.data_window)
plot(matrix.get(m, 2, 0), "CF020_remaining_2_0", display=display.data_window)
plot(matrix.get(m, 2, 1), "CF020_remaining_2_1", display=display.data_window)

plot(time, "CTRL_time", display=display.data_window)
plot(bar_index, "CTRL_bar_index", display=display.data_window)
plot(close, "CTRL_close", display=display.data_window)
plot(1, "CTRL_sentinel", display=display.data_window)
