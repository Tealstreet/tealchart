    box.new(bar_index - 7, 64, bar_index - 7 + width, 40, text="ALPHA BETA GAMMA DELTA EPSILON ZETA ETA THETA IOTA KAPPA LAMBDA MU NU XI OMICRON PI RHO SIGMA TAU", text_size=0, text_wrap=text.wrap_auto, text_halign=text.align_left, text_valign=text.align_top, text_color=color.white, bgcolor=color.new(color.black, 20), border_color=color.white)
if barstate.islastconfirmedhistory
    label.new(bar_index - 22, 33, "size=size.auto", style=label.style_none, textcolor=color.white)
    box.new(bar_index - 17, 33, bar_index - 17 + width, 9, text="ALPHA BETA GAMMA DELTA EPSILON ZETA ETA THETA IOTA KAPPA LAMBDA MU NU XI OMICRON PI RHO SIGMA TAU", text_size=size.auto, text_wrap=text.wrap_none, text_halign=text.align_left, text_valign=text.align_top, text_color=color.white, bgcolor=color.new(color.black, 20), border_color=color.white)
    box.new(bar_index - 7, 33, bar_index - 7 + width, 9, text="ALPHA BETA GAMMA DELTA EPSILON ZETA ETA THETA IOTA KAPPA LAMBDA MU NU XI OMICRON PI RHO SIGMA TAU", text_size=size.auto, text_wrap=text.wrap_auto, text_halign=text.align_left, text_valign=text.align_top, text_color=color.white, bgcolor=color.new(color.black, 20), border_color=color.white)

