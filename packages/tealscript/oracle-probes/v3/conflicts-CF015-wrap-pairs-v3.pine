    box.new(bar_index - 7, 95, bar_index - 7 + width, 71, text="ALPHA BETA GAMMA DELTA EPSILON ZETA ETA THETA IOTA KAPPA LAMBDA MU NU XI OMICRON PI RHO SIGMA TAU", text_size=18, text_wrap=text.wrap_auto, text_halign=text.align_left, text_valign=text.align_top, text_color=color.white, bgcolor=color.new(color.black, 20), border_color=color.white)
