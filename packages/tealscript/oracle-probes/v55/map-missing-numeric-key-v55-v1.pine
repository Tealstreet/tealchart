//@version=6
indicator("Map missing numeric key v1", calc_bars_count=32)
var int sample = 0
m = map.new<float, int>()
float missingKey = na
firstPrevious = m.put(missingKey, 11)
afterFirst = m.size()
secondPrevious = m.put(missingKey, 23)
plot(afterFirst, "size_first")
plot(m.size(), "size_second")
plot(m.contains(missingKey) ? 1 : 0, "contains_na")
plot(m.get(missingKey), "get_na")
plot(na(firstPrevious) ? 1 : 0, "first_previous_missing")
plot(secondPrevious, "second_previous")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
