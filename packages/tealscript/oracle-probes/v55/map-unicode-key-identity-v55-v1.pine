//@version=6
indicator("Map Unicode key identity v1", calc_bars_count=32)
var int sample = 0
m = map.new<string, int>()
string composed = "é"
string decomposed = "é"
m.put("z", 7)
m.put(composed, 11)
previous = m.put(decomposed, 23)
k = m.keys()
v = m.values()
plot(m.size(), "size_unicode")
plot(m.get(composed), "get_composed")
plot(m.get(decomposed), "get_decomposed")
plot(previous, "decomposed_put_previous")
plot(k.get(0) == "z" ? 1 : 0, "first_key_z")
plot(v.get(0), "first_value")
plot(v.get(1), "second_value")
plot(m.size() > 2 ? v.get(2) : na, "third_value")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
