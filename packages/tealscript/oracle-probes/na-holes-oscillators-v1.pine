//@version=6
indicator("Oracle: na holes oscillators v1", overlay=false, precision=10, max_bars_back=200)
// Export ALL available chart data, including bar_index 0 through at least 80.
// Only clean RSI is visible. Other raw plots stay in the Data Window and CSV.
// WPR hole plots are FORMULAS, not calls to ta.wpr with injected OHLC.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_nahole_bar40_41 = hole ? na : close
s_nastart_bar0_2 = bar_index < 3 ? na : close
plot(bar_index, title="input_bar_index", display=display.data_window)
plot(open, title="input_open", display=display.data_window)
plot(high, title="input_high", display=display.data_window)
plot(low, title="input_low", display=display.data_window)
plot(close, title="input_close", display=display.data_window)
plot(volume, title="input_volume", display=display.data_window)
plot(ta.rsi(s_clean, 14), title="rsi_len14_clean", display=display.all)
plot(ta.rsi(s_nahole_bar40_41, 14), title="rsi_len14_nahole_bar40_41", display=display.data_window)
plot(ta.rsi(s_nastart_bar0_2, 14), title="rsi_len14_nastart_bar0_2", display=display.data_window)
plot(ta.stoch(s_clean, high, low, 14), title="stoch_len14_clean", display=display.data_window)
plot(ta.stoch(s_nahole_bar40_41, high, low, 14), title="stoch_len14_nahole_bar40_41", display=display.data_window)
plot(ta.stoch(s_nastart_bar0_2, high, low, 14), title="stoch_len14_nastart_bar0_2", display=display.data_window)
plot(ta.bbw(s_clean, 14, 2.0), title="bbw_len14_clean", display=display.data_window)
plot(ta.bbw(s_nahole_bar40_41, 14, 2.0), title="bbw_len14_nahole_bar40_41", display=display.data_window)
plot(ta.bbw(s_nastart_bar0_2, 14, 2.0), title="bbw_len14_nastart_bar0_2", display=display.data_window)
plot(ta.kcw(s_clean, 14, 2.0, true), title="kcw_len14_clean", display=display.data_window)
plot(ta.kcw(s_nahole_bar40_41, 14, 2.0, true), title="kcw_len14_nahole_bar40_41", display=display.data_window)
plot(ta.kcw(s_nastart_bar0_2, 14, 2.0, true), title="kcw_len14_nastart_bar0_2", display=display.data_window)
plot(ta.cci(s_clean, 14), title="cci_len14_clean", display=display.data_window)
plot(ta.cci(s_nahole_bar40_41, 14), title="cci_len14_nahole_bar40_41", display=display.data_window)
plot(ta.cci(s_nastart_bar0_2, 14), title="cci_len14_nastart_bar0_2", display=display.data_window)
plot(ta.cmo(s_clean, 14), title="cmo_len14_clean", display=display.data_window)
plot(ta.cmo(s_nahole_bar40_41, 14), title="cmo_len14_nahole_bar40_41", display=display.data_window)
plot(ta.cmo(s_nastart_bar0_2, 14), title="cmo_len14_nastart_bar0_2", display=display.data_window)
[bb_basis_clean, bb_upper_clean, bb_lower_clean] = ta.bb(s_clean, 14, 2.0)
plot(bb_basis_clean, title="bb_basis_len14_mult2_clean", display=display.data_window)
plot(bb_upper_clean, title="bb_upper_len14_mult2_clean", display=display.data_window)
plot(bb_lower_clean, title="bb_lower_len14_mult2_clean", display=display.data_window)
[bb_basis_nahole_bar40_41, bb_upper_nahole_bar40_41, bb_lower_nahole_bar40_41] = ta.bb(s_nahole_bar40_41, 14, 2.0)
plot(bb_basis_nahole_bar40_41, title="bb_basis_len14_mult2_nahole_bar40_41", display=display.data_window)
plot(bb_upper_nahole_bar40_41, title="bb_upper_len14_mult2_nahole_bar40_41", display=display.data_window)
plot(bb_lower_nahole_bar40_41, title="bb_lower_len14_mult2_nahole_bar40_41", display=display.data_window)
[bb_basis_nastart_bar0_2, bb_upper_nastart_bar0_2, bb_lower_nastart_bar0_2] = ta.bb(s_nastart_bar0_2, 14, 2.0)
plot(bb_basis_nastart_bar0_2, title="bb_basis_len14_mult2_nastart_bar0_2", display=display.data_window)
plot(bb_upper_nastart_bar0_2, title="bb_upper_len14_mult2_nastart_bar0_2", display=display.data_window)
plot(bb_lower_nastart_bar0_2, title="bb_lower_len14_mult2_nastart_bar0_2", display=display.data_window)
[kc_basis_clean, kc_upper_clean, kc_lower_clean] = ta.kc(s_clean, 14, 2.0, true)
plot(kc_basis_clean, title="kc_basis_len14_mult2_clean", display=display.data_window)
plot(kc_upper_clean, title="kc_upper_len14_mult2_clean", display=display.data_window)
plot(kc_lower_clean, title="kc_lower_len14_mult2_clean", display=display.data_window)
[kc_basis_nahole_bar40_41, kc_upper_nahole_bar40_41, kc_lower_nahole_bar40_41] = ta.kc(s_nahole_bar40_41, 14, 2.0, true)
plot(kc_basis_nahole_bar40_41, title="kc_basis_len14_mult2_nahole_bar40_41", display=display.data_window)
plot(kc_upper_nahole_bar40_41, title="kc_upper_len14_mult2_nahole_bar40_41", display=display.data_window)
plot(kc_lower_nahole_bar40_41, title="kc_lower_len14_mult2_nahole_bar40_41", display=display.data_window)
[kc_basis_nastart_bar0_2, kc_upper_nastart_bar0_2, kc_lower_nastart_bar0_2] = ta.kc(s_nastart_bar0_2, 14, 2.0, true)
plot(kc_basis_nastart_bar0_2, title="kc_basis_len14_mult2_nastart_bar0_2", display=display.data_window)
plot(kc_upper_nastart_bar0_2, title="kc_upper_len14_mult2_nastart_bar0_2", display=display.data_window)
plot(kc_lower_nastart_bar0_2, title="kc_lower_len14_mult2_nastart_bar0_2", display=display.data_window)
plot(ta.wpr(14), title="wpr_builtin_len14_clean", display=display.data_window)
wh_clean = false ? na : high
wl_clean = false ? na : low
wmax_clean = ta.highest(wh_clean, 14)
wmin_clean = ta.lowest(wl_clean, 14)
plot(100 * (s_clean - wmax_clean) / (wmax_clean - wmin_clean), title="wpr_formula_len14_clean", display=display.data_window)
wh_nahole_bar40_41 = hole ? na : high
wl_nahole_bar40_41 = hole ? na : low
wmax_nahole_bar40_41 = ta.highest(wh_nahole_bar40_41, 14)
wmin_nahole_bar40_41 = ta.lowest(wl_nahole_bar40_41, 14)
plot(100 * (s_nahole_bar40_41 - wmax_nahole_bar40_41) / (wmax_nahole_bar40_41 - wmin_nahole_bar40_41), title="wpr_formula_len14_nahole_bar40_41", display=display.data_window)
wh_nastart_bar0_2 = bar_index < 3 ? na : high
wl_nastart_bar0_2 = bar_index < 3 ? na : low
wmax_nastart_bar0_2 = ta.highest(wh_nastart_bar0_2, 14)
wmin_nastart_bar0_2 = ta.lowest(wl_nastart_bar0_2, 14)
plot(100 * (s_nastart_bar0_2 - wmax_nastart_bar0_2) / (wmax_nastart_bar0_2 - wmin_nastart_bar0_2), title="wpr_formula_len14_nastart_bar0_2", display=display.data_window)
f_rsi_adjacent(s) =>
    delta = ta.change(s)
    up = ta.rma(math.max(delta, 0.0), 14)
    down = ta.rma(math.max(-delta, 0.0), 14)
    100 - 100 / (1 + up / down)
plot(f_rsi_adjacent(s_clean), title="rsi_adjacent_rma_len14_clean", display=display.data_window)
plot(f_rsi_adjacent(s_nahole_bar40_41), title="rsi_adjacent_rma_len14_nahole_bar40_41", display=display.data_window)
plot(f_rsi_adjacent(s_nastart_bar0_2), title="rsi_adjacent_rma_len14_nastart_bar0_2", display=display.data_window)
plot((s_nahole_bar40_41 - ta.sma(s_nahole_bar40_41, 14)) / (0.015 * ta.dev(s_nahole_bar40_41, 14)), title="cci_formula_len14_nahole_bar40_41", display=display.data_window)
cm = ta.change(s_nahole_bar40_41)
cg = math.sum(cm >= 0 ? cm : 0.0, 14)
cl = math.sum(cm >= 0 ? 0.0 : -cm, 14)
plot(100 * (cg - cl) / (cg + cl), title="cmo_formula_len14_nahole_bar40_41", display=display.data_window)
plot(ta.sma(s_nahole_bar40_41, 14) + 2.0 * ta.stdev(s_nahole_bar40_41, 14, true), title="bb_upper_formula_len14_mult2_nahole_bar40_41", display=display.data_window)
plot(ta.ema(s_nahole_bar40_41, 14) + 2.0 * ta.ema(ta.tr, 14), title="kc_upper_formula_len14_mult2_tr_nahole_bar40_41", display=display.data_window)
plot(100 * (s_nahole_bar40_41 - ta.lowest(low, 14)) / (ta.highest(high, 14) - ta.lowest(low, 14)), title="stoch_formula_len14_srcnahole_bar40_41", display=display.data_window)
plot(4.0 * ta.stdev(s_clean, 14, true) / ta.sma(s_clean, 14), title="bbw_formula_len14_mult2_clean", display=display.data_window)
plot(4.0 * ta.ema(ta.tr, 14) / ta.ema(s_clean, 14), title="kcw_formula_len14_mult2_tr_clean", display=display.data_window)
plot(4.0 * ta.stdev(s_nahole_bar40_41, 14, true) / ta.sma(s_nahole_bar40_41, 14), title="bbw_formula_len14_mult2_nahole_bar40_41", display=display.data_window)
plot(4.0 * ta.ema(ta.tr, 14) / ta.ema(s_nahole_bar40_41, 14), title="kcw_formula_len14_mult2_tr_nahole_bar40_41", display=display.data_window)
plot(4.0 * ta.stdev(s_nastart_bar0_2, 14, true) / ta.sma(s_nastart_bar0_2, 14), title="bbw_formula_len14_mult2_nastart_bar0_2", display=display.data_window)
plot(4.0 * ta.ema(ta.tr, 14) / ta.ema(s_nastart_bar0_2, 14), title="kcw_formula_len14_mult2_tr_nastart_bar0_2", display=display.data_window)
