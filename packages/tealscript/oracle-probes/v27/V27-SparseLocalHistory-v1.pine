//@version=6
indicator("V27 sparse local history v1", precision=16, max_bars_back=128)
sample(float source) =>
    var int invocation = 0
    invocation += 1
    float local = float(invocation) * 1000.0 + source
    [invocation, source, source[2], source[3], local, local[2], local[3]]
[denseCount, denseNow, denseArg2, denseArg3, denseLocal, denseLocal2, denseLocal3] = sample(float(bar_index) + 101.0)
maskA = bar_index % 3 == 0
maskB = bar_index % 5 == 1
float countA = na
float nowA = na
float arg2A = na
float arg3A = na
float localA = na
float local2A = na
float local3A = na
float countB = na
float nowB = na
float arg2B = na
float arg3B = na
float localB = na
float local2B = na
float local3B = na
if maskA
    [count, now, arg2, arg3, local, local2, local3] = sample(float(bar_index) + 201.0)
    countA := float(count)
    nowA := now
    arg2A := arg2
    arg3A := arg3
    localA := local
    local2A := local2
    local3A := local3
if maskB
    [count, now, arg2, arg3, local, local2, local3] = sample(float(bar_index) + 301.0)
    countB := float(count)
    nowB := now
    arg2B := arg2
    arg3B := arg3
    localB := local
    local2B := local2
    local3B := local3
plot(bar_index, "PineIndex")
plot(time, "TimeMs")
plot(maskA ? 1 : 0, "MaskA")
plot(maskB ? 1 : 0, "MaskB")
plot(denseCount, "DenseInvocation")
plot(denseNow, "DenseArgument")
plot(denseArg2, "DenseArgument2")
plot(denseArg3, "DenseArgument3")
plot(denseLocal, "DenseLocal")
plot(denseLocal2, "DenseLocal2")
plot(denseLocal3, "DenseLocal3")
plot(countA, "AInvocation")
plot(nowA, "AArgument")
plot(arg2A, "AArgument2")
plot(arg3A, "AArgument3")
plot(localA, "ALocal")
plot(local2A, "ALocal2")
plot(local3A, "ALocal3")
plot(countB, "BInvocation")
plot(nowB, "BArgument")
plot(arg2B, "BArgument2")
plot(arg3B, "BArgument3")
plot(localB, "BLocal")
plot(local2B, "BLocal2")
plot(local3B, "BLocal3")
