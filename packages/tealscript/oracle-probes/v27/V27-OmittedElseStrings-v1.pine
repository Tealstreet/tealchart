//@version=6
indicator("V27 dynamic omitted-else strings v1", precision=16)
inputEnabled = input.bool(false, "InputEnabled")
enabled = bar_index % 4 == 1
string direct = if enabled
    "chosen"
string inputResult = if inputEnabled
    "chosen"
chooseString(bool condition) =>
    string result = if condition
        "chosen"
    result
string functionResult = chooseString(enabled)
string explicitEmpty = if enabled
    "chosen"
else
    ""
string explicitMissing = if enabled
    "chosen"
else
    na
plot(bar_index, "PineIndex")
plot(time, "TimeMs")
plot(enabled ? 1 : 0, "DynamicEnabled")
plot(inputEnabled ? 1 : 0, "InputEnabled")
plot(na(direct) ? 1 : 0, "DirectIsNa")
plot(direct == "" ? 1 : 0, "DirectIsEmpty")
plot(direct == "chosen" ? 1 : 0, "DirectIsChosen")
plot(str.length(direct), "DirectLength")
plot(na(inputResult) ? 1 : 0, "InputIsNa")
plot(inputResult == "" ? 1 : 0, "InputIsEmpty")
plot(str.length(inputResult), "InputLength")
plot(na(functionResult) ? 1 : 0, "FunctionIsNa")
plot(functionResult == "" ? 1 : 0, "FunctionIsEmpty")
plot(functionResult == "chosen" ? 1 : 0, "FunctionIsChosen")
plot(str.length(functionResult), "FunctionLength")
plot(na(explicitEmpty) ? 1 : 0, "EmptyControlIsNa")
plot(explicitEmpty == "" ? 1 : 0, "EmptyControlIsEmpty")
plot(str.length(explicitEmpty), "EmptyControlLength")
plot(na(explicitMissing) ? 1 : 0, "MissingControlIsNa")
plot(explicitMissing == "" ? 1 : 0, "MissingControlIsEmpty")
plot(str.length(explicitMissing), "MissingControlLength")
