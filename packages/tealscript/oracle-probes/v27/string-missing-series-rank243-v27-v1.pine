//@version=6
indicator("V26 string discriminator v1", precision=12)
int phase = bar_index % 32
series string missing = phase < 3 or (phase >= 10 and phase <= 15) ? string(na) : phase % 2 == 0 ? "" : "CONTROL"
series string copied = string(missing)
plot(phase, "INPUT_PHASE")
plot(na(missing) ? 1 : 0, "SOURCE_NA")
plot(na(copied) ? 1 : 0, "CAST_NA")
plot(na(missing) ? -1 : missing == "" ? 0 : 1, "SOURCE_KIND_NA_EMPTY_DEFINED")
plot(na(copied) ? -1 : copied == "" ? 0 : 1, "CAST_KIND_NA_EMPTY_DEFINED")
plot(str.length(copied), "CAST_LENGTH")
plot(1, "EXECUTION_CONTROL")
