//@version=5
indicator("V27 cross and bool change v5 D v1", precision=10, max_bars_back=64)
encode(bool value) =>
    na(value) ? -1 : value ? 1 : 0
phase = bar_index % 32
step = phase % 8
cleanA = step == 0 ? -2.0 : step == 1 ? -1.0 : step == 2 ? 0.0 : step == 3 ? 1.0 : step == 4 ? 2.0 : step == 5 ? 0.0 : step == 6 ? -1.0 : -2.0
holeA = phase == 9 or phase == 11 or phase == 12 or phase == 18 or phase >= 20 and phase <= 23
holeB = phase == 14 or phase == 17 or phase == 24 or phase == 25
sourceA = holeA ? na : cleanA
sourceB = holeB ? na : 0.0
var float lastValidA = na
var float lastValidB = na
validPair = not na(sourceA) and not na(sourceB)
bridgeUp = validPair and not na(lastValidA) and not na(lastValidB) and sourceA > sourceB and lastValidA <= lastValidB
bridgeDown = validPair and not na(lastValidA) and not na(lastValidB) and sourceA < sourceB and lastValidA >= lastValidB
rawUp = sourceA > sourceB and sourceA[1] <= sourceB[1]
rawDown = sourceA < sourceB and sourceA[1] >= sourceB[1]
up = ta.crossover(sourceA, sourceB)
down = ta.crossunder(sourceA, sourceB)
cross = ta.cross(sourceA, sourceB)
flag = sourceA > sourceB
changed1 = ta.change(flag, 1)
changed2 = ta.change(flag, 2)
if validPair
    lastValidA := sourceA
    lastValidB := sourceB
plot(float(bar_index), "INPUT_BAR_INDEX")
plot(float(phase), "INPUT_PHASE32")
plot(sourceA, "INPUT_A")
plot(sourceB, "INPUT_B")
plot(holeA ? 1 : 0, "INPUT_A_HOLE")
plot(holeB ? 1 : 0, "INPUT_B_HOLE")
plot(encode(up), "R391_R392_CROSSOVER_NAminus1_false0_true1")
plot(encode(rawUp), "R391_R392_MODEL_raw_adjacent_comparisons")
plot(encode(bridgeUp), "R391_R392_MODEL_lastvalid_pair_bridge")
plot(encode(down), "R399_R400_CROSSUNDER_NAminus1_false0_true1")
plot(encode(rawDown), "R399_R400_MODEL_raw_adjacent_comparisons")
plot(encode(bridgeDown), "R399_R400_MODEL_lastvalid_pair_bridge")
plot(encode(cross), "R655_CROSS_NAminus1_false0_true1")
plot(encode(up or down), "R655_MODEL_crossover_OR_crossunder")
plot(encode(bridgeUp or bridgeDown), "R655_MODEL_lastvalid_pair_bridge")
plot(encode(flag), "R459_BOOL_SOURCE_NAminus1_false0_true1")
plot(encode(changed1), "R459_CHANGE_BOOL_len1_hole_and_recovery")
plot(encode(changed2), "R459_CHANGE_BOOL_len2_hole_and_recovery")
plot(encode(flag != flag[1]), "R459_MODEL_raw_inequality_len1")
plot(encode(flag != flag[2]), "R459_MODEL_raw_inequality_len2")
plot(encode(ta.crossover(cleanA, 0.0)), "R391_R392_CLEAN_CONTROL_up")
plot(encode(ta.crossunder(cleanA, 0.0)), "R399_R400_CLEAN_CONTROL_down")
plot(encode(ta.cross(cleanA, 0.0)), "R655_CLEAN_CONTROL_cross")
plot(encode(ta.change(cleanA > 0.0, 2)), "R459_CLEAN_CONTROL_bool_change2")
