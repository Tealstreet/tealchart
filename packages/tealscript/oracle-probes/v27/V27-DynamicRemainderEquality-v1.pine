//@version=6
indicator("V27 dynamic remainder and equality v1", precision=16)
caseId = bar_index % 8
float dividend = switch caseId
    0 => 5.25
    1 => -5.25
    2 => 5.0
    3 => -5.0
    4 => 1000000000000.25
    5 => -1000000000000.25
    6 => 0.1 + 0.2
    => -(0.1 + 0.2)
float divisor = caseId == 0 or caseId == 3 or caseId == 4 ? 3.0 : caseId == 1 or caseId == 2 or caseId == 5 ? -3.0 : 0.3
nativeRemainder = dividend % divisor
float compound = dividend
compound %= divisor
floorModel = dividend - divisor * math.floor(dividend / divisor)
truncModel = dividend - divisor * int(dividend / divisor)
delta = float(bar_index % 11 - 5) * 0.0000000001
left = 1.0 + delta
right = 1.0
float seriesSum = 0.1 + 0.2 + float(bar_index) * 0.0
plot(bar_index, "PineIndex")
plot(time, "TimeMs")
plot(caseId, "CaseId")
plot(dividend, "Dividend")
plot(divisor, "Divisor")
plot(nativeRemainder, "NativeRemainder")
plot(compound, "CompoundRemainder")
plot(floorModel, "FloorModel")
plot(truncModel, "TruncModel")
plot(na(nativeRemainder) ? 1 : 0, "RemainderIsNa")
plot(nativeRemainder == compound ? 1 : 0, "CompoundEqualsDirect")
plot(delta, "EqualityDelta")
plot(left, "EqualityLeft")
plot(right, "EqualityRight")
plot(left == right ? 1 : 0, "DynamicEqual")
plot(0.1 + 0.2 == 0.3 ? 1 : 0, "ConstSumEqual")
plot(seriesSum == 0.3 ? 1 : 0, "SeriesSumEqual")
plot(seriesSum, "SeriesSum")
