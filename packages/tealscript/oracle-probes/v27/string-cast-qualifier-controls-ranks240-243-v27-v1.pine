//@version=6
indicator("V26 string discriminator v1", precision=12)
const string constSource = "CONTROL"
const string constCopy = string(constSource)
input string inputSource = input.string("CONTROL", "Defined input source")
input string inputCopy = string(inputSource)
simple string simpleSource = syminfo.tickerid
simple string simpleCopy = string(simpleSource)
series string seriesSource = bar_index % 2 == 0 ? "" : "CONTROL"
series string seriesCopy = string(seriesSource)
plot(constCopy == constSource ? 1 : 0, "CONST_DEFINED_CAST_CONTROL")
plot(inputCopy == inputSource ? 1 : 0, "INPUT_DEFINED_CAST_CONTROL")
plot(simpleCopy == simpleSource ? 1 : 0, "SIMPLE_DEFINED_CAST_CONTROL")
plot(seriesCopy == seriesSource ? 1 : 0, "SERIES_DEFINED_CAST_CONTROL")
string unqualifiedMissing = string(na)
plot(na(unqualifiedMissing) ? 1 : 0, "UNQUALIFIED_MISSING_NA")
plot(na(unqualifiedMissing) ? -1 : unqualifiedMissing == "" ? 0 : 1, "UNQUALIFIED_KIND_NA_EMPTY_DEFINED")
plot(na("") ? 1 : 0, "EMPTY_STRING_NA_CONTROL")
