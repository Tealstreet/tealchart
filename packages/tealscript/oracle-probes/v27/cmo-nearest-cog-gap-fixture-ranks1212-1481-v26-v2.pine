//@version=6
indicator("V26 cmo-nearest-cog G6 v2", precision=10, max_bars_back=64)
phase = bar_index % 32
source = phase < 3 ? na : phase <= 6 ? float(phase + 7) : phase >= 7 and phase <= 10 ? na : phase == 11 ? 13.0 : phase == 12 ? 12.0 : phase == 13 ? 13.0 : phase == 14 or phase == 15 ? 14.0 : phase == 16 ? na : phase >= 17 and phase <= 20 ? float(phase - 2) : phase >= 21 and phase <= 25 ? float(39 - phase) : phase >= 26 and phase <= 29 ? na : 11.0
rawChange = ta.change(source)
var float previousFinite = na
bridgeChange = not na(source) and not na(previousFinite) ? source - previousFinite : na
if not na(source)
    previousFinite := source
rawUp = math.sum(rawChange >= 0 ? rawChange : 0.0, 3)
rawDown = math.sum(rawChange >= 0 ? 0.0 : -rawChange, 3)
bridgeUp = math.sum(bridgeChange >= 0 ? bridgeChange : 0.0, 3)
bridgeDown = math.sum(bridgeChange >= 0 ? 0.0 : -bridgeChange, 3)
rawCmo = 100.0 * (rawUp - rawDown) / (rawUp + rawDown)
bridgeCmo = 100.0 * (bridgeUp - bridgeDown) / (bridgeUp + bridgeDown)
cmo = ta.cmo(source, 3)
sameValue(float left, float right) =>
    na(left) and na(right) or not na(left) and not na(right) and math.abs(left - right) <= 0.000000001
float rawNumerator = 0.0
float rawDenominator = 0.0
float validNumerator = 0.0
float validDenominator = 0.0
int rawCount = 0
int validCount = 0
float firstValid = na
float secondValid = na
float thirdValid = na
float rawMin = na
float rawMax = na
for age = 0 to 63
    value = source[age]
    if not na(value)
        if age < 3
            rawNumerator += value * (age + 1)
            rawDenominator += value
            rawCount += 1
            rawMin := na(rawMin) ? value : math.min(rawMin, value)
            rawMax := na(rawMax) ? value : math.max(rawMax, value)
        if validCount < 3
            if validCount == 0
                firstValid := value
            else if validCount == 1
                secondValid := value
            else
                thirdValid := value
            validNumerator += value * (validCount + 1)
            validDenominator += value
            validCount += 1
validMin = math.min(firstValid, math.min(secondValid, thirdValid))
validMax = math.max(firstValid, math.max(secondValid, thirdValid))
validMedian = firstValid + secondValid + thirdValid - validMin - validMax
rawMedian = source + source[1] + source[2] - rawMin - rawMax
rawNearest = rawCount == 3 ? rawMedian : rawCount > 0 ? rawMin : na
plot(cmo, "R1212_CMO_RAW_ADJACENT_OR_SKIP_HOLE")
plot((sameValue(cmo, rawCmo) ? 1 : 0) + (sameValue(cmo, bridgeCmo) ? 2 : 0), "R1214_CMO_RAW1_BRIDGED2_MATCH")
plot(ta.percentile_nearest_rank(source, 3, 40), "R1318_NEAREST_RAW_LENGTH_OR_NONNA_LENGTH")
plot(ta.cog(source, 3), "R1481_COG_RAW_OR_NONNA_WINDOW")
plot(rawCmo, "MODEL_CMO_RAW_ADJACENT")
plot(bridgeCmo, "MODEL_CMO_FINITE_BRIDGE")
plot(rawChange, "MODEL_RAW_CHANGE")
plot(bridgeChange, "MODEL_BRIDGED_CHANGE")
plot(rawCount == 3 ? rawMedian : na, "MODEL_NEAREST_STRICT_RAW3")
plot(rawNearest, "MODEL_NEAREST_SKIP_WITHIN_RAW3")
plot(validCount == 3 ? validMedian : na, "MODEL_NEAREST_LAST3_VALID")
plot(rawCount == 3 ? -rawNumerator / rawDenominator : na, "MODEL_COG_STRICT_RAW3")
plot(rawCount > 0 ? -rawNumerator / rawDenominator : na, "MODEL_COG_SKIP_RAW_PHYSICAL_WEIGHTS")
plot(validCount == 3 ? -validNumerator / validDenominator : na, "MODEL_COG_LAST3_VALID_COMPACT_WEIGHTS")
plot(float(rawCount), "MODEL_RAW3_COUNT")
plot(float(validCount), "MODEL_VALID3_COUNT")
plot(float(bar_index), "INPUT_BAR_INDEX")
plot(float(phase), "INPUT_PHASE32")
plot(source, "INPUT_SOURCE")
plot(na(source) ? 1 : 0, "INPUT_SOURCE_NA")
