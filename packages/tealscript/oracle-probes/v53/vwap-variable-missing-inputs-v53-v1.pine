//@version=6
indicator("V53 VWAP variable missing inputs", calc_bars_count=32)
var int sample = 0
sourceMissing = na(hlc3)
volumeMissing = na(volume)
inputMissing = sourceMissing or volumeMissing
vwapValue = ta.vwap
if barstate.isconfirmed
    log.info("sample={0}; hlc3={1}; volume={2}; sourceNA={3}; volumeNA={4}; vwap={5}", sample, str.tostring(hlc3), str.tostring(volume), str.tostring(sourceMissing), str.tostring(volumeMissing), str.tostring(vwapValue))
plot(hlc3, "INPUT_HLC3")
plot(sourceMissing ? 1 : 0, "SOURCE_NA")
plot(volumeMissing ? 1 : 0, "VOLUME_NA")
plot(inputMissing ? 1 : 0, "ELIGIBLE_MISSING_INPUT")
plot(not inputMissing and inputMissing[1] ? 1 : 0, "FINITE_AFTER_MISSING")
plot(vwapValue, "VWAP_VARIABLE")
plot(na(vwapValue) ? 1 : 0, "VWAP_NA")
plot(nz(vwapValue, 123456.0), "VWAP_NZ_SENTINEL")
plot(vwapValue[1], "PREVIOUS_VWAP")
plot(time_tradingday, "TRADING_DAY")
plot(open, "INPUT_OPEN")
plot(high, "INPUT_HIGH")
plot(low, "INPUT_LOW")
plot(close, "INPUT_CLOSE")
plot(volume, "INPUT_VOLUME")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
