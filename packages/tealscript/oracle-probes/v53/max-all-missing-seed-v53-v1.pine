//@version=6
indicator("V53 max all missing seed", calc_bars_count=32)
var int sample = 0
series float allMissing = na
delayedSource = sample < 3 ? float(na) : sample == 3 ? -2.0 : sample == 5 ? 4.0 : float(na)
allMissingMax = ta.max(allMissing)
delayedMax = ta.max(delayedSource)
finiteMax = ta.max(-2.0)
if barstate.isconfirmed
    log.info("sample={0}; allMissingSource={1}; allMissingMax={2}; delayedSource={3}; delayedMax={4}; finiteControl={5}", sample, str.tostring(allMissing), str.tostring(allMissingMax), str.tostring(delayedSource), str.tostring(delayedMax), str.tostring(finiteMax))
plot(allMissing, "ALL_MISSING_SOURCE")
plot(na(allMissing) ? 1 : 0, "SOURCE_NA")
plot(allMissingMax, "ALL_MISSING_MAX")
plot(na(allMissingMax) ? 1 : 0, "ALL_MISSING_MAX_NA")
plot(nz(allMissingMax, 123456.0), "ALL_MISSING_MAX_NZ_SENTINEL")
plot(delayedSource, "DELAYED_SOURCE_CONTROL")
plot(delayedMax, "DELAYED_MAX_CONTROL")
plot(na(delayedMax) ? 1 : 0, "DELAYED_MAX_NA_CONTROL")
plot(finiteMax, "FINITE_NEGATIVE_CONTROL")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
