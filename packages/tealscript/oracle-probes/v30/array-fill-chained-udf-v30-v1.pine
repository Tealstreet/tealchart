//@version=6
indicator("V30 chained array fill receiver")
copyFill(values) =>
    array.copy(values).fill(3)
    array.size(values)
partialFill(array<int> values) =>
    array.copy(values).fill(9, 1, 2)
    array.get(values, 1)
values = array.from(1, 2)
array.copy(values).fill(7, 0, 2)
plot(copyFill(values), "UDF_COPY_SIZE")
plot(partialFill(values), "UDF_ORIGINAL_SECOND")
plot(array.get(values, 0), "GLOBAL_ORIGINAL_FIRST")
plot(bar_index, "CHART_INDEX")
plot(time, "CHART_TIME_MS")
