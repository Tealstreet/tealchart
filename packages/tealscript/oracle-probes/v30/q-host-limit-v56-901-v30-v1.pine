//@version=5
indicator("Array methods fixture")
var persisted = array.new_float()
fresh = array.new_float(2, close)
var persisted_int = array.new_int()
fresh_int = array.new_int(2, bar_index)
var persisted_bool = array.new_bool()
fresh_bool = array.new_bool(2, close > open)
var persisted_string = array.new_string()
fresh_string = array.new_string(2, "seed")
var persisted_color = array.new_color()
fresh_color = array.new_color(2, color.red)

persisted.push(close)
fresh.push(high)
fresh.set(0, low)
persisted_int.push(bar_index)
fresh_int.push(10)
fresh_int.set(0, 3)
persisted_bool.push(bar_index == 0)
fresh_bool.push(true)
fresh_bool.set(0, false)
persisted_string.push("seed")
fresh_string.push("tail")
fresh_string.set(0, "head")
persisted_color.push(color.red)
fresh_color.push(color.green)
fresh_color.set(0, color.blue)

plot(persisted.size())
plot(persisted.get(0))
plot(fresh.get(0) + fresh.pop() + fresh.size())
empty_pop = array.new_float()
plot(na(empty_pop.pop()) and empty_pop.size() == 0 ? 1 : 0)
plot(persisted_int.size())
plot(persisted_int.get(0))
plot(fresh_int.get(0) + fresh_int.pop() + fresh_int.size())
plot(persisted_bool.size())
plot(persisted_bool.get(0) ? 1 : 0)
plot((fresh_bool.get(0) or fresh_bool.pop()) ? fresh_bool.size() : 0)
plot(persisted_string.size())
plot(persisted_string.get(0) == "seed" ? 1 : 0)
plot((fresh_string.get(0) == "head" and fresh_string.pop() == "tail") ? fresh_string.size() : 0)
plot(persisted_color.size())
plot(persisted_color.get(0) == color.red ? 1 : 0)
plot((fresh_color.get(0) == color.blue and fresh_color.pop() == color.green) ? fresh_color.size() : 0)
