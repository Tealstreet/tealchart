//@version=6
indicator("Guarded footprint ordered rows companion v1", precision=16)
logStart = input.int(0, "Log first Pine index", minval=0)
logEnd = input.int(31, "Log last Pine index", minval=0)
var int chartOrigin = time
emit = bar_index >= logStart and bar_index <= logEnd
num(float x) =>
    na(x) ? "null" : str.tostring(x, "0.################")
firstExecution() =>
    var int origin = time
    origin
if bar_index == logStart or barstate.islastconfirmedhistory
    log.info("CONTEXT ticker=" + syminfo.tickerid + " tf=" + timeframe.period + " timezone=" + syminfo.timezone + " session=" + syminfo.session + " currency=" + syminfo.currency + " mintick=" + str.tostring(syminfo.mintick) + " chartOrigin=" + str.tostring(chartOrigin))
rowLog(volume_row row, string role, int order) =>
    if na(row)
        log.info("{\"chartTime\":" + num(time) + ",\"role\":\"" + role + "\",\"order\":" + str.tostring(order) + ",\"missing\":true}")
    else
        log.info("{\"chartTime\":" + num(time) + ",\"role\":\"" + role + "\",\"order\":" + str.tostring(order) + ",\"missing\":false,\"up\":" + num(volume_row.up_price(row)) + ",\"down\":" + num(volume_row.down_price(row)) + ",\"buy\":" + num(volume_row.buy_volume(row)) + ",\"sell\":" + num(volume_row.sell_volume(row)) + ",\"total\":" + num(volume_row.total_volume(row)) + ",\"delta\":" + num(volume_row.delta(row)) + ",\"buyImbalance\":" + (volume_row.has_buy_imbalance(row) ? "true" : "false") + ",\"sellImbalance\":" + (volume_row.has_sell_imbalance(row) ? "true" : "false") + "}")
ticksPerRow = input.int(10, "Ticks Per Row", minval=1, maxval=100)
vaPercent = input.float(70, "Value Area %", minval=50, maxval=95)
imbalancePercent = input.float(300, "Imbalance Threshold %", minval=150, maxval=500)
minStackedRows = input.int(4, "Min Stacked Rows", minval=2, maxval=8)
minDensityPercent = input.float(40, "Min Imbalance Density %", minval=20, maxval=80)
minVolumeRatio = input.float(1.3, "Min Volume vs 20-SMA", minval=0.5, maxval=3.0)
minZoneCoverage = input.float(30, "Min Zone % of Bar Range", minval=10, maxval=80)
fp = request.footprint(ticksPerRow, vaPercent, imbalancePercent)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(last_bar_index, "CHART_LAST_INDEX", display=display.data_window)
plot(chartOrigin, "CHART_FIRST_EXECUTION_MS", display=display.data_window)
plot(open, "CHART_OPEN", display=display.data_window)
plot(high, "CHART_HIGH", display=display.data_window)
plot(low, "CHART_LOW", display=display.data_window)
plot(close, "CHART_CLOSE", display=display.data_window)
plot(volume, "CHART_VOLUME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
float rowCount = na
float totalBuy = na
float totalSell = na
float totalVolume = na
float totalDelta = na
int buyCount = 0
int sellCount = 0
int buyStreak = 0
int sellStreak = 0
int maxBuy = 0
int maxSell = 0
if not na(fp)
    rows = footprint.rows(fp)
    rowCount := array.size(rows)
    totalBuy := footprint.buy_volume(fp)
    totalSell := footprint.sell_volume(fp)
    totalVolume := footprint.total_volume(fp)
    totalDelta := footprint.delta(fp)
    if emit
        rowLog(footprint.poc(fp), "POC", -1)
        rowLog(footprint.vah(fp), "VAH", -1)
        rowLog(footprint.val(fp), "VAL", -1)
        rowLog(footprint.get_row_by_price(fp, close), "CLOSE_SELECTED", -1)
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            row = array.get(rows, i)
            if emit
                rowLog(row, "ORDERED", i)
            if volume_row.has_buy_imbalance(row)
                buyCount += 1
                buyStreak += 1
                sellStreak := 0
            else
                maxBuy := math.max(maxBuy, buyStreak)
                buyStreak := 0
            if volume_row.has_sell_imbalance(row)
                sellCount += 1
                sellStreak += 1
                buyStreak := 0
            else
                maxSell := math.max(maxSell, sellStreak)
                sellStreak := 0
    maxBuy := math.max(maxBuy, buyStreak)
    maxSell := math.max(maxSell, sellStreak)
if emit
    log.info("{\"chartTime\":" + num(time) + ",\"barIndex\":" + str.tostring(bar_index) + ",\"footprintMissing\":" + (na(fp) ? "true" : "false") + ",\"expectedOrderedRows\":" + num(rowCount) + "}")
plot(na(fp) ? 1 : 0, "FP_NA", display=display.data_window)
plot(rowCount, "ROW_COUNT", display=display.data_window)
plot(totalBuy, "FP_BUY", display=display.data_window)
plot(totalSell, "FP_SELL", display=display.data_window)
plot(totalVolume, "FP_TOTAL", display=display.data_window)
plot(totalDelta, "FP_DELTA", display=display.data_window)
plot(buyCount, "BUY_IMBALANCE_COUNT", display=display.data_window)
plot(sellCount, "SELL_IMBALANCE_COUNT", display=display.data_window)
plot(maxBuy, "MAX_BUY_STREAK", display=display.data_window)
plot(maxSell, "MAX_SELL_STREAK", display=display.data_window)
volumeSma = ta.sma(volume, 20)
volumeRatio = volumeSma > 0 ? volume / volumeSma : 1.0
plot(volumeSma, "VOLUME_SMA20", display=display.data_window)
plot(volumeRatio, "VOLUME_RATIO", display=display.data_window)
buyDensity = rowCount > 0 ? buyCount / rowCount * 100 : 0
sellDensity = rowCount > 0 ? sellCount / rowCount * 100 : 0
zoneCoverage = high > low ? math.max(maxBuy, maxSell) * ticksPerRow * syminfo.mintick / (high - low) * 100 : 0
buySignal = not na(fp) and maxBuy >= minStackedRows and close > open and buyDensity >= minDensityPercent and zoneCoverage >= minZoneCoverage and volumeRatio >= minVolumeRatio
sellSignal = not na(fp) and maxSell >= minStackedRows and close < open and sellDensity >= minDensityPercent and zoneCoverage >= minZoneCoverage and volumeRatio >= minVolumeRatio
plot(buyDensity, "BUY_DENSITY", display=display.data_window)
plot(sellDensity, "SELL_DENSITY", display=display.data_window)
plot(zoneCoverage, "ZONE_COVERAGE", display=display.data_window)
plot(buySignal ? 1 : 0, "BUY_SIGNAL", display=display.data_window)
plot(sellSignal ? 1 : 0, "SELL_SIGNAL", display=display.data_window)
