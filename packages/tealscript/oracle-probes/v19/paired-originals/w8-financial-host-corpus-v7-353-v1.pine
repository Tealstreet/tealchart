//@version=6
indicator("All: Valuation Ratios + Vol", overlay=true)

// ════════════════════════════════════════════════════════════════════════
// ABOUT THIS FILE
// ════════════════════════════════════════════════════════════════════════
// One indicator combining fundamentals (Debt/EBITDA, EV/EBITDA, FCF Yield,
// Revenue Growth) with a relative-volume signal (D_RVol) in a SINGLE table.
//
// D_RVol is an informational row only — it does NOT feed into the 0-5
// fundamentals score shown in the status box (that score stays purely
// Debt/EBITDA + EV/EBITDA + FCF Yield [+ optional Revenue Growth]).
// Volume is a short-term technical signal on a different time scale than a
// fundamentals verdict, so mixing them into one number would make the score
// harder to interpret rather than more accurate.
//
// ── v-next: TABLE ENHANCEMENT ───────────────────────────────────────────
// Scoring logic is UNCHANGED (same weights: Debt 0-3, EV 0-2, FCF 0-3,
// optional Growth 0-2, same 0-5 banding). What changed is presentation and
// configurability:
//
//   VISUAL
//   • One unified header for the whole table instead of a volume block
//     floating above a separate fundamentals header.
//   • Title band showing the ticker, so screenshots are self-documenting.
//   • Continuous red→amber→green gradient on Value cells (color.from_gradient
//     on the metric's score fraction) instead of three flat buckets — a
//     Debt/EBITDA of 2.1 and 3.9 no longer look identical.
//   • Neutral slate for N/A instead of red: missing data is not bad data.
//   • Real typographic hierarchy via text_formatting=text.format_bold on the
//     header, Value column and score footer; metric labels and history
//     columns are dimmed so the eye lands on the current value first.
//   • Optional ▰▱ score meter in the Verdict column — shows how much of each
//     metric's max points was earned, which the ✅/❌ icon alone can't.
//   • Optional score footer row inside the table, so the whole verdict can
//     live in one object if you'd rather drop the floating box.
//   • Rows are built on barstate.islast with a dynamic row counter rather
//     than fixed indices, so hiding a row leaves no gap.
//
//   CONFIG
//   • Table position, text size, theme (Dark / Midnight / Light).
//   • Show/hide: title band, 2Y & NY history columns, score meter, D_RVol
//     row, Revenue row, in-table footer, floating score box (+ its position).
//   • Every threshold is now an input: Debt/EBITDA, EV/EBITDA, FCF Yield,
//     Revenue CAGR bands, and the D_RVol ACTIF/NORMAL multipliers. Labels,
//     colors, tooltips and the score all read from the same inputs, so they
//     can never drift apart.
//
// ── v-next+1: CALCULATION FIXES ─────────────────────────────────────────
// Three defects that changed what the table reported. Each is marked FIX #n
// at its site.
//
//   FIX #1 — EV/EBITDA history was measured in BARS, not years.
//     The array was gated on `ta.change(evEBITDA) != 0`, but evEBITDA depends
//     on `close`, which moves every bar, so it captured the last 11 bars. The
//     "2Y" and "5Y" EV/EBITDA columns were showing the multiple from 2 and 5
//     BARS ago. History is now committed on fiscal-year events derived from
//     the raw financial fields, which carry no price dependency.
//
//   FIX #2 — A missing Net Debt figure was treated as zero.
//     `nz(netDebt, 0)` collapsed EV to market cap, understating EV and
//     scoring the symbol "Cheap" precisely when the data was absent. Missing
//     net debt now yields N/A.
//
//   FIX #3 — N/A metrics were scored as zero instead of being excluded.
//     The denominator was a fixed 8 regardless of coverage, so a symbol with
//     no fundamentals at all scored 0/8 and read "⛔ Avoid". The score now
//     normalises over the metrics that resolved, coverage is displayed, and
//     a verdict is withheld below a configurable minimum.
//
//   FIX #4 — The Revenue verdict described a number that wasn't on screen.
//     Value showed 1Y YoY while the icon, label, score and cell colour all
//     came from the N-year CAGR, so "-12.00%  📈 Steady" on green was a
//     normal sight. The basis is now an explicit input, the verdict is
//     tagged with it, and the gradient moves onto the column that figure
//     actually occupies.
//
// ── v-next+2: DATA-VINTAGE FIXES (findings 5-9) ─────────────────────────
//   #5 and #7 were already closed as side effects of FIX #1 — the explicit
//   previous-value tracking captures the first fiscal year that ta.change()
//   used to drop, and the settle-window commit collapses a report that
//   publishes across several bars into one aligned history entry.
//
//   FIX #6 — Fiscal history depth depends on how much CHART is loaded, since
//     the arrays are built by walking bars. Pine cannot reach fiscal data
//     outside the loaded range, so this is surfaced rather than silently
//     absorbed: the title band reports years loaded and warns when the
//     lookback needs more.
//
//   FIX #8 — The Value column divided a live price by last-fiscal-year
//     figures: a share count that missed every buyback since, and
//     trailing-fiscal-year rather than trailing-twelve-month earnings. Flow
//     items now come from TTM and balance-sheet items from the latest
//     quarter, falling back to FY where those aren't published.
//
//   FIX #9 — request.financial reports in the company's currency while
//     `close` is in the chart's. Pine doesn't expose the statement currency,
//     so it's a declared input; everything is then converted into the chart
//     currency, and an unresolvable pair yields N/A rather than a silent 1.0.
//
// ── OPACITY ─────────────────────────────────────────────────────────────
// If the table ever looks see-through, the cause is almost never the drawing
// code — it is a colour carrying alpha. Every background is therefore forced
// through solid() at the point it is DEFINED, which strips whatever alpha the
// source had: theme constants, colour inputs, and color.from_gradient output
// alike. `Table Transparency` (default 0) is the single place that decides it.
//
// The trap worth knowing: TRADINGVIEW KEEPS YOUR SAVED INPUT VALUES WHEN A
// SCRIPT IS UPDATED. Earlier versions of this file defaulted the frame colour
// to 100 transparency, so an instance already on a chart still carries that
// stored value no matter what the code now says. Forcing alpha at definition
// time fixes it without touching your settings — but if anything else still
// looks wrong, open the indicator's settings and use Defaults → Reset settings.
//
// ── v-next+3: BAND MECHANICS ────────────────────────────────────────────
//   • Boundary operators are uniform. FCF mixed `> 8`, `>= 6`, `> 3`, so
//     exactly 8.00% scored 2 rather than 3 and exactly 3.00% scored 0. One
//     rule now applies everywhere: THE THRESHOLD VALUE BELONGS TO THE BETTER
//     BAND — >= for higher-is-better, <= for lower-is-better.
//   • Threshold ordering is guarded. The chains evaluate top-down, so an
//     inverted pair made a band unreachable without any error. Values are
//     clamped monotonic and the adjustment is flagged in the title band.
//   • Integer division was already neutralised (`rawScore * 1.0 / maxRaw`).
//     Whether Pine truncates int/int is not something this file should
//     depend on; the cast costs nothing and removes the question.
//   • 5/5 is reachable again. The old scale needed 8/8, and 3 of those points
//     required a net-cash balance sheet, so any company carrying net debt
//     capped at 4/5 however cheap and cash-generative. Net Cash and Healthy
//     now both earn the row's full 2 points (the label still distinguishes
//     them) and the row max drops to 2. "Net Cash Required for Top Score"
//     restores the old 0-3 behaviour.
//
// Carried along, because the same code paths were involved: the first fiscal
// year on the chart is no longer dropped (`ta.change` is na on bar one, so
// the oldest year never entered the array), the three history arrays are now
// index-aligned so a missing year cannot shift the others, and the score
// percentage is forced to float division.
//
// NOT addressed here — these are data-vintage and methodology limits rather
// than defects, and are unchanged: FY (not TTM) figures against a live price,
// stale FY share counts in market cap, reporting-currency vs chart-currency
// mismatch on ADRs and converted charts, history depth depending on how many
// bars the chart has loaded, and D_RVol comparing a partial session against
// full sessions intraday.
// ════════════════════════════════════════════════════════════════════════


// ┌──────────────────────────────────────────────────────────────────────┐
// │  INPUTS                                                              │
// └──────────────────────────────────────────────────────────────────────┘
// NOTE: group/options/tooltip on input.* require const strings, so these
// group names are plain assignments (NOT `var`, which would make them series).
G_SCORE = "① Score & Growth"
G_TH    = "② Thresholds"
G_VOL   = "③ D_RVol (Daily Relative Volume)"
G_TBL   = "④ Table Appearance"
G_DATA  = "⑤ Data Handling"

// ── Score & growth ──
lookbackYears = input.int(5, "Growth Lookback (Years)", minval=1, maxval=10, group=G_SCORE, tooltip="Number of fiscal years back used for the average annual growth (CAGR) shown in the configurable growth column.")
weighGrowth   = input.bool(false, "Include Revenue Growth in Score", group=G_SCORE, tooltip="If enabled, adds 0-2 points (based on CAGR bands set in Thresholds) into the overall additive score, alongside Debt/EBITDA, EV/EBITDA and FCF Yield. Off by default so growth stays purely informational.")
netCashTop    = input.bool(false, "Net Cash Required for Top Score", group=G_SCORE, tooltip="OFF (default): Net Cash and Healthy both earn Debt/EBITDA's full 2 points, so the metric's max is 2 and a Healthy + Cheap + Cash Cow company reaches 100% and scores 5/5. The row label still says Net Cash vs Healthy, so nothing is hidden — only the points are equalised.\n\nON: the original 0-3 scale, where only a negative net-debt balance sheet earns 3. Because the top band needs 100%, ANY company carrying net debt then caps at 7/8 = 4/5, however cheap and cash-generative it is. That is a defensible purist stance, but it makes 5/5 unreachable for most quality businesses — which is why it is no longer the default.")
growthBasis   = input.string("Auto (longest available)", "Growth Basis for Verdict & Score", options=["Auto (longest available)", "1Y YoY", "2Y CAGR", "Lookback CAGR"], group=G_SCORE, tooltip="Which growth figure the Revenue verdict, icon and score are read from.\n\nAuto walks down to whatever history supports: Lookback CAGR → 2Y CAGR → 1Y YoY.\n\nWhichever you pick, that column is the one highlighted in the table and the verdict is tagged with it, so the label always describes a number you can see.")

// ── Thresholds (drive the score, the labels, the colors AND the tooltips) ──
thDebtHealthy  = input.float(2.0,  "Debt/EBITDA · Healthy up to",     step=0.5, minval=0, group=G_TH, tooltip="Net Debt / EBITDA under this value scores 2 points (Healthy). Negative net debt always scores 3 (Net Cash).")
thDebtModerate = input.float(4.0,  "Debt/EBITDA · Moderate up to",    step=0.5, minval=0, group=G_TH, tooltip="Between the Healthy threshold and this value scores 1 point. Above it scores 0 (High leverage).")
thEvCheap      = input.float(10.0, "EV/EBITDA · Cheap up to",         step=0.5, minval=0, group=G_TH, tooltip="EV / EBITDA under this value scores 2 points (Cheap).")
thEvFair       = input.float(15.0, "EV/EBITDA · Fair up to",          step=0.5, minval=0, group=G_TH, tooltip="Between the Cheap threshold and this value scores 1 point. Above it scores 0 (Expensive).")
thFcfCow       = input.float(8.0,  "FCF Yield % · Cash Cow from",   step=0.5, group=G_TH, tooltip="FCF Yield above this percentage scores 3 points.")
thFcfStrong    = input.float(6.0,  "FCF Yield % · Strong from",      step=0.5, group=G_TH, tooltip="FCF Yield at or above this percentage scores 2 points.")
thFcfDecent    = input.float(3.0,  "FCF Yield % · Decent from",     step=0.5, group=G_TH, tooltip="FCF Yield above this percentage scores 1 point. At or below it scores 0.")
thGrowthHigh   = input.float(15.0, "Revenue CAGR % · High from",    step=1.0, group=G_TH, tooltip="Revenue CAGR above this percentage scores 2 points (only counted if 'Include Revenue Growth in Score' is on).")
thGrowthSteady = input.float(5.0,  "Revenue CAGR % · Steady from",  step=1.0, group=G_TH, tooltip="Revenue CAGR above this percentage scores 1 point.")

// ── D_RVol ──
rvol_len         = input.int(20, "Volume Average Length (Days)", minval=1, group=G_VOL, tooltip="Number of preceding daily sessions averaged to build D_RVol's baseline. Today is excluded from its own average.")
rvol_threshold   = input.float(2.0, "ANOMALIE Threshold (x)", minval=0.5, step=0.1, group=G_VOL, tooltip="D_RVol at or above this multiple triggers the alert, the on-chart triangle and the ANOMALIE label.")
rvolActifMult    = input.float(0.6, "ACTIF Level (× threshold)",  minval=0.1, maxval=1.0, step=0.05, group=G_VOL, tooltip="Fraction of the ANOMALIE threshold above which volume reads as ACTIF (and the row icon turns ✅).")
rvolNormalMult   = input.float(0.4, "NORMAL Level (× threshold)", minval=0.05, maxval=1.0, step=0.05, group=G_VOL, tooltip="Fraction of the ANOMALIE threshold above which volume reads as NORMAL rather than SOMMEIL.")
alertOnlyHighTF  = input.bool(true, "Alerts Only on Daily/Weekly Charts", group=G_VOL, tooltip="When on, both the alert and the on-chart triangle marker only fire on Daily/Weekly charts, avoiding repeated alerts if you glance at a lower timeframe. When off, they fire on whatever timeframe you're viewing.")

// ── Table appearance ──
tblPosIn      = input.string("Bottom Right", "Table Position",    options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=G_TBL)
txtSize       = input.string("normal",       "Text Size",         options=["tiny","small","normal","large"], group=G_TBL)
themeIn       = input.string("Dark",         "Theme",             options=["Dark","Midnight","Light"], group=G_TBL)
showTitle     = input.bool(true,  "Show Title Band",              group=G_TBL, tooltip="A band above the header showing the ticker and the table name — useful when screenshotting.")
showHistory   = input.bool(true,  "Show 2Y / NY History Columns", group=G_TBL, tooltip="Turn off for a compact 3-column table (Metric / Value / Verdict). Hidden columns collapse to zero width.")
showMeter     = input.bool(true,  "Show Score Meter (▰▱)",        group=G_TBL, tooltip="Appends a filled/empty bar to the Verdict column showing points earned out of that metric's maximum.")
showRvolRow   = input.bool(true,  "Show D_RVol Row",              group=G_TBL)
showRevRow    = input.bool(true,  "Show Revenue Growth Row",      group=G_TBL)
showFooter    = input.bool(true,  "Show Score Footer in Table",   group=G_TBL, tooltip="Adds the total score as a colored band at the bottom of the main table.")
showStatusBox = input.bool(true,  "Show Floating Score Box",      group=G_TBL, tooltip="The separate score box. Turn off if you keep the footer above and want a single object on the chart.")
statusPosIn   = input.string("Top Right", "Floating Score Box Position", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=G_TBL)
frameColIn    = input.color(color.new(#8fa2c8, 0),   "Frame Color", group=G_TBL, tooltip="Outer frame of both tables. Opaque by default — raise the transparency if you want the frame to disappear into the chart.")
accentIn      = input.color(color.new(#2c4577, 0),   "Header Accent", group=G_TBL)
tableTransp   = input.int(0, "Table Transparency", minval=0, maxval=100, group=G_TBL, tooltip="0 = fully solid (default). Every background in both tables is forced through this value, so a colour picked with alpha — or an alpha value carried over from a previous version of this script in your saved settings — cannot leave the table see-through.\n\nNOTE: TradingView keeps your saved inputs when a script is updated. If this table looked transparent before, open the indicator's settings and use Defaults → Reset settings to clear stale colour values.")

// ── Data handling ──
currentBasis = input.string("TTM + latest quarter", "Current-Figure Basis", options=["TTM + latest quarter", "Fiscal year (FY)"], group=G_DATA, tooltip="Which vintage the Value column and the score are built from.\n\nTTM + latest quarter: flow items (EBITDA, FCF) come from the trailing twelve months and balance-sheet items (Net Debt, share count) from the most recent reported quarter. This is what screeners quote, and it stops a live price being divided by figures up to ~15 months old.\n\nFiscal year (FY): the previous behaviour — everything from the last completed fiscal year.\n\nEither way the 2Y / NY history columns and all growth figures stay strictly FY, because year-over-year comparisons need matching annual periods. Falls back to FY automatically when TTM/FQ data isn't published for the symbol.")
fxFinancials = input.string("", "Financials Currency (blank = same as chart)", group=G_DATA, tooltip="Currency the company REPORTS in, if it differs from the chart's quote currency — ADRs, dual listings, or any chart with TradingView's currency conversion switched on.\n\nEnter a code such as USD, EUR, JPY. All financial figures are then converted into the chart currency so market cap, EV/EBITDA and FCF Yield stay internally consistent. Leave blank when they already match.\n\nIf the FX pair can't be resolved the affected metrics go N/A rather than silently assuming a rate of 1.")
minMetrics   = input.int(2, "Minimum Metrics Required for a Verdict", minval=1, maxval=3, group=G_DATA, tooltip="How many of the three core metrics (Debt/EBITDA, EV/EBITDA, FCF Yield) must actually resolve before a score is shown.\n\nThe score is normalised over the metrics that HAVE data, so with only one metric a perfect result would read 5/5 on a single data point. This floor stops that: below it the verdict reads ❔ Insufficient Data instead of a number.")
fySettleBars = input.int(2, "Fiscal-Year Settle (bars)", minval=0, maxval=20, group=G_DATA, tooltip="After any financial field changes, wait this many bars before snapshotting the fiscal year into the history columns.\n\nThis lets fields that publish on slightly different bars all land before the year is recorded, so the 2Y / NY columns stay aligned across metrics. Raise it if history looks off by a year; lower it to 0 on very high timeframes where each bar is long.")

MAX_LOOKBACK = 10
MAX_HISTORY  = MAX_LOOKBACK + 1

// ── BOUNDARY RULE ──────────────────────────────────────────────────────
// One rule everywhere: THE THRESHOLD VALUE BELONGS TO THE BETTER BAND.
// Higher-is-better metrics compare with >=, lower-is-better with <=. The FCF
// bands used to mix `> 8`, `>= 6`, `> 3`, so exactly 8.00% scored 2 instead
// of 3 and exactly 3.00% scored 0 — two different meanings for the same
// on-screen number depending on which row you were reading.

// ── ORDERING GUARD ─────────────────────────────────────────────────────
// The band chains are evaluated top-down, so an out-of-order threshold does
// not error — it makes a band silently unreachable. Set FCF Strong above FCF
// Cash Cow and the "Strong" band can never be hit, because the Cash Cow test
// fires first. The thresholds are clamped into a monotonic order here and the
// adjustment is flagged on screen, rather than either erroring out or quietly
// scoring against a chain the settings don't describe.
thDebtHealthyEff  = thDebtHealthy
thDebtModerateEff = math.max(thDebtModerate, thDebtHealthy)
thEvCheapEff      = thEvCheap
thEvFairEff       = math.max(thEvFair, thEvCheap)
thFcfCowEff       = thFcfCow
thFcfStrongEff    = math.min(thFcfStrong, thFcfCow)
thFcfDecentEff    = math.min(thFcfDecent, math.min(thFcfStrong, thFcfCow))
thGrowthHighEff   = thGrowthHigh
thGrowthSteadyEff = math.min(thGrowthSteady, thGrowthHigh)

thresholdsAdjusted = thDebtModerateEff != thDebtModerate or thEvFairEff != thEvFair or thFcfStrongEff != thFcfStrong or thFcfDecentEff != thFcfDecent or thGrowthSteadyEff != thGrowthSteady

// Debt/EBITDA weight. With "Net Cash Required for Top Score" off, Net Cash and
// Healthy both earn the metric's full 2 points and the label keeps the
// distinction; the row max drops to 2 so a Healthy + Cheap + Cash Cow company
// can actually reach 100%. With it on, the old 0-3 scale returns and 5/5 stays
// reserved for net-cash balance sheets.
debtMaxPts = netCashTop ? 3 : 2

// Thresholds expressed as fractions where the underlying metric is a fraction.
fcfCow    = thFcfCowEff / 100.0
fcfStrong = thFcfStrongEff / 100.0
fcfDecent = thFcfDecentEff / 100.0

// Derived D_RVol levels — every label, color and tooltip reads from these, so
// "ANOMALIE" always means exactly what fires the alert.
rvolActifLvl  = rvol_threshold * rvolActifMult
rvolNormalLvl = rvol_threshold * rvolNormalMult


// ┌──────────────────────────────────────────────────────────────────────┐
// │  THEME                                                               │
// └──────────────────────────────────────────────────────────────────────┘
// Every background colour in this script passes through solid() exactly once,
// at the point it is DEFINED rather than where it is used. Two reasons:
//
//  1. Pine colours carry their own alpha. A colour input, a theme constant, or
//     an interpolation from color.from_gradient can each smuggle transparency
//     into a cell background, and one transparent cell is enough to make the
//     whole table look like it is floating over the candles.
//  2. TradingView PERSISTS SAVED INPUT VALUES ACROSS SCRIPT UPDATES. The frame
//     colour in earlier versions of this file defaulted to 100 transparency,
//     so simply changing the default in code does not fix an instance already
//     sitting on a chart — the old value is still stored. Forcing the alpha at
//     definition time overrides whatever was saved.
//
// Wrapping at definition rather than at each `bgcolor=` argument also means a
// new cell cannot be added later that quietly bypasses it.
solid(color c) => color.new(c, tableTransp)

// Text is forced to zero alpha unconditionally. It deliberately does NOT read
// tableTransp: making the fill translucent is a legitimate look, making the
// glyphs translucent never is, and a colour input set with alpha would
// otherwise render unreadable text over a perfectly solid cell.
ink(color c) => color.new(c, 0)

accentCol = solid(accentIn)
frameCol  = solid(frameColIn)

isLight = themeIn == "Light"
isMid   = themeIn == "Midnight"

COL_OUTER_BG  = solid(isLight ? color.new(#d7dbe6, 0) : isMid ? color.new(#04040c, 0) : color.new(#0a0a1a, 0))
COL_ROW_EVEN  = solid(isLight ? color.new(#ffffff, 0) : isMid ? color.new(#0e1428, 0) : color.new(#16213e, 0))
COL_ROW_ODD   = solid(isLight ? color.new(#eef1f7, 0) : isMid ? color.new(#131a33, 0) : color.new(#1c2541, 0))
COL_DIVIDER   = solid(isLight ? color.new(#b9c0d2, 0) : isMid ? color.new(#22305a, 0) : color.new(#2a3a5a, 0))
COL_BORDER_IN = solid(isLight ? color.new(#c8cede, 0) : color.new(#2a2a4a, 0))
COL_TITLE_BG  = solid(isLight ? color.new(#1c2541, 0) : color.new(#101a33, 0))

COL_TXT       = ink(isLight ? color.new(#12182b, 0) : color.new(#f0f0f0, 0))   // primary text
COL_TXT_DIM   = ink(isLight ? color.new(#5a6072, 0) : color.new(#9aa3b8, 0))   // labels / history columns
COL_TXT_ON_BG = ink(color.new(#ffffff, 0))                                 // text over score/title colors

// Score gradient endpoints — kept theme-independent so white text always reads.
COL_SCORE_BAD  = solid(color.new(#8c1f1f, 0))
COL_SCORE_MID  = solid(color.new(#8a7300, 0))
COL_SCORE_GOOD = solid(color.new(#1b5e20, 0))
COL_SCORE_NA   = solid(isLight ? color.new(#7d8496, 0) : color.new(#3a4157, 0))   // neutral: missing ≠ bad

// Title size is one step above the body size.
titleSize = txtSize == "tiny" ? "small" : txtSize == "small" ? "normal" : txtSize == "normal" ? "large" : "huge"


// ┌──────────────────────────────────────────────────────────────────────┐
// │  TABLES                                                              │
// └──────────────────────────────────────────────────────────────────────┘
posFromString(string s) =>
    s == "Top Left"      ? position.top_left      :
     s == "Top Center"    ? position.top_center    :
     s == "Top Right"     ? position.top_right     :
     s == "Middle Left"   ? position.middle_left   :
     s == "Middle Center" ? position.middle_center :
     s == "Middle Right"  ? position.middle_right  :
     s == "Bottom Left"   ? position.bottom_left   :
     s == "Bottom Center" ? position.bottom_center :
     position.bottom_right

// 7 columns: [0] left gutter, [1] Metric, [2] Value, [3] 2Y, [4] NY,
//            [5] Verdict, [6] right gutter.
// 14 rows is a ceiling — unused rows and columns are never written to, and
// Pine collapses unwritten rows/columns to zero size, so nothing is reserved.
// No table.merge_cells anywhere: full-width bands are drawn by giving every
// visible cell in the row the same bgcolor, which avoids the "cells already
// merged" runtime error when the table is repainted on every realtime tick.
// Both tables carry an explicit opaque bgcolor. Every cell is painted too, so
// nothing behind the table shows through: an unset cell background and an
// unset table background both render transparent in Pine, and either one
// would let candles bleed into the layout.
var table ratios = table.new(
     posFromString(tblPosIn), 7, 14,
     bgcolor       = COL_OUTER_BG,
     border_width  = 2,
     frame_width   = 2,
     frame_color   = frameCol,
     border_color  = COL_BORDER_IN,
     force_overlay = true
     )

var table ratiosStatus = table.new(
     posFromString(statusPosIn), 1, 1,
     bgcolor       = COL_OUTER_BG,
     border_width  = 2,
     frame_width   = 2,
     frame_color   = frameCol,
     border_color  = COL_BORDER_IN,
     force_overlay = true
     )


// ┌──────────────────────────────────────────────────────────────────────┐
// │  RENDER HELPERS                                                      │
// └──────────────────────────────────────────────────────────────────────┘
// Continuous red → amber → green ramp on the metric's score fraction, so
// near-misses and comfortable passes are visually distinct.
gradeColor(float frac) =>
    color out = COL_SCORE_NA
    if not na(frac)
        f = math.max(0.0, math.min(1.0, frac))
        out := f < 0.5 ? color.from_gradient(f, 0.0, 0.5, COL_SCORE_BAD, COL_SCORE_MID) : color.from_gradient(f, 0.5, 1.0, COL_SCORE_MID, COL_SCORE_GOOD)
    solid(out)

meterStr(int score, int maxScore) =>
    string s = ""
    if maxScore > 0
        for i = 0 to maxScore - 1
            s := s + (i < score ? "▰" : "▱")
    s

starsFilled(int filled) =>
    string stars = ""
    for i = 0 to 4
        stars := stars + (i < filled ? "★" : "☆")
    stars

// Paints every VISIBLE cell of a row with one background — the merge-free way
// to draw a full-width band. Columns 3/4 are skipped when history is hidden so
// they stay collapsed.
fillBand(int row, color bg) =>
    table.cell(ratios, 0, row, "", bgcolor=bg)
    table.cell(ratios, 1, row, "", bgcolor=bg)
    table.cell(ratios, 2, row, "", bgcolor=bg)
    if showHistory
        table.cell(ratios, 3, row, "", bgcolor=bg)
        table.cell(ratios, 4, row, "", bgcolor=bg)
    table.cell(ratios, 5, row, "", bgcolor=bg)
    table.cell(ratios, 6, row, "", bgcolor=bg)

thinRow(int row, color bg) =>
    table.cell(ratios, 0, row, "", bgcolor=bg, height=1)
    table.cell(ratios, 1, row, "", bgcolor=bg, height=1)
    table.cell(ratios, 2, row, "", bgcolor=bg, height=1)
    if showHistory
        table.cell(ratios, 3, row, "", bgcolor=bg, height=1)
        table.cell(ratios, 4, row, "", bgcolor=bg, height=1)
    table.cell(ratios, 5, row, "", bgcolor=bg, height=1)
    table.cell(ratios, 6, row, "", bgcolor=bg, height=1)

// One metric row. `scoreCol` says which column holds the figure the score was
// derived from — that cell gets the gradient and the bold, the rest stay plain.
// For every row except Revenue this is the Value column; Revenue can point it
// at a history column (see FIX #4). If the history columns are hidden there is
// nowhere else to put it, so it falls back to Value — and the Revenue row
// compensates by showing the scored figure there instead of the 1Y one.
drawRow(int row, string label, string valTxt, string txt2y, string txtNy, string verdict, color valBg, color rowBg, string tip, int scoreCol) =>
    sc = showHistory ? scoreCol : 2
    table.cell(ratios, 0, row, "", bgcolor=COL_OUTER_BG)
    table.cell(ratios, 1, row, label, bgcolor=rowBg, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=tip)
    table.cell(ratios, 2, row, valTxt, bgcolor = sc == 2 ? valBg : rowBg, text_color = sc == 2 ? COL_TXT_ON_BG : COL_TXT, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=tip)
    if showHistory
        table.cell(ratios, 3, row, txt2y, bgcolor = sc == 3 ? valBg : rowBg, text_color = sc == 3 ? COL_TXT_ON_BG : COL_TXT_DIM, text_size=txtSize, text_halign=text.align_right, text_formatting = sc == 3 ? text.format_bold : text.format_none, tooltip=tip)
        table.cell(ratios, 4, row, txtNy, bgcolor = sc == 4 ? valBg : rowBg, text_color = sc == 4 ? COL_TXT_ON_BG : COL_TXT_DIM, text_size=txtSize, text_halign=text.align_right, text_formatting = sc == 4 ? text.format_bold : text.format_none, tooltip=tip)
    table.cell(ratios, 5, row, verdict, bgcolor=rowBg, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=tip)
    table.cell(ratios, 6, row, "", bgcolor=COL_OUTER_BG)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  CALCULATIONS: VALUATION RATIOS                                      │
// └──────────────────────────────────────────────────────────────────────┘
// ── RAW SERIES ─────────────────────────────────────────────────────────
// The FY set is the annual backbone: every history column, every CAGR and the
// fiscal-year event detector read from it, because year-over-year comparisons
// need matching annual periods on both ends.
netDebtFY = request.financial(syminfo.tickerid, "NET_DEBT", "FY")
ebitdaFY  = request.financial(syminfo.tickerid, "EBITDA", "FY")
fcfFY     = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "FY")
sharesFY  = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FY")
revenueFY = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FY")

// FIX #8 — Fresher current figures.
// Every ratio in the Value column used to divide a LIVE price by figures from
// the last completed fiscal year: a share count up to ~15 months stale (so
// market cap missed every buyback and raise since) and trailing-fiscal-year
// rather than trailing-twelve-month earnings. Flow items now come from TTM
// and balance-sheet items from the latest reported quarter, each falling back
// to FY when the fresher period is unavailable — common outside the US.
ebitdaTTM  = request.financial(syminfo.tickerid, "EBITDA", "TTM")
fcfTTM     = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "TTM")
netDebtFQ  = request.financial(syminfo.tickerid, "NET_DEBT", "FQ")
sharesFQ   = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ")

coalesce(float a, float b) => na(a) ? b : a

useFresh   = currentBasis == "TTM + latest quarter"
netDebtSel = useFresh ? coalesce(netDebtFQ, netDebtFY) : netDebtFY
ebitdaSel  = useFresh ? coalesce(ebitdaTTM, ebitdaFY)  : ebitdaFY
fcfSel     = useFresh ? coalesce(fcfTTM, fcfFY)        : fcfFY
sharesSel  = useFresh ? coalesce(sharesFQ, sharesFY)   : sharesFY

// True only when the fresher period actually resolved, so the on-screen basis
// tag reports what is really being used rather than what was requested.
freshLive = useFresh and (not na(ebitdaTTM) or not na(netDebtFQ) or not na(sharesFQ))


// ── FIX #9: CURRENCY ───────────────────────────────────────────────────
// request.financial returns the company's REPORTING currency; `close` is in
// the chart's quote currency. For an ADR, a dual listing, or any chart with
// TradingView's currency conversion switched on, `shares * close` mixed two
// currencies and produced a nonsense market cap — and therefore nonsense
// EV/EBITDA and FCF Yield. (Debt/EBITDA was always safe: both sides come from
// the statements, so the units cancel.)
//
// Pine does not expose the statement currency, so this cannot be detected
// automatically — you tell it, and everything is converted INTO the chart
// currency so all three ratios stay internally consistent. Share count is a
// count and is never converted.
//
// If the FX pair can't be resolved the rate is na and the affected metrics go
// N/A rather than quietly falling back to 1.0, which would be the same
// "missing data reads as a real number" failure as the old nz(netDebt, 0).
fxNeeded = str.length(fxFinancials) > 0 and fxFinancials != syminfo.currency
fxPair   = fxNeeded ? fxFinancials + syminfo.currency : syminfo.tickerid
fxRaw    = request.security(fxPair, "D", close, ignore_invalid_symbol = true)
fxRate   = fxNeeded ? fxRaw : 1.0
fxBroken = fxNeeded and na(fxRate)

conv(float v) => (na(v) or na(fxRate)) ? na : v * fxRate

netDebt = conv(netDebtSel)
ebitda  = conv(ebitdaSel)
fcf     = conv(fcfSel)
shares  = sharesSel

netDebtFYc = conv(netDebtFY)
ebitdaFYc  = conv(ebitdaFY)
revenueFYc = conv(revenueFY)

// Growth is measured FY-to-FY on both ends regardless of the basis above:
// comparing a TTM figure against a completed fiscal year would not be a
// growth rate at all.
revenue = revenueFYc

fcfPS         = (na(shares) or shares == 0) ? na : fcf / shares
netDebtEBITDA = (na(ebitda) or ebitda == 0) ? na : netDebt / ebitda
fcfYield      = (na(close)  or close == 0)  ? na : fcfPS / close

marketCap     = (na(shares) or na(close)) ? na : shares * close

// FIX #2 — Missing Net Debt is NOT zero.
// The old `marketCap + nz(netDebt, 0)` silently collapsed EV to market cap
// whenever TradingView had no NET_DEBT for the symbol (common for banks and
// financials). That UNDERSTATES EV, which pushes EV/EBITDA down into the
// "Cheap" band — i.e. missing data was being read as a bullish signal, and
// isEvNA never caught it because it only tested EBITDA. Now a missing net
// debt figure propagates to N/A, which (with FIX #3) removes the metric from
// the score entirely instead of awarding it points.
derivedEV     = (na(marketCap) or na(netDebt)) ? na : marketCap + netDebt
evEBITDA      = (na(ebitda) or ebitda == 0 or na(derivedEV)) ? na : derivedEV / ebitda

// Strictly-FY variants, used only to fill the 2Y / NY history columns. The
// Value column may be running on TTM + latest quarter, but a history column
// has to be a like-for-like annual series or the years aren't comparable to
// each other.
marketCapFY   = (na(sharesFY) or na(close)) ? na : sharesFY * close
derivedEVFY   = (na(marketCapFY) or na(netDebtFYc)) ? na : marketCapFY + netDebtFYc
ndEbitdaFYval = (na(ebitdaFYc) or ebitdaFYc == 0) ? na : netDebtFYc / ebitdaFYc
evEbitdaFYval = (na(ebitdaFYc) or ebitdaFYc == 0 or na(derivedEVFY)) ? na : derivedEVFY / ebitdaFYc


// ── FISCAL-YEAR HISTORY ────────────────────────────────────────────────
// FIX #1 — History is now keyed on FISCAL-YEAR events, not on value changes.
//
// The old code pushed evEBITDA whenever `ta.change(evEBITDA) != 0`. But
// evEBITDA derives from marketCap = shares * close, and `close` moves every
// bar — so the condition was true on virtually every bar and the array held
// the last 11 BARS, not the last 11 fiscal years. The "2Y" and "5Y" EV/EBITDA
// columns were showing the multiple from 2 and 5 bars ago.
//
// Instead we detect a change in any RAW financial field (none of which depend
// on price), wait `fySettleBars` for fields that publish on slightly offset
// bars to all land, then snapshot all three metrics in one commit. Because
// every array is pushed by the same commit, they stay index-aligned: index
// k is the same fiscal year in all three, and a metric that was missing that
// year is stored as na rather than skipped — a skip would silently shift
// every older year by one.
//
// Side effect: this also fixes the dropped first year. `ta.change()` returns
// na on the first bar (nothing to compare against), so `na != 0` was falsy
// and the fiscal year in effect at chart start was never recorded. The
// explicit previous-value tracking below fires on that first value too.
//
// Note on meaning: a stored evEBITDA is the multiple AS OF that report date —
// that year's EBITDA against the share price at the time. That is the correct
// historical reading; there is no way to reconstruct it from FY data alone.

// The detector watches the RAW, UNCONVERTED FY fields. Watching the converted
// ones would make the FX rate a trigger, and an FX rate moves every day —
// which is exactly the bug FIX #1 removed, reintroduced through the back door.
fieldChanged(float cur, float prev) => not na(cur) and (na(prev) or cur != prev)

var float prevRevenue = na
var float prevEbitda  = na
var float prevNetDebt = na
var float prevFcf     = na
var float prevShares  = na

fyEvent = fieldChanged(revenueFY, prevRevenue) or fieldChanged(ebitdaFY, prevEbitda) or fieldChanged(netDebtFY, prevNetDebt) or fieldChanged(fcfFY, prevFcf) or fieldChanged(sharesFY, prevShares)

if fyEvent
    prevRevenue := revenueFY
    prevEbitda  := ebitdaFY
    prevNetDebt := netDebtFY
    prevFcf     := fcfFY
    prevShares  := sharesFY

// -1 = idle. Any field change restarts the countdown; the commit happens on
// the bar the countdown reaches 0, so a report that trickles in over several
// bars produces exactly one history entry.
var int fyCountdown = -1
if fyEvent
    fyCountdown := fySettleBars
else if fyCountdown > 0
    fyCountdown := fyCountdown - 1

commitFY = fyCountdown == 0

var float[] revHistory      = array.new_float(0)
var float[] ndEbitdaHistory = array.new_float(0)
var float[] evEbitdaHistory = array.new_float(0)

if commitFY
    fyCountdown := -1
    array.push(revHistory,      revenueFYc)
    array.push(ndEbitdaHistory, ndEbitdaFYval)
    array.push(evEbitdaHistory, evEbitdaFYval)
    if array.size(revHistory) > MAX_HISTORY
        array.shift(revHistory)
        array.shift(ndEbitdaHistory)
        array.shift(evEbitdaHistory)

revHistSize      = array.size(revHistory)
ndEbitdaHistSize = array.size(ndEbitdaHistory)
evEBITDAHistSize = array.size(evEbitdaHistory)

getPastValue(float[] hist, int histSize, int lookback) =>
    lookback >= 0 and histSize > lookback ? array.get(hist, histSize - 1 - lookback) : na

// While a commit is pending (inside the settle window) the newest fiscal year
// is not in the arrays yet, so the array top is already one year back and
// every lookback shifts down by one. Outside the window the top holds the
// current year. Without this the few bars right after a report would compare
// the new year against the year before last and label it "1Y".
fyLag = fyCountdown >= 0 ? 0 : 1

revenuePast1y  = getPastValue(revHistory, revHistSize, fyLag)
revenuePast2y  = getPastValue(revHistory, revHistSize, fyLag + 1)
revenuePastN   = getPastValue(revHistory, revHistSize, fyLag + lookbackYears - 1)

ndEbitdaPast2y = getPastValue(ndEbitdaHistory, ndEbitdaHistSize, fyLag + 1)
ndEbitdaPastN  = getPastValue(ndEbitdaHistory, ndEbitdaHistSize, fyLag + lookbackYears - 1)

evEbitdaPast2y = getPastValue(evEbitdaHistory, evEBITDAHistSize, fyLag + 1)
evEbitdaPastN  = getPastValue(evEbitdaHistory, evEBITDAHistSize, fyLag + lookbackYears - 1)

// FIX #6 — Chart-history dependence is now visible instead of silent.
//
// These arrays are filled by walking the chart's own bars, so the depth of
// available fiscal history is a property of HOW MUCH CHART IS LOADED, not of
// the company. On a 15-minute chart spanning a few months there may be zero
// fiscal-year transitions, and the 2Y / NY columns quietly read "—" exactly
// as they would for a genuinely young company. Worse, with growth in the
// score and the basis on Auto, the total score used to change when you
// switched timeframes while nothing about the business changed.
//
// This cannot be fixed by computing harder — Pine has no access to fiscal
// data outside the loaded range. So it is surfaced: the title band reports
// how many fiscal years are actually loaded, and warns when that is fewer
// than the lookback needs. Selecting an explicit growth basis (FIX #4)
// rather than Auto also stops the silent substitution.
fyYearsLoaded  = revHistSize
fyYearsNeeded  = lookbackYears + 1
historyShort   = fyYearsLoaded < fyYearsNeeded
historyTag     = (historyShort ? "⚠ " : "") + str.tostring(fyYearsLoaded) + " FY"

calcCAGR(float current, float past, int years) =>
    (na(current) or na(past) or past <= 0 or current <= 0) ? na : (math.pow(current / past, 1.0 / years) - 1) * 100

revenueGrowth1y = (na(revenue) or na(revenuePast1y) or revenuePast1y <= 0 or revenue <= 0) ? na : (revenue - revenuePast1y) / revenuePast1y * 100
revenueCAGR2y   = calcCAGR(revenue, revenuePast2y, 2)
revenueCAGRNy   = calcCAGR(revenue, revenuePastN, lookbackYears)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  SCORING (unchanged weights: Debt 0-3 · EV 0-2 · FCF 0-3 · Growth 0-2)│
// └──────────────────────────────────────────────────────────────────────┘
netDebtScore = 0
if na(netDebtEBITDA) or ebitda <= 0
    netDebtScore := 0
else if netDebtEBITDA <= 0
    netDebtScore := debtMaxPts
else if netDebtEBITDA <= thDebtHealthyEff
    netDebtScore := 2
else if netDebtEBITDA <= thDebtModerateEff
    netDebtScore := 1
else
    netDebtScore := 0

evEBITDAScore = 0
if na(evEBITDA) or ebitda <= 0
    evEBITDAScore := 0
else if evEBITDA <= thEvCheapEff
    evEBITDAScore := 2
else if evEBITDA <= thEvFairEff
    evEBITDAScore := 1
else
    evEBITDAScore := 0

fcfYieldScore = 0
if na(fcfYield)
    fcfYieldScore := 0
else if fcfYield >= fcfCow
    fcfYieldScore := 3
else if fcfYield >= fcfStrong
    fcfYieldScore := 2
else if fcfYield >= fcfDecent
    fcfYieldScore := 1
else
    fcfYieldScore := 0

isDebtNA = na(netDebtEBITDA) or ebitda <= 0
isEvNA   = na(evEBITDA) or ebitda <= 0
isFcfNA  = na(fcfYield)

statusIcon(bool isNA, int score) => isNA ? "➖" : score > 0 ? "✅" : "❌"

debtIcon = statusIcon(isDebtNA, netDebtScore)
evIcon   = statusIcon(isEvNA, evEBITDAScore)
fcfIcon  = statusIcon(isFcfNA, fcfYieldScore)

debtShort = isDebtNA ? "N/A" : netDebtEBITDA <= 0 ? "Net Cash" : netDebtEBITDA <= thDebtHealthyEff ? "Healthy" : netDebtEBITDA <= thDebtModerateEff ? "Moderate" : "High"
evShort   = isEvNA   ? "N/A" : evEBITDA <= thEvCheapEff ? "Cheap" : evEBITDA <= thEvFairEff ? "Fair" : "Expensive"
fcfShort  = isFcfNA  ? "N/A" : fcfYield >= fcfCow ? "Cash Cow" : fcfYield >= fcfStrong ? "Strong" : fcfYield >= fcfDecent ? "Decent" : fcfYield >= 0 ? "Weak" : "Burn"

// FIX #4 — The Revenue verdict now describes a number you can actually see.
//
// The Value cell showed 1Y YoY, but the icon, the label, the score AND the
// gradient behind the cell all came from `revenueCAGRNy` whenever it existed.
// A company at −12% last year but +9% annualised over five years rendered as
// "-12.00%  📈 Steady" on a green background — three statements about the
// five-year trend wrapped around one number about last year.
//
// The basis is now explicit and selectable. Three things follow from it:
//   • the verdict is tagged with the basis, e.g. "📈 Steady · 5Y";
//   • `growthBasisCol` moves the score gradient onto the column that figure
//     lives in, so the coloured cell is always the one being judged;
//   • Auto now steps Lookback → 2Y → 1Y. The old fallback jumped straight
//     from the lookback CAGR to 1Y YoY, ignoring a perfectly good 2Y CAGR
//     whenever history was too short for the full lookback.

growthAuto = not na(revenueCAGRNy) ? revenueCAGRNy : not na(revenueCAGR2y) ? revenueCAGR2y : revenueGrowth1y

growthForScore = growthBasis == "1Y YoY"        ? revenueGrowth1y :
     growthBasis == "2Y CAGR"       ? revenueCAGR2y :
     growthBasis == "Lookback CAGR" ? revenueCAGRNy :
     growthAuto

// Column index in the table that holds the figure above: 2 = Value (1Y),
// 3 = the 2Y column, 4 = the lookback column.
growthBasisCol = growthBasis == "1Y YoY"        ? 2 :
     growthBasis == "2Y CAGR"       ? 3 :
     growthBasis == "Lookback CAGR" ? 4 :
     not na(revenueCAGRNy) ? 4 : not na(revenueCAGR2y) ? 3 : 2

growthBasisTag = growthBasisCol == 2 ? "1Y" : growthBasisCol == 3 ? "2Y" : str.tostring(lookbackYears) + "Y"

growthScore    = na(growthForScore) ? 0 : growthForScore >= thGrowthHighEff ? 2 : growthForScore >= thGrowthSteadyEff ? 1 : 0
isGrowthNA     = na(growthForScore)
growthIcon     = isGrowthNA ? "➖" : growthForScore >= thGrowthHighEff ? "🚀" : growthForScore >= thGrowthSteadyEff ? "📈" : growthForScore >= 0 ? "🟡" : "🔻"
growthShort    = isGrowthNA ? "N/A · " + growthBasisTag :
     (growthForScore >= thGrowthHighEff ? "High" : growthForScore >= thGrowthSteadyEff ? "Steady" : growthForScore >= 0 ? "Slow" : "Declining") + " · " + growthBasisTag

// FIX #3 — N/A metrics no longer drag the score down.
//
// maxRaw used to be a fixed 8 no matter how many metrics actually resolved,
// so every missing metric silently contributed 0 out of its full weight. A
// symbol with no fundamentals at all — an ETF, an index, a crypto pair —
// scored 0/8 and the box read "⛔ Avoid" while every row honestly showed ➖.
// A negative-EBITDA company with a strong FCF yield had two of three inputs
// zeroed out and landed on "😐 Neutral" for no defensible reason.
//
// The denominator is now built only from metrics that have data, so the score
// means "how good is this on what we can actually measure".
//
// That renormalisation creates the opposite hazard — 3/3 on a single metric
// would read 5/5 "Attractive" — so coverage is tracked separately and a
// verdict is withheld below `minMetrics`, with the coverage shown on screen.

coreCount = (isDebtNA ? 0 : 1) + (isEvNA ? 0 : 1) + (isFcfNA ? 0 : 1)
hasVerdict = coreCount >= minMetrics

rawScore = netDebtScore + evEBITDAScore + fcfYieldScore + (weighGrowth ? growthScore : 0)
maxRaw   = (isDebtNA ? 0 : debtMaxPts) + (isEvNA ? 0 : 2) + (isFcfNA ? 0 : 3) + ((weighGrowth and not isGrowthNA) ? 2 : 0)

// The 1.0 factor forces float division — int/int would truncate every partial
// score to 0 and collapse the whole 1-4 band into "Avoid".
scorePct = maxRaw == 0 ? 0.0 : rawScore * 1.0 / maxRaw

scoreBand = scorePct >= 1.0    ? 5 :
     scorePct >= 0.75  ? 4 :
     scorePct >= 0.5   ? 3 :
     scorePct >= 0.25  ? 2 :
     scorePct >= 0.125 ? 1 :
     0

totalScoreNum = hasVerdict ? scoreBand : 0

totalScore = hasVerdict ? str.tostring(scoreBand) + "/5" : "—/5"

finalInterpretation = not hasVerdict ? (coreCount == 0 ? "❔ No Data" : "❔ Insufficient Data") :
     scoreBand == 5 ? "🔥 Attractive" :
     scoreBand == 4 ? "💪 Strong" :
     scoreBand == 3 ? "📈 Balanced" :
     scoreBand == 2 ? "😐 Neutral" :
     scoreBand == 1 ? "🚨 Weak" :
     "⛔ Avoid"

// Shown next to the verdict whenever the score rests on incomplete data.
coverageNote = coreCount < 3 ? "  ⚠️ " + str.tostring(coreCount) + "/3 metrics" : ""

// No verdict gets a neutral slate — the same "missing ≠ bad" rule the N/A
// cells follow. Painting an unmeasurable symbol red was the visual half of
// the bug fixed above.
finalBgColor = solid(not hasVerdict ? COL_SCORE_NA :
     scoreBand == 5 ? color.new(#05990a, 0) :
     scoreBand == 4 ? color.new(color.green, 0) :
     scoreBand == 3 ? color.new(color.teal, 0) :
     scoreBand == 2 ? color.new(#8a7300, 0) :
     scoreBand == 1 ? color.new(color.orange, 0) :
     color.new(color.red, 0))


// ┌──────────────────────────────────────────────────────────────────────┐
// │  CALCULATIONS: D_RVOL                                                │
// └──────────────────────────────────────────────────────────────────────┘
// Baseline excludes the current (still-forming) daily bar via a [1] shift so a
// live spike doesn't dilute its own average; na/zero guards prevent bogus
// readings on no-volume symbols.
float daily_avg_vol      = request.security(syminfo.tickerid, "D", ta.sma(volume, rvol_len)[1])
float daily_volume_total = request.security(syminfo.tickerid, "D", volume)
bool  hasDailyVolume     = not na(daily_volume_total) and not na(daily_avg_vol) and daily_avg_vol != 0
float d_rvol             = hasDailyVolume ? daily_volume_total / daily_avg_vol : na

bool is_high_tf    = not alertOnlyHighTF or (timeframe.isdaily or timeframe.isweekly)
bool alert_trigger = hasDailyVolume and (d_rvol >= rvol_threshold) and is_high_tf

rvolIcon = na(d_rvol) ? "➖" : d_rvol >= rvolActifLvl ? "✅" : "❌"
rvolDesc = na(d_rvol) ? "N/A" :
     d_rvol >= rvol_threshold ? "ANOMALIE" :
     d_rvol >= rvolActifLvl   ? "ACTIF"    :
     d_rvol >= rvolNormalLvl  ? "NORMAL"   :
     "SOMMEIL"

// 0-3 pseudo-score purely for the meter + gradient. It is NOT added to the
// fundamentals score — see the note at the top of the file.
rvolMeterScore = na(d_rvol) ? 0 : d_rvol >= rvol_threshold ? 3 : d_rvol >= rvolActifLvl ? 2 : d_rvol >= rvolNormalLvl ? 1 : 0
rvolFrac       = na(d_rvol) ? na : math.min(d_rvol / rvol_threshold, 1.0)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  TOOLTIPS (built from the live threshold inputs — never drift)       │
// └──────────────────────────────────────────────────────────────────────┘
// Data provenance, shown in the title band. Replaces the old decorative
// "VALUATION & VOLUME" text with something load-bearing: which vintage the
// Value column is on (FIX #8), how much fiscal history the chart actually
// supports (FIX #6), and whether an FX conversion is active or broken
// (FIX #9). All three used to be invisible assumptions.
basisTag = freshLive ? "TTM·FQ" : "FY"
fxTag    = fxBroken ? " · FX ✕" : fxNeeded ? " · " + fxFinancials + "→" + syminfo.currency : ""
thTag    = thresholdsAdjusted ? " · ⚠ thresholds" : ""
provenanceTag = basisTag + " · " + historyTag + fxTag + thTag

provenanceTooltip = "DATA PROVENANCE\n\n" +
     "Current figures: " + (freshLive ? "TTM flows + latest-quarter balance sheet." : "last completed fiscal year (FY).") +
     (useFresh and not freshLive ? "\n⚠ TTM/FQ was requested but is not published for this symbol — fell back to FY." : "") +
     "\n\nFiscal years loaded: " + str.tostring(fyYearsLoaded) + ". The " + str.tostring(lookbackYears) + "Y column needs " + str.tostring(fyYearsNeeded) + "." +
     (historyShort ? "\n⚠ NOT ENOUGH HISTORY. This is a limit of how many bars this chart has loaded, not of the company — fiscal history is rebuilt by walking chart bars, so a short or low-timeframe chart starves it. Switch to a Daily/Weekly/Monthly chart, or scroll left to load more bars, and the columns will fill in." : "") +
     "\n\nCurrency: " + (fxBroken ? "⚠ conversion requested but the pair " + fxPair + " could not be resolved — affected metrics are N/A." : fxNeeded ? "financials converted " + fxFinancials + " → " + syminfo.currency + "." : "financials assumed to be in the chart currency (" + syminfo.currency + "). If this symbol reports in a different currency, set it under Data Handling — market cap, EV/EBITDA and FCF Yield are wrong until you do.") +
     (thresholdsAdjusted ? "\n\n⚠ THRESHOLDS REORDERED. At least one threshold was set out of order, which would have made a band unreachable — the band chain is evaluated top-down, so the wider test fires first and the narrower one never runs. The values have been clamped into a monotonic order for scoring; check the Thresholds group. The scale shown in each row's tooltip is the one actually in use." : "") +
     "\n\nGrowth and the 2Y / NY columns are always strictly FY, whatever the basis above."

dRvolTooltip = "DAILY RELATIVE VOLUME (constant regardless of chart timeframe)\n\nToday's cumulative daily volume vs. the average of the PRECEDING " + str.tostring(rvol_len) + " full daily sessions (today excluded from its own baseline).\n\n• ANOMALIE: ≥ " + str.tostring(rvol_threshold, "#.##") + "x\n• ACTIF: ≥ " + str.tostring(rvolActifLvl, "#.##") + "x\n• NORMAL: ≥ " + str.tostring(rvolNormalLvl, "#.##") + "x\n• SOMMEIL: below that\n\nInformational only — NOT included in the 0-5 fundamentals score."

ndTooltip = "NET DEBT / EBITDA — years of earnings needed to repay net debt.\n\nSCALE (a boundary value always falls in the BETTER band):\n• Negative/zero EBITDA → N/A (excluded from the score)\n• ≤ 0 → " + str.tostring(debtMaxPts) + " pts (Net Cash)\n• ≤ " + str.tostring(thDebtHealthyEff, "#.##") + " → 2 pts (Healthy)\n• ≤ " + str.tostring(thDebtModerateEff, "#.##") + " → 1 pt (Moderate)\n• above that → 0 pts (High leverage)\n\n" + (netCashTop ? "Net Cash is worth 3 here, so this row's max is 3 and only a net-cash balance sheet can reach it." : "Net Cash and Healthy are both worth this row's full 2 points; the label still tells them apart. Turn on \"Net Cash Required for Top Score\" to restore the 0-3 scale.") + "\n\n2Y / NY columns show the raw ratio as reported for that fiscal year, not a change. A year with no data shows — and does not shift the other years."

evTooltip = "EV / EBITDA — business value relative to operating earnings.\nEV = market cap + net debt.\n\nSCALE:\n• Negative/zero EBITDA → N/A (excluded from the score)\n• Missing Net Debt → N/A (EV cannot be built; it is NOT assumed to be zero, which would make the symbol look artificially cheap)\n• ≤ " + str.tostring(thEvCheapEff, "#.##") + "x → 2 pts (Cheap)\n• ≤ " + str.tostring(thEvFairEff, "#.##") + "x → 1 pt (Fair)\n• above that → 0 pts (Expensive)\n\n2Y / NY columns are the multiple AS OF that fiscal report — that year's EBITDA against the share price at the time — not today's price against old earnings."

fcfTooltip = "FREE CASH FLOW YIELD (FCF / Market Cap)\n\nVALUE column drives the score.\n2Y / NY: not applicable — historical FCF Yield isn't computable without a historical share price.\n\nSCALE (a boundary value always falls in the BETTER band):\n• ≥ " + str.tostring(thFcfCowEff, "#.##") + "% → 3 pts (Cash Cow)\n• ≥ " + str.tostring(thFcfStrongEff, "#.##") + "% → 2 pts (Strong)\n• ≥ " + str.tostring(thFcfDecentEff, "#.##") + "% → 1 pt (Decent)\n• below that, or negative, or missing → 0 pts (Weak / Burn)"

revTooltip = "REVENUE GROWTH — fiscal year over fiscal year, NOT year-to-date and not TTM.\n\nBoth endpoints are completed, reported fiscal years, so the figure only refreshes when the annual report publishes and follows the company's fiscal calendar, not the calendar year.\n\n" +
     (showHistory ? "VALUE column: most recent Year-over-Year growth %.\n" : "VALUE column: the " + growthBasisTag + " figure the verdict is based on (history columns are hidden).\n") +
     "2Y column: 2-year CAGR (annualized).\n" + str.tostring(lookbackYears) + "Y column: CAGR over the lookback period (annualized).\nN/A if fiscal-year history is insufficient, or if either endpoint is non-positive (CAGR is undefined across a sign flip).\n\n" +
     "VERDICT BASIS: " + growthBasisTag + (growthBasis == "Auto (longest available)" ? " (auto — longest available)" : "") + ". The highlighted column is the figure being scored; the verdict label carries the same tag. Change it under Score & Growth.\n\n" +
     "SCALE (a boundary value always falls in the BETTER band):\n• ≥ " + str.tostring(thGrowthHighEff, "#.##") + "% → 🚀 High (2 pts)\n• ≥ " + str.tostring(thGrowthSteadyEff, "#.##") + "% → 📈 Steady (1 pt)\n• ≥ 0% → 🟡 Slow (0 pts)\n• < 0% → 🔻 Declining (0 pts)\n\nCounts toward the score only if \"Include Revenue Growth in Score\" is enabled."

scoreTooltip = (hasVerdict ? "Score " + str.tostring(rawScore) + " / " + str.tostring(maxRaw) + " → " + totalScore : coreCount == 0 ? "No fundamentals available for this symbol — no score can be computed." : "Only " + str.tostring(coreCount) + " of 3 core metrics resolved; the minimum for a verdict is " + str.tostring(minMetrics) + " (see Data Handling).") +
     "\n\nCOVERAGE — only metrics WITH data count toward the denominator:\n" +
     "• Debt/EBITDA (0-" + str.tostring(debtMaxPts) + "): " + (isDebtNA ? "N/A — excluded" : str.tostring(netDebtScore) + " pts") + "\n" +
     "• EV/EBITDA (0-2): "    + (isEvNA   ? "N/A — excluded" : str.tostring(evEBITDAScore) + " pts") + "\n" +
     "• FCF Yield (0-3): "    + (isFcfNA  ? "N/A — excluded" : str.tostring(fcfYieldScore) + " pts") +
     (weighGrowth ? "\n• Revenue Growth (0-2): " + (isGrowthNA ? "N/A — excluded" : str.tostring(growthScore) + " pts") : "") +
     "\n\nBanding → 5/5 at 100%, 4/5 at ≥75%, 3/5 at ≥50%, 2/5 at ≥25%, 1/5 at ≥12.5%, else 0/5.\n\nD_RVol is shown in the table but is NOT part of this score."


// ┌──────────────────────────────────────────────────────────────────────┐
// │  CELL TEXT                                                           │
// └──────────────────────────────────────────────────────────────────────┘
verdictTxt(string icon, string label, int score, int maxScore) =>
    icon + " " + label + (showMeter ? "  " + meterStr(score, maxScore) : "")

rvolValTxt = na(d_rvol) ? "N/A" : str.tostring(d_rvol, "#.##") + "x"
ndValTxt   = na(netDebtEBITDA) ? "N/A" : str.tostring(netDebtEBITDA, "#.00") + "x"
evValTxt   = na(evEBITDA) ? "N/A" : str.tostring(evEBITDA, "#.00") + "x"
fcfValTxt  = na(fcfYield) ? "N/A" : str.tostring(fcfYield * 100, "#.00") + "%"

ndValue2yText = na(ndEbitdaPast2y) ? "—" : str.tostring(ndEbitdaPast2y, "#.00") + "x"
ndValueNyText = na(ndEbitdaPastN)  ? "—" : str.tostring(ndEbitdaPastN, "#.00") + "x"
evValue2yText = na(evEbitdaPast2y) ? "—" : str.tostring(evEbitdaPast2y, "#.00") + "x"
evValueNyText = na(evEbitdaPastN)  ? "—" : str.tostring(evEbitdaPastN, "#.00") + "x"

revGrowth2yText = na(revenueCAGR2y) ? "—" : str.tostring(revenueCAGR2y, "#.00") + "%"
revGrowthNyText = na(revenueCAGRNy) ? "—" : str.tostring(revenueCAGRNy, "#.00") + "%"

// With history columns visible the Value cell keeps its own meaning (1Y YoY)
// and the gradient travels to whichever column the basis points at. In compact
// mode there is only one numeric cell, so it has to hold the scored figure —
// otherwise the verdict would once again be describing a number that isn't on
// screen, which is the whole defect being fixed here.
revGrowth1yText = na(revenueGrowth1y) ? "N/A" : str.tostring(revenueGrowth1y, "#.00") + "%"
revBasisText    = na(growthForScore)  ? "N/A" : str.tostring(growthForScore, "#.00") + "%"
revValueText    = showHistory ? revGrowth1yText : revBasisText


// ┌──────────────────────────────────────────────────────────────────────┐
// │  DRAW — built once per realtime tick on the last bar only            │
// └──────────────────────────────────────────────────────────────────────┘
// Row indices come from a running counter instead of hardcoded numbers, so
// toggling any row off closes the gap rather than leaving a blank stripe.
if barstate.islast
    int r = 0
    int metricIdx = 0

    // top margin
    thinRow(r, COL_OUTER_BG)
    r := r + 1

    // title band
    if showTitle
        fillBand(r, COL_TITLE_BG)
        table.cell(ratios, 1, r, "📊 " + syminfo.ticker, bgcolor=COL_TITLE_BG, text_color=COL_TXT_ON_BG, text_size=titleSize, text_halign=text.align_left, text_formatting=text.format_bold, tooltip=provenanceTooltip)
        table.cell(ratios, 5, r, provenanceTag, bgcolor=COL_TITLE_BG, text_color = (historyShort or fxBroken) ? ink(color.new(#ffcf6b, 0)) : COL_TXT_DIM, text_size=txtSize, text_halign=text.align_right, tooltip=provenanceTooltip)
        r := r + 1

    // column header
    table.cell(ratios, 0, r, "", bgcolor=COL_OUTER_BG)
    table.cell(ratios, 1, r, "METRIC", bgcolor=accentCol, text_color=COL_TXT_ON_BG, text_halign=text.align_left,  text_size=txtSize, text_formatting=text.format_bold)
    table.cell(ratios, 2, r, "VALUE",  bgcolor=accentCol, text_color=COL_TXT_ON_BG, text_halign=text.align_right, text_size=txtSize, text_formatting=text.format_bold)
    if showHistory
        table.cell(ratios, 3, r, "2Y", bgcolor=accentCol, text_color=COL_TXT_ON_BG, text_halign=text.align_right, text_size=txtSize, text_formatting=text.format_bold)
        table.cell(ratios, 4, r, str.tostring(lookbackYears) + "Y", bgcolor=accentCol, text_color=COL_TXT_ON_BG, text_halign=text.align_right, text_size=txtSize, text_formatting=text.format_bold)
    table.cell(ratios, 5, r, "VERDICT", bgcolor=accentCol, text_color=COL_TXT_ON_BG, text_halign=text.align_left, text_size=txtSize, text_formatting=text.format_bold)
    table.cell(ratios, 6, r, "", bgcolor=COL_OUTER_BG)
    r := r + 1

    // D_RVol (daily, timeframe-independent) + separator
    if showRvolRow
        drawRow(r, "D_RVol (Day)", rvolValTxt, "—", "—", verdictTxt(rvolIcon, rvolDesc, rvolMeterScore, 3), gradeColor(rvolFrac), COL_ROW_EVEN, dRvolTooltip, 2)
        r := r + 1
        thinRow(r, COL_DIVIDER)
        r := r + 1

    // Net Debt / EBITDA
    drawRow(r, "Debt/EBITDA", ndValTxt, ndValue2yText, ndValueNyText, verdictTxt(debtIcon, debtShort, netDebtScore, debtMaxPts), isDebtNA ? COL_SCORE_NA : gradeColor(netDebtScore * 1.0 / debtMaxPts), metricIdx % 2 == 0 ? COL_ROW_EVEN : COL_ROW_ODD, ndTooltip, 2)
    r := r + 1
    metricIdx := metricIdx + 1

    // EV / EBITDA
    drawRow(r, "EV/EBITDA", evValTxt, evValue2yText, evValueNyText, verdictTxt(evIcon, evShort, evEBITDAScore, 2), isEvNA ? COL_SCORE_NA : gradeColor(evEBITDAScore / 2.0), metricIdx % 2 == 0 ? COL_ROW_EVEN : COL_ROW_ODD, evTooltip, 2)
    r := r + 1
    metricIdx := metricIdx + 1

    // FCF Yield
    drawRow(r, "FCF Yield", fcfValTxt, "—", "—", verdictTxt(fcfIcon, fcfShort, fcfYieldScore, 3), isFcfNA ? COL_SCORE_NA : gradeColor(fcfYieldScore / 3.0), metricIdx % 2 == 0 ? COL_ROW_EVEN : COL_ROW_ODD, fcfTooltip, 2)
    r := r + 1
    metricIdx := metricIdx + 1

    // Revenue growth
    if showRevRow
        drawRow(r, "Revenue", revValueText, revGrowth2yText, revGrowthNyText, verdictTxt(growthIcon, growthShort, growthScore, 2), isGrowthNA ? COL_SCORE_NA : gradeColor(growthScore / 2.0), metricIdx % 2 == 0 ? COL_ROW_EVEN : COL_ROW_ODD, revTooltip, growthBasisCol)
        r := r + 1
        metricIdx := metricIdx + 1

    // score footer band
    if showFooter
        thinRow(r, COL_DIVIDER)
        r := r + 1
        fillBand(r, finalBgColor)
        table.cell(ratios, 1, r, "SCORE", bgcolor=finalBgColor, text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_left, text_formatting=text.format_bold)
        table.cell(ratios, 2, r, totalScore, bgcolor=finalBgColor, text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=scoreTooltip)
        table.cell(ratios, 5, r, (hasVerdict ? starsFilled(totalScoreNum) + "  " : "") + finalInterpretation + coverageNote, bgcolor=finalBgColor, text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=scoreTooltip)
        r := r + 1

    // bottom margin
    thinRow(r, COL_OUTER_BG)

    // floating score box
    if showStatusBox
        table.cell(ratiosStatus, 0, 0, (hasVerdict ? starsFilled(totalScoreNum) + "  " + totalScore + "  " : "") + finalInterpretation + coverageNote,
             bgcolor         = finalBgColor,
             text_color      = COL_TXT_ON_BG,
             text_size       = titleSize,
             text_halign     = text.align_center,
             text_formatting = text.format_bold,
             tooltip         = scoreTooltip)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  ALERTS & VISUAL MARKER (D_RVol volume spike)                        │
// └──────────────────────────────────────────────────────────────────────┘
if alert_trigger
    alert("Explosion de volume (Daily) sur " + syminfo.ticker + " ! D_RVol: " + str.tostring(d_rvol, "#.##"), alert.freq_once_per_bar_close)

alertcondition(alert_trigger, title="Volume Explosion", message="Daily volume explosion on {{ticker}} — D_RVol above threshold.")

plotshape(alert_trigger,
     title="Explosion Volume",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.new(color.lime, 0),
     size=size.small,
     text="VOL",
     textcolor=color.white)