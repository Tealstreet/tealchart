//@version=6
indicator("Pivot request feed and origin companion v1", precision=16)
logStart = input.int(0, "Log first Pine index", minval=0)
logEnd = input.int(31, "Log last Pine index", minval=0)
var int chartOrigin = time
emit = bar_index >= logStart and bar_index <= logEnd
num(float x) =>
    na(x) ? "null" : str.tostring(x, "0.################")
firstExecution() =>
    var int origin = time
    origin
if bar_index == logStart or barstate.islastconfirmedhistory
    log.info("CONTEXT ticker=" + syminfo.tickerid + " tf=" + timeframe.period + " timezone=" + syminfo.timezone + " session=" + syminfo.session + " currency=" + syminfo.currency + " mintick=" + str.tostring(syminfo.mintick) + " chartOrigin=" + str.tostring(chartOrigin))
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(last_bar_index, "CHART_LAST_INDEX", display=display.data_window)
plot(chartOrigin, "CHART_FIRST_EXECUTION_MS", display=display.data_window)
plot(open, "CHART_OPEN", display=display.data_window)
plot(high, "CHART_HIGH", display=display.data_window)
plot(low, "CHART_LOW", display=display.data_window)
plot(close, "CHART_CLOSE", display=display.data_window)
plot(volume, "CHART_VOLUME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
[TF_2_GAPS_OFF_TIME, TF_2_GAPS_OFF_END, TF_2_GAPS_OFF_INDEX, TF_2_GAPS_OFF_OPEN, TF_2_GAPS_OFF_HIGH, TF_2_GAPS_OFF_LOW, TF_2_GAPS_OFF_CLOSE, TF_2_GAPS_OFF_VOLUME, TF_2_GAPS_OFF_FIRST, TF_2_GAPS_OFF_LAST] = request.security(syminfo.tickerid, "2", [time, time_close, bar_index, open, high, low, close, volume, firstExecution(), last_bar_index], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(TF_2_GAPS_OFF_TIME, "TF_2_GAPS_OFF_TIME", display=display.data_window)
plot(TF_2_GAPS_OFF_END, "TF_2_GAPS_OFF_END", display=display.data_window)
plot(TF_2_GAPS_OFF_INDEX, "TF_2_GAPS_OFF_INDEX", display=display.data_window)
plot(TF_2_GAPS_OFF_CLOSE, "TF_2_GAPS_OFF_CLOSE", display=display.data_window)
plot(TF_2_GAPS_OFF_FIRST, "TF_2_GAPS_OFF_FIRST", display=display.data_window)
plot(TF_2_GAPS_OFF_LAST, "TF_2_GAPS_OFF_LAST", display=display.data_window)
if emit
    log.info("{\"context\":\"TF_2_GAPS_OFF\",\"chartTime\":" + num(time) + ",\"time\":" + num(TF_2_GAPS_OFF_TIME) + ",\"end\":" + num(TF_2_GAPS_OFF_END) + ",\"index\":" + num(TF_2_GAPS_OFF_INDEX) + ",\"open\":" + num(TF_2_GAPS_OFF_OPEN) + ",\"high\":" + num(TF_2_GAPS_OFF_HIGH) + ",\"low\":" + num(TF_2_GAPS_OFF_LOW) + ",\"close\":" + num(TF_2_GAPS_OFF_CLOSE) + ",\"volume\":" + num(TF_2_GAPS_OFF_VOLUME) + ",\"firstExecution\":" + num(TF_2_GAPS_OFF_FIRST) + ",\"lastIndex\":" + num(TF_2_GAPS_OFF_LAST) + "}")
[TF_2_GAPS_ON_TIME, TF_2_GAPS_ON_END, TF_2_GAPS_ON_INDEX, TF_2_GAPS_ON_OPEN, TF_2_GAPS_ON_HIGH, TF_2_GAPS_ON_LOW, TF_2_GAPS_ON_CLOSE, TF_2_GAPS_ON_VOLUME, TF_2_GAPS_ON_FIRST, TF_2_GAPS_ON_LAST] = request.security(syminfo.tickerid, "2", [time, time_close, bar_index, open, high, low, close, volume, firstExecution(), last_bar_index], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
