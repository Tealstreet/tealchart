//@version=6
indicator("Financial nine series and daily FX companion v1", precision=16)
logStart = input.int(0, "Log first Pine index", minval=0)
logEnd = input.int(31, "Log last Pine index", minval=0)
var int chartOrigin = time
emit = bar_index >= logStart and bar_index <= logEnd
num(float x) =>
    na(x) ? "null" : str.tostring(x, "0.################")
firstExecution() =>
    var int origin = time
    origin
if bar_index == logStart or barstate.islastconfirmedhistory
    log.info("CONTEXT ticker=" + syminfo.tickerid + " tf=" + timeframe.period + " timezone=" + syminfo.timezone + " session=" + syminfo.session + " currency=" + syminfo.currency + " mintick=" + str.tostring(syminfo.mintick) + " chartOrigin=" + str.tostring(chartOrigin))
rvolLen = input.int(20, "Volume Average Length (Days)", minval=1)
reportingCurrency = input.string("", "Financial reporting currency; copy original setting")
fxNeeded = str.length(reportingCurrency) > 0 and reportingCurrency != syminfo.currency
fxPair = fxNeeded ? reportingCurrency + syminfo.currency : syminfo.tickerid
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_END_MS", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(last_bar_index, "CHART_LAST_INDEX", display=display.data_window)
plot(chartOrigin, "CHART_FIRST_EXECUTION_MS", display=display.data_window)
plot(open, "CHART_OPEN", display=display.data_window)
plot(high, "CHART_HIGH", display=display.data_window)
plot(low, "CHART_LOW", display=display.data_window)
plot(close, "CHART_CLOSE", display=display.data_window)
plot(volume, "CHART_VOLUME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
NET_DEBT_FY_GAPS_OFF = request.financial(syminfo.tickerid, "NET_DEBT", "FY", gaps=barmerge.gaps_off)
plot(NET_DEBT_FY_GAPS_OFF, "NET_DEBT_FY_GAPS_OFF", display=display.data_window)
plot(na(NET_DEBT_FY_GAPS_OFF) ? 1 : 0, "NET_DEBT_FY_GAPS_OFF_NA", display=display.data_window)
NET_DEBT_FY_GAPS_ON = request.financial(syminfo.tickerid, "NET_DEBT", "FY", gaps=barmerge.gaps_on)
plot(NET_DEBT_FY_GAPS_ON, "NET_DEBT_FY_GAPS_ON", display=display.data_window)
plot(na(NET_DEBT_FY_GAPS_ON) ? 1 : 0, "NET_DEBT_FY_GAPS_ON_NA", display=display.data_window)
EBITDA_FY_GAPS_OFF = request.financial(syminfo.tickerid, "EBITDA", "FY", gaps=barmerge.gaps_off)
plot(EBITDA_FY_GAPS_OFF, "EBITDA_FY_GAPS_OFF", display=display.data_window)
plot(na(EBITDA_FY_GAPS_OFF) ? 1 : 0, "EBITDA_FY_GAPS_OFF_NA", display=display.data_window)
EBITDA_FY_GAPS_ON = request.financial(syminfo.tickerid, "EBITDA", "FY", gaps=barmerge.gaps_on)
plot(EBITDA_FY_GAPS_ON, "EBITDA_FY_GAPS_ON", display=display.data_window)
plot(na(EBITDA_FY_GAPS_ON) ? 1 : 0, "EBITDA_FY_GAPS_ON_NA", display=display.data_window)
FREE_CASH_FLOW_FY_GAPS_OFF = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "FY", gaps=barmerge.gaps_off)
plot(FREE_CASH_FLOW_FY_GAPS_OFF, "FREE_CASH_FLOW_FY_GAPS_OFF", display=display.data_window)
plot(na(FREE_CASH_FLOW_FY_GAPS_OFF) ? 1 : 0, "FREE_CASH_FLOW_FY_GAPS_OFF_NA", display=display.data_window)
FREE_CASH_FLOW_FY_GAPS_ON = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "FY", gaps=barmerge.gaps_on)
plot(FREE_CASH_FLOW_FY_GAPS_ON, "FREE_CASH_FLOW_FY_GAPS_ON", display=display.data_window)
plot(na(FREE_CASH_FLOW_FY_GAPS_ON) ? 1 : 0, "FREE_CASH_FLOW_FY_GAPS_ON_NA", display=display.data_window)
TOTAL_SHARES_OUTSTANDING_FY_GAPS_OFF = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FY", gaps=barmerge.gaps_off)
plot(TOTAL_SHARES_OUTSTANDING_FY_GAPS_OFF, "TOTAL_SHARES_OUTSTANDING_FY_GAPS_OFF", display=display.data_window)
plot(na(TOTAL_SHARES_OUTSTANDING_FY_GAPS_OFF) ? 1 : 0, "TOTAL_SHARES_OUTSTANDING_FY_GAPS_OFF_NA", display=display.data_window)
TOTAL_SHARES_OUTSTANDING_FY_GAPS_ON = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FY", gaps=barmerge.gaps_on)
plot(TOTAL_SHARES_OUTSTANDING_FY_GAPS_ON, "TOTAL_SHARES_OUTSTANDING_FY_GAPS_ON", display=display.data_window)
plot(na(TOTAL_SHARES_OUTSTANDING_FY_GAPS_ON) ? 1 : 0, "TOTAL_SHARES_OUTSTANDING_FY_GAPS_ON_NA", display=display.data_window)
TOTAL_REVENUE_FY_GAPS_OFF = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FY", gaps=barmerge.gaps_off)
plot(TOTAL_REVENUE_FY_GAPS_OFF, "TOTAL_REVENUE_FY_GAPS_OFF", display=display.data_window)
plot(na(TOTAL_REVENUE_FY_GAPS_OFF) ? 1 : 0, "TOTAL_REVENUE_FY_GAPS_OFF_NA", display=display.data_window)
TOTAL_REVENUE_FY_GAPS_ON = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FY", gaps=barmerge.gaps_on)
plot(TOTAL_REVENUE_FY_GAPS_ON, "TOTAL_REVENUE_FY_GAPS_ON", display=display.data_window)
plot(na(TOTAL_REVENUE_FY_GAPS_ON) ? 1 : 0, "TOTAL_REVENUE_FY_GAPS_ON_NA", display=display.data_window)
EBITDA_TTM_GAPS_OFF = request.financial(syminfo.tickerid, "EBITDA", "TTM", gaps=barmerge.gaps_off)
plot(EBITDA_TTM_GAPS_OFF, "EBITDA_TTM_GAPS_OFF", display=display.data_window)
plot(na(EBITDA_TTM_GAPS_OFF) ? 1 : 0, "EBITDA_TTM_GAPS_OFF_NA", display=display.data_window)
EBITDA_TTM_GAPS_ON = request.financial(syminfo.tickerid, "EBITDA", "TTM", gaps=barmerge.gaps_on)
plot(EBITDA_TTM_GAPS_ON, "EBITDA_TTM_GAPS_ON", display=display.data_window)
plot(na(EBITDA_TTM_GAPS_ON) ? 1 : 0, "EBITDA_TTM_GAPS_ON_NA", display=display.data_window)
FREE_CASH_FLOW_TTM_GAPS_OFF = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "TTM", gaps=barmerge.gaps_off)
plot(FREE_CASH_FLOW_TTM_GAPS_OFF, "FREE_CASH_FLOW_TTM_GAPS_OFF", display=display.data_window)
plot(na(FREE_CASH_FLOW_TTM_GAPS_OFF) ? 1 : 0, "FREE_CASH_FLOW_TTM_GAPS_OFF_NA", display=display.data_window)
FREE_CASH_FLOW_TTM_GAPS_ON = request.financial(syminfo.tickerid, "FREE_CASH_FLOW", "TTM", gaps=barmerge.gaps_on)
plot(FREE_CASH_FLOW_TTM_GAPS_ON, "FREE_CASH_FLOW_TTM_GAPS_ON", display=display.data_window)
plot(na(FREE_CASH_FLOW_TTM_GAPS_ON) ? 1 : 0, "FREE_CASH_FLOW_TTM_GAPS_ON_NA", display=display.data_window)
NET_DEBT_FQ_GAPS_OFF = request.financial(syminfo.tickerid, "NET_DEBT", "FQ", gaps=barmerge.gaps_off)
plot(NET_DEBT_FQ_GAPS_OFF, "NET_DEBT_FQ_GAPS_OFF", display=display.data_window)
plot(na(NET_DEBT_FQ_GAPS_OFF) ? 1 : 0, "NET_DEBT_FQ_GAPS_OFF_NA", display=display.data_window)
NET_DEBT_FQ_GAPS_ON = request.financial(syminfo.tickerid, "NET_DEBT", "FQ", gaps=barmerge.gaps_on)
plot(NET_DEBT_FQ_GAPS_ON, "NET_DEBT_FQ_GAPS_ON", display=display.data_window)
plot(na(NET_DEBT_FQ_GAPS_ON) ? 1 : 0, "NET_DEBT_FQ_GAPS_ON_NA", display=display.data_window)
TOTAL_SHARES_OUTSTANDING_FQ_GAPS_OFF = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", gaps=barmerge.gaps_off)
plot(TOTAL_SHARES_OUTSTANDING_FQ_GAPS_OFF, "TOTAL_SHARES_OUTSTANDING_FQ_GAPS_OFF", display=display.data_window)
plot(na(TOTAL_SHARES_OUTSTANDING_FQ_GAPS_OFF) ? 1 : 0, "TOTAL_SHARES_OUTSTANDING_FQ_GAPS_OFF_NA", display=display.data_window)
TOTAL_SHARES_OUTSTANDING_FQ_GAPS_ON = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", gaps=barmerge.gaps_on)
plot(TOTAL_SHARES_OUTSTANDING_FQ_GAPS_ON, "TOTAL_SHARES_OUTSTANDING_FQ_GAPS_ON", display=display.data_window)
plot(na(TOTAL_SHARES_OUTSTANDING_FQ_GAPS_ON) ? 1 : 0, "TOTAL_SHARES_OUTSTANDING_FQ_GAPS_ON_NA", display=display.data_window)
[fxTime, fxClose] = request.security(fxPair, "D", [time, close], ignore_invalid_symbol=true)
fxRate = fxNeeded ? fxClose : 1.0
[dailyTime, dailyEnd, dailyIndex, dailyOpen, dailyHigh, dailyLow, dailyClose, dailyVolume, priorDailySma, dailyOrigin] = request.security(syminfo.tickerid, "D", [time, time_close, bar_index, open, high, low, close, volume, ta.sma(volume, rvolLen)[1], firstExecution()])
plot(fxTime, "FX_D_TIME", display=display.data_window)
plot(fxClose, "FX_D_CLOSE", display=display.data_window)
plot(fxRate, "FX_RATE", display=display.data_window)
plot(fxNeeded ? 1 : 0, "FX_NEEDED", display=display.data_window)
plot(dailyTime, "D_TIME", display=display.data_window)
plot(dailyEnd, "D_END", display=display.data_window)
plot(dailyIndex, "D_INDEX", display=display.data_window)
plot(dailyOpen, "D_OPEN", display=display.data_window)
plot(dailyHigh, "D_HIGH", display=display.data_window)
plot(dailyLow, "D_LOW", display=display.data_window)
plot(dailyClose, "D_CLOSE", display=display.data_window)
plot(dailyVolume, "D_VOLUME", display=display.data_window)
plot(priorDailySma, "D_PRIOR_VOLUME_SMA", display=display.data_window)
plot(dailyOrigin, "D_FIRST_EXECUTION", display=display.data_window)
if emit
    log.info("FINANCIAL_CONTEXT ticker=" + syminfo.tickerid + " reportingCurrency=" + reportingCurrency + " fxPair=" + fxPair + " rvolLen=" + str.tostring(rvolLen))
