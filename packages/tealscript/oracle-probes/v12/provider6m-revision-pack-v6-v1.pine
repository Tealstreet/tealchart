//@version=6
indicator("V11 requested6m revision pack", overlay=false, precision=12)
if timeframe.period != "2"
    runtime.error("Use BINANCE BTCUSDT standard 2-minute candles")
revisionPack() =>
    var int firstTime = time
    phase = int(time / 360000) % 11
    hole = phase == 3 or phase == 4 ? na : close
    [close, hole, ta.sma(close, 4), ta.rma(close, 4), open, high, low, volume, time, time_close, bar_index, firstTime]
[gapsoff_0, gapsoff_1, gapsoff_2, gapsoff_3, gapsoff_4, gapsoff_5, gapsoff_6, gapsoff_7, gapsoff_8, gapsoff_9, gapsoff_10, gapsoff_11] = request.security(syminfo.tickerid, "6", revisionPack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(gapsoff_0, "htf6_gapsoff_clean", display=display.data_window)
plot(gapsoff_1, "htf6_gapsoff_hole", display=display.data_window)
plot(gapsoff_2, "htf6_gapsoff_sma4", display=display.data_window)
plot(gapsoff_3, "htf6_gapsoff_rma4", display=display.data_window)
plot(gapsoff_4, "htf6_gapsoff_INPUT_open", display=display.data_window)
plot(gapsoff_5, "htf6_gapsoff_INPUT_high", display=display.data_window)
plot(gapsoff_6, "htf6_gapsoff_INPUT_low", display=display.data_window)
plot(gapsoff_7, "htf6_gapsoff_INPUT_volume", display=display.data_window)
plot(gapsoff_8, "htf6_gapsoff_INPUT_time", display=display.data_window)
plot(gapsoff_9, "htf6_gapsoff_INPUT_time_close", display=display.data_window)
plot(gapsoff_10, "htf6_gapsoff_INPUT_index", display=display.data_window)
plot(gapsoff_11, "htf6_gapsoff_INPUT_first_time", display=display.data_window)
[gapson_0, gapson_1, gapson_2, gapson_3, gapson_4, gapson_5, gapson_6, gapson_7, gapson_8, gapson_9, gapson_10, gapson_11] = request.security(syminfo.tickerid, "6", revisionPack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
plot(gapson_0, "htf6_gapson_clean", display=display.data_window)
plot(gapson_1, "htf6_gapson_hole", display=display.data_window)
plot(gapson_2, "htf6_gapson_sma4", display=display.data_window)
plot(gapson_3, "htf6_gapson_rma4", display=display.data_window)
plot(gapson_4, "htf6_gapson_INPUT_open", display=display.data_window)
plot(gapson_5, "htf6_gapson_INPUT_high", display=display.data_window)
plot(gapson_6, "htf6_gapson_INPUT_low", display=display.data_window)
plot(gapson_7, "htf6_gapson_INPUT_volume", display=display.data_window)
plot(gapson_8, "htf6_gapson_INPUT_time", display=display.data_window)
plot(gapson_9, "htf6_gapson_INPUT_time_close", display=display.data_window)
plot(gapson_10, "htf6_gapson_INPUT_index", display=display.data_window)
plot(gapson_11, "htf6_gapson_INPUT_first_time", display=display.data_window)
plot(open, "CHART_open", display=display.data_window)
plot(high, "CHART_high", display=display.data_window)
plot(low, "CHART_low", display=display.data_window)
plot(close, "CHART_close", display=display.data_window)
plot(volume, "CHART_volume", display=display.data_window)
plot(time, "CHART_time", display=display.data_window)
plot(time_close, "CHART_time_close", display=display.data_window)
plot(bar_index, "CHART_bar_index", display=display.data_window)
plot(timenow, "CHART_timenow", display=display.data_window)
