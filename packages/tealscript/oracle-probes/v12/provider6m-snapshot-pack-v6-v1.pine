//@version=6
indicator("V11 requested6m snapshot pack", overlay=false, precision=12)
if timeframe.period != "2"
    runtime.error("Use BINANCE BTCUSDT standard 2-minute candles")
reqPack() =>
    var int firstTime = time
    float srcHole = bar_index % 97 == 40 or bar_index % 97 == 41 or bar_index % 97 == 42 ? na : close
    [close, math.sum(close, 3), math.sum(srcHole, 3), high-low, hl2, hlc3, ohlc4, close[2], time_close, dayofweek, time("1D"), srcHole, open, high, low, volume, time, bar_index, firstTime]
[goff_0, goff_1, goff_2, goff_3, goff_4, goff_5, goff_6, goff_7, goff_8, goff_9, goff_10, goff_11, goff_12, goff_13, goff_14, goff_15, goff_16, goff_17, goff_18] = request.security(syminfo.tickerid, "6", reqPack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(goff_0, "htf6_goff_lon_close_clean", display=display.data_window)
plot(goff_1, "htf6_goff_lon_sum_close_len3_clean", display=display.data_window)
plot(goff_2, "htf6_goff_lon_sum_close_len3_hole", display=display.data_window)
plot(goff_3, "htf6_goff_lon_range", display=display.data_window)
plot(goff_4, "htf6_goff_lon_hl2", display=display.data_window)
plot(goff_5, "htf6_goff_lon_hlc3", display=display.data_window)
plot(goff_6, "htf6_goff_lon_ohlc4", display=display.data_window)
plot(goff_7, "htf6_goff_lon_close_history2", display=display.data_window)
plot(goff_8, "htf6_goff_lon_time_close", display=display.data_window)
plot(goff_9, "htf6_goff_lon_dayofweek", display=display.data_window)
plot(goff_10, "htf6_goff_lon_daily_open", display=display.data_window)
plot(goff_11, "htf6_goff_lon_close_hole97", display=display.data_window)
plot(goff_12, "htf6_goff_lon_INPUT_open", display=display.data_window)
plot(goff_13, "htf6_goff_lon_INPUT_high", display=display.data_window)
plot(goff_14, "htf6_goff_lon_INPUT_low", display=display.data_window)
plot(goff_15, "htf6_goff_lon_INPUT_volume", display=display.data_window)
plot(goff_16, "htf6_goff_lon_INPUT_time", display=display.data_window)
plot(goff_17, "htf6_goff_lon_INPUT_index", display=display.data_window)
plot(goff_18, "htf6_goff_lon_INPUT_first_time", display=display.data_window)
[gon_0, gon_1, gon_2, gon_3, gon_4, gon_5, gon_6, gon_7, gon_8, gon_9, gon_10, gon_11, gon_12, gon_13, gon_14, gon_15, gon_16, gon_17, gon_18] = request.security(syminfo.tickerid, "6", reqPack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
plot(gon_0, "htf6_gon_lon_close_clean", display=display.data_window)
plot(gon_1, "htf6_gon_lon_sum_close_len3_clean", display=display.data_window)
plot(gon_2, "htf6_gon_lon_sum_close_len3_hole", display=display.data_window)
plot(gon_3, "htf6_gon_lon_range", display=display.data_window)
plot(gon_4, "htf6_gon_lon_hl2", display=display.data_window)
plot(gon_5, "htf6_gon_lon_hlc3", display=display.data_window)
plot(gon_6, "htf6_gon_lon_ohlc4", display=display.data_window)
plot(gon_7, "htf6_gon_lon_close_history2", display=display.data_window)
plot(gon_8, "htf6_gon_lon_time_close", display=display.data_window)
plot(gon_9, "htf6_gon_lon_dayofweek", display=display.data_window)
plot(gon_10, "htf6_gon_lon_daily_open", display=display.data_window)
plot(gon_11, "htf6_gon_lon_close_hole97", display=display.data_window)
plot(gon_12, "htf6_gon_lon_INPUT_open", display=display.data_window)
plot(gon_13, "htf6_gon_lon_INPUT_high", display=display.data_window)
plot(gon_14, "htf6_gon_lon_INPUT_low", display=display.data_window)
plot(gon_15, "htf6_gon_lon_INPUT_volume", display=display.data_window)
plot(gon_16, "htf6_gon_lon_INPUT_time", display=display.data_window)
plot(gon_17, "htf6_gon_lon_INPUT_index", display=display.data_window)
plot(gon_18, "htf6_gon_lon_INPUT_first_time", display=display.data_window)
plot(open, "CHART_open", display=display.data_window)
plot(high, "CHART_high", display=display.data_window)
plot(low, "CHART_low", display=display.data_window)
plot(close, "CHART_close", display=display.data_window)
plot(volume, "CHART_volume", display=display.data_window)
plot(time, "CHART_time", display=display.data_window)
plot(time_close, "CHART_time_close", display=display.data_window)
plot(bar_index, "CHART_bar_index", display=display.data_window)
plot(timenow, "CHART_timenow", display=display.data_window)
