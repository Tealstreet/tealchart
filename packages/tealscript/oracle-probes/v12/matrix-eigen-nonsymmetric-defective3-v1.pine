//@version=6
indicator("matrix-eigen-nonsymmetric-defective3-v1")
var m=matrix.new<float>(3,3,0.0)
matrix.set(m,0,0,1.0)
matrix.set(m,0,1,1.0)
matrix.set(m,0,2,0.0)
matrix.set(m,1,0,0.0)
matrix.set(m,1,1,1.0)
matrix.set(m,1,2,1.0)
matrix.set(m,2,0,0.0)
matrix.set(m,2,1,0.0)
matrix.set(m,2,2,1.0)
e=matrix.eigenvalues(m)
plot(array.get(e,0),"eigen0")
plot(array.get(e,1),"eigen1")
plot(array.get(e,2),"eigen2")
