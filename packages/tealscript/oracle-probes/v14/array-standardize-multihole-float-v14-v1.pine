//@version=6
indicator("array-standardize-multihole-float v14 v1", precision=16)
a = array.from(1.0, float(na), 5.0, float(na), 9.0)
r = array.standardize(a)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(a.size(), "SOURCE_SIZE", display=display.data_window)
plot(r.size(), "RESULT_SIZE", display=display.data_window)
plot(a.get(0), "SOURCE_0", display=display.data_window)
plot(a.get(1), "SOURCE_1", display=display.data_window)
plot(a.get(2), "SOURCE_2", display=display.data_window)
plot(a.get(3), "SOURCE_3", display=display.data_window)
plot(a.get(4), "SOURCE_4", display=display.data_window)
plot(r.get(0), "RESULT_0", display=display.data_window)
plot(r.get(1), "RESULT_1", display=display.data_window)
plot(r.get(2), "RESULT_2", display=display.data_window)
plot(r.get(3), "RESULT_3", display=display.data_window)
plot(r.get(4), "RESULT_4", display=display.data_window)
