//@version=6
indicator("array-linear-overflow-percentage-positive v14 v1", precision=16)
a = array.from(1.0, 2.0, 4.0)
p = math.exp(1000.0)
r = array.percentile_linear_interpolation(a, p)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(p, "INPUT_PERCENTAGE", display=display.data_window)
plot(na(p) ? 1 : 0, "INPUT_NA", display=display.data_window)
plot(r, "RESULT", display=display.data_window)
plot(na(r) ? 1 : 0, "RESULT_NA", display=display.data_window)
