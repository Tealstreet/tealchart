//@version=6
indicator("array-covariance-bias-paired-holes v14 v1", precision=16)
x = array.from(1.0, 3.0, 5.0)
y = array.from(2.0, 4.0, 8.0)
h = array.from(1.0, float(na), 5.0)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(array.covariance(x, y, true), "POPULATION", display=display.data_window)
plot(array.covariance(x, y, false), "SAMPLE", display=display.data_window)
plot(array.covariance(x, y), "DEFAULT", display=display.data_window)
plot(x.covariance(y, true), "METHOD_POPULATION", display=display.data_window)
plot(x.covariance(y, false), "METHOD_SAMPLE", display=display.data_window)
plot(array.covariance(h, y, true), "HOLE_POPULATION", display=display.data_window)
plot(array.covariance(h, y, false), "HOLE_SAMPLE", display=display.data_window)
