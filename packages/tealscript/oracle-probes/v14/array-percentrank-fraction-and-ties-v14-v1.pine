//@version=6
indicator("array-percentrank-fraction-and-ties v14 v1", precision=16)
i = array.from(1, 2, 3)
f = array.from(1.0, 2.0, 3.0)
t = array.from(1.0, 2.0, 2.0, 4.0)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(array.percentrank(i, 0), "INT_NAMESPACE", display=display.data_window)
plot(i.percentrank(0), "INT_METHOD", display=display.data_window)
plot(array.percentrank(f, 0), "FLOAT_NAMESPACE", display=display.data_window)
plot(f.percentrank(0), "FLOAT_METHOD", display=display.data_window)
plot(array.percentrank(t, 1), "TIE_NAMESPACE", display=display.data_window)
plot(t.percentrank(1), "TIE_METHOD", display=display.data_window)
