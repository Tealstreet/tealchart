//@version=6
indicator("TealScript volume-vwap oracle v1", overlay=false, precision=16, max_bars_back=500)
// All 60 raw series export from the Data Window without distorting any scale.
// Export the complete dataset including bar_index 0, and at least 100 bars.
oneHole = bar_index == 40 ? na : close
burstHole = bar_index == 40 or bar_index == 41 ? na : close
leadingHole = bar_index < 5 ? na : close
periodicHole = bar_index % 17 == 0 ? na : close
resetHole = bar_index % 20 == 0 and bar_index > 0 ? na : close
anchor20 = bar_index % 20 == 0
dayAnchor = timeframe.change("1D")
ramp = 100.0 + bar_index
mixedSignZig = bar_index % 2 == 0 ? -100.0 : 90.0

// Published MFI reference composition is expanded per plot at root scope.
// This keeps each rolling math.sum control in a distinct written call site.

// Explicit hold state, but return na on a source hole, matching current TS cum.
f_cum(src) =>
    var float total = 0.0
    if not na(src)
        total += src
    na(src) ? na : total

// Skip invalid samples, reset before sample validation; separate mean/variance control.
f_vwap(src, anchor) =>
    var float sv = 0.0
    var float vv = 0.0
    var float ss = 0.0
    if anchor
        sv := 0.0
        vv := 0.0
        ss := 0.0
    if not na(src) and not na(volume)
        sv += src * volume
        vv += volume
        ss += src * src * volume
    mean = vv > 0.0 ? sv / vv : na
    sd = math.sqrt(math.max(ss / vv - mean * mean, 0.0))
    [na(src) ? na : mean, sd]

f_vi(decrease) =>
    var float value = 1.0
    prev = nz(value[1], 0.0) == 0.0 ? 1.0 : value[1]
    if nz(close, 0.0) == 0.0 or nz(close[1], 0.0) == 0.0
        value := prev
    else
        value := (decrease ? volume < nz(volume[1], 0.0) : volume > nz(volume[1], 0.0)) ? prev + (close - close[1]) / close[1] * prev : prev
    value

[v20c, u20c, l20c] = ta.vwap(close, anchor20, 2.0)
[v20h, u20h, l20h] = ta.vwap(burstHole, anchor20, 2.0)
[manual20c, sd20c] = f_vwap(close, anchor20)
[manual20h, sd20h] = f_vwap(burstHole, anchor20)

// 60 uniquely named raw export columns.
plot(open, "input_open", display=display.data_window, editable=false)
plot(high, "input_high", display=display.data_window, editable=false)
plot(low, "input_low", display=display.data_window, editable=false)
plot(close, "input_close", display=display.data_window, editable=false)
plot(volume, "input_volume", display=display.data_window, editable=false)
plot(time, "input_time", display=display.data_window, editable=false)
plot(bar_index, "input_bar_index", display=display.data_window, editable=false)
plot(dayAnchor ? 1 : 0, "input_day_anchor_1d", display=display.data_window, editable=false)
plot(ta.obv, "obv_builtin_clean", display=display.data_window, editable=false)
plot(ta.cum(math.sign(ta.change(close)) * volume), "obv_reference_clean", display=display.data_window, editable=false)
plot(ta.pvt, "pvt_builtin_clean", display=display.data_window, editable=false)
plot(ta.cum(ta.change(close) / close[1] * volume), "pvt_reference_clean", display=display.data_window, editable=false)
plot(ta.nvi, "nvi_builtin_clean", display=display.data_window, editable=false)
plot(f_vi(true), "nvi_reference_clean", display=display.data_window, editable=false)
plot(ta.pvi, "pvi_builtin_clean", display=display.data_window, editable=false)
plot(f_vi(false), "pvi_reference_clean", display=display.data_window, editable=false)
plot(ta.accdist, "accdist_builtin_clean", display=display.data_window, editable=false)
plot(ta.cum(high == low ? 0.0 : (2.0 * close - low - high) / (high - low) * volume), "accdist_reference_clean", display=display.data_window, editable=false)
plot(ta.vwap, "vwap_variable_hlc3_clean", display=display.data_window, editable=false)
plot(ta.vwap(hlc3), "vwap_source_hlc3_clean", display=display.data_window, editable=false)
plot(ta.cum(close), "cum_close_clean", display=display.data_window, editable=false)
plot(f_cum(close), "cum_manual_close_clean", display=display.data_window, editable=false)
plot(ta.cum(burstHole), "cum_close_holes40_41", display=display.data_window, editable=false)
plot(f_cum(burstHole), "cum_manual_close_holes40_41", display=display.data_window, editable=false)
plot(ta.cum(leadingHole), "cum_close_leading_na0_4", display=display.data_window, editable=false)
plot(f_cum(leadingHole), "cum_manual_close_leading_na0_4", display=display.data_window, editable=false)
plot(ta.vwap(close, anchor20), "vwap_close_anchor20_clean", display=display.data_window, editable=false)
plot(ta.vwap(burstHole, anchor20), "vwap_close_anchor20_holes40_41", display=display.data_window, editable=false)
plot(ta.vwap(resetHole, anchor20), "vwap_close_anchor20_reset_na", display=display.data_window, editable=false)
plot(ta.vwap(close, bar_index == 40), "vwap_close_delayed_anchor40_clean", display=display.data_window, editable=false)
plot(ta.vwap(oneHole, bar_index == 40), "vwap_close_delayed_anchor40_hole40", display=display.data_window, editable=false)
plot(ta.vwap(close, false), "vwap_close_never_anchor", display=display.data_window, editable=false)
plot(v20c, "vwap_tuple_anchor20_basis_clean", display=display.data_window, editable=false)
plot(u20c, "vwap_tuple_anchor20_upper2_clean", display=display.data_window, editable=false)
plot(l20c, "vwap_tuple_anchor20_lower2_clean", display=display.data_window, editable=false)
plot(v20h, "vwap_tuple_anchor20_basis_holes40_41", display=display.data_window, editable=false)
plot(u20h, "vwap_tuple_anchor20_upper2_holes40_41", display=display.data_window, editable=false)
plot(l20h, "vwap_tuple_anchor20_lower2_holes40_41", display=display.data_window, editable=false)
plot(manual20c, "vwap_manual_anchor20_close_clean", display=display.data_window, editable=false)
plot(manual20h, "vwap_manual_anchor20_close_holes40_41", display=display.data_window, editable=false)
plot(ta.mfi(hlc3, 14), "mfi_builtin_len14_hlc3_clean", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(hlc3) <= 0.0 ? 0.0 : hlc3), 14) / math.sum(volume * (ta.change(hlc3) >= 0.0 ? 0.0 : hlc3), 14)), "mfi_reference_len14_hlc3_clean", display=display.data_window, editable=false)
plot(ta.mfi(close, 2), "mfi_builtin_len2_close_clean", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(close) <= 0.0 ? 0.0 : close), 2) / math.sum(volume * (ta.change(close) >= 0.0 ? 0.0 : close), 2)), "mfi_reference_len2_close_clean", display=display.data_window, editable=false)
plot(ta.mfi(oneHole, 2), "mfi_builtin_len2_close_hole40", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(oneHole) <= 0.0 ? 0.0 : oneHole), 2) / math.sum(volume * (ta.change(oneHole) >= 0.0 ? 0.0 : oneHole), 2)), "mfi_reference_len2_close_hole40", display=display.data_window, editable=false)
plot(ta.mfi(close, 14), "mfi_builtin_len14_close_clean", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(close) <= 0.0 ? 0.0 : close), 14) / math.sum(volume * (ta.change(close) >= 0.0 ? 0.0 : close), 14)), "mfi_reference_len14_close_clean", display=display.data_window, editable=false)
plot(ta.mfi(burstHole, 14), "mfi_builtin_len14_close_holes40_41", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(burstHole) <= 0.0 ? 0.0 : burstHole), 14) / math.sum(volume * (ta.change(burstHole) >= 0.0 ? 0.0 : burstHole), 14)), "mfi_reference_len14_close_holes40_41", display=display.data_window, editable=false)
plot(ta.mfi(leadingHole, 14), "mfi_builtin_len14_close_leading_na0_4", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(leadingHole) <= 0.0 ? 0.0 : leadingHole), 14) / math.sum(volume * (ta.change(leadingHole) >= 0.0 ? 0.0 : leadingHole), 14)), "mfi_reference_len14_close_leading_na0_4", display=display.data_window, editable=false)
plot(ta.mfi(periodicHole, 14), "mfi_builtin_len14_close_periodic_na_mod17", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(periodicHole) <= 0.0 ? 0.0 : periodicHole), 14) / math.sum(volume * (ta.change(periodicHole) >= 0.0 ? 0.0 : periodicHole), 14)), "mfi_reference_len14_close_periodic_na_mod17", display=display.data_window, editable=false)
plot(ta.mfi(100.0, 14), "mfi_builtin_len14_constant100", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(100.0) <= 0.0 ? 0.0 : 100.0), 14) / math.sum(volume * (ta.change(100.0) >= 0.0 ? 0.0 : 100.0), 14)), "mfi_reference_len14_constant100", display=display.data_window, editable=false)
plot(ta.mfi(ramp, 14), "mfi_builtin_len14_ramp100_plus_bar", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(ramp) <= 0.0 ? 0.0 : ramp), 14) / math.sum(volume * (ta.change(ramp) >= 0.0 ? 0.0 : ramp), 14)), "mfi_reference_len14_ramp100_plus_bar", display=display.data_window, editable=false)
plot(ta.mfi(mixedSignZig, 14), "mfi_builtin_len14_mixed_sign_minus100_plus90", display=display.data_window, editable=false)
plot(100.0 - 100.0 / (1.0 + math.sum(volume * (ta.change(mixedSignZig) <= 0.0 ? 0.0 : mixedSignZig), 14) / math.sum(volume * (ta.change(mixedSignZig) >= 0.0 ? 0.0 : mixedSignZig), 14)), "mfi_reference_len14_mixed_sign_minus100_plus90", display=display.data_window, editable=false)
