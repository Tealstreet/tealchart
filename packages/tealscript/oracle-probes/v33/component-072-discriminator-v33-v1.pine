//@version=6
indicator("V33 isolated component")
v33_close = switch bar_index
    0 => 0.0
    1 => -2.0
    2 => 0.0
    3 => 2.0
    4 => -1.0
    5 => 3.0
    6 => 0.0
    7 => -3.0
    8 => 1.0
    9 => 0.0
    10 => -2.0
    11 => 2.0
    => float(na)
plot(v33_close, "SRC_CLOSE")
plot(bar_index, "INDEX")
offset = bar_index == 3 ? na : 1
value = v33_close[offset]
plot(value, "VALUE_1")
plot(na(value) ? 1 : 0, "VALUE_2")
