//@version=6
indicator("V33 isolated component")
v33_high = switch bar_index
    0 => 1.0
    1 => -1.0
    2 => 1.0
    3 => 3.0
    4 => 0.0
    5 => 4.0
    6 => 1.0
    7 => -2.0
    8 => 2.0
    9 => 1.0
    10 => -1.0
    11 => 3.0
    => float(na)
plot(v33_high, "SRC_HIGH")
v33_low = switch bar_index
    0 => -1.0
    1 => -3.0
    2 => -1.0
    3 => 1.0
    4 => -2.0
    5 => 2.0
    6 => -1.0
    7 => -4.0
    8 => 0.0
    9 => -1.0
    10 => -3.0
    11 => 1.0
    => float(na)
plot(v33_low, "SRC_LOW")
v33_close = switch bar_index
    0 => 0.0
    1 => -2.0
    2 => 0.0
    3 => 2.0
    4 => -1.0
    5 => 3.0
    6 => 0.0
    7 => -3.0
    8 => 1.0
    9 => 0.0
    10 => -2.0
    11 => 2.0
    => float(na)
plot(v33_close, "SRC_CLOSE")
plot(bar_index, "INDEX")
plot(ta.ema(source=v33_close, length=3), "VALUE_1")
plot(ta.sma(source=v33_close, length=3), "VALUE_2")
plot(ta.highest(source=v33_high, length=3), "VALUE_3")
plot(ta.lowest(source=v33_low, length=3), "VALUE_4")
plot(ta.atr(length=3), "VALUE_5")
plot(ta.crossover(source1=v33_close, source2=0) ? 1 : 0, "VALUE_6")
plot(ta.crossunder(source1=v33_close, source2=0) ? 1 : 0, "VALUE_7")
