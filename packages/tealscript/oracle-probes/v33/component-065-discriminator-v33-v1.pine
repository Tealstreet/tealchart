//@version=6
indicator("V33 isolated component")
plot(bar_index, "INDEX")
plot(timeframe.period == "60" ? 1 : 0, "VALUE_1")
plot(timeframe.multiplier, "VALUE_2")
plot(timeframe.isminutes ? 1 : 0, "VALUE_3")
plot(timeframe.isdwm ? 1 : 0, "VALUE_4")
plot(timeframe.isdaily ? 1 : 0, "VALUE_5")
plot(timeframe.isweekly ? 1 : 0, "VALUE_6")
plot(timeframe.ismonthly ? 1 : 0, "VALUE_7")
plot(timeframe.isseconds ? 1 : 0, "VALUE_8")
plot(timeframe.isticks ? 1 : 0, "VALUE_9")
plot(timeframe.to_seconds("2D"), "VALUE_10")
plot(timeframe.from_seconds(90) == "2" ? 1 : 0, "VALUE_11")
plot(timeframe.change("D") ? 1 : 0, "VALUE_12")
