//@version=6
indicator("V33 isolated component")
v33_close = switch bar_index
    0 => 0.0
    1 => -2.0
    2 => float(na)
    3 => 2.0
    4 => -1.0
    5 => 3.0
    6 => 0.0
    7 => float(na)
    8 => 1.0
    9 => 0.0
    10 => float(na)
    11 => 2.0
    => float(na)
plot(v33_close, "SRC_CLOSE")
plot(bar_index, "INDEX")
[basis, upper, lower] = ta.kc(v33_close, 3, 1.5)
allNa = na(basis) and na(upper) and na(lower)
allValid = not na(basis) and not na(upper) and not na(lower)
plot(allNa or (allValid and upper >= basis and basis >= lower) ? 1 : 0, "VALUE_1")
