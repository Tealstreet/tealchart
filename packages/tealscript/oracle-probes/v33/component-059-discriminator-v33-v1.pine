//@version=6
indicator("V33 isolated component")
v33_high = switch bar_index
    0 => 1.0
    1 => -1.0
    2 => 1.0
    3 => 3.0
    4 => 0.0
    5 => float(na)
    6 => 1.0
    7 => -2.0
    8 => 2.0
    9 => 1.0
    10 => -1.0
    11 => 3.0
    => float(na)
plot(v33_high, "SRC_HIGH")
plot(bar_index, "INDEX")
plot(ta.highest(v33_high, 3), "VALUE_1")
