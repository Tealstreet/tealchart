//@version=6
indicator("V33 isolated component")
v33_close = switch bar_index
    0 => 0.0
    1 => -2.0
    2 => float(na)
    3 => 2.0
    4 => -1.0
    5 => 3.0
    6 => 0.0
    7 => float(na)
    8 => 1.0
    9 => 0.0
    10 => float(na)
    11 => 2.0
    => float(na)
plot(v33_close, "SRC_CLOSE")
plot(bar_index, "INDEX")
plot(ta.pivotlow(v33_close, 1, 1), "VALUE_1")
