//@version=6
indicator("V33 isolated component")
v33_close = switch bar_index
    0 => 0.0
    1 => -2.0
    2 => 0.0
    3 => 2.0
    4 => -1.0
    5 => float(na)
    6 => 0.0
    7 => -3.0
    8 => 1.0
    9 => 0.0
    10 => -2.0
    11 => 2.0
    => float(na)
plot(v33_close, "SRC_CLOSE")
v33_volume = switch bar_index
    0 => 100.0
    1 => 110.0
    2 => 120.0
    3 => 130.0
    4 => 140.0
    5 => 150.0
    6 => 160.0
    7 => 170.0
    8 => 180.0
    9 => 190.0
    10 => 200.0
    11 => 210.0
    => float(na)
plot(v33_volume, "SRC_VOLUME")
plot(bar_index, "INDEX")
plot(ta.correlation(v33_close, v33_volume, 3), "VALUE_1")
