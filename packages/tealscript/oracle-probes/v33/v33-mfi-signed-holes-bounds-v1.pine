//@version=6
indicator("v33 MFI signed holes bounds discriminator", precision=16)
pattern = array.from(0.0, -2.0, 0.0, 2.0, -1.0, 3.0, 0.0, -3.0, 1.0, 0.0, -2.0, 2.0)
i = bar_index % 12
base = array.get(pattern, i)
holes = i == 2 or i == 7 or i == 10 ? na : base
leading = bar_index == 0 ? na : base
holesMfi = ta.mfi(holes, 3)
leadingMfi = ta.mfi(leading, 3)
plot(bar_index, "input_bar_index")
plot(volume, "input_volume")
plot(holes, "holes_source")
plot(leading, "leading_source")
plot(holesMfi, "holes_mfi")
plot(leadingMfi, "leading_mfi")
plot(na(holesMfi) or (holesMfi >= 0 and holesMfi <= 100) ? 1 : 0, "holes_bounds")
plot(na(leadingMfi) or (leadingMfi >= 0 and leadingMfi <= 100) ? 1 : 0, "leading_bounds")
