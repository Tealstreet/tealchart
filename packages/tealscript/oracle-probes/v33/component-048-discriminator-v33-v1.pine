//@version=6
indicator("V33 isolated component")
v33_close = switch bar_index
    0 => 1.0
    1 => 3.0
    2 => 3.0
    3 => 2.0
    4 => 3.0
    5 => 1.0
    6 => 1.0
    7 => 4.0
    8 => 4.0
    9 => 2.0
    10 => 4.0
    11 => 0.0
    => float(na)
plot(v33_close, "SRC_CLOSE")
plot(bar_index, "INDEX")
plot(ta.highestbars(v33_close, 3), "VALUE_1")
