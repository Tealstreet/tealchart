indicator("V33 isolated component")
v33_close = switch bar_index
    0 => 10.0
    1 => 11.0
    2 => 13.0
    3 => 12.0
    4 => 14.0
    5 => 15.0
    6 => 13.0
    7 => 16.0
    8 => 18.0
    9 => 17.0
    10 => 19.0
