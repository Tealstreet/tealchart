//@version=6
indicator("Silent audit eigen-complex-placeholder v13 v1", overlay=false, precision=16)
m=matrix.new<float>(3,3,0)
m.set(0,1,-1)
m.set(1,0,1)
m.set(2,2,1)
a=matrix.eigenvalues(m)
plot(bar_index,"INPUT_BAR_INDEX",display=display.data_window)
plot(array.size(a),"RESULT_SIZE",display=display.data_window)
plot(a.get(0),"EIGEN0",display=display.data_window)
plot(a.get(1),"EIGEN1",display=display.data_window)
plot(a.get(2),"EIGEN2",display=display.data_window)
