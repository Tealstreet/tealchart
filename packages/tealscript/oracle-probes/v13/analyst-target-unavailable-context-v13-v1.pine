//@version=6
indicator("V13 analyst target unavailable context v1", overlay=false)
plot(syminfo.target_price_high, title="TARGET_HIGH", display=display.data_window)
plot(na(syminfo.target_price_high) ? 1 : 0, title="HIGH_IS_NA", display=display.data_window)
plot(syminfo.target_price_low, title="TARGET_LOW", display=display.data_window)
plot(na(syminfo.target_price_low) ? 1 : 0, title="LOW_IS_NA", display=display.data_window)
plot(syminfo.target_price_median, title="TARGET_MEDIAN", display=display.data_window)
plot(na(syminfo.target_price_median) ? 1 : 0, title="MEDIAN_IS_NA", display=display.data_window)
plot(syminfo.target_price_average, title="TARGET_AVERAGE", display=display.data_window)
plot(na(syminfo.target_price_average) ? 1 : 0, title="AVERAGE_IS_NA", display=display.data_window)
plot(syminfo.target_price_date, title="TARGET_DATE", display=display.data_window)
plot(na(syminfo.target_price_date) ? 1 : 0, title="DATE_IS_NA", display=display.data_window)
plot(syminfo.target_price_estimates, title="TARGET_ESTIMATES", display=display.data_window)
plot(na(syminfo.target_price_estimates) ? 1 : 0, title="ESTIMATES_IS_NA", display=display.data_window)
plot(time, title="INPUT_TIME", display=display.data_window)
plot(close, title="INPUT_CLOSE", display=display.data_window)
plot(barstate.islast ? 1 : 0, title="IS_LAST", display=display.data_window)
plot(syminfo.type == "stock" ? 1 : 0, title="TYPE_STOCK", display=display.data_window)
