//@version=6
indicator("V13 implicit volume recovery context v1")
plot(open,"INPUT_OPEN")
plot(high,"INPUT_HIGH")
plot(low,"INPUT_LOW")
plot(close,"INPUT_CLOSE")
plot(volume,"INPUT_VOLUME")
plot(time,"INPUT_TIME")
plot(bar_index,"INPUT_INDEX")
plot(na(open) or na(high) or na(low) or na(close) ? 1 : 0,"OHLC_MISSING")
plot(na(volume) ? 1 : 0,"VOLUME_MISSING")
plot(na(volume[1]) and not na(volume) and bar_index > 0 ? 1 : 0,"VOLUME_RECOVERY")
plot(high == low ? 1 : 0,"FLAT_RANGE")
plot(ta.obv,"OBV")
plot(ta.pvt,"PVT")
plot(ta.wad,"WAD")
plot(ta.accdist,"ACCDIST")
plot(ta.mfi(hlc3,4),"MFI_HLC3")
phase = bar_index % 16
source = phase < 3 or phase == 8 or phase == 9 ? na : 10.0 + phase
plot(source,"PATTERN_SOURCE")
plot(ta.mfi(source,4),"MFI_PATTERN")
plot(ta.obv[1],"PREV_OBV")
plot(ta.pvt[1],"PREV_PVT")
plot(ta.wad[1],"PREV_WAD")
plot(ta.accdist[1],"PREV_ACCDIST")
plot(ta.mfi(hlc3,4)[1],"PREV_MFI_HLC3")
