//@version=6
indicator("Silent audit eigen-tiny-cleanup v13 v1", overlay=false, precision=16)
phase=bar_index%4
e=phase==0?1e-12:phase==1?1e-10:phase==2?1e-9:1.0
m=matrix.new<float>(2,2,0)
m.set(0,0,e)
m.set(1,1,2*e)
a=matrix.eigenvalues(m)
plot(bar_index,"INPUT_BAR_INDEX",display=display.data_window)
plot(e,"INPUT_EPSILON",display=display.data_window)
plot(a.get(0),"EIGEN0",display=display.data_window)
plot(a.get(1),"EIGEN1",display=display.data_window)
plot(a.get(0)*1e12,"SCALED_EIGEN0",display=display.data_window)
plot(a.get(1)*1e12,"SCALED_EIGEN1",display=display.data_window)
