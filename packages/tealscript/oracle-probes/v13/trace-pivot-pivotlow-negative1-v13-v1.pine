//@version=6
indicator("Silent audit pivot-pivotlow-negative1 v13 v1", overlay=false, precision=16)
src=float(bar_index%5)
plot(bar_index,"INPUT_BAR_INDEX",display=display.data_window)
plot(src,"INPUT_SOURCE",display=display.data_window)
plot(ta.pivotlow(src,-1,0),"OUTCOME",display=display.data_window)
plot(ta.pivotlow(src,0,0),"ZERO_STRENGTH_CONTROL",display=display.data_window)
