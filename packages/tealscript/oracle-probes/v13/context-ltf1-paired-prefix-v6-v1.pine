//@version=6
indicator("V13 paired minute prefix v1", precision=12)
if timeframe.period != "2"
    runtime.error("Use BINANCE BTCUSDT standard 2-minute candles")
minutePack() =>
    var int firstTime = time
    hole = int(time / 60000) % 29 == 5 or int(time / 60000) % 29 == 6 ? na : close
    value = ta.sma(close, 7)
    warm = int(time / 60000) % 47 < 7 ? na : value
    [close, hole, warm, float(time), float(bar_index), float(firstTime)]
stats(array<float> values) =>
    count = array.size(values)
    valid = 0
    total = 0.0
    if count > 0
        for i = 0 to count - 1
            value = array.get(values, i)
            if not na(value)
                valid += 1
                total += value
    first = count > 0 ? array.get(values, 0) : na
    last = count > 0 ? array.get(values, count - 1) : na
    [float(count), float(valid), first, last, valid > 0 ? total : na, valid > 0 ? total / valid : na]
[clean, hole, warm, minuteTime, minuteIndex, minuteFirst] = request.security_lower_tf(syminfo.tickerid, "1", minutePack())
[cc, cv, cf, cl, cs, cm] = stats(clean)
[hc, hv, hf, hl, hs, hm] = stats(hole)
[wc, wv, wf, wl, ws, wm] = stats(warm)
[tc, tv, tf, tl, ts, tm] = stats(minuteTime)
[ic, iv, ixFirst, ixLast, ixSum, ixMean] = stats(minuteIndex)
[fc, fv, originFirst, originLast, fs, fm] = stats(minuteFirst)
plot(cc, "ltf1_clean_count", display=display.data_window)
plot(cv, "ltf1_clean_non_na_count", display=display.data_window)
plot(cf, "ltf1_clean_first", display=display.data_window)
plot(cl, "ltf1_clean_last", display=display.data_window)
plot(cs, "ltf1_clean_non_na_sum", display=display.data_window)
plot(cm, "ltf1_clean_non_na_mean", display=display.data_window)
plot(hc, "ltf1_hole_count", display=display.data_window)
plot(hv, "ltf1_hole_non_na_count", display=display.data_window)
plot(hf, "ltf1_hole_first", display=display.data_window)
plot(hl, "ltf1_hole_last", display=display.data_window)
plot(hs, "ltf1_hole_non_na_sum", display=display.data_window)
plot(hm, "ltf1_hole_non_na_mean", display=display.data_window)
plot(wc, "ltf1_warm_count", display=display.data_window)
plot(wv, "ltf1_warm_non_na_count", display=display.data_window)
plot(wf, "ltf1_warm_first", display=display.data_window)
plot(wl, "ltf1_warm_last", display=display.data_window)
plot(ws, "ltf1_warm_non_na_sum", display=display.data_window)
plot(wm, "ltf1_warm_non_na_mean", display=display.data_window)
plot(tf, "INPUT_minute_first_time", display=display.data_window)
plot(tl, "INPUT_minute_last_time", display=display.data_window)
plot(ixFirst, "INPUT_minute_first_index", display=display.data_window)
plot(ixLast, "INPUT_minute_last_index", display=display.data_window)
plot(originFirst, "INPUT_requested_origin_first", display=display.data_window)
plot(originLast, "INPUT_requested_origin_last", display=display.data_window)
plot(open, "CHART_open", display=display.data_window)
plot(high, "CHART_high", display=display.data_window)
plot(low, "CHART_low", display=display.data_window)
plot(close, "CHART_close", display=display.data_window)
plot(volume, "CHART_volume", display=display.data_window)
plot(time, "CHART_time", display=display.data_window)
plot(bar_index, "CHART_index", display=display.data_window)
plot(timenow, "CHART_clock", display=display.data_window)
