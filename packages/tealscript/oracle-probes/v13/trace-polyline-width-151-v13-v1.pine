//@version=6
indicator("Silent audit polyline-width-151 v13 v1", overlay=true, precision=16)
if barstate.islast
    c1=chart.point.from_index(bar_index-5, 1)
    c2=chart.point.from_index(bar_index-1, 1)
    t1=chart.point.from_index(bar_index-5, 2)
    t2=chart.point.from_index(bar_index-1, 2)
    polyline.new(array.from(c1,c2),line_width=100,line_color=color.blue)
    polyline.new(array.from(t1,t2),line_width=151,line_color=color.red)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(151, "REQUESTED_WIDTH", display=display.data_window)
