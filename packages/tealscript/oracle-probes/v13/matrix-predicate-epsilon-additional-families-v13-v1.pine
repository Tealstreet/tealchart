//@version=6
indicator("Matrix predicate epsilon families v13 v1", precision=16)
phase = bar_index % 8
e = phase == 0 ? 0.0 : phase == 1 ? 1e-15 : phase == 2 ? 1e-12 : phase == 3 ? 1e-10 : phase == 4 ? 1e-9 : phase == 5 ? 1e-8 : phase == 6 ? 1e-7 : 1e-6
m = matrix.new<float>(2, 2, 0.0)
m.set(0, 0, 1.0)
m.set(1, 1, 1.0)
m.set(0, 1, e)
a = matrix.new<float>(2, 2, 0.0)
a.set(0, 1, 1.0)
a.set(1, 0, 1.0)
a.set(0, 0, e)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(e, "EPSILON", display=display.data_window)
plot(m.is_identity() ? 1 : 0, "IDENTITY", display=display.data_window)
plot(m.is_diagonal() ? 1 : 0, "DIAGONAL", display=display.data_window)
plot(m.is_symmetric() ? 1 : 0, "SYMMETRIC", display=display.data_window)
plot(m.is_triangular() ? 1 : 0, "TRIANGULAR", display=display.data_window)
plot(a.is_antidiagonal() ? 1 : 0, "ANTIDIAGONAL", display=display.data_window)
plot(a.is_antisymmetric() ? 1 : 0, "ANTISYMMETRIC_CONTROL", display=display.data_window)
