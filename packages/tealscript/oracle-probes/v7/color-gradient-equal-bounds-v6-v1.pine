//@version=6
indicator("V7 color-gradient-equal-bounds-v6-v1")
x = bar_index % 4 == 0 ? -1.0 : bar_index % 4 == 1 ? 0.0 : bar_index % 4 == 2 ? 1.0 : na
c = color.from_gradient(x,0,0,color.red,color.blue)
plot(x,"INPUT")
plot(color.r(c),"R")
plot(color.g(c),"G")
plot(color.b(c),"B")
plot(color.t(c),"T")
plot(1,"SWATCH",color=c)
