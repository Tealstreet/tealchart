//@version=6
indicator("V7 ta-vwap-mfi-source-holes-v6-v1")
phase = bar_index % 16
clean = 10.0 + phase
s = phase < 3 or phase == 8 or phase == 9 ? na : clean
plot(s, "SOURCE")
plot(clean, "CLEAN")
anchor = bar_index % 16 == 0
plot(volume, "ACTUAL_VOLUME")
plot(anchor ? 1 : 0, "ANCHOR")
plot(ta.vwap(s,anchor), "VWAP_SOURCE_HOLE")
plot(ta.mfi(s,4), "MFI_SOURCE_HOLE")
