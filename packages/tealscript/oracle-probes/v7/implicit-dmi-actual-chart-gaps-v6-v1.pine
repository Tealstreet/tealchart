//@version=6
indicator("V7 implicit-dmi-actual-chart-gaps-v6-v1")
plot(open, "ACTUAL_OPEN")
plot(high, "ACTUAL_HIGH")
plot(low, "ACTUAL_LOW")
plot(close, "ACTUAL_CLOSE")
plot(volume, "ACTUAL_VOLUME")
plot(na(open) or na(high) or na(low) or na(close) ? 1 : 0, "OHLC_MISSING")
plot(na(volume) ? 1 : 0, "VOLUME_MISSING")
[plus, minus, adx] = ta.dmi(4,4)
plot(plus,"PLUS")
plot(minus,"MINUS")
plot(adx,"ADX")
