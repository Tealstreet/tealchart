//@version=6
indicator("V7 ta-bbw-tsi-hole-zero-v6-v1")
phase = bar_index % 16
clean = 10.0 + phase
s = phase < 3 or phase == 8 or phase == 9 ? na : clean
plot(s, "SOURCE")
plot(clean, "CLEAN")
plot(ta.bbw(s,4,2),"BBW_HOLES")
plot(ta.bbw(0.0,4,2),"BBW_ZERO")
plot(ta.tsi(s,3,5),"TSI_HOLES")
plot(ta.tsi(10.0,3,5),"TSI_CONSTANT")
