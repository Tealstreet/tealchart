//@version=6
indicator("V7 label-viewport-clamp-eight-styles-v6-v1")
if barstate.islastconfirmedhistory
    label.new(bar_index-1,0.0,"LONG LABEL 0",style=label.style_label_left)
    label.new(bar_index-2,1.0,"LONG LABEL 1",style=label.style_label_right)
    label.new(bar_index-3,2.0,"LONG LABEL 2",style=label.style_label_up)
    label.new(bar_index-4,3.0,"LONG LABEL 3",style=label.style_label_down)
    label.new(bar_index-5,4.0,"LONG LABEL 4",style=label.style_label_upper_left)
    label.new(bar_index-6,5.0,"LONG LABEL 5",style=label.style_label_upper_right)
    label.new(bar_index-7,6.0,"LONG LABEL 6",style=label.style_label_lower_left)
    label.new(bar_index-8,7.0,"LONG LABEL 7",style=label.style_label_lower_right)
plot(0,"LOW")
plot(7,"HIGH")
