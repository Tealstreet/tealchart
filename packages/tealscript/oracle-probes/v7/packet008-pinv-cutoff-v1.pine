//@version=6
indicator("packet008 pinv cutoff")
power = -4 - bar_index % 13
small = math.pow(10.0, power)
scale = bar_index % 2 == 0 ? 1.0 : 100.0
m = matrix.new<float>(2, 2, 0.0)
matrix.set(m, 0, 0, scale)
matrix.set(m, 1, 1, scale * small)
p = matrix.pinv(m)
plot(power, "power")
plot(scale, "scale")
plot(small, "relative_small")
plot(matrix.get(p, 0, 0), "p00")
plot(matrix.get(p, 1, 1), "p11")
