//@version=6
indicator("packet008-pinv-rankone-v1")
var m=matrix.new<float>(2,2,0)
matrix.set(m,0,0,1)
matrix.set(m,0,1,2)
matrix.set(m,1,0,2)
matrix.set(m,1,1,4)
p=matrix.pinv(m)
plot(matrix.get(p,0,0),"p00")
plot(matrix.get(p,0,1),"p01")
plot(matrix.get(p,1,0),"p10")
plot(matrix.get(p,1,1),"p11")
