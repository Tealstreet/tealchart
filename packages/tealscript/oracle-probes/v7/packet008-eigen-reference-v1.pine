//@version=6
indicator("packet008-eigen-reference-v1")
var m=matrix.new<float>(2,2,0)
matrix.set(m,0,0,2)
matrix.set(m,0,1,4)
matrix.set(m,1,0,6)
matrix.set(m,1,1,8)
v=matrix.eigenvalues(m)
e=matrix.eigenvectors(m)
plot(array.get(v,0),"value0")
plot(array.get(v,1),"value1")
plot(matrix.get(e,0,0),"vector00")
plot(matrix.get(e,0,1),"vector01")
plot(matrix.get(e,1,0),"vector10")
plot(matrix.get(e,1,1),"vector11")
