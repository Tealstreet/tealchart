//@version=6
indicator("v40 tostring-leading-zeros v1", precision=16)
plot(bar_index, "INDEX", display=display.data_window)
target = str.tostring(7, "000")
plot(na(target) ? 1 : 0, "TARGET_NA", display=display.data_window)
plot(str.length(target), "TARGET_LENGTH", display=display.data_window)
plot(target == "007" ? 1 : 0, "CANDIDATE_1_MATCH", display=display.data_window)
plot(target == "7" ? 1 : 0, "CANDIDATE_2_MATCH", display=display.data_window)
plot(target == "0007" ? 1 : 0, "CANDIDATE_3_MATCH", display=display.data_window)
if barstate.islastconfirmedhistory
    log.info("TARGET=[{0}]", target)
