//@version=6
indicator("v40 replace-all-empty-target v1", precision=16)
plot(bar_index, "INDEX", display=display.data_window)
target = str.replace_all("ab", "", "-")
plot(na(target) ? 1 : 0, "TARGET_NA", display=display.data_window)
plot(str.length(target), "TARGET_LENGTH", display=display.data_window)
plot(target == "-a-b-" ? 1 : 0, "CANDIDATE_1_MATCH", display=display.data_window)
plot(target == "a-b" ? 1 : 0, "CANDIDATE_2_MATCH", display=display.data_window)
plot(target == "ab" ? 1 : 0, "CANDIDATE_3_MATCH", display=display.data_window)
if barstate.islastconfirmedhistory
    log.info("TARGET=[{0}]", target)
