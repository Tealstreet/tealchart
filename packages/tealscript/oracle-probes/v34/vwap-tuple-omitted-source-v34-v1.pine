//@version=6
indicator("V34 vwap-tuple-omitted-source", overlay=false)
[v, u, l] = ta.vwap(anchor=bar_index == 3, stdev_mult=2)
plot(v, "TARGET", display=display.data_window)
plot(u, "UPPER", display=display.data_window)
plot(l, "LOWER", display=display.data_window)
plot(bar_index, "INDEX", display=display.data_window)
