//@version=5
indicator("Array insert remove fixture")
ints = array.new_int()
ints.push(1)
ints.push(3)
array.insert(ints, 1, 2)
removed = ints.remove(0)
plot(removed)
plot(ints.get(0) * 10 + ints.get(1))

floats = array.new_float()
floats.push(close)
floats.insert(1, high)
plot(floats.get(0) + floats.get(1))

words = array.new_string()
words.push("a")
words.push("c")
words.insert(1, "b")
word_removed = array.remove(words, 2)
plot(word_removed == "c" and words.join("|") == "a|b" ? 1 : 0)

colors = array.new_color()
colors.push(color.red)
colors.insert(1, color.green)
color_removed = colors.remove(0)
plot(color_removed == color.red and colors.get(0) == color.green ? 1 : 0)

flags = array.new_bool()
flags.insert(0, true)
plot(flags.remove(0) ? flags.size() : 99)

negative = array.from(10, 20, 30)
plot(negative.get(-1) + negative.get(-3))
negative.set(-2, 99)
plot(negative.get(1))
negative.insert(-1, 25)
plot(negative.get(2) * 100 + negative.get(-1))
negative_head = negative.remove(-4)
negative_tail = negative.remove(-1)
plot(negative_head + negative_tail + negative.size())

computed_index = 1
computed_positions = array.from(5, 15)
computed_positions.insert(computed_index + 1, 25)
computed_removed = computed_positions.remove(computed_index)
plot(computed_removed + computed_positions.get(0) + computed_positions.get(computed_index))

branch_insert_remove = array.from(1, 4)
branch_insert_remove_score = bar_index * 0
if bar_index % 2 == 0
    array.insert(branch_insert_remove, 1, 2)
    branch_removed_even = branch_insert_remove.remove(2)
    branch_insert_remove_score := branch_removed_even * 100 + branch_insert_remove.get(0) * 10 + branch_insert_remove.get(1)
else
    branch_insert_remove.insert(1, 3)
    branch_removed_odd = array.remove(branch_insert_remove, 0)
    branch_insert_remove_score := branch_removed_odd * 100 + branch_insert_remove.get(0) * 10 + branch_insert_remove.get(1)
plot(branch_insert_remove_score)

loop_insert_remove = array.from(10)
loop_insert_remove_score = bar_index * 0
for i = 0 to 1
    if i == 0
        array.insert(loop_insert_remove, i + 1, 20)
        loop_insert_remove_score := loop_insert_remove_score + loop_insert_remove.remove(0)
    else
        loop_insert_remove.insert(i, 30)
        loop_insert_remove_score := loop_insert_remove_score + array.remove(loop_insert_remove, 1)
plot(loop_insert_remove_score * 10 + loop_insert_remove.size() + loop_insert_remove.get(0))

independent_insert_values = array.from(1, 4)
independent_insert_score = bar_index * 0
independent_insert_i = 0
while independent_insert_i < 1
    array.insert(independent_insert_values, 1, 2)
    independent_insert_values.insert(2, 3)
    independent_insert_score := independent_insert_values.get(0) * 1000 + independent_insert_values.get(1) * 100 + independent_insert_values.get(2) * 10 + independent_insert_values.get(3)
    independent_insert_i := independent_insert_i + 1
plot(independent_insert_score)

independent_remove_values = array.from(1, 2, 3, 4)
independent_remove_score = bar_index * 0
independent_remove_i = 0
while independent_remove_i < 1
    independent_removed_mid = array.remove(independent_remove_values, 1)
    independent_removed_tail = independent_remove_values.remove(-1)
    independent_remove_score := independent_removed_mid * 100 + independent_removed_tail * 10 + independent_remove_values.size()
    independent_remove_i := independent_remove_i + 1
plot(independent_remove_score)
