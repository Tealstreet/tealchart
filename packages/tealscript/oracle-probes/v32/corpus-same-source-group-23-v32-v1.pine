//@version=5
indicator("Change Edge Cases")
numeric_default = ta.change(close)
numeric_length = ta.change(close, 2)
invalid_zero = ta.change(close, 0)
invalid_negative = ta.change(close, -1)
dynamic_length = bar_index == 0 ? 1 : 2
numeric_dynamic_length = ta.change(close, dynamic_length)
udf_length() =>
    bar_index == 0 ? 1 : 2
numeric_udf_length = ta.change(close, udf_length())
missing_source = bar_index == 2 ? na : close
missing_default = ta.change(missing_source)
flag = bar_index == 0 ? false : bar_index == 1 ? false : bar_index == 2 ? true : false
flag_default = ta.change(flag)
flag_dynamic_length = ta.change(flag, dynamic_length)
flag_udf_length = ta.change(flag, udf_length())
missing_flag = bar_index == 2 ? na : close > 2
missing_flag_default = ta.change(missing_flag)
plot(numeric_default)
plot(numeric_length)
plot(invalid_zero)
plot(invalid_negative)
plot(numeric_dynamic_length)
plot(numeric_udf_length)
plot(missing_default)
plot(na(flag_default) ? 0 : flag_default ? 1 : -1)
plot(na(flag_dynamic_length) ? 0 : flag_dynamic_length ? 1 : -1)
plot(na(flag_udf_length) ? 0 : flag_udf_length ? 1 : -1)
plot(na(missing_flag_default) ? 0 : missing_flag_default ? 1 : -1)
