//@version=6
indicator("V56 live once rollback discriminator", calc_bars_count=32)
var int rollbackCount = 0
varip int retainedCount = 0
varip int tickControl = 0
varip int confirmedCount = 0
varip int firstLiveBar = na
if barstate.isrealtime
    if na(firstLiveBar)
        firstLiveBar := bar_index
    tickControl += 1
    once
        rollbackCount += 1
        retainedCount += 1
        log.info("ONCE bar={0} time={1} tick={2} confirmed={3} retained={4}", bar_index, timenow, tickControl, barstate.isconfirmed, retainedCount)
    once barstate.isconfirmed
        confirmedCount += 1
        log.info("CLOSE_ONCE bar={0} time={1} tick={2} retained={3}", bar_index, timenow, tickControl, confirmedCount)
    log.info("TICK bar={0} time={1} tick={2} confirmed={3} retained={4} closeCount={5}", bar_index, timenow, tickControl, barstate.isconfirmed, retainedCount, confirmedCount)
plot(rollbackCount, title="Once_RollbackVar")
plot(retainedCount, title="Once_RetainedVarip")
plot(confirmedCount, title="CloseOnce_RetainedVarip")
plot(tickControl, title="Tick_Control")
plot(firstLiveBar, title="FirstLiveBar_Control")
plot(bar_index, title="Bar_Index_Control")
plot(barstate.isconfirmed ? 1 : 0, title="Confirmed_Control")
plot(barstate.isrealtime ? 1 : 0, title="Realtime_Control")
plot(close, title="Close_Control")
var int captureSample = 0
plot(captureSample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
captureSample += 1
