//@version=6
indicator("Matrix equal-key row order", precision=0, calc_bars_count=32)
m = matrix.new<int>(3, 2, 0)
m.set(0, 0, 2)
m.set(0, 1, 17)
m.set(1, 0, 1)
m.set(1, 1, 43)
m.set(2, 0, 2)
m.set(2, 1, 29)
m.sort(0, order.ascending)
plot(m.get(0, 1), "ASC_ID0")
plot(m.get(1, 1), "ASC_ID1")
plot(m.get(2, 1), "ASC_ID2")
m.sort(0, order.descending)
plot(m.get(0, 1), "DESC_ID0")
plot(m.get(1, 1), "DESC_ID1")
plot(m.get(2, 1), "DESC_ID2")
var int captureSample = 0
plot(captureSample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
captureSample += 1
