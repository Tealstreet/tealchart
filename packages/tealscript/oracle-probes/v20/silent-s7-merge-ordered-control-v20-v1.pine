//@version=6
indicator("silent-s7-merge-ordered-control-v20-v1", precision=16)
var table id = table.new(position.top_right, 2, 2)
var int completed = 0
if barstate.islastconfirmedhistory
    table.cell(id, 0, 0, "A TOP-LEFT", bgcolor=color.green)
    table.cell(id, 1, 0, "B", bgcolor=color.blue)
    table.cell(id, 0, 1, "C", bgcolor=color.yellow)
    table.cell(id, 1, 1, "D BOTTOM-RIGHT", bgcolor=color.red)
    table.merge_cells(id, 0, 0, 1, 1)
    completed := 1
plot(bar_index, title="CHART_INDEX", display=display.data_window)
plot(time, title="CHART_TIME_MS", display=display.data_window)
plot(completed, title="MERGE_COMPLETED", display=display.data_window)
