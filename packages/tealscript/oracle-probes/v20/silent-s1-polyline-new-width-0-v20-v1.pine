//@version=6
indicator("silent-s1-polyline-new-width-0-v20-v1", precision=16)
var int completed = 0
if barstate.islastconfirmedhistory
    array<chart.point> points = array.from(chart.point.from_index(bar_index - 8, 4.0), chart.point.from_index(bar_index, 4.0))
    polyline.new(points, line_width=0, line_color=color.red)
    polyline.new(array.from(chart.point.from_index(bar_index - 8, 2.0), chart.point.from_index(bar_index, 2.0)), line_width=1, line_color=color.blue)
    polyline.new(array.from(chart.point.from_index(bar_index - 8, 0.0), chart.point.from_index(bar_index, 0.0)), line_width=100, line_color=color.green)
    completed := 1
plot(bar_index, title="CHART_INDEX", display=display.data_window)
plot(time, title="CHART_TIME_MS", display=display.data_window)
plot(0, title="REQUESTED_WIDTH", display=display.data_window)
plot(completed, title="CALL_COMPLETED", display=display.data_window)
plot(array.size(polyline.all), title="OBJECT_COUNT", display=display.data_window)
plot(6.0, title="PANE_TOP", color=color.new(color.gray, 100))
plot(-1.0, title="PANE_BOTTOM", color=color.new(color.gray, 100))
