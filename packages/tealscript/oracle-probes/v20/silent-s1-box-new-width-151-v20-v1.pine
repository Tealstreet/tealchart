//@version=6
indicator("silent-s1-box-new-width-151-v20-v1", precision=16)
var int completed = 0
if barstate.islastconfirmedhistory
    box id = box.new(bar_index - 8, 5.0, bar_index, 3.0, border_width=151, border_color=color.red, bgcolor=na)
    box.new(bar_index - 8, 2.0, bar_index - 5, 0.0, border_width=1, border_color=color.blue, bgcolor=na)
    box.new(bar_index - 3, 2.0, bar_index, 0.0, border_width=100, border_color=color.green, bgcolor=na)
    completed := 1
plot(bar_index, title="CHART_INDEX", display=display.data_window)
plot(time, title="CHART_TIME_MS", display=display.data_window)
plot(151, title="REQUESTED_WIDTH", display=display.data_window)
plot(completed, title="CALL_COMPLETED", display=display.data_window)
plot(array.size(box.all), title="OBJECT_COUNT", display=display.data_window)
plot(6.0, title="PANE_TOP", color=color.new(color.gray, 100))
plot(-1.0, title="PANE_BOTTOM", color=color.new(color.gray, 100))
