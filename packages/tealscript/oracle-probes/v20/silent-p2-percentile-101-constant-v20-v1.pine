//@version=6
indicator("silent-p2-percentile-101-constant-v20-v1", precision=16)
array<float> values = array.from(1.0, 2.0)
float percentage = 101.0
float result = array.percentile_linear_interpolation(values, percentage)
plot(bar_index, title="CHART_INDEX", display=display.data_window)
plot(time, title="CHART_TIME_MS", display=display.data_window)
plot(percentage, title="REQUESTED_PERCENTAGE", display=display.data_window)
plot(result, title="PERCENTILE_RESULT")
plot(na(result) ? 1 : 0, title="RESULT_NA", display=display.data_window)
