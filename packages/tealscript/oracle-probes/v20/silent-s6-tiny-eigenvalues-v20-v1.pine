//@version=6
indicator("silent-s6-tiny-eigenvalues-v20-v1", precision=16)
var matrix<float> m = matrix.new<float>(2, 2, 0.0)
if barstate.isfirst
    matrix.set(m, 0, 0, 0.000000000001)
    matrix.set(m, 1, 1, 0.000000000002)
array<float> eigen = matrix.eigenvalues(m)
plot(bar_index, title="CHART_INDEX", display=display.data_window)
plot(time, title="CHART_TIME_MS", display=display.data_window)
plot(array.get(eigen, 0), title="EIGEN_0")
plot(array.get(eigen, 0) * 1e12, title="EIGEN_0_SCALED_1E12")
plot(na(array.get(eigen, 0)) ? 1 : 0, title="EIGEN_0_NA", display=display.data_window)
plot(array.get(eigen, 1), title="EIGEN_1")
plot(array.get(eigen, 1) * 1e12, title="EIGEN_1_SCALED_1E12")
plot(na(array.get(eigen, 1)) ? 1 : 0, title="EIGEN_1_NA", display=display.data_window)
