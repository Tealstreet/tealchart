//@version=6
indicator("V44 math.max float NA matrix v1", precision = 8)

int mask = bar_index % 8
float a = mask % 2 == 1 ? na : -8.5
float b = mask % 4 >= 2 ? na : -4.25
float c = mask >= 4 ? na : -2.125
float missing = na
float ab = math.max(a, b)
float ba = math.max(b, a)
float abc = math.max(a, b, c)
float cba = math.max(c, b, a)
float missingFirst = math.max(missing, -4.25)
float missingLast = math.max(-4.25, missing)
float allMissing = math.max(missing, missing)

plot(bar_index, "INDEX")
plot(mask, "NA_MASK")
plot(a, "A")
plot(b, "B")
plot(c, "C")
plot(na(a) ? 1 : 0, "A_NA")
plot(na(b) ? 1 : 0, "B_NA")
plot(na(c) ? 1 : 0, "C_NA")
plot(ab, "MAX_AB")
plot(na(ab) ? 1 : 0, "MAX_AB_NA")
plot(ba, "MAX_BA")
plot(na(ba) ? 1 : 0, "MAX_BA_NA")
plot(abc, "MAX_ABC")
plot(na(abc) ? 1 : 0, "MAX_ABC_NA")
plot(cba, "MAX_CBA")
plot(na(cba) ? 1 : 0, "MAX_CBA_NA")
plot(missingFirst, "MISSING_FIRST")
plot(na(missingFirst) ? 1 : 0, "MISSING_FIRST_NA")
plot(missingLast, "MISSING_LAST")
plot(na(missingLast) ? 1 : 0, "MISSING_LAST_NA")
plot(allMissing, "ALL_MISSING")
plot(na(allMissing) ? 1 : 0, "ALL_MISSING_NA")
plot(math.max(-8.5, -8.5), "EQUAL_FINITE_CONTROL")
plot(math.max(-8.5, -4.25, -2.125), "NEGATIVE_CONTROL")
plot(math.max(-8.5, 0.0, -2.125), "ZERO_CONTROL")
plot(math.max(1.25, 2.5, -3.75), "POSITIVE_CONTROL")
