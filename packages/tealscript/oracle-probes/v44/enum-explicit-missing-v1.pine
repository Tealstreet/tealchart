//@version=6
indicator("V44 enum explicit missing v1")

enum State
    Up = "Up"
    Down = "Down"

State missing = na
State defined = State.Down

plot(bar_index, "INDEX")
plot(na(missing) ? 1 : 0, "MISSING_NA")
plot(missing == State.Up ? 1 : 0, "MISSING_EQ_UP")
plot(missing == State.Down ? 1 : 0, "MISSING_EQ_DOWN")
plot(na(defined) ? 1 : 0, "DEFINED_NA_CONTROL")
plot(defined == State.Down ? 1 : 0, "DEFINED_EQ_DOWN_CONTROL")
