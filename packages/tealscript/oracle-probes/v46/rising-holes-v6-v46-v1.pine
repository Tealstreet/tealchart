//@version=6
indicator("V46 rising-holes-v6", overlay=false)
phase = bar_index % 16
float src = phase == 0 ? 2.0 : phase == 1 ? 4.0 : phase == 2 ? na : phase == 3 ? 3.0 : phase == 4 ? 8.0 : phase == 5 ? 9.0 : phase == 6 ? na : phase == 7 ? 10.0 : phase == 8 ? 11.0 : phase == 9 ? 12.0 : phase == 10 ? na : phase == 11 ? 13.0 : phase == 12 ? 9.0 : phase == 13 ? na : phase == 14 ? 10.0 : 12.0
r1 = ta.rising(src, 1)
r2 = ta.rising(src, 2)
r3 = ta.rising(src, 3)
p1 = ta.valuewhen(not na(src), src, 1)
p2 = ta.valuewhen(not na(src), src, 2)
p3 = ta.valuewhen(not na(src), src, 3)
float w1 = na(src) or na(p1) ? na : (src > p1 ? 1.0 : 0.0)
float w2 = na(src) or na(p2) ? na : (src > p1 and src > p2 ? 1.0 : 0.0)
float w3 = na(src) or na(p3) ? na : (src > p1 and src > p2 and src > p3 ? 1.0 : 0.0)
var int adjacentRun = 0
if not na(src) and not na(src[1])
    adjacentRun := src > src[1] ? math.min(3, adjacentRun + 1) : 0
plot(bar_index, "INDEX", display=display.data_window)
plot(phase, "PHASE", display=display.data_window)
plot(src, "SRC", display=display.data_window)
plot(na(src) ? 1 : 0, "SRC_NA", display=display.data_window)
plot(r1 ? 1 : 0, "RISING_1", display=display.data_window)
plot(r2 ? 1 : 0, "RISING_2", display=display.data_window)
plot(r3 ? 1 : 0, "RISING_3", display=display.data_window)
plot(w1, "WINDOW_MODEL_1", display=display.data_window)
plot(w2, "WINDOW_MODEL_2", display=display.data_window)
plot(w3, "WINDOW_MODEL_3", display=display.data_window)
plot(adjacentRun >= 1 ? 1 : 0, "ADJACENT_MODEL_1", display=display.data_window)
plot(adjacentRun >= 2 ? 1 : 0, "ADJACENT_MODEL_2", display=display.data_window)
plot(adjacentRun >= 3 ? 1 : 0, "ADJACENT_MODEL_3", display=display.data_window)
plot(adjacentRun, "ADJACENT_RUN", display=display.data_window)
