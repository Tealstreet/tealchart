//@version=6
indicator("marker-plotshape-metrics-v6-v1", precision=2)
plot(0, "Y_ZERO", color=#808080)
plot(1, "Y_ONE", color=#808080)
plot(2, "Y_TWO", color=#808080)
plotshape(bar_index == last_bar_index - 13 ? 1.0 : na, title="circle_tiny", style=shape.circle, location=location.absolute, color=#F23645, size=size.tiny)
plotshape(bar_index == last_bar_index - 12 ? 1.0 : na, title="square_tiny", style=shape.square, location=location.absolute, color=#F23645, size=size.tiny)
plotshape(bar_index == last_bar_index - 11 ? 1.0 : na, title="triangleup_tiny", style=shape.triangleup, location=location.absolute, color=#F23645, size=size.tiny)
plotshape(bar_index == last_bar_index - 10 ? 1.0 : na, title="cross_tiny", style=shape.cross, location=location.absolute, color=#F23645, size=size.tiny)
plotshape(bar_index == last_bar_index - 9 ? 1.0 : na, title="circle_normal", style=shape.circle, location=location.absolute, color=#F23645, size=size.normal)
plotshape(bar_index == last_bar_index - 8 ? 1.0 : na, title="square_normal", style=shape.square, location=location.absolute, color=#F23645, size=size.normal)
plotshape(bar_index == last_bar_index - 7 ? 1.0 : na, title="triangleup_normal", style=shape.triangleup, location=location.absolute, color=#F23645, size=size.normal)
plotshape(bar_index == last_bar_index - 6 ? 1.0 : na, title="cross_normal", style=shape.cross, location=location.absolute, color=#F23645, size=size.normal)
plotshape(bar_index == last_bar_index - 5 ? 1.0 : na, title="circle_huge", style=shape.circle, location=location.absolute, color=#F23645, size=size.huge)
plotshape(bar_index == last_bar_index - 4 ? 1.0 : na, title="square_huge", style=shape.square, location=location.absolute, color=#F23645, size=size.huge)
plotshape(bar_index == last_bar_index - 3 ? 1.0 : na, title="triangleup_huge", style=shape.triangleup, location=location.absolute, color=#F23645, size=size.huge)
plotshape(bar_index == last_bar_index - 2 ? 1.0 : na, title="cross_huge", style=shape.cross, location=location.absolute, color=#F23645, size=size.huge)
