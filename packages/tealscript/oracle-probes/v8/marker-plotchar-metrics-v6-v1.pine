//@version=6
indicator("marker-plotchar-metrics-v6-v1", precision=2)
plot(0, "Y_ZERO", color=#808080)
plot(1, "Y_ONE", color=#808080)
plot(2, "Y_TWO", color=#808080)
plotchar(bar_index == last_bar_index - 13 ? 1.0 : na, title="char0_tiny", char="W", location=location.absolute, color=#2962FF, size=size.tiny)
plotchar(bar_index == last_bar_index - 12 ? 1.0 : na, title="char1_tiny", char="i", location=location.absolute, color=#2962FF, size=size.tiny)
plotchar(bar_index == last_bar_index - 11 ? 1.0 : na, title="char2_tiny", char="●", location=location.absolute, color=#2962FF, size=size.tiny)
plotchar(bar_index == last_bar_index - 10 ? 1.0 : na, title="char3_tiny", char="+", location=location.absolute, color=#2962FF, size=size.tiny)
plotchar(bar_index == last_bar_index - 9 ? 1.0 : na, title="char0_normal", char="W", location=location.absolute, color=#2962FF, size=size.normal)
plotchar(bar_index == last_bar_index - 8 ? 1.0 : na, title="char1_normal", char="i", location=location.absolute, color=#2962FF, size=size.normal)
plotchar(bar_index == last_bar_index - 7 ? 1.0 : na, title="char2_normal", char="●", location=location.absolute, color=#2962FF, size=size.normal)
plotchar(bar_index == last_bar_index - 6 ? 1.0 : na, title="char3_normal", char="+", location=location.absolute, color=#2962FF, size=size.normal)
plotchar(bar_index == last_bar_index - 5 ? 1.0 : na, title="char0_huge", char="W", location=location.absolute, color=#2962FF, size=size.huge)
plotchar(bar_index == last_bar_index - 4 ? 1.0 : na, title="char1_huge", char="i", location=location.absolute, color=#2962FF, size=size.huge)
plotchar(bar_index == last_bar_index - 3 ? 1.0 : na, title="char2_huge", char="●", location=location.absolute, color=#2962FF, size=size.huge)
plotchar(bar_index == last_bar_index - 2 ? 1.0 : na, title="char3_huge", char="+", location=location.absolute, color=#2962FF, size=size.huge)
