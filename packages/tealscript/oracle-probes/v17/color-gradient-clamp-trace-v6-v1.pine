//@version=6
indicator("Color gradient clamp TRACE v1", precision=16)
value = input.float(-1.0, "Value") + bar_index * 0.0
bottom = input.float(0.0, "Bottom")
top = input.float(1.0, "Top")
lower = color.new(color.rgb(17, 43, 91), 20)
upper = color.new(color.rgb(211, 149, 67), 80)
result = color.from_gradient(value, bottom, top, lower, upper)
plot(value, "VALUE")
plot(bottom, "BOTTOM")
plot(top, "TOP")
plot(color.r(result), "RESULT_R")
plot(color.g(result), "RESULT_G")
plot(color.b(result), "RESULT_B")
plot(color.t(result), "RESULT_T")
plot(na(result) ? 1 : 0, "RESULT_NA")
plot(color.r(lower), "LOWER_R")
plot(color.g(lower), "LOWER_G")
plot(color.b(lower), "LOWER_B")
plot(color.t(lower), "LOWER_T")
plot(color.r(upper), "UPPER_R")
plot(color.g(upper), "UPPER_G")
plot(color.b(upper), "UPPER_B")
plot(color.t(upper), "UPPER_T")
plot(bar_index, "PINE_INDEX")
plot(time, "TIME_MS")
