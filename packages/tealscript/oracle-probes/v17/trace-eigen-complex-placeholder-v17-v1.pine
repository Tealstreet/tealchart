//@version=6
indicator("Eigen complex placeholder trace v17 v1",precision=16)
m=matrix.new<float>(3,3,0)
m.set(0,1,-1)
m.set(1,0,1)
m.set(2,2,1)
a=matrix.eigenvalues(m)
n=array.size(a)
plot(bar_index,"INPUT_BAR_INDEX",display=display.data_window)
plot(n,"RESULT_SIZE",display=display.data_window)
plot(n>0?a.get(0):na,"EIGEN0",display=display.data_window)
plot(n>1?a.get(1):na,"EIGEN1",display=display.data_window)
plot(n>2?a.get(2):na,"EIGEN2",display=display.data_window)
