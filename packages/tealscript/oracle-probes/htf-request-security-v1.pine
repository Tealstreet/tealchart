//@version=6
indicator("HTF security oracle v1 — 2m chart", overlay=false, precision=10)
// Use standard candles, 2-minute chart, continuous liquid symbol. Export all indicator columns.
if timeframe.period != "2"
    runtime.error("Use a standard 2-minute chart")
hole() =>
    bar_index % 97 == 40 or bar_index % 97 == 41 ? na : close
edge(array<float> a, bool last) =>
    array.size(a) > 0 ? array.get(a, last ? array.size(a) - 1 : 0) : na
plot(open, title="chart_2m_open", display=display.data_window)
plot(high, title="chart_2m_high", display=display.data_window)
plot(low, title="chart_2m_low", display=display.data_window)
plot(close, title="chart_2m_close", display=display.data_window)
plot(volume, title="chart_2m_volume", display=display.data_window)
plot(time, title="chart_2m_time", display=display.data_window)
plot(bar_index, title="chart_2m_bar_index", display=display.data_window)
[h6_goff_loff_clean, h6_goff_loff_hole] = request.security(syminfo.tickerid, "6", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(h6_goff_loff_clean, title="htf6_close_clean_gapsoff_lookaheadoff", display=display.data_window)
plot(h6_goff_loff_hole, title="htf6_close_hole_gapsoff_lookaheadoff", display=display.data_window)
[h6_goff_lon_clean, h6_goff_lon_hole] = request.security(syminfo.tickerid, "6", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(h6_goff_lon_clean, title="htf6_close_clean_gapsoff_lookaheadon", display=display.data_window)
plot(h6_goff_lon_hole, title="htf6_close_hole_gapsoff_lookaheadon", display=display.data_window)
[h6_gon_loff_clean, h6_gon_loff_hole] = request.security(syminfo.tickerid, "6", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
plot(h6_gon_loff_clean, title="htf6_close_clean_gapson_lookaheadoff", display=display.data_window)
plot(h6_gon_loff_hole, title="htf6_close_hole_gapson_lookaheadoff", display=display.data_window)
[h6_gon_lon_clean, h6_gon_lon_hole] = request.security(syminfo.tickerid, "6", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
plot(h6_gon_lon_clean, title="htf6_close_clean_gapson_lookaheadon", display=display.data_window)
plot(h6_gon_lon_hole, title="htf6_close_hole_gapson_lookaheadon", display=display.data_window)
[h6_meta_prev, h6_meta_index, h6_meta_time, h6_meta_end] = request.security(syminfo.tickerid, "6", [close[1], bar_index, time, time_close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(h6_meta_prev, title="htf6_prev_gapsoff_lookaheadon", display=display.data_window)
plot(h6_meta_index, title="htf6_index_gapsoff_lookaheadon", display=display.data_window)
plot(h6_meta_time, title="htf6_time_gapsoff_lookaheadon", display=display.data_window)
plot(h6_meta_end, title="htf6_end_gapsoff_lookaheadon", display=display.data_window)
[h10_goff_loff_clean, h10_goff_loff_hole] = request.security(syminfo.tickerid, "10", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(h10_goff_loff_clean, title="htf10_close_clean_gapsoff_lookaheadoff", display=display.data_window)
plot(h10_goff_loff_hole, title="htf10_close_hole_gapsoff_lookaheadoff", display=display.data_window)
[h10_goff_lon_clean, h10_goff_lon_hole] = request.security(syminfo.tickerid, "10", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(h10_goff_lon_clean, title="htf10_close_clean_gapsoff_lookaheadon", display=display.data_window)
plot(h10_goff_lon_hole, title="htf10_close_hole_gapsoff_lookaheadon", display=display.data_window)
[h10_gon_loff_clean, h10_gon_loff_hole] = request.security(syminfo.tickerid, "10", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
plot(h10_gon_loff_clean, title="htf10_close_clean_gapson_lookaheadoff", display=display.data_window)
plot(h10_gon_loff_hole, title="htf10_close_hole_gapson_lookaheadoff", display=display.data_window)
[h10_gon_lon_clean, h10_gon_lon_hole] = request.security(syminfo.tickerid, "10", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
plot(h10_gon_lon_clean, title="htf10_close_clean_gapson_lookaheadon", display=display.data_window)
plot(h10_gon_lon_hole, title="htf10_close_hole_gapson_lookaheadon", display=display.data_window)
[h10_meta_prev, h10_meta_index, h10_meta_time, h10_meta_end] = request.security(syminfo.tickerid, "10", [close[1], bar_index, time, time_close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(h10_meta_prev, title="htf10_prev_gapsoff_lookaheadon", display=display.data_window)
plot(h10_meta_index, title="htf10_index_gapsoff_lookaheadon", display=display.data_window)
plot(h10_meta_time, title="htf10_time_gapsoff_lookaheadon", display=display.data_window)
plot(h10_meta_end, title="htf10_end_gapsoff_lookaheadon", display=display.data_window)
[h30_goff_loff_clean, h30_goff_loff_hole] = request.security(syminfo.tickerid, "30", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(h30_goff_loff_clean, title="htf30_close_clean_gapsoff_lookaheadoff", display=display.data_window)
plot(h30_goff_loff_hole, title="htf30_close_hole_gapsoff_lookaheadoff", display=display.data_window)
[h30_goff_lon_clean, h30_goff_lon_hole] = request.security(syminfo.tickerid, "30", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(h30_goff_lon_clean, title="htf30_close_clean_gapsoff_lookaheadon", display=display.data_window)
plot(h30_goff_lon_hole, title="htf30_close_hole_gapsoff_lookaheadon", display=display.data_window)
[h30_gon_loff_clean, h30_gon_loff_hole] = request.security(syminfo.tickerid, "30", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
plot(h30_gon_loff_clean, title="htf30_close_clean_gapson_lookaheadoff", display=display.data_window)
plot(h30_gon_loff_hole, title="htf30_close_hole_gapson_lookaheadoff", display=display.data_window)
[h30_gon_lon_clean, h30_gon_lon_hole] = request.security(syminfo.tickerid, "30", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
plot(h30_gon_lon_clean, title="htf30_close_clean_gapson_lookaheadon", display=display.data_window)
plot(h30_gon_lon_hole, title="htf30_close_hole_gapson_lookaheadon", display=display.data_window)
[h30_meta_prev, h30_meta_index, h30_meta_time, h30_meta_end] = request.security(syminfo.tickerid, "30", [close[1], bar_index, time, time_close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(h30_meta_prev, title="htf30_prev_gapsoff_lookaheadon", display=display.data_window)
plot(h30_meta_index, title="htf30_index_gapsoff_lookaheadon", display=display.data_window)
plot(h30_meta_time, title="htf30_time_gapsoff_lookaheadon", display=display.data_window)
plot(h30_meta_end, title="htf30_end_gapsoff_lookaheadon", display=display.data_window)
[lt, lo, lh, ll, lc, lv, lx] = request.security_lower_tf(syminfo.tickerid, "1", [float(time), open, high, low, close, volume, hole()])
plot(edge(lt, false), title="ltf1_time_first", display=display.data_window)
plot(edge(lt, true), title="ltf1_time_last", display=display.data_window)
plot(edge(lo, false), title="ltf1_open_first", display=display.data_window)
plot(edge(lo, true), title="ltf1_open_last", display=display.data_window)
plot(edge(lh, false), title="ltf1_high_first", display=display.data_window)
plot(edge(lh, true), title="ltf1_high_last", display=display.data_window)
plot(edge(ll, false), title="ltf1_low_first", display=display.data_window)
plot(edge(ll, true), title="ltf1_low_last", display=display.data_window)
plot(edge(lc, false), title="ltf1_close_first", display=display.data_window)
plot(edge(lc, true), title="ltf1_close_last", display=display.data_window)
plot(edge(lv, false), title="ltf1_volume_first", display=display.data_window)
plot(edge(lv, true), title="ltf1_volume_last", display=display.data_window)
plot(edge(lx, false), title="ltf1_hole_close_first", display=display.data_window)
plot(edge(lx, true), title="ltf1_hole_close_last", display=display.data_window)
plot(array.size(lc), title="ltf1_count", display=display.data_window)
var float manualPrev6 = na
if timeframe.change("6")
    manualPrev6 := close[1]
plot(manualPrev6, title="manual6_previous_close_from_chart", display=display.data_window)
plot(time_close == time_close("6") ? close : na, title="manual6_confirmed_close_on_last_2m_bar", display=display.data_window)
