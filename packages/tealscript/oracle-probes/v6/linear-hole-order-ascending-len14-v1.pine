//@version=6
indicator("Linear hole order ascending length14 v1", precision=16, max_bars_back=500)
phase = bar_index % 64
clean = 100.0 + phase
missing = phase == 20 or phase == 21
source = missing ? na : clean
plot(time, "input_time_ms", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(phase, "input_phase", display=display.data_window)
plot(clean, "input_clean", display=display.data_window)
plot(source, "input_source", display=display.data_window)
plot(missing ? 1 : 0, "input_missing", display=display.data_window)
plot(ta.percentile_linear_interpolation(source, 14, 75.0), "linear_hole_p75", display=display.data_window)
