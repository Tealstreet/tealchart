//@version=6
indicator("MFI private zero boundary v1", overlay=false, precision=16, max_bars_back=500)
// The 1e-10 guard is a candidate to discriminate, not a native contract.
// Export all 60 columns from bar_index0; preserve blanks and signed carries.

f_probe(scale) =>
    src = close * scale
    scaledChange = ta.change(src)
    rawChange = ta.change(close)
    pineUp = volume * (scaledChange <= 0.0 ? 0.0 : src)
    pineDown = volume * (scaledChange >= 0.0 ? 0.0 : src)
    unscaledSignUp = volume * (rawChange <= 0.0 ? 0.0 : src)
    unscaledSignDown = volume * (rawChange >= 0.0 ? 0.0 : src)
    pineUpSum = math.sum(pineUp, 2)
    pineDownSum = math.sum(pineDown, 2)
    upper = math.sum(unscaledSignUp, 2)
    lower = math.sum(unscaledSignDown, 2)
    pineReference = 100.0 - 100.0 / (1.0 + pineUpSum / pineDownSum)
    unscaledSignReference = 100.0 - 100.0 / (1.0 + upper / lower)
    smallUpper = math.abs(upper) / 0.0000000001 < 1.0
    smallLower = math.abs(lower) / 0.0000000001 < 1.0
    guardedUpper = smallUpper ? 0.0 : upper
    guardCandidate = smallLower ? 100.0 : 100.0 - 100.0 / (1.0 + guardedUpper / lower)
    nativeMfi = ta.mfi(src, 2)
    [nativeMfi, pineReference, unscaledSignReference, guardCandidate, upper / scale, lower / scale, pineUp / scale, pineDown / scale]

plot(time, "input_time_ms", display=display.data_window, editable=false)
plot(bar_index, "input_bar_index", display=display.data_window, editable=false)
plot(close, "input_close", display=display.data_window, editable=false)
plot(volume, "input_volume", display=display.data_window, editable=false)

[s0_builtin, s0_pine_reference, s0_unscaled_sign_reference, s0_guard_candidate, s0_upper_restored, s0_lower_restored, s0_pine_up_flow_restored, s0_pine_down_flow_restored] = f_probe(1.0 / 1.0)
plot(s0_builtin, "pow2_minus0_builtin", display=display.data_window, editable=false)
plot(s0_pine_reference, "pow2_minus0_pine_reference", display=display.data_window, editable=false)
plot(s0_unscaled_sign_reference, "pow2_minus0_unscaled_sign_reference", display=display.data_window, editable=false)
plot(s0_guard_candidate, "pow2_minus0_guard_candidate", display=display.data_window, editable=false)
plot(s0_upper_restored, "pow2_minus0_upper_restored", display=display.data_window, editable=false)
plot(s0_lower_restored, "pow2_minus0_lower_restored", display=display.data_window, editable=false)
plot(s0_pine_up_flow_restored, "pow2_minus0_pine_up_flow_restored", display=display.data_window, editable=false)
plot(s0_pine_down_flow_restored, "pow2_minus0_pine_down_flow_restored", display=display.data_window, editable=false)

[s1_builtin, s1_pine_reference, s1_unscaled_sign_reference, s1_guard_candidate, s1_upper_restored, s1_lower_restored, s1_pine_up_flow_restored, s1_pine_down_flow_restored] = f_probe(1.0 / 1048576.0)
