//@version=6
indicator("V45 CCI zero MAD", precision=16)
phase = bar_index % 16
source = phase < 8 or phase >= 11 ? 10.0 : phase == 8 ? 12.0 : phase == 9 ? 14.0 : 13.0
basis = ta.sma(source, 3)
deviation = ta.dev(source, 3)
value = ta.cci(source, 3)
ready = not na(source[2])
plot(bar_index, "INDEX")
plot(phase, "PHASE")
plot(source, "SOURCE")
plot(basis, "BASIS")
plot(deviation, "MAD")
plot(ready ? 1 : 0, "READY")
plot(value, "CCI")
plot(ready ? (na(value) ? 1 : 0) : na, "CCI_IS_NA")
plot(ready ? nz(value, 42.0) : na, "CCI_NZ42")
plot(ta.cci(float(phase), 3), "VARYING_CONTROL")
