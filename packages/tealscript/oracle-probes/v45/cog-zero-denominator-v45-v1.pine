//@version=6
indicator("V45 COG zero denominator", precision=16)
phase = bar_index % 12
source = switch phase
    3 => 1.0
    4 => -1.0
    6 => 1.0
    7 => 2.0
    8 => -3.0
    9 => 2.0
    10 => 3.0
    11 => 4.0
    => 0.0
denominator = math.sum(source, 3)
numerator = -(source + 2.0 * source[1] + 3.0 * source[2])
value = ta.cog(source, 3)
ready = not na(source[2])
plot(bar_index, "INDEX")
plot(phase, "PHASE")
plot(source, "SOURCE")
plot(denominator, "DENOMINATOR")
plot(numerator, "NUMERATOR")
plot(ready ? 1 : 0, "READY")
plot(value, "COG")
plot(ready ? (na(value) ? 1 : 0) : na, "COG_IS_NA")
plot(ready ? nz(value, 42.0) : na, "COG_NZ42")
plot(ta.cog(0.0, 3), "ALL_ZERO_CONTROL")
plot(ta.cog(2.0, 3), "FINITE_CONTROL")
