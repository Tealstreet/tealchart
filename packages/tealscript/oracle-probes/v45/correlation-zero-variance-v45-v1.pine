//@version=6
indicator("V45 correlation zero variance", precision=16)
source = float(bar_index % 16)
leftConstant = ta.correlation(2.0, source, 4)
rightConstant = ta.correlation(source, 3.0, 4)
bothConstant = ta.correlation(2.0, 3.0, 4)
ready = not na(source[3])
plot(bar_index, "INDEX")
plot(source, "VARYING_SOURCE")
plot(ta.stdev(source, 4), "VARYING_STDEV")
plot(ready ? 1 : 0, "READY")
plot(leftConstant, "LEFT_CONSTANT")
plot(rightConstant, "RIGHT_CONSTANT")
plot(bothConstant, "BOTH_CONSTANT")
plot(ready ? (na(leftConstant) ? 1 : 0) : na, "LEFT_IS_NA")
plot(ready ? (na(rightConstant) ? 1 : 0) : na, "RIGHT_IS_NA")
plot(ready ? (na(bothConstant) ? 1 : 0) : na, "BOTH_IS_NA")
plot(ready ? nz(leftConstant, 42.0) : na, "LEFT_NZ42")
plot(ready ? nz(rightConstant, 42.0) : na, "RIGHT_NZ42")
plot(ready ? nz(bothConstant, 42.0) : na, "BOTH_NZ42")
plot(ta.correlation(source, source, 4), "POSITIVE_CONTROL")
plot(ta.correlation(source, -source, 4), "NEGATIVE_CONTROL")
