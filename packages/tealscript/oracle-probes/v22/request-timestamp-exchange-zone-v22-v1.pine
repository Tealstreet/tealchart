//@version=6
indicator("Requested timestamp exchange zone v22 v1")
pack() =>
    literal = timestamp(2024, 1, 2, 3, 4, 5)
    explicit = timestamp(syminfo.timezone, 2024, 1, 2, 3, 4, 5)
    utc = timestamp("Etc/UTC", 2024, 1, 2, 3, 4, 5)
    midnight = timestamp(year, month, dayofmonth, 0, 0)
    explicitMidnight = timestamp(syminfo.timezone, year, month, dayofmonth, 0, 0)
    dateString = timestamp("02 Jan 2024 03:04:05")
    isNewYork = syminfo.timezone == "America/New_York" ? 1 : 0
    [time, literal, explicit, utc, midnight, explicitMidnight, dateString, isNewYork]
[remoteTime, literal, explicit, utc, midnight, explicitMidnight, dateString, isNewYork] = request.security("NASDAQ:MSFT", timeframe.period, pack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(time, title="CHART_TIME_MS")
plot(timestamp(2024, 1, 2, 3, 4, 5), title="CHART_IMPLICIT_LITERAL")
plot(remoteTime, title="REQUEST_TIME_MS")
plot(literal, title="REQUEST_IMPLICIT_LITERAL")
plot(explicit, title="REQUEST_EXPLICIT_EXCHANGE_LITERAL")
plot(utc, title="REQUEST_EXPLICIT_UTC_LITERAL")
plot(midnight, title="REQUEST_IMPLICIT_SERIES_MIDNIGHT")
plot(explicitMidnight, title="REQUEST_EXPLICIT_EXCHANGE_SERIES_MIDNIGHT")
plot(dateString, title="REQUEST_DATESTRING_UTC")
plot(isNewYork, title="REQUEST_ZONE_IS_NEWYORK")
