//@version=6
indicator("Round exact negative half ties")
series float negativeHalf = bar_index >= 0 ? -1.5 : na
plot(math.round(-0.5), title="Const_negative_half")
plot(math.round(-1.5), title="Const_negative_one_half")
plot(math.round(negativeHalf), title="Series_negative_one_half")
plot(math.round(1.5), title="Positive_one_half_control")
plot(math.round(-1.125, 2), title="Negative_precision_two")
plot(math.round(number=-1.125, precision=2), title="Named_negative_precision_two")
plot(math.round(1.125, 2), title="Positive_precision_two_control")
plot(math.round(-1.0625, 2), title="Negative_non_tie_control")
