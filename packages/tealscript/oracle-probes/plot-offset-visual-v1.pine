//@version=6
// 60 numeric plot slots; constant colors keep the plot-count at 60.
// Keep Shift input = 3 for the paired primitive controls.
// Series-valued offset is INVALID in v6; see companion notes.
indicator("Oracle plot-offset-visual v1", overlay=false, precision=8, max_bars_back=20)
int shiftInput = input.int(3, "Shift (keep 3 for primary run)", minval=1, maxval=10)
simple int shiftSimple = 3
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 97) - 48 + (b % 11) / 100.0
float holes = hole ? na : clean
// Positive-offset equivalent reads the past; negative-offset equivalent
// evaluates this deterministic source at the future index, never real OHLC.
int f = b + 3
float futureClean = (f % 97) - 48 + (f % 11) / 100.0
float futureHoles = f % 97 == 40 or f % 97 == 41 or f % 97 == 42 ? na : futureClean

plot(open, "input_open_raw", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(high, "input_high_raw", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(low, "input_low_raw", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(close, "input_close_raw", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(volume, "input_volume_raw", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(b, "input_bar_index_raw", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(hole ? 1 : 0, "input_hole_mod97_40_42", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(shiftInput, "input_offset_magnitude_default3", color=color.blue, style=plot.style_line, offset=0, display=display.data_window)
plot(clean, "line_clean_const0", color=color.blue, style=plot.style_line, offset=0)
plot(holes, "line_hole_const0", color=color.blue, style=plot.style_line, offset=0)
plot(holes, "line_hole_const_p3", color=color.blue, style=plot.style_line, offset=3)
plot(holes, "line_hole_const_m3", color=color.blue, style=plot.style_line, offset=-3)
plot(clean, "linebr_clean_const0", color=color.blue, style=plot.style_linebr, offset=0)
plot(holes, "linebr_hole_const0", color=color.blue, style=plot.style_linebr, offset=0)
plot(holes, "linebr_hole_const_p3", color=color.blue, style=plot.style_linebr, offset=3)
plot(holes, "linebr_hole_const_m3", color=color.blue, style=plot.style_linebr, offset=-3)
plot(clean, "stepline_clean_const0", color=color.blue, style=plot.style_stepline, offset=0)
plot(holes, "stepline_hole_const0", color=color.blue, style=plot.style_stepline, offset=0)
plot(holes, "stepline_hole_const_p3", color=color.blue, style=plot.style_stepline, offset=3)
plot(holes, "stepline_hole_const_m3", color=color.blue, style=plot.style_stepline, offset=-3)
plot(clean, "steplinebr_clean_const0", color=color.blue, style=plot.style_steplinebr, offset=0)
plot(holes, "steplinebr_hole_const0", color=color.blue, style=plot.style_steplinebr, offset=0)
plot(holes, "steplinebr_hole_const_p3", color=color.blue, style=plot.style_steplinebr, offset=3)
plot(holes, "steplinebr_hole_const_m3", color=color.blue, style=plot.style_steplinebr, offset=-3)
plot(clean, "area_clean_const0", color=color.blue, style=plot.style_area, offset=0)
plot(holes, "area_hole_const0", color=color.blue, style=plot.style_area, offset=0)
plot(holes, "area_hole_const_p3", color=color.blue, style=plot.style_area, offset=3)
plot(holes, "area_hole_const_m3", color=color.blue, style=plot.style_area, offset=-3)
plot(clean, "areabr_clean_const0", color=color.blue, style=plot.style_areabr, offset=0)
plot(holes, "areabr_hole_const0", color=color.blue, style=plot.style_areabr, offset=0)
plot(holes, "areabr_hole_const_p3", color=color.blue, style=plot.style_areabr, offset=3)
plot(holes, "areabr_hole_const_m3", color=color.blue, style=plot.style_areabr, offset=-3)
plot(clean, "histogram_clean_const0", color=color.blue, style=plot.style_histogram, offset=0)
plot(holes, "histogram_hole_const0", color=color.blue, style=plot.style_histogram, offset=0)
plot(holes, "histogram_hole_const_p3", color=color.blue, style=plot.style_histogram, offset=3)
plot(holes, "histogram_hole_const_m3", color=color.blue, style=plot.style_histogram, offset=-3)
plot(clean, "columns_clean_const0", color=color.blue, style=plot.style_columns, offset=0)
plot(holes, "columns_hole_const0", color=color.blue, style=plot.style_columns, offset=0)
plot(holes, "columns_hole_const_p3", color=color.blue, style=plot.style_columns, offset=3)
plot(holes, "columns_hole_const_m3", color=color.blue, style=plot.style_columns, offset=-3)
plot(clean, "circles_clean_const0", color=color.blue, style=plot.style_circles, offset=0)
plot(holes, "circles_hole_const0", color=color.blue, style=plot.style_circles, offset=0)
plot(holes, "circles_hole_const_p3", color=color.blue, style=plot.style_circles, offset=3)
plot(holes, "circles_hole_const_m3", color=color.blue, style=plot.style_circles, offset=-3)
plot(clean, "cross_clean_const0", color=color.blue, style=plot.style_cross, offset=0)
plot(holes, "cross_hole_const0", color=color.blue, style=plot.style_cross, offset=0)
plot(holes, "cross_hole_const_p3", color=color.blue, style=plot.style_cross, offset=3)
plot(holes, "cross_hole_const_m3", color=color.blue, style=plot.style_cross, offset=-3)
plot(clean[3], "primitive_clean_history3", color=color.blue, style=plot.style_line, offset=0)
plot(holes[3], "primitive_hole_history3", color=color.blue, style=plot.style_line, offset=0)
plot(futureClean, "primitive_clean_future3", color=color.blue, style=plot.style_line, offset=0)
plot(futureHoles, "primitive_hole_future3", color=color.blue, style=plot.style_line, offset=0)
plot(clean, "line_clean_input_p3", color=color.blue, style=plot.style_line, offset=shiftInput)
plot(holes, "line_hole_input_p3", color=color.blue, style=plot.style_line, offset=shiftInput)
plot(clean, "line_clean_input_m3", color=color.blue, style=plot.style_line, offset=-shiftInput)
plot(holes, "line_hole_input_m3", color=color.blue, style=plot.style_line, offset=-shiftInput)
plot(clean, "line_clean_simple_p3", color=color.blue, style=plot.style_line, offset=shiftSimple)
plot(holes, "line_hole_simple_p3", color=color.blue, style=plot.style_line, offset=shiftSimple)
plot(clean, "line_clean_simple_m3", color=color.blue, style=plot.style_line, offset=-shiftSimple)
plot(holes, "line_hole_simple_m3", color=color.blue, style=plot.style_line, offset=-shiftSimple)
