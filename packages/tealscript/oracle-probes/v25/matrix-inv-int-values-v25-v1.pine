//@version=6
indicator("matrix-inv-int-values-v25-v1", precision=16)
m = matrix.new<int>(2, 2, 0)
matrix.set(m, 0, 0, 1)
matrix.set(m, 0, 1, 2)
matrix.set(m, 1, 0, 3)
matrix.set(m, 1, 1, 4)
b = matrix.inv(m)
c = m.inv()
plot(matrix.get(b, 0, 0), "FUNCTION_00")
plot(matrix.get(b, 0, 1), "FUNCTION_01")
plot(matrix.get(b, 1, 0), "FUNCTION_10")
plot(matrix.get(b, 1, 1), "FUNCTION_11")
plot(matrix.get(c, 0, 0), "METHOD_00")
plot(matrix.get(c, 0, 1), "METHOD_01")
plot(matrix.get(c, 1, 0), "METHOD_10")
plot(matrix.get(c, 1, 1), "METHOD_11")
