//@version=6
indicator("HTF context 6m v16 v1", overlay=false, precision=10)
if timeframe.period != "2" or not chart.is_standard
    runtime.error("Use standard candles on a 2-minute chart")
hole() =>
    bar_index % 97 == 40 or bar_index % 97 == 41 ? na : close
[ro, rh, rl, rc, rv, rt, re, ri, rp, rx, rTick, rMove, rScale, rSymbol, rPeriod, rZone, rSession] = request.security(syminfo.tickerid, "6", [open, high, low, close, volume, time, time_close, bar_index, close[1], hole(), syminfo.mintick, syminfo.minmove, syminfo.pricescale, syminfo.tickerid, timeframe.period, syminfo.timezone, syminfo.session], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[gc, gx] = request.security(syminfo.tickerid, "6", [close, hole()], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_on)
[oc, ox] = request.security(syminfo.tickerid, "6", [close, hole()], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(time, "chart_time", display=display.data_window)
plot(time_close, "chart_end", display=display.data_window)
plot(bar_index, "chart_index", display=display.data_window)
plot(open, "chart_open", display=display.data_window)
plot(high, "chart_high", display=display.data_window)
plot(low, "chart_low", display=display.data_window)
plot(close, "chart_close", display=display.data_window)
plot(volume, "chart_volume", display=display.data_window)
plot(syminfo.mintick, "chart_tick", display=display.data_window)
plot(syminfo.minmove, "chart_minmove", display=display.data_window)
plot(syminfo.pricescale, "chart_pricescale", display=display.data_window)
plot(session.ismarket ? 1 : 0, "chart_regular", display=display.data_window)
plot(session.ispremarket ? 1 : 0, "chart_premarket", display=display.data_window)
plot(session.ispostmarket ? 1 : 0, "chart_postmarket", display=display.data_window)
plot(ro, "request_open", display=display.data_window)
plot(rh, "request_high", display=display.data_window)
plot(rl, "request_low", display=display.data_window)
plot(rc, "request_close_goff_lon", display=display.data_window)
plot(rv, "request_volume", display=display.data_window)
plot(rt, "request_time", display=display.data_window)
plot(re, "request_end", display=display.data_window)
plot(ri, "request_index", display=display.data_window)
plot(rp, "request_previous_close", display=display.data_window)
plot(rx, "request_hole_goff_lon", display=display.data_window)
plot(rTick, "request_tick", display=display.data_window)
plot(rMove, "request_minmove", display=display.data_window)
plot(rScale, "request_pricescale", display=display.data_window)
plot(gc, "request_close_gon_lon", display=display.data_window)
plot(gx, "request_hole_gon_lon", display=display.data_window)
plot(oc, "request_close_goff_loff", display=display.data_window)
plot(ox, "request_hole_goff_loff", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "chart_realtime", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "chart_confirmed", display=display.data_window)
if barstate.islastconfirmedhistory or barstate.islast
    log.info("CHART symbol=" + syminfo.tickerid + " standard=" + ticker.standard(syminfo.tickerid) + " period=" + timeframe.period + " timezone=" + syminfo.timezone + " session=" + syminfo.session)
    log.info("REQUEST symbol=" + rSymbol + " period=" + rPeriod + " timezone=" + rZone + " session=" + rSession)
