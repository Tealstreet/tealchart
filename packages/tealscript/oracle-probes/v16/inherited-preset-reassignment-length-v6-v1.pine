//@version=6
indicator("Inherited preset reassignment qualifier v1")
presetInput = input.string("Auto", "Preset", options=["Auto", "Scalping", "Swing"])
customAtrLen = input.int(14, "ATR length", minval=1)
customOscLen = input.int(14, "Oscillator length", minval=1)
customOscSmooth = input.int(3, "Smoothing", minval=1)
chartSeconds = timeframe.in_seconds()
resolvedPreset = presetInput
if presetInput == "Auto"
    if chartSeconds <= 5 * 60
        resolvedPreset := "Scalping"
    else
        resolvedPreset := "Swing"
atrLen = customAtrLen
if resolvedPreset == "Scalping"
    atrLen := 10
else if resolvedPreset == "Swing"
    atrLen := 21
oscLen = customOscLen
if resolvedPreset == "Scalping"
    oscLen := 9
else if resolvedPreset == "Swing"
    oscLen := 21
oscSmooth = customOscSmooth
if resolvedPreset == "Scalping"
    oscSmooth := 2
else if resolvedPreset == "Swing"
    oscSmooth := 4
plot(ta.atr(atrLen), "ATR", display=display.data_window)
plot(ta.rsi(close, oscLen), "RSI", display=display.data_window)
plot(ta.ema(close, oscSmooth), "EMA", display=display.data_window)
plot(atrLen, "ATR_LENGTH", display=display.data_window)
plot(oscLen, "OSC_LENGTH", display=display.data_window)
plot(oscSmooth, "SMOOTH_LENGTH", display=display.data_window)
plot(bar_index, "BAR_INDEX", display=display.data_window)
