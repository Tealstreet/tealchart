//@version=6
indicator("BBI cumulative and TSI state discriminators v1")
float clean = 20.0 + (bar_index % 7) * 3.0 - (bar_index % 3)
bool hole = bar_index < 60 or bar_index == 96 or bar_index == 97 or bar_index == 130 or bar_index == 258 or bar_index == 259
float source = hole ? na : clean
var float skipped = 0.0
var float sticky = 0.0
var float resumed = 0.0
if not na(source)
    skipped += source
sticky += source
resumed := nz(resumed[1], 0.0) + source
plot(bar_index, "BAR_INDEX")
plot(hole ? 1 : 0, "SOURCE_HOLE")
plot(source, "SOURCE")
plot(ta.cum(source), "CUM_HOLES")
plot(ta.cum(nz(source)), "CUM_ZERO_FILLED")
plot(skipped, "CONTROL_SKIP_CARRY")
plot(hole ? na : skipped, "CONTROL_SKIP_MASK_OUTPUT")
plot(sticky, "CONTROL_STICKY_NA")
plot(resumed, "CONTROL_RESUME_AFTER_NA")
plot(ta.tsi(source, 2, 3), "TSI_HOLES_2_3")
plot(ta.tsi(source, 3, 7), "TSI_HOLES_3_7")
plot(ta.tsi(clean, 2, 3), "TSI_CLEAN_2_3")
plot(ta.tsi(nz(source), 2, 3), "TSI_ZERO_FILLED_2_3")
