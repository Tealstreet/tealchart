//@version=6
indicator("V26 numeric container discriminators CNF v2")
phase = bar_index % 12
plot(phase, "Phase", display=display.data_window)
missingSize = phase % 4 == 0 ? 0 : phase % 4 == 1 ? 1 : phase % 4 == 2 ? 2 : 5
allMissing = array.new<float>(missingSize, na)
allStandard = array.standardize(allMissing)
emptyStandard = array.standardize(array.new<float>(0))
allMethod = allMissing.standardize()
allCode = array.size(allStandard) * 100 + array.size(allMethod) * 10 + array.size(emptyStandard)
plot(allCode, "R1217_AllNAEmpty_DropVsRetain", display=display.data_window)
mixed = array.new<float>(6, na)
if phase % 3 == 0
    array.set(mixed, 0, 2.0)
    array.set(mixed, 3, 10.0)
    array.set(mixed, 5, 18.0)
else if phase % 3 == 1
    array.set(mixed, 1, 2.0)
    array.set(mixed, 2, 10.0)
    array.set(mixed, 4, 18.0)
else
    array.set(mixed, 0, 2.0)
    array.set(mixed, 1, 10.0)
    array.set(mixed, 2, 18.0)
standard = array.standardize(mixed)
naMask = 0
finiteCount = 0
if array.size(standard) > 0
    for i = 0 to array.size(standard) - 1
        if na(array.get(standard, i))
            naMask += int(math.pow(2, i))
        else
            finiteCount += 1
plot(array.size(standard) * 1000000 + naMask * 1000 + finiteCount, "R1218_MixedNA_PreserveCompactPropagate", display=display.data_window)
rowOnly = matrix.new<float>(2, 2, 0.0)
rowOnly.set(0, 0, 0.8)
rowOnly.set(0, 1, 0.2)
rowOnly.set(1, 0, 0.6)
rowOnly.set(1, 1, 0.4)
colOnly = matrix.transpose(rowOnly)
negative = matrix.new<float>(2, 2, 0.0)
negative.set(0, 0, 1.2)
negative.set(0, 1, -0.2)
negative.set(1, 0, -0.2)
negative.set(1, 1, 1.2)
stochasticMask = (matrix.is_stochastic(rowOnly) ? 1 : 0) + (matrix.is_stochastic(colOnly) ? 2 : 0) + (matrix.is_stochastic(negative) ? 4 : 0) + (rowOnly.is_stochastic() ? 8 : 0) + (colOnly.is_stochastic() ? 16 : 0) + (negative.is_stochastic() ? 32 : 0)
plot(stochasticMask, "R1429_Stochastic_RowColumnNonnegative", display=display.data_window)
delta = phase == 0 ? 0.0 : phase == 1 ? 1e-12 : phase == 2 ? 1e-11 : phase == 3 ? 9.999e-11 : phase == 4 ? 1e-10 : phase == 5 ? 1.0001e-10 : phase == 6 ? 1e-9 : phase == 7 ? 1e-8 : phase == 8 ? -1e-12 : phase == 9 ? -1e-10 : phase == 10 ? -1.0001e-10 : -1e-9
zero = matrix.new<float>(2, 2, 0.0)
zero.set(0, 1, delta)
identity = matrix.new<float>(2, 2, 0.0)
identity.set(0, 0, 1.0)
identity.set(1, 1, 1.0)
identity.set(0, 1, delta)
symmetric = matrix.new<float>(2, 2, 0.0)
symmetric.set(0, 0, 1.0)
symmetric.set(0, 1, 2.0)
symmetric.set(1, 0, 2.0 + delta)
symmetric.set(1, 1, 3.0)
anti = matrix.new<float>(2, 2, 0.0)
anti.set(0, 1, 2.0)
anti.set(1, 0, -2.0 + delta)
predicateMask = (matrix.is_zero(zero) ? 1 : 0) + (matrix.is_binary(zero) ? 2 : 0) + (matrix.is_identity(identity) ? 4 : 0) + (matrix.is_symmetric(symmetric) ? 8 : 0) + (matrix.is_antisymmetric(anti) ? 16 : 0)
plot(predicateMask, "R1468_Predicates_ExactInclusiveExclusiveEpsilon", display=display.data_window)
ints = array.from(2, 2, 2, 7, 9)
floats = array.from(2.0, 2.0, 2.0, 7.0, 9.0)
intQuery = phase == 0 ? -1 : phase == 1 ? 2 : phase == 2 ? 3 : phase == 3 ? 6 : phase == 4 ? 7 : phase == 5 ? 8 : phase == 6 ? 9 : phase == 7 ? 10 : phase == 8 ? 0 : phase == 9 ? 1 : phase == 10 ? 4 : 5
floatQuery = phase == 0 ? 1.99999999999 : phase == 1 ? 2.0 : phase == 2 ? 2.00000000001 : phase == 3 ? 6.99999999999 : phase == 4 ? 7.0 : phase == 5 ? 7.00000000001 : phase == 6 ? 9.0 : phase == 7 ? 9.00000000001 : phase == 8 ? -1.0 : phase == 9 ? 10.0 : phase == 10 ? 4.5 : 8.5
plot(array.binary_search_rightmost(floats, floatQuery), "R1136_FloatNS_RightmostExactGapOutside", display=display.data_window)
plot(array.binary_search_rightmost(ints, intQuery), "R1137_IntNS_RightmostExactGapOutside", display=display.data_window)
plot(floats.binary_search_rightmost(floatQuery), "R1140_FloatMethod_RightmostExactGapOutside", display=display.data_window)
plot(ints.binary_search_rightmost(intQuery), "R1141_IntMethod_RightmostExactGapOutside", display=display.data_window)
