//@version=6
indicator("V26 matrix determinant static return kind CNF v2")
kindCode(int value) =>
    value * 0 + 1
kindCode(float value) =>
    value * 0 + 2
ints = matrix.new<int>(2, 2, 0)
ints.set(0, 0, 2)
ints.set(1, 1, 3)
floats = matrix.new<float>(2, 2, 0.0)
floats.set(0, 0, 2.0)
floats.set(1, 1, 3.0)
plot(kindCode(matrix.det(floats)), "R1324_FloatNS_StaticFloatVsNumericInt", display=display.data_window)
plot(kindCode(matrix.det(ints)), "R1325_IntNS_StaticIntVsGenericFloat", display=display.data_window)
plot(kindCode(floats.det()), "R1328_FloatMethod_StaticFloatVsNumericInt", display=display.data_window)
plot(kindCode(ints.det()), "R1329_IntMethod_StaticIntVsGenericFloat", display=display.data_window)
plot(kindCode(6), "Control_IntLiteral", display=display.data_window)
plot(kindCode(6.0), "Control_FloatLiteral", display=display.data_window)
