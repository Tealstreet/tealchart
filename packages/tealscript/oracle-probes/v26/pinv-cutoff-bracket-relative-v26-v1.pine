//@version=6
indicator("Pinv cutoff bracket and relative scale v26")
var tiny13=matrix.new<float>(2,2,0.0)
matrix.set(tiny13,0,0,1.0)
matrix.set(tiny13,1,1,1e-13)
p_tiny13=matrix.pinv(tiny13)
plot(matrix.get(p_tiny13,0,0),"tiny13 pinv00")
plot(matrix.get(p_tiny13,1,1),"tiny13 pinv11")
plot(matrix.get(tiny13,1,1),"tiny13 source11")
var tiny14=matrix.new<float>(2,2,0.0)
matrix.set(tiny14,0,0,1.0)
matrix.set(tiny14,1,1,1e-14)
p_tiny14=matrix.pinv(tiny14)
plot(matrix.get(p_tiny14,0,0),"tiny14 pinv00")
plot(matrix.get(p_tiny14,1,1),"tiny14 pinv11")
plot(matrix.get(tiny14,1,1),"tiny14 source11")
var tiny15=matrix.new<float>(2,2,0.0)
matrix.set(tiny15,0,0,1.0)
matrix.set(tiny15,1,1,1e-15)
p_tiny15=matrix.pinv(tiny15)
plot(matrix.get(p_tiny15,0,0),"tiny15 pinv00")
plot(matrix.get(p_tiny15,1,1),"tiny15 pinv11")
plot(matrix.get(tiny15,1,1),"tiny15 source11")
var scaled=matrix.new<float>(2,2,0.0)
matrix.set(scaled,0,0,1e6)
matrix.set(scaled,1,1,1e-12)
p_scaled=matrix.pinv(scaled)
plot(matrix.get(p_scaled,0,0),"scaled pinv00")
plot(matrix.get(p_scaled,1,1),"scaled pinv11")
plot(matrix.get(scaled,1,1),"scaled source11")
