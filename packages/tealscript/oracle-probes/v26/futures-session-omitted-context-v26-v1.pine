//@version=6
indicator("Futures session omitted context v26 v1", precision=16)
pack() =>
    [time, time_close, close, session.ismarket ? 1 : 0, session.isfirstbar_regular ? 1 : 0, session.islastbar_regular ? 1 : 0]
[ot, otc, oc, om, of, ol] = request.security("", "", pack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
[et, etc, ec, em, ef, el] = request.security(syminfo.tickerid, timeframe.period, pack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
regularId = ticker.modify(syminfo.tickerid, session=session.regular)
extendedId = ticker.modify(syminfo.tickerid, session=session.extended)
[rt, rtc, rc, rm, rf, rl] = request.security(regularId, timeframe.period, pack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
[xt, xtc, xc, xm, xf, xl] = request.security(extendedId, timeframe.period, pack(), gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plot(time_close, "CHART_CLOSE_MS", display=display.data_window)
plot(timenow, "OBSERVATION_TIME_MS", display=display.data_window)
plot(close, "CHART_CLOSE", display=display.data_window)
plot(session.ismarket ? 1 : 0, "CHART_MARKET", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, "CHART_REALTIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(ot, "OMITTED_TIME_MS", display=display.data_window)
plot(otc, "OMITTED_CLOSE_MS", display=display.data_window)
plot(oc, "OMITTED_PRICE", display=display.data_window)
plot(om, "OMITTED_MARKET", display=display.data_window)
plot(of, "OMITTED_FIRST_REGULAR", display=display.data_window)
plot(ol, "OMITTED_LAST_REGULAR", display=display.data_window)
plot(et, "EXPLICIT_TIME_MS", display=display.data_window)
plot(etc, "EXPLICIT_CLOSE_MS", display=display.data_window)
plot(ec, "EXPLICIT_PRICE", display=display.data_window)
plot(em, "EXPLICIT_MARKET", display=display.data_window)
plot(ef, "EXPLICIT_FIRST_REGULAR", display=display.data_window)
plot(el, "EXPLICIT_LAST_REGULAR", display=display.data_window)
plot(rt, "REGULAR_TIME_MS", display=display.data_window)
plot(rtc, "REGULAR_CLOSE_MS", display=display.data_window)
plot(rc, "REGULAR_PRICE", display=display.data_window)
plot(rm, "REGULAR_MARKET", display=display.data_window)
plot(rf, "REGULAR_FIRST_REGULAR", display=display.data_window)
plot(rl, "REGULAR_LAST_REGULAR", display=display.data_window)
plot(xt, "EXTENDED_TIME_MS", display=display.data_window)
plot(xtc, "EXTENDED_CLOSE_MS", display=display.data_window)
plot(xc, "EXTENDED_PRICE", display=display.data_window)
plot(xm, "EXTENDED_MARKET", display=display.data_window)
plot(xf, "EXTENDED_FIRST_REGULAR", display=display.data_window)
plot(xl, "EXTENDED_LAST_REGULAR", display=display.data_window)
var table context = table.new(position.top_right, 2, 7)
if barstate.islast
    table.cell(context, 0, 0, "Ticker ID")
    table.cell(context, 1, 0, syminfo.tickerid)
    table.cell(context, 0, 1, "Exchange timezone")
    table.cell(context, 1, 1, syminfo.timezone)
    table.cell(context, 0, 2, "Session")
    table.cell(context, 1, 2, syminfo.session)
    table.cell(context, 0, 3, "Timeframe")
    table.cell(context, 1, 3, timeframe.period)
    table.cell(context, 0, 4, "Minimum tick")
    table.cell(context, 1, 4, str.tostring(syminfo.mintick))
    table.cell(context, 0, 5, "Point value")
    table.cell(context, 1, 5, str.tostring(syminfo.pointvalue))
    table.cell(context, 0, 6, "Currency")
    table.cell(context, 1, 6, syminfo.currency)
