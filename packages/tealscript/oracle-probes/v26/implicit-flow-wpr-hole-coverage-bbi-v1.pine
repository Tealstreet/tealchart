//@version=6
indicator("BBI implicit flows and WPR missing coverage v1")
float previous = close[1]
float delta = ta.change(close)
float obvFlow = math.sign(delta) * volume
float pvtFlow = delta / previous * volume
float trueHigh = math.max(high, previous)
float trueLow = math.min(low, previous)
float wadFlow = close > previous ? close - trueLow : close < previous ? close - trueHigh : 0.0
bool priceHole = na(high) or na(low) or na(close)
bool volumeHole = na(volume)
plot(bar_index, "BAR_INDEX")
plot(high, "RAW_HIGH")
plot(low, "RAW_LOW")
plot(close, "RAW_CLOSE")
plot(volume, "RAW_VOLUME")
plot(priceHole ? 1 : 0, "PRICE_HOLE")
plot(volumeHole ? 1 : 0, "VOLUME_HOLE")
plot(ta.cum(priceHole ? 1 : 0), "PRICE_HOLE_COUNT")
plot(ta.cum(volumeHole ? 1 : 0), "VOLUME_HOLE_COUNT")
plot(obvFlow, "OBV_RAW_FLOW")
plot(pvtFlow, "PVT_RAW_FLOW")
plot(wadFlow, "WAD_RAW_FLOW")
plot(ta.obv, "OBV_BUILTIN")
plot(ta.cum(obvFlow), "OBV_DOCUMENTED_COMPOSITION")
plot(ta.cum(nz(obvFlow)), "OBV_ZERO_FLOW_CONTROL")
plot(ta.pvt, "PVT_BUILTIN")
plot(ta.cum(pvtFlow), "PVT_DOCUMENTED_COMPOSITION")
plot(ta.cum(nz(pvtFlow)), "PVT_ZERO_FLOW_CONTROL")
plot(ta.wad, "WAD_BUILTIN")
plot(ta.cum(wadFlow), "WAD_DOCUMENTED_COMPOSITION")
plot(ta.cum(nz(wadFlow)), "WAD_ZERO_FLOW_CONTROL")
plot(ta.wpr(1), "WPR_1")
plot(ta.wpr(3), "WPR_3")
plot(ta.wpr(7), "WPR_7")
float high3 = ta.highest(high, 3)
float low3 = ta.lowest(low, 3)
plot(-100.0 * (high3 - close) / (high3 - low3), "WPR_WINDOW_3_CONTROL")
plot(high3, "HIGH_WINDOW_3")
plot(low3, "LOW_WINDOW_3")
