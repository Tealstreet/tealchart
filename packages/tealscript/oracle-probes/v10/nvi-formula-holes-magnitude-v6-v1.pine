//@version=6
indicator("Synthetic NVI holes and plot magnitude v1", precision=16, max_bars_back=500)
phase = bar_index % 64
priceClean = 10.0 + phase % 7
priceHole = phase == 12 or phase == 13 ? na : priceClean
volumeFallHole = phase == 20 ? na : 100.0 - phase

f_vi(c, v, decrease) =>
    float value = 1.0
    float previous = nz(value[1], 0.0) == 0.0 ? 1.0 : value[1]
    if nz(c, 0.0) == 0.0 or nz(c[1], 0.0) == 0.0
        value := previous
    else
        value := (decrease ? v < nz(v[1], 0.0) : v > nz(v[1], 0.0)) ? previous + ((c - c[1]) / c[1]) * previous : previous
    value

// Pre-fix TealScript volume-index behavior, deliberately separate from the authority.
f_vi_legacy(c, v, decrease) =>
    var float value = 1.0
    if not na(c) and not na(c[1]) and c[1] != 0.0 and not na(v) and not na(v[1])
        if decrease ? v < v[1] : v > v[1]
            value := value + ((c - c[1]) / c[1]) * value
    value

docValue = f_vi(priceHole, volumeFallHole, true)
legacyValue = f_vi_legacy(priceHole, volumeFallHole, true)
plot(docValue, title="nvi_na_synthetic_doc")
plot(legacyValue, title="nvi_na_synthetic_legacy")
plot(docValue / 1e99, title="NVI doc scaled by 1e99", display=display.data_window)
plot(legacyValue / 1e99, title="NVI legacy scaled by 1e99", display=display.data_window)
plot(na(docValue) ? 1 : 0, title="NVI doc source is NA", display=display.data_window)
plot(na(legacyValue) ? 1 : 0, title="NVI legacy source is NA", display=display.data_window)
plot(priceHole, title="Input synthetic price", display=display.data_window)
plot(volumeFallHole, title="Input synthetic volume", display=display.data_window)
plot(phase, title="Input cycle phase", display=display.data_window)
plot(bar_index, title="Input bar index", display=display.data_window)
