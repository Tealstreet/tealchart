//@version=6
indicator("V52 qualifier-length-input-simple", calc_bars_count=32)
sourceText = input.string("abc", "Source")
value = str.length(sourceText)
consume(simple int sampleNumber) => sampleNumber
plot(consume(value), "CONSUMER")
plot(value, "TARGET")
plot(bar_index, "INDEX")
plot(close, "CONTROL_CLOSE")
