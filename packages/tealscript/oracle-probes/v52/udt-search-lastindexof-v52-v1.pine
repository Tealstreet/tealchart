//@version=6
indicator("V52 udt-search-lastindexof", calc_bars_count=32)
type Cell
    int value
original = Cell.new(7)
alias = original
sameFields = Cell.new(7)
values = array.from(original, sameFields, original)
plot(array.lastindexof(values, alias), "SAME_REFERENCE")
plot(array.lastindexof(values, sameFields), "DISTINCT_EQUAL_FIELDS")
notStored = Cell.new(7)
plot(array.lastindexof(values, notStored), "EQUAL_FIELDS_NOT_STORED")
original.value := 23
plot(array.lastindexof(values, alias), "SAME_REFERENCE_AFTER_FIELD_WRITE")
plot(array.lastindexof(values, sameFields), "DISTINCT_AFTER_FIELD_WRITE")
plot(array.lastindexof(values, notStored), "NOT_STORED_AFTER_FIELD_WRITE")
plot(bar_index, "BAR_INDEX")
