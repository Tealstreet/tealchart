//@version=5
indicator("w8-int-target-ternary-v5-v1", overlay=false, max_labels_count=10)
n = input.int(9, "Numerator", minval=1)
d = input.int(2, "Divisor", minval=1)
choose = input.bool(true, "Choose first")
int target = choose ? n / d : (n + 2) / d
plot(bar_index,"CHART_INDEX")
plot(choose ? n / d : (n + 2) / d,"RAW_QUOTIENT")
plot(target,"INT_TARGET")
plot(int(choose ? n / d : (n + 2) / d),"EXPLICIT_INT_CONTROL")
