//@version=6
indicator("V29 asymmetric polyline curve J v1", max_polylines_count=2)
var int anchor = na
if barstate.islastconfirmedhistory and bar_index >= 40
    anchor := bar_index - 30
    array<chart.point> points = array.new<chart.point>()
    array.push(points, chart.point.from_index(anchor, 20.0))
    array.push(points, chart.point.from_index(anchor + 4, 70.0))
    array.push(points, chart.point.from_index(anchor + 13, 15.0))
    array.push(points, chart.point.from_index(anchor + 17, 90.0))
    array.push(points, chart.point.from_index(anchor + 24, 40.0))
    polyline.new(points, curved=true, closed=false, xloc=xloc.bar_index, line_color=color.blue, line_width=2)
    polyline.new(points, curved=false, closed=false, xloc=xloc.bar_index, line_color=color.orange, line_width=1)
    log.info("CURVE anchor={0} dx=[0,4,13,17,24] y=[20,70,15,90,40]", anchor)
plot(anchor, "POINT0_INDEX", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(10.0, "LOW_AXIS_CONTROL", color=color.gray)
plot(100.0, "HIGH_AXIS_CONTROL", color=color.gray)
