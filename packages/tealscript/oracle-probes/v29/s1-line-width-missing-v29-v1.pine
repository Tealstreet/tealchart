//@version=6
indicator("s1-line-width-missing-v29-v1", precision=16)
int w=int(na)
var int completed=0
if barstate.islastconfirmedhistory
    line.new(bar_index-8,4,bar_index,4,width=w,color=color.red)
    line.new(bar_index-8,0,bar_index,0,width=1,color=color.blue)
    completed:=1
plot(completed,"CALL_COMPLETED")
plot(w,"REQUESTED_WIDTH")
plot(bar_index,"CHART_INDEX")
