//@version=6
indicator("Zero division observability and composition v1", precision=16)
positive = math.abs(close) + 1.0
zero = close - close
positiveRatio = positive / zero
negativeRatio = -positive / zero
zeroRatio = zero / zero
plot(close, "INPUT_CLOSE", display=display.data_window)
plot(bar_index, "INPUT_BAR_INDEX", display=display.data_window)
plot(positiveRatio, "POS_RAW", display=display.data_window)
plot(na(positiveRatio) ? 1 : 0, "POS_IS_NA", display=display.data_window)
plot(nz(positiveRatio, 42), "POS_NZ42", display=display.data_window)
plot(negativeRatio, "NEG_RAW", display=display.data_window)
plot(na(negativeRatio) ? 1 : 0, "NEG_IS_NA", display=display.data_window)
plot(nz(negativeRatio, 42), "NEG_NZ42", display=display.data_window)
plot(zeroRatio, "ZERO_RAW", display=display.data_window)
plot(na(zeroRatio) ? 1 : 0, "ZERO_IS_NA", display=display.data_window)
plot(nz(zeroRatio, 42), "ZERO_NZ42", display=display.data_window)
plot(100.0 - 100.0 / (1.0 + positiveRatio), "POS_ASSIGNED_COMPOSITE", display=display.data_window)
plot(100.0 - 100.0 / (1.0 + positive / zero), "POS_INLINE_COMPOSITE", display=display.data_window)
plot(100.0 - 100.0 / (1.0 + negativeRatio), "NEG_ASSIGNED_COMPOSITE", display=display.data_window)
plot(100.0 - 100.0 / (1.0 - positive / zero), "NEG_INLINE_COMPOSITE", display=display.data_window)
plot(100.0 - 100.0 / (1.0 + zeroRatio), "ZERO_ASSIGNED_COMPOSITE", display=display.data_window)
plot(100.0 - 100.0 / (1.0 + zero / zero), "ZERO_INLINE_COMPOSITE", display=display.data_window)
plot(na(positive / zero) ? 1 : 0, "POS_DIRECT_IS_NA", display=display.data_window)
plot(nz(positive / zero, 42), "POS_DIRECT_NZ42", display=display.data_window)
plot(5.0 / 2.0, "FINITE_CONTROL", display=display.data_window)
