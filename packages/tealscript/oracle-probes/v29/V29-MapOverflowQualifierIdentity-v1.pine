//@version=6
indicator("V29 map overflow qualifier identity v1", precision=16)
inputExponent = input.float(1000.0, "Exponent")
seriesExponent = inputExponent + bar_index * 0.0
plot(bar_index, "PineIndex", display=display.data_window)
plot(inputExponent, "InputExponent", display=display.data_window)
constMissing = float(na)
constPositive = math.exp(1000.0)
constNegative = -math.exp(1000.0)
constMap = map.new<float, int>()
constMap.put(constMissing, 11)
constSizeMissing = constMap.size()
constMap.put(constPositive, 22)
constSizePositive = constMap.size()
constMap.put(constNegative, 33)
constSizeNegative = constMap.size()
constRecomputedValue = constMap.get(math.exp(1000.0))
constRepeatedPrevious = constMap.put(math.exp(1000.0), 44)
constSizeRepeated = constMap.size()
plot(na(constMissing) ? 1 : 0, "ConstMissingNa", display=display.data_window)
plot(na(constPositive) ? 1 : 0, "ConstPositiveNa", display=display.data_window)
plot(na(constNegative) ? 1 : 0, "ConstNegativeNa", display=display.data_window)
plot(constPositive == constPositive ? 1 : 0, "ConstPositiveSelfEqual", display=display.data_window)
plot(constNegative == constNegative ? 1 : 0, "ConstNegativeSelfEqual", display=display.data_window)
plot(constMissing == constPositive ? 1 : 0, "ConstMissingEqualsPositive", display=display.data_window)
plot(constPositive == constNegative ? 1 : 0, "ConstPositiveEqualsNegative", display=display.data_window)
plot(constSizeMissing, "ConstSizeMissing", display=display.data_window)
plot(constSizePositive, "ConstSizePositive", display=display.data_window)
plot(constSizeNegative, "ConstSizeNegative", display=display.data_window)
plot(constMap.get(constMissing), "ConstMissingValue", display=display.data_window)
plot(constMap.get(constPositive), "ConstPositiveValue", display=display.data_window)
plot(constMap.get(constNegative), "ConstNegativeValue", display=display.data_window)
plot(constRecomputedValue, "ConstRecomputedValue", display=display.data_window)
plot(constRepeatedPrevious, "ConstRepeatedPrevious", display=display.data_window)
plot(constSizeRepeated, "ConstSizeRepeated", display=display.data_window)
plot(constMap.contains(constMissing) ? 1 : 0, "ConstContainsMissing", display=display.data_window)
plot(constMap.contains(constPositive) ? 1 : 0, "ConstContainsPositive", display=display.data_window)
plot(constMap.contains(constNegative) ? 1 : 0, "ConstContainsNegative", display=display.data_window)
