plot(inputNegative == inputNegative ? 1 : 0, "InputNegativeSelfEqual", display=display.data_window)
plot(inputMissing == inputPositive ? 1 : 0, "InputMissingEqualsPositive", display=display.data_window)
plot(inputPositive == inputNegative ? 1 : 0, "InputPositiveEqualsNegative", display=display.data_window)
plot(inputSizeMissing, "InputSizeMissing", display=display.data_window)
plot(inputSizePositive, "InputSizePositive", display=display.data_window)
plot(inputSizeNegative, "InputSizeNegative", display=display.data_window)
plot(inputMap.get(inputMissing), "InputMissingValue", display=display.data_window)
plot(inputMap.get(inputPositive), "InputPositiveValue", display=display.data_window)
plot(inputMap.get(inputNegative), "InputNegativeValue", display=display.data_window)
plot(inputRecomputedValue, "InputRecomputedValue", display=display.data_window)
plot(inputRepeatedPrevious, "InputRepeatedPrevious", display=display.data_window)
plot(inputSizeRepeated, "InputSizeRepeated", display=display.data_window)
plot(inputMap.contains(inputMissing) ? 1 : 0, "InputContainsMissing", display=display.data_window)
plot(inputMap.contains(inputPositive) ? 1 : 0, "InputContainsPositive", display=display.data_window)
plot(inputMap.contains(inputNegative) ? 1 : 0, "InputContainsNegative", display=display.data_window)
