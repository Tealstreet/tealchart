//@version=6
indicator("V29 map put_all capacity overflow J v1", precision=0)
var map<int, int> target = map.new<int, int>()
var map<int, int> incoming = map.new<int, int>()
var bool attempted = false
if barstate.isfirst
    map.put(incoming, 0, 222)
    map.put(incoming, 50000, 333)
    map.put(incoming, 50001, 444)
if not attempted
    for slot = 0 to 99
        if map.size(target) < 49999
            map.put(target, map.size(target), 111)
int beforeSize = map.size(target)
int beforeKey0 = map.get(target, 0)
if not attempted and beforeSize == 49999
    log.info("BEFORE size={0} key0={1} incoming=3 order=[0,50000,50001]", beforeSize, beforeKey0)
    map.put_all(target, incoming)
    attempted := true
    log.info("AFTER size={0} key0={1} key50000={2} key50001={3}", map.size(target), map.get(target, 0), map.get(target, 50000), map.get(target, 50001))
plot(bar_index, "CHART_INDEX")
plot(beforeSize, "PRE_SIZE")
plot(beforeKey0, "PRE_KEY0")
plot(map.size(target), "POST_SIZE")
plot(map.get(target, 0), "POST_KEY0")
plot(map.get(target, 50000), "POST_FIRST_NEW_KEY")
plot(map.get(target, 50001), "POST_SECOND_NEW_KEY")
plot(attempted ? 1 : 0, "COMPLETED_PUT_ALL")
