//@version=6
indicator("array-percentrank-size-and-ties-v29-v1", precision=16)
caseId = input.int(0, "CASE", minval=0, maxval=5)
values = switch caseId
    0 => array.from(8.0)
    1 => array.from(1.0, 2.0)
    2 => array.from(2.0, 2.0)
    3 => array.from(2.0, 2.0, 2.0)
    4 => array.from(1.0, 1.0, 2.0, 2.0, 4.0)
    => array.from(1.0, 2.0, 2.0, 4.0)
size = array.size(values)
plot(caseId, "CASE")
plot(bar_index, "INPUT_BAR_INDEX")
plot(time, "INPUT_TIME_MS")
plot(size, "SIZE")
plot(size > 0 ? array.get(values, 0) : na, "SOURCE_0")
plot(size > 1 ? array.get(values, 1) : na, "SOURCE_1")
plot(size > 2 ? array.get(values, 2) : na, "SOURCE_2")
plot(size > 3 ? array.get(values, 3) : na, "SOURCE_3")
plot(size > 4 ? array.get(values, 4) : na, "SOURCE_4")
plot(array.percentrank(values, 0), "RANK_NAMESPACE_0")
plot(size > 1 ? array.percentrank(values, 1) : na, "RANK_NAMESPACE_1")
plot(size > 2 ? array.percentrank(values, 2) : na, "RANK_NAMESPACE_2")
plot(size > 3 ? array.percentrank(values, 3) : na, "RANK_NAMESPACE_3")
plot(size > 4 ? array.percentrank(values, 4) : na, "RANK_NAMESPACE_4")
plot(values.percentrank(0), "RANK_METHOD_0")
plot(size > 1 ? values.percentrank(1) : na, "RANK_METHOD_1")
plot(size > 2 ? values.percentrank(2) : na, "RANK_METHOD_2")
plot(size > 3 ? values.percentrank(3) : na, "RANK_METHOD_3")
plot(size > 4 ? values.percentrank(4) : na, "RANK_METHOD_4")
