//@version=6
indicator("w8-seconds-literal-v6-v1", overlay=false, max_labels_count=10)
divisor = input.int(7,"Divisor",minval=1)
chartSeconds = timeframe.in_seconds(timeframe.period)
secondsAlias = chartSeconds / divisor
resolved = timeframe.from_seconds(17.5)
control = timeframe.from_seconds(int(17.5))
plot(bar_index,"CHART_INDEX")
plot(17.5,"SECONDS_ARGUMENT")
plot(timeframe.in_seconds(resolved),"RESOLVED_SECONDS")
plot(timeframe.in_seconds(control),"EXPLICIT_INT_SECONDS")
if barstate.islastconfirmedhistory
    label.new(bar_index,close,"resolved="+resolved+"; control="+control)
