//@version=6
indicator("s1-box-width-missing-v29-v1", precision=16)
int w=int(na)
var int completed=0
if barstate.islastconfirmedhistory
    box.new(bar_index-8,4,bar_index,2,border_width=w,border_color=color.red,bgcolor=na)
    box.new(bar_index-8,0,bar_index,-2,border_width=1,border_color=color.blue,bgcolor=na)
    completed:=1
plot(completed,"CALL_COMPLETED")
plot(w,"REQUESTED_WIDTH")
plot(bar_index,"CHART_INDEX")
