//@version=6
indicator("S6 tiny eigenvector components v29 v1", precision=16)
float coupling = input.float(1e-12, "Off-diagonal coupling")
var matrix<float> target = matrix.new<float>(2, 2, 0.0)
if barstate.isfirst
    matrix.set(target, 0, 0, 1.0)
    matrix.set(target, 0, 1, coupling)
    matrix.set(target, 1, 0, coupling)
    matrix.set(target, 1, 1, 2.0)
var matrix<float> vectors = matrix.eigenvectors(target)
float v00 = matrix.get(vectors, 0, 0)
float v01 = matrix.get(vectors, 0, 1)
float v10 = matrix.get(vectors, 1, 0)
float v11 = matrix.get(vectors, 1, 1)
float small0 = math.min(math.abs(v00), math.abs(v10))
float small1 = math.min(math.abs(v01), math.abs(v11))
plot(bar_index, "CHART_INDEX")
plot(time, "CHART_TIME_MS")
plot(close, "CHART_CLOSE")
plot(coupling, "COUPLING")
plot(v00, "VECTOR_00_RAW")
plot(v01, "VECTOR_01_RAW")
plot(v10, "VECTOR_10_RAW")
plot(v11, "VECTOR_11_RAW")
plot(small0, "COLUMN_0_SMALL_ABS")
plot(small1, "COLUMN_1_SMALL_ABS")
plot(small0 / coupling, "COLUMN_0_SMALL_OVER_COUPLING")
plot(small1 / coupling, "COLUMN_1_SMALL_OVER_COUPLING")
plot((na(v00) ? 1 : 0) + (na(v01) ? 1 : 0) + (na(v10) ? 1 : 0) + (na(v11) ? 1 : 0), "VECTOR_NA_COUNT")
