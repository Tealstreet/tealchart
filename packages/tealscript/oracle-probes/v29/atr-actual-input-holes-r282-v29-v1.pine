//@version=6
indicator("V29 ATR actual input holes J v1", precision=16)
float trTrue = ta.tr(true)
float trFalse = ta.tr(false)
float nativeAtr = ta.atr(3)
float trueRma = ta.rma(trTrue, 3)
float falseRma = ta.rma(trFalse, 3)
plot(bar_index, "CHART_INDEX")
plot(time, "CHART_TIME_MS")
plot(high, "INPUT_HIGH")
plot(low, "INPUT_LOW")
plot(close, "INPUT_CLOSE")
plot(close[1], "INPUT_PRIOR_CLOSE")
plot(na(high) or na(low) or na(close) ? 1 : 0, "INPUT_OHLC_NA")
plot(na(close[1]) ? 1 : 0, "PRIOR_CLOSE_NA")
plot(trTrue, "TR_HANDLE_TRUE")
plot(trFalse, "TR_HANDLE_FALSE")
plot(nativeAtr, "ATR_LEN3")
plot(trueRma, "RMA_TRUE_TR_CONTROL")
plot(falseRma, "RMA_FALSE_TR_CANDIDATE")
plot(na(nativeAtr) ? 1 : 0, "ATR_NA")
