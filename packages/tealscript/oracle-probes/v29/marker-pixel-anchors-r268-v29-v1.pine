//@version=6
indicator("V29 marker pixel anchors J v1", overlay=false)
int phase = bar_index % 16
plot(100.0, "Y_ANCHOR", color=color.gray)
plot(phase, "PHASE", display=display.data_window)
plot(bar_index, "CHART_INDEX", display=display.data_window)
plot(time, "CHART_TIME_MS", display=display.data_window)
plotshape(phase == 2 ? 100.0 : na, title="TRIANGLE_TINY", style=shape.triangleup, location=location.absolute, color=color.blue, size=size.tiny)
plotshape(phase == 5 ? 100.0 : na, title="TRIANGLE_NORMAL", style=shape.triangleup, location=location.absolute, color=color.blue, size=size.normal)
plotshape(phase == 8 ? 100.0 : na, title="CIRCLE_NORMAL", style=shape.circle, location=location.absolute, color=color.orange, size=size.normal)
plotchar(phase == 11 ? 100.0 : na, title="CHAR_A_NORMAL", char="A", location=location.absolute, color=color.red, size=size.normal)
