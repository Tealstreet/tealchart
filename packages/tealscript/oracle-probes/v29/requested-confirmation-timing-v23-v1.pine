//@version=6
indicator("Requested confirmation timing v23 v1", precision=16)
varip int updates = 0
if barstate.isnew
    updates := 0
updates += 1
pack() =>
    [time, time_close, barstate.isconfirmed ? 1 : 0, barstate.ishistory ? 1 : 0, barstate.isrealtime ? 1 : 0, barstate.isnew ? 1 : 0]
[st, sc, sconfirmed, shistory, srealtime, snew] = request.security(syminfo.tickerid, timeframe.period, pack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[ht, hc, hconfirmed, hhistory, hrealtime, hnew] = request.security(syminfo.tickerid, "10", pack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(bar_index, title="CHART_INDEX", display=display.data_window)
plot(time, title="CHART_TIME_MS", display=display.data_window)
plot(time_close, title="CHART_CLOSE_TIME_MS", display=display.data_window)
plot(timenow, title="CHART_TIMENOW_MS", display=display.data_window)
plot(updates, title="CHART_UPDATE_COUNT", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED", display=display.data_window)
plot(barstate.ishistory ? 1 : 0, title="CHART_HISTORY", display=display.data_window)
plot(barstate.isrealtime ? 1 : 0, title="CHART_REALTIME", display=display.data_window)
plot(barstate.isnew ? 1 : 0, title="CHART_NEW", display=display.data_window)
plot(st, title="SAME_TIME_MS", display=display.data_window)
plot(sc, title="SAME_CLOSE_TIME_MS", display=display.data_window)
plot(sconfirmed, title="SAME_CONFIRMED", display=display.data_window)
plot(shistory, title="SAME_HISTORY", display=display.data_window)
plot(srealtime, title="SAME_REALTIME", display=display.data_window)
plot(snew, title="SAME_NEW", display=display.data_window)
plot(ht, title="HTF_TIME_MS", display=display.data_window)
plot(hc, title="HTF_CLOSE_TIME_MS", display=display.data_window)
plot(hconfirmed, title="HTF_CONFIRMED", display=display.data_window)
plot(hhistory, title="HTF_HISTORY", display=display.data_window)
plot(hrealtime, title="HTF_REALTIME", display=display.data_window)
plot(hnew, title="HTF_NEW", display=display.data_window)
