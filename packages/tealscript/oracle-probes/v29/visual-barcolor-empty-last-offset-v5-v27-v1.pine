//@version=5
indicator("V27 barcolor empty last offset v5", overlay=false)
edgeShift = input.int(3, "Edge shift", minval=-3, maxval=3)
m = bar_index % 64
sourceOffset = m < 16 ? 2 : m < 32 ? -2 : m < 48 ? 0 : 3
dynamicOffset = barstate.islast ? edgeShift : sourceOffset
event = m % 8 == 4 and not barstate.islast
zeroEvent = m % 8 == 0 and not barstate.islast
plusEvent = m % 8 == 1 and not barstate.islast
minusEvent = m % 8 == 7 and not barstate.islast
shade = event ? (m < 16 ? color.red : m < 32 ? color.lime : m < 48 ? color.aqua : color.fuchsia) : na
barcolor(shade, offset=dynamicOffset)
barcolor(zeroEvent ? color.white : na, offset=0)
barcolor(plusEvent ? color.orange : na, offset=2)
barcolor(minusEvent ? color.yellow : na, offset=-2)
plot(bar_index, title="BAR_INDEX", display=display.data_window)
plot(m, title="SOURCE_INDEX_MOD64", display=display.data_window)
plot(sourceOffset, title="SOURCE_OFFSET", display=display.data_window)
plot(dynamicOffset, title="DYNAMIC_OFFSET", display=display.data_window)
plot(edgeShift, title="EDGE_INPUT", display=display.data_window)
plot(event ? 1 : 0, title="DYNAMIC_EVENT", display=display.data_window)
plot(zeroEvent ? 1 : 0, title="ZERO_EVENT", display=display.data_window)
plot(plusEvent ? 1 : 0, title="PLUS_EVENT", display=display.data_window)
plot(minusEvent ? 1 : 0, title="MINUS_EVENT", display=display.data_window)
