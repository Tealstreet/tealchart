//@version=3
study("V11 visual offsets v3", overlay=false, precision=6)
phase = bar_index % 7
shift = phase < 2 ? -2 : phase < 5 ? 1 : 3
event = bar_index % 8 == 0
plot(bar_index / 1000.0, title="SOURCE_INDEX_SCALED", color=black)
plot(shift, title="SOURCE_SHIFT", color=black)
plot(event ? bar_index / 1000.0 : na, title="EVENT_INDEX_SCALED", color=black)
plot(100 + phase, title="DYNAMIC_PLOT", offset=shift, color=blue)
plot(100 + phase, title="ZERO_PLOT", color=red)
plotshape(event ? 200 + phase : na, title="DYNAMIC_SHAPE", style=shape.circle, location=location.absolute, offset=shift, color=blue)
plotshape(event ? 200 + phase : na, title="ZERO_SHAPE", style=shape.circle, location=location.absolute, color=red)
plotchar(event ? 300 + phase : na, title="DYNAMIC_CHAR", char="X", location=location.absolute, offset=shift, color=blue)
plotchar(event ? 300 + phase : na, title="ZERO_CHAR", char="X", location=location.absolute, color=red)
plotarrow(event ? (phase % 2 == 0 ? 1 : -1) : 0, title="DYNAMIC_ARROW", offset=shift, colorup=blue, colordown=blue, minheight=20, maxheight=20)
plotarrow(event ? (phase % 2 == 0 ? 1 : -1) : 0, title="ZERO_ARROW", colorup=red, colordown=red, minheight=10, maxheight=10)
bgcolor(event ? blue : na, title="DYNAMIC_BACKGROUND", offset=shift)
barcolor(event ? blue : na, title="DYNAMIC_BAR", offset=shift)
