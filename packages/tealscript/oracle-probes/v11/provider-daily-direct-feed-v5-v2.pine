//@version=5
indicator("V11 direct daily provider prefix", overlay=false, precision=12)
if not timeframe.isdaily or timeframe.multiplier != 1
    runtime.error("Use BINANCE BTCUSDT standard daily candles")
var int firstTime = time
var count = 0
if timeframe.change("1D")
    count += 1
var int firstCount = count
plot(open, "FEED_open", display=display.data_window)
plot(high, "FEED_high", display=display.data_window)
plot(low, "FEED_low", display=display.data_window)
plot(close, "FEED_close", display=display.data_window)
plot(volume, "FEED_volume", display=display.data_window)
plot(time, "FEED_time", display=display.data_window)
plot(time_close, "FEED_time_close", display=display.data_window)
plot(bar_index, "FEED_bar_index", display=display.data_window)
plot(timenow, "FEED_timenow", display=display.data_window)
plot(firstTime, "FEED_first_time", display=display.data_window)
plot(firstCount, "FEED_first_count", display=display.data_window)
plot(count, "FEED_counter_control", display=display.data_window)
