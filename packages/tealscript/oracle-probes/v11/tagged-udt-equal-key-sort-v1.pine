//@version=6
indicator("V11 tagged-udt-equal-key-sort-v1", max_bars_back=256)
type Tagged
    int key
    int tag
items = array.from(Tagged.new(1, 10), Tagged.new(0, 20), Tagged.new(1, 30), Tagged.new(1, 40), Tagged.new(0, 50))
array.sort(items, order.ascending, "key")
first = array.get(items, 0)
second = array.get(items, 1)
third = array.get(items, 2)
fourth = array.get(items, 3)
fifth = array.get(items, 4)
plot(first.tag, "TAG0")
plot(second.tag, "TAG1")
plot(third.tag, "TAG2")
plot(fourth.tag, "TAG3")
plot(fifth.tag, "TAG4")
