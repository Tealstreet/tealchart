//@version=6
indicator("V11 curve geometry and point copies", max_polylines_count=10, max_labels_count=16)
hline(-4, "LOWER_CALIBRATION")
hline(0, "ZERO_CALIBRATION")
hline(4, "UPPER_CALIBRATION")
hline(12, "MUTATED_CALIBRATION")
hline(20, "UNIFORM_BASE")
if barstate.islastconfirmedhistory
    p0 = chart.point.from_index(bar_index - 12, 1)
    p1 = chart.point.from_index(bar_index - 10, 4)
    p2 = chart.point.from_index(bar_index - 5, -2)
    p3 = chart.point.from_index(bar_index, 2)
    points = array.from(p0, p1, p2, p3)
    polyline.new(points, curved=true, line_color=color.red, line_width=3)
    polyline.new(points, curved=false, line_color=color.blue, line_width=1)
    label.new(p0, "A", style=label.style_none)
    label.new(p1, "B", style=label.style_none)
    label.new(p2, "C", style=label.style_none)
    label.new(p3, "D", style=label.style_none)
    p1.price := 12
    polyline.new(points, curved=true, line_color=color.green, line_width=2)
    label.new(p1, "B mutated", style=label.style_none)
    uniform = array.from(chart.point.from_index(bar_index - 12, 21), chart.point.from_index(bar_index - 8, 24), chart.point.from_index(bar_index - 4, 18), chart.point.from_index(bar_index, 22))
    polyline.new(uniform, curved=true, line_color=color.orange, line_width=3)
    polyline.new(uniform, curved=false, line_color=color.purple, line_width=1)
plot(bar_index, "BAR_INDEX", display=display.data_window)
plot(barstate.islastconfirmedhistory ? bar_index : na, "DRAWING_END_INDEX", display=display.data_window)
plot(array.size(polyline.all), "POLYLINE_COUNT", display=display.data_window)
