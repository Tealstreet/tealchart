//@version=5
indicator("V11 legacy-cross-hole-matrix-v1", max_bars_back=256)
n = bar_index
x = n < 2 or n % 7 == 3 ? na : float(n % 5 - 2)
y = n % 9 == 6 ? na : 0.0
up = ta.crossover(x, y)
down = ta.crossunder(x, y)
both = ta.cross(x, y)
plot(float(n), "BAR_INDEX")
plot(x, "X")
plot(y, "Y")
plot(na(up) ? -1 : up ? 1 : 0, "CROSSOVER_STATE")
plot(na(down) ? -1 : down ? 1 : 0, "CROSSUNDER_STATE")
plot(na(both) ? -1 : both ? 1 : 0, "CROSS_STATE")
