//@version=3
study("V11 isolated plotarrow offset v3", overlay=false, precision=6)
phase = bar_index % 7
shift = phase < 2 ? -2 : phase < 5 ? 1 : 3
event = bar_index % 8 == 0
plot(bar_index / 1000.0, title="SOURCE_INDEX_SCALED")
plot(shift, title="SOURCE_SHIFT")
plot(event ? bar_index / 1000.0 : na, title="EVENT_INDEX_SCALED")
plotarrow(event ? (phase % 2 == 0 ? 1 : -1) : 0, title="TARGET", offset=shift, colorup=blue, colordown=blue, minheight=20, maxheight=20)
plotarrow(event ? (phase % 2 == 0 ? 1 : -1) : 0, title="ZERO_CONTROL", colorup=red, colordown=red, minheight=10, maxheight=10)
