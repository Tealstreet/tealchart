//@version=6
indicator("V11 four-family retention", max_labels_count=3, max_lines_count=3, max_boxes_count=3, max_polylines_count=3)
var labels = array.new<label>()
var lines = array.new<line>()
var boxes = array.new<box>()
var curves = array.new<polyline>()
if bar_index < 32
    array.push(labels, label.new(bar_index, 1, str.tostring(bar_index)))
    array.push(lines, line.new(bar_index, 3, bar_index + 1, 4))
    array.push(boxes, box.new(bar_index, 7, bar_index + 1, 6))
    points = array.from(chart.point.from_index(bar_index, 10), chart.point.from_index(bar_index + 1, 11))
    array.push(curves, polyline.new(points))
int oldestLabel = na
int oldestLine = na
int oldestBox = na
int oldestCurve = na
for i = 0 to array.size(labels) - 1
    if na(oldestLabel) and array.includes(label.all, array.get(labels, i))
        oldestLabel := i
    if na(oldestLine) and array.includes(line.all, array.get(lines, i))
        oldestLine := i
    if na(oldestBox) and array.includes(box.all, array.get(boxes, i))
        oldestBox := i
    if na(oldestCurve) and array.includes(polyline.all, array.get(curves, i))
        oldestCurve := i
plot(bar_index, "BAR_INDEX")
plot(array.size(labels), "CREATED")
plot(array.size(label.all), "LABEL_COUNT")
plot(oldestLabel, "LABEL_OLDEST_CREATED")
plot(array.size(line.all), "LINE_COUNT")
plot(oldestLine, "LINE_OLDEST_CREATED")
plot(array.size(box.all), "BOX_COUNT")
plot(oldestBox, "BOX_OLDEST_CREATED")
plot(array.size(polyline.all), "POLYLINE_COUNT")
plot(oldestCurve, "POLYLINE_OLDEST_CREATED")
