//@version=6
indicator("V11 array-linear-standardize-matrix-v1", max_bars_back=256)
af = array.from(1.0, na, 9.0, 4.0)
ai = array.from(1, 4, 9, 12)
standard = array.standardize(af)
plot(array.size(standard), "STANDARD_SIZE")
plot(array.size(standard) > 0 ? array.get(standard, 0) : na, "STANDARD_0")
plot(array.size(standard) > 1 ? array.get(standard, 1) : na, "STANDARD_1")
plot(array.size(standard) > 2 ? array.get(standard, 2) : na, "STANDARD_2")
plot(array.size(standard) > 3 ? array.get(standard, 3) : na, "STANDARD_3")
plot(array.percentile_linear_interpolation(af, 25), "AF_P25_NS")
plot(af.percentile_linear_interpolation(25), "AF_P25_METHOD")
plot(array.percentile_linear_interpolation(af, 50), "AF_P50_NS")
plot(af.percentile_linear_interpolation(50), "AF_P50_METHOD")
plot(array.percentile_linear_interpolation(af, 75), "AF_P75_NS")
plot(af.percentile_linear_interpolation(75), "AF_P75_METHOD")
plot(array.percentile_linear_interpolation(ai, 25), "AI_P25_NS")
plot(ai.percentile_linear_interpolation(25), "AI_P25_METHOD")
plot(array.percentile_linear_interpolation(ai, 50), "AI_P50_NS")
plot(ai.percentile_linear_interpolation(50), "AI_P50_METHOD")
plot(array.percentile_linear_interpolation(ai, 75), "AI_P75_NS")
plot(ai.percentile_linear_interpolation(75), "AI_P75_METHOD")
