//@version=6
indicator("V11 chart-context-lifecycle-matrix-v1", max_bars_back=256)
var int executions = 0
varip int updates = 0
executions += 1
updates += 1
plot(float(bar_index), "BAR_INDEX")
plot(time, "BAR_TIME")
plot(timenow, "CLOCK")
plot(updates, "LIVE_UPDATES")
plot(chart.left_visible_bar_time, "VISIBLE_LEFT")
plot(chart.right_visible_bar_time, "VISIBLE_RIGHT")
plot(color.r(chart.bg_color), "BG_R")
plot(color.g(chart.bg_color), "BG_G")
plot(color.b(chart.bg_color), "BG_B")
plot(color.r(chart.fg_color), "FG_R")
plot(color.g(chart.fg_color), "FG_G")
plot(color.b(chart.fg_color), "FG_B")
plot(executions, "EXECUTION_COUNT", display=display.status_line)
plot(17, "RESET_DISPLAY", display=display.none)
