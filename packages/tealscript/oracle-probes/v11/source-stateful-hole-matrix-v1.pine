//@version=6
indicator("V11 source-stateful-hole-matrix-v1", max_bars_back=256)
n = bar_index
clean = float(10 + (n * 7 % 13))
x = n < 3 or n % 11 == 7 or n % 11 == 8 ? na : clean
peer = n < 2 or n % 13 == 5 ? na : float(30 - n * 3 % 17)
plot(float(n), "BAR_INDEX")
plot(clean, "CLEAN")
plot(x, "SOURCE")
plot(peer, "PEER")
event = n % 5 == 0
[macdLine, signalLine, histogram] = ta.macd(x, 3, 6, 2)
plot(ta.cum(x), "CUM")
plot(fixnan(x), "FIXNAN")
plot(ta.valuewhen(event, x, 0), "VALUEWHEN0")
plot(ta.valuewhen(event, x, 3), "VALUEWHEN3")
plot(macdLine, "MACD")
plot(signalLine, "SIGNAL")
plot(histogram, "HISTOGRAM")
