indicator("V11 requested-confirmation-pair-v1", max_bars_back=256)
higher = input.timeframe("15", "Requested timeframe")
remote = request.security(syminfo.tickerid, higher, barstate.isconfirmed)
plot(barstate.isconfirmed ? 1 : 0, "LOCAL_CONFIRMED")
