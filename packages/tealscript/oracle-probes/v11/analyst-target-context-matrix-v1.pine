//@version=6
indicator("V11 analyst-target-context-matrix-v1", max_bars_back=256)
plot(syminfo.target_price_average, "TARGET_AVERAGE")
plot(na(syminfo.target_price_average) ? 1 : 0, "AVERAGE_MISSING")
plot(syminfo.target_price_median, "TARGET_MEDIAN")
plot(na(syminfo.target_price_median) ? 1 : 0, "MEDIAN_MISSING")
plot(syminfo.target_price_date, "TARGET_DATE")
plot(na(syminfo.target_price_date) ? 1 : 0, "DATE_MISSING")
plot(syminfo.target_price_estimates, "TARGET_ESTIMATES")
plot(na(syminfo.target_price_estimates) ? 1 : 0, "ESTIMATES_MISSING")
plot(syminfo.target_price_high, "TARGET_HIGH")
plot(na(syminfo.target_price_high) ? 1 : 0, "HIGH_MISSING")
plot(syminfo.target_price_low, "TARGET_LOW")
plot(na(syminfo.target_price_low) ? 1 : 0, "LOW_MISSING")
plot(time, "BAR_TIME")
plot(timenow, "OBSERVATION_TIME")
