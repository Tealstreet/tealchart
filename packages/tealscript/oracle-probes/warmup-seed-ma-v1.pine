//@version=6
indicator("Oracle warmup-seed-ma v1 (60 columns)", overlay=false, precision=12, max_bars_back=200)
// Fresh seed in an exportable recent window. var freezes the anchor until reload.
// Export phase -5 through at least 100; phase 159 is the initial last chart bar.
var int anchor = math.max(0, last_bar_index - 159)
int phase = bar_index - anchor
float clean = phase >= 0 ? close : na
bool hole = phase == 1 or phase == 2 or phase == 40 or phase == 41 or (phase >= 80 and phase <= 85)
float holes = hole ? na : clean

// Explicit latest-n-valid sample arithmetic, independently of ta.*.
f_valid_mean(float x, simple int n, simple bool weighted) =>
    var array<float> samples = array.new<float>(0)
    if not na(x)
        array.push(samples, x)
        if array.size(samples) > n
            array.shift(samples)
    float result = na
    if array.size(samples) == n
        float numerator = 0.0
        float denominator = 0.0
        for i = 0 to n - 1
            float weight = weighted ? i + 1.0 : 1.0
            numerator += array.get(samples, i) * weight
            denominator += weight
        result := numerator / denominator
    result

f_ema_skip(float x, simple int n) =>
    var float value = na
    float alpha = 2.0 / (n + 1.0)
    if not na(x)
        value := na(value) ? x : alpha * x + (1.0 - alpha) * value
    value

f_rma_skip(float x, simple int n) =>
    float seed = f_valid_mean(x, n, false)
    var float value = na
    if not na(x)
        value := na(value) ? seed : x / n + (1.0 - 1.0 / n) * value
    value

f_alma_window(float x, simple int n, simple bool floored) =>
    float m = floored ? math.floor(0.85 * (n - 1)) : 0.85 * (n - 1)
    float width = n / 6.0
    float numerator = 0.0
    float denominator = 0.0
    for i = 0 to n - 1
        float weight = math.exp(-math.pow(i - m, 2) / (2.0 * width * width))
        numerator += x[n - 1 - i] * weight
        denominator += weight
    numerator / denominator

f_linreg_window(float x, simple int n) =>
    float sx = 0.0
    float sy = 0.0
    float sxy = 0.0
    float sxx = 0.0
    for i = 0 to n - 1
        float y = x[n - 1 - i]
        sx += i
        sy += y
        sxy += i * y
        sxx += i * i
    float slope = (n * sxy - sx * sy) / (n * sxx - sx * sx)
    (sy - slope * sx) / n + slope * (n - 1)

// Every TA and UDF call executes unconditionally on EVERY chart bar.
plot(open, "input_open", display=display.data_window)
plot(high, "input_high", display=display.data_window)
plot(low, "input_low", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(volume, "input_volume", display=display.data_window)
plot(phase, "input_seed_phase", display=display.data_window)
plot(clean, "input_close_clean_seed0", display=display.all)
plot(holes, "input_close_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.sma(clean, 1), "sma_len1_clean_seed0", display=display.data_window)
plot(ta.sma(clean, 2), "sma_len2_clean_seed0", display=display.data_window)
plot(ta.sma(clean, 5), "sma_len5_clean_seed0", display=display.data_window)
plot(ta.ema(clean, 1), "ema_len1_clean_seed0", display=display.data_window)
plot(ta.ema(clean, 2), "ema_len2_clean_seed0", display=display.data_window)
plot(ta.ema(clean, 5), "ema_len5_clean_seed0", display=display.data_window)
plot(ta.rma(clean, 1), "rma_len1_clean_seed0", display=display.data_window)
plot(ta.rma(clean, 2), "rma_len2_clean_seed0", display=display.data_window)
plot(ta.rma(clean, 5), "rma_len5_clean_seed0", display=display.data_window)
plot(ta.wma(clean, 1), "wma_len1_clean_seed0", display=display.data_window)
plot(ta.wma(clean, 2), "wma_len2_clean_seed0", display=display.data_window)
plot(ta.wma(clean, 5), "wma_len5_clean_seed0", display=display.data_window)
plot(ta.vwma(clean, 1), "vwma_len1_clean_seed0", display=display.data_window)
plot(ta.vwma(clean, 2), "vwma_len2_clean_seed0", display=display.data_window)
plot(ta.vwma(clean, 5), "vwma_len5_clean_seed0", display=display.data_window)
plot(ta.alma(clean, 1, 0.85, 6, false), "alma_len1_clean_seed0_offset085_sigma6_floorfalse", display=display.data_window)
plot(ta.alma(clean, 2, 0.85, 6, false), "alma_len2_clean_seed0_offset085_sigma6_floorfalse", display=display.data_window)
plot(ta.alma(clean, 5, 0.85, 6, false), "alma_len5_clean_seed0_offset085_sigma6_floorfalse", display=display.data_window)
plot(ta.hma(clean, 1), "hma_len1_clean_seed0", display=display.data_window)
plot(ta.hma(clean, 2), "hma_len2_clean_seed0", display=display.data_window)
plot(ta.hma(clean, 5), "hma_len5_clean_seed0", display=display.data_window)
plot(ta.linreg(clean, 1, 0), "linreg_len1_clean_seed0_offset0", display=display.data_window)
plot(ta.linreg(clean, 2, 0), "linreg_len2_clean_seed0_offset0", display=display.data_window)
plot(ta.linreg(clean, 5, 0), "linreg_len5_clean_seed0_offset0", display=display.data_window)
plot(ta.swma(clean), "swma_len4_clean_seed0", display=display.data_window)
plot(ta.sma(holes, 2), "sma_len2_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.sma(holes, 5), "sma_len5_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.ema(holes, 2), "ema_len2_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.ema(holes, 5), "ema_len5_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.rma(holes, 2), "rma_len2_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.rma(holes, 5), "rma_len5_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.wma(holes, 2), "wma_len2_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.wma(holes, 5), "wma_len5_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.vwma(holes, 2), "vwma_len2_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.vwma(holes, 5), "vwma_len5_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.alma(holes, 2, 0.85, 6, false), "alma_len2_holes_p1_p2_p40_p41_p80to85_offset085_sigma6_floorfalse", display=display.data_window)
plot(ta.alma(holes, 5, 0.85, 6, false), "alma_len5_holes_p1_p2_p40_p41_p80to85_offset085_sigma6_floorfalse", display=display.data_window)
plot(ta.hma(holes, 2), "hma_len2_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.hma(holes, 5), "hma_len5_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(ta.linreg(holes, 2, 0), "linreg_len2_holes_p1_p2_p40_p41_p80to85_offset0", display=display.data_window)
plot(ta.linreg(holes, 5, 0), "linreg_len5_holes_p1_p2_p40_p41_p80to85_offset0", display=display.data_window)
plot(ta.swma(holes), "swma_len4_holes_p1_p2_p40_p41_p80to85", display=display.data_window)
plot(f_valid_mean(holes, 5, false), "control_sma_len5_holes", display=display.data_window)
plot(f_ema_skip(holes, 5), "control_ema_len5_holes", display=display.data_window)
plot(f_rma_skip(holes, 5), "control_rma_len5_holes", display=display.data_window)
plot(f_valid_mean(holes, 5, true), "control_wma_len5_holes", display=display.data_window)
plot(f_valid_mean(holes * volume, 5, false) / f_valid_mean(volume, 5, false), "control_vwma_len5_holes", display=display.data_window)
plot((holes + 2.0 * holes[1] + 2.0 * holes[2] + holes[3]) / 6.0, "control_swma_len4_holes", display=display.data_window)
plot(f_alma_window(holes, 5, false), "control_alma_len5_holes_offset085_sigma6_floorfalse", display=display.data_window)
plot(ta.wma(2.0 * ta.wma(holes, 2) - ta.wma(holes, 5), 2), "control_hma_len5_holes", display=display.data_window)
plot(f_linreg_window(holes, 5), "control_linreg_len5_holes_offset0", display=display.data_window)
plot(ta.alma(clean, 5, 0.85, 6, true), "alma_len5_clean_seed0_offset085_sigma6_floortrue", display=display.data_window)
