//@version=6
indicator("corpus-array-median-float-control-v1")
a0 = array.new<float>()
array.push(a0, 2)
array.push(a0, 4)
array.push(a0, 6)
float m0 = array.median(a0)
plot(m0, "median_0")
a1 = array.new<float>()
array.push(a1, 1)
array.push(a1, 2)
float m1 = array.median(a1)
plot(m1, "median_1")
a2 = array.new<float>()
array.push(a2, -2)
array.push(a2, -1)
float m2 = array.median(a2)
plot(m2, "median_2")
