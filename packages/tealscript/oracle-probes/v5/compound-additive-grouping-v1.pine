//@version=6
indicator("V5 compound additive grouping", overlay=false)
f_plain(s, r) =>
    float x = 1e16
    x += s - r
    x
f_grouped(s, r) =>
    float x = 1e16
    x += (s - r)
    x
s = -1e16
r = -1.0
float plain = 1e16
plain += s - r
float grouped = 1e16
grouped += (s - r)
float left = 1e16
left := (left + s) - r
float right = 1e16
right := right + (s - r)
plot(time, "input_time", display=display.data_window)
plot(bar_index, "input_bar_index", display=display.data_window)
plot(plain, "root_plain", display=display.data_window)
plot(grouped, "root_grouped", display=display.data_window)
plot(left, "control_left", display=display.data_window)
plot(right, "control_right", display=display.data_window)
plot(f_plain(s, r), "udf_plain", display=display.data_window)
plot(f_grouped(s, r), "udf_grouped", display=display.data_window)
