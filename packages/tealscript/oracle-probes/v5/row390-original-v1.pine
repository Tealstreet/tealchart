f_cisdColor(int state) =>
    state == 0 ? pendingColor : state == 1 ? fadedColor : confirmedColor

f_cisdWidth(int state) =>
    state == 0 ? pendingWidth : state == 1 ? fadedWidth : confirmedWidth

f_cisdText(bool isBull, int state) =>
    switch state
        0 => isBull ? "+P-CISD" : "-P-CISD"
        2 => isBull ? bullStr : bearStr
        => ""

f_addCISD(bool isBull, int x1Index, float y, int state) =>
    if showCISDNeo and not na(y) and not na(x1Index)
        if cisdMode == "Confirmed" and state != 2
            na
        else
            clrBase = isBull ? bullishBreakColor : bearishBreakColor
            clr     = state == 2 and cisdMode == "Confirmed" ? clrBase : f_cisdColor(state)
            w       = state == 2 and cisdMode == "Confirmed" ? lineWidth : f_cisdWidth(state)
            txt     = f_cisdText(isBull, state)

            ln = line.new(x1Index, y, bar_index + lookAheadBars, y,
                 xloc=xloc.bar_index,
                 color=clr,
                 width=w,
                 style=cisdLineStyle)

            lb = label.new(bar_index + lookAheadBars, y, txt,
                 xloc=xloc.bar_index,
                 style=label.style_label_left,
                 color=color.new(color.white, 100),
                 textcolor=clr,
                 size=size.small,
                 text_font_family=font.family_monospace)

            obj = cisdNeo.new(ln, lb, false)

            if isBull
                array.push(cisdLevelsBu, obj)
                if array.size(cisdLevelsBu) > 1 and not keepLevels
                    old = array.shift(cisdLevelsBu)
                    line.delete(old.level)
                    label.delete(old.txt)
            else
                array.push(cisdLevelsBe, obj)
                if array.size(cisdLevelsBe) > 1 and not keepLevels
                    old = array.shift(cisdLevelsBe)
                    line.delete(old.level)
                    label.delete(old.txt)

f_setLastCISDStyle(bool isBull, int state) =>
    arr = isBull ? cisdLevelsBu : cisdLevelsBe
    if array.size(arr) > 0
        lastIdx = array.size(arr) - 1
        lastObj = array.get(arr, lastIdx)
        if not na(lastObj.level) and not na(lastObj.txt)
            clrBase = isBull ? bullishBreakColor : bearishBreakColor
            clr     = state == 2 and cisdMode == "Confirmed" ? clrBase : f_cisdColor(state)
            w       = state == 2 and cisdMode == "Confirmed" ? lineWidth : f_cisdWidth(state)
            line.set_color(lastObj.level, clr)
            line.set_width(lastObj.level, w)
            label.set_textcolor(lastObj.txt, clr)
            label.set_text(lastObj.txt, f_cisdText(isBull, state))

f_removeLastPendingCISD(bool isBull) =>
    if cisdMode == "Hybrid"
        arr = isBull ? cisdLevelsBu : cisdLevelsBe
        if array.size(arr) > 0
            lastIdx = array.size(arr) - 1
            lastObj = array.get(arr, lastIdx)
            if not lastObj.completed
                if not na(lastObj.txt)
                    label.delete(lastObj.txt)
                if not na(lastObj.level)
                    line.delete(lastObj.level)
                array.pop(arr)

f_updateCISD() =>
    if array.size(cisdLevelsBu) > 0
        lastIdx = array.size(cisdLevelsBu) - 1
        lastObj = array.get(cisdLevelsBu, lastIdx)
        if not lastObj.completed
            y = line.get_y1(lastObj.level)
            line.set_x2(lastObj.level, bar_index + lookAheadBars)
            label.set_x(lastObj.txt,  bar_index + lookAheadBars)
            if close < y
                lastObj.completed := true
                array.set(cisdLevelsBu, lastIdx, lastObj)
                if bullishAlerts
                    alert("CISD break: +CISD (close below level)")
    if array.size(cisdLevelsBe) > 0
        lastIdx = array.size(cisdLevelsBe) - 1
        lastObj = array.get(cisdLevelsBe, lastIdx)
        if not lastObj.completed
            y = line.get_y1(lastObj.level)
            line.set_x2(lastObj.level, bar_index + lookAheadBars)
            label.set_x(lastObj.txt,  bar_index + lookAheadBars)
            if close > y
                lastObj.completed := true
                array.set(cisdLevelsBe, lastIdx, lastObj)
                if bearishAlerts
                    alert("CISD break: -CISD (close above level)")

f_updateCISD()

if timeframe.change(auto_tf)
    t0 := time
    o0 := open
    h0 := high
    l0 := low
    bull_level_fixed := na
    bull_index_fixed := na
    bear_level_fixed := na
    bear_index_fixed := na
    bull_reclaimed_current := false
    bull_reclaim_bar := na
    bear_reclaimed_current := false
    bear_reclaim_bar := na

if high >= h0
    h0 := high
if low <= l0
    l0 := low
c0 := close

if timeframe.change(auto_tf)
    h2 := h1
    l2 := l1
    o1 := o0[1]
    h1 := h0[1]
    l1 := l0[1]
    t1 := t0[1]
    c1 := close[1]

h_swept = h0 > h1 and math.max(o0, c0) < h1
l_swept = l0 < l1 and math.min(o0, c0) > l1

if timeframe.change(auto_tf)
    h_swept1 := h_swept[1]
    l_swept1 := l_swept[1]

if showHTFCandles
    HTFBarTime = time(auto_tf, "america/New_York")
    isNewHTFCandle = ta.change(HTFBarTime) > 0

    if isNewHTFCandle
        candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.o_time := time
        candle.c_time := time
        candle.is_closed := false

        if array.size(htfCandles) > 0
            prevCandle = array.get(htfCandles, 0)
            prevCandle.is_closed := true
            array.set(htfCandles, 0, prevCandle)

        bull = candle.c > candle.o
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c),
                               bull ? bull_border : bear_border, 1, bgcolor=bull ? bull_body : bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color=bull ? bull_wick : bear_wick)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color=bull ? bull_wick : bear_wick)

        array.unshift(htfCandles, candle)

        if array.size(htfCandles) > max_htf_candles
            delCandle = array.pop(htfCandles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.time_label)
                label.delete(delCandle.time_label)
            if not na(delCandle.htf_time_lbl)
                label.delete(delCandle.htf_time_lbl)
            if not na(delCandle.htf_rem_lbl)
                label.delete(delCandle.htf_rem_lbl)
            if not na(delCandle.htf_int_lbl)
                label.delete(delCandle.htf_int_lbl)
            if not na(delCandle.swing_high_line)
                line.delete(delCandle.swing_high_line)
            if not na(delCandle.swing_low_line)
                line.delete(delCandle.swing_low_line)
            if not na(delCandle.ltf_sweep_high)
                line.delete(delCandle.ltf_sweep_high)
            if not na(delCandle.ltf_sweep_low)
                line.delete(delCandle.ltf_sweep_low)
            if not na(delCandle.ltf_sweep_high_lbl)
                label.delete(delCandle.ltf_sweep_high_lbl)
            if not na(delCandle.ltf_sweep_low_lbl)
                label.delete(delCandle.ltf_sweep_low_lbl)

    if array.size(htfCandles) > 0
        candle = array.get(htfCandles, 0)
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index
        candle.c_time := time

        bull = candle.c > candle.o
        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_bgcolor(candle.body, bull ? bull_body : bear_body)
        box.set_border_color(candle.body, bull ? bull_border : bear_border)
        line.set_color(candle.wick_up, bull ? bull_wick : bear_wick)
        line.set_color(candle.wick_down, bull ? bull_wick : bear_wick)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        array.set(htfCandles, 0, candle)

        if barstate.isrealtime or barstate.islast
            size = array.size(htfCandles)

            if size > 0
                if array.size(htfFVGs) > 0
                    for i = 0 to array.size(htfFVGs) - 1
                        box.delete((array.get(htfFVGs, i)).b)
                array.clear(htfFVGs)

                if array.size(htfVIs) > 0
                    for j = 0 to array.size(htfVIs) - 1
                        box.delete(array.get(htfVIs, j))
                array.clear(htfVIs)

                for i = size - 1 to 0
                    c = array.get(htfCandles, i)
                    t_buffer = htf_padding + (htf_candle_width + htf_space) * (size - i - 1)
                    box.set_left(c.body, bar_index + t_buffer)
                    box.set_right(c.body, bar_index + t_buffer + htf_candle_width)
                    line.set_x1(c.wick_up, bar_index + t_buffer + int(math.floor(htf_candle_width/2.0)))
                    line.set_x2(c.wick_up, bar_index + t_buffer + int(math.floor(htf_candle_width/2.0)))
                    line.set_x1(c.wick_down, bar_index + t_buffer + int(math.floor(htf_candle_width/2.0)))
                    line.set_x2(c.wick_down, bar_index + t_buffer + int(math.floor(htf_candle_width/2.0)))

                    if not na(c.htf_time_lbl)
                        label.delete(c.htf_time_lbl)
                        c.htf_time_lbl := na
                    if not na(c.htf_rem_lbl)
                        label.delete(c.htf_rem_lbl)
                        c.htf_rem_lbl := na
                    if not na(c.htf_int_lbl)
                        label.delete(c.htf_int_lbl)
                        c.htf_int_lbl := na

                    if show_candle_time
                        time_text = formatCandleTime(c.o_time, auto_tf)
                        if not na(c.time_label)
                            label.set_x(c.time_label, bar_index + t_buffer + int(math.floor(htf_candle_width / 2.0)))
                            label.set_y(c.time_label, c.l)
                            label.set_text(c.time_label, time_text)
                        else
                            c.time_label := label.new(
                                bar_index + t_buffer + int(math.floor(htf_candle_width / 2.0)),
                                c.l,
                                time_text,
                                color=color.new(color.white, 100),
                                textcolor=candle_time_color,
                                style=label.style_label_up,
                                size=getTextSize(candle_time_size),
                                text_font_family=font.family_monospace
                            )

                    array.set(htfCandles, i, c)

                var label htf_overall_lbl = na
                if htfLabelShow
                    tf_txt = auto_tf == "1D" ? "1D" : auto_tf == "1W" ? "1W" : auto_tf == "1M" ? "1M" : auto_tf + "m"

                    rem_raw = RemainingTime(auto_tf)
                    rem_txt = "(" + rem_raw + ")"

                    line1 = intervalValueShow ? tf_txt : ""
                    line2 = remainingTimeShow ? rem_txt : ""
                    txt = line1
                    if str.length(line2) > 0
                        txt := (str.length(txt) > 0 ? (txt + "\n" + line2) : line2)

                    total_w = (htf_candle_width + htf_space) * (size - 1) + htf_candle_width
                    x_center = bar_index + htf_padding + int(math.floor(total_w / 2.0))

                    float topH = na
                    for k = 0 to size - 1
                        ck = array.get(htfCandles, k)
                        topH := na(topH) ? ck.h : math.max(topH, ck.h)
                    y = topH + (htfLabelYOffsetTicks * syminfo.mintick)

                    x_left  = bar_index + htf_padding
                    x_right = bar_index + htf_padding + total_w
                    x_final = labelAlignment == "Left" ? x_left : labelAlignment == "Right" ? x_right : x_center

                    y_final = labelPositions == "Bottom" ? (math.min(array.get(htfCandles, 0).l, topH) - (htfLabelYOffsetTicks * syminfo.mintick)) : y
                    lbl_style = labelPositions == "Bottom" ? label.style_label_up : label.style_label_down

                    if na(htf_overall_lbl)
                        htf_overall_lbl := label.new(
                            x_final,
                            y_final,
                            txt,
                            xloc=xloc.bar_index,
                            style=lbl_style,
                            color=htfLabelBG,
                            textcolor=htfLabelColor,
                            size=lblSize(htfLabelSizeOpt),
                            text_font_family=font.family_monospace
                        )
                    else
                        label.set_x(htf_overall_lbl, x_final)
                        label.set_y(htf_overall_lbl, y_final)
                        label.set_text(htf_overall_lbl, txt)
                        label.set_color(htf_overall_lbl, htfLabelBG)
                        label.set_textcolor(htf_overall_lbl, htfLabelColor)
                        label.set_size(htf_overall_lbl, lblSize(htfLabelSizeOpt))
                        label.set_style(htf_overall_lbl, lbl_style)
                else
                    if not na(htf_overall_lbl)
                        label.delete(htf_overall_lbl)
                        htf_overall_lbl := na

                if show_fvg and size > 2
                    for i = 0 to size - 3
                        fvg1 = array.get(htfCandles, i)
                        fvg2 = array.get(htfCandles, i + 2)

                        if fvg1.l > fvg2.h and math.min(fvg1.o, fvg1.c) > math.max(fvg2.o, fvg2.c)
                            t_buffer1 = htf_padding + (htf_candle_width + htf_space) * (size - i - 1)
                            t_buffer2 = htf_padding + (htf_candle_width + htf_space) * (size - (i + 2) - 1)
                            f = FVG.new()
                            f.b := box.new(bar_index + t_buffer2 + htf_candle_width, fvg2.h, bar_index + t_buffer1, fvg1.l, bgcolor=fvg_color, border_color=color.new(color.white, 100))
                            array.push(htfFVGs, f)

                        if fvg1.h < fvg2.l and math.max(fvg1.o, fvg1.c) < math.min(fvg2.o, fvg2.c)
                            t_buffer1 = htf_padding + (htf_candle_width + htf_space) * (size - i - 1)
                            t_buffer2 = htf_padding + (htf_candle_width + htf_space) * (size - (i + 2) - 1)
                            f = FVG.new()
                            f.b := box.new(bar_index + t_buffer1, fvg1.h, bar_index + t_buffer2 + htf_candle_width, fvg2.l, bgcolor=fvg_color, border_color=color.new(color.white, 100))
                            array.push(htfFVGs, f)

                if vi_show and size > 1
                    for ii = 0 to size - 2
                        c1_ = array.get(htfCandles, ii)
                        c2_ = array.get(htfCandles, ii + 1)

                        if (c1_.l < c2_.h and math.min(c1_.o, c1_.c) > math.max(c2_.o, c2_.c))
                            b = box.new(bar_index + (htf_padding + (htf_candle_width + htf_space) * (size - (ii + 1) - 1)), math.min(c1_.o, c1_.c), bar_index + (htf_padding + (htf_candle_width + htf_space) * (size - ii - 1)) + htf_candle_width, math.max(c2_.o, c2_.c), bgcolor=vi_color, border_color=color.new(color.white, 100))
                            array.push(htfVIs, b)

                        if (c1_.h > c2_.l and math.max(c1_.o, c1_.c) < math.min(c2_.o, c2_.c))
                            b = box.new(bar_index + (htf_padding + (htf_candle_width + htf_space) * (size - ii - 1)) + htf_candle_width, math.min(c2_.o, c2_.c), bar_index + (htf_padding + (htf_candle_width + htf_space) * (size - (ii + 1) - 1)), math.max(c1_.o, c1_.c), bgcolor=vi_color, border_color=color.new(color.white, 100))
                            array.push(htfVIs, b)

                if show_swing_lines and size > 1
                    for i = size - 1 to 1
                        c = array.get(htfCandles, i)
                        next_c = array.get(htfCandles, i - 1)

                        if next_c.is_closed or (i > 1)
                            is_confirmed_high = next_c.h > c.h and next_c.c < c.h
                            is_confirmed_low  = next_c.l < c.l and next_c.c > c.l

                            if is_confirmed_high
                                t_buffer = htf_padding + (htf_candle_width + htf_space) * (size - i - 1)
                                next_buffer = htf_padding + (htf_candle_width + htf_space) * (size - (i - 1) - 1)
                                line_start = bar_index + t_buffer + int(math.floor(htf_candle_width/2.0))
                                line_end   = bar_index + next_buffer + htf_candle_width + swing_overshoot
                                if na(c.swing_high_line)
                                    c.swing_high_line := line.new(line_start, c.h, line_end, c.h, color=swing_high_color, width=swing_line_width, style=swing_line_style)
                                else
                                    line.set_x1(c.swing_high_line, line_start)
                                    line.set_y1(c.swing_high_line, c.h)
                                    line.set_x2(c.swing_high_line, line_end)
                                    line.set_y2(c.swing_high_line, c.h)
                            else
                                if not na(c.swing_high_line)
                                    line.delete(c.swing_high_line)
                                    c.swing_high_line := na

                            if is_confirmed_low
                                t_buffer = htf_padding + (htf_candle_width + htf_space) * (size - i - 1)
                                next_buffer = htf_padding + (htf_candle_width + htf_space) * (size - (i - 1) - 1)
                                line_start = bar_index + t_buffer + int(math.floor(htf_candle_width/2.0))
                                line_end   = bar_index + next_buffer + htf_candle_width + swing_overshoot
                                if na(c.swing_low_line)
                                    c.swing_low_line := line.new(line_start, c.l, line_end, c.l, color=swing_low_color, width=swing_line_width, style=swing_line_style)
                                else
                                    line.set_x1(c.swing_low_line, line_start)
                                    line.set_y1(c.swing_low_line, c.l)
                                    line.set_x2(c.swing_low_line, line_end)
                                    line.set_y2(c.swing_low_line, c.l)
                            else
                                if not na(c.swing_low_line)
                                    line.delete(c.swing_low_line)
                                    c.swing_low_line := na

                            array.set(htfCandles, i, c)

                if show_sweeps and size > 1
                    for i = 0 to size - 2
                        swp1 = array.get(htfCandles, i + 1)
                        swp2 = array.get(htfCandles, i)

                        c2_bull = swp2.c > swp2.o

                        bull_sweep_in_range = c2_bull ? (swp2.c < swp1.h) : (swp2.o < swp1.h)
                        is_bull_sweep = swp2.h > swp1.h and bull_sweep_in_range

                        bear_sweep_in_range = c2_bull ? (swp2.o > swp1.l) : (swp2.c > swp1.l)
                        is_bear_sweep = swp2.l < swp1.l and bear_sweep_in_range

                        if is_bull_sweep
                            x2_end = i > 0 ? (array.get(htfCandles, i - 1)).c_idx : swp2.c_idx
                            if na(swp1.ltf_sweep_high)
                                swp1.ltf_sweep_high := line.new(swp1.h_idx, swp1.h, x2_end, swp1.h, color=sweep_line_color, width=sweep_line_width, style=sweep_line_style)
                            else
                                line.set_x1(swp1.ltf_sweep_high, swp1.h_idx)
                                line.set_y1(swp1.ltf_sweep_high, swp1.h)
                                line.set_x2(swp1.ltf_sweep_high, x2_end)
                                line.set_y2(swp1.ltf_sweep_high, swp1.h)

                        if is_bear_sweep
                            x2_end = i > 0 ? (array.get(htfCandles, i - 1)).c_idx : swp2.c_idx
                            if na(swp1.ltf_sweep_low)
                                swp1.ltf_sweep_low := line.new(swp1.l_idx, swp1.l, x2_end, swp1.l, color=sweep_line_color, width=sweep_line_width, style=sweep_line_style)
                            else
                                line.set_x1(swp1.ltf_sweep_low, swp1.l_idx)
                                line.set_y1(swp1.ltf_sweep_low, swp1.l)
                                line.set_x2(swp1.ltf_sweep_low, x2_end)
                                line.set_y2(swp1.ltf_sweep_low, swp1.l)

                        array.set(htfCandles, i + 1, swp1)

if showOCLines and barstate.islast
    for ln in ocLines
        line.delete(ln)
    array.clear(ocLines)

    if array.size(htfCandles) > 0
        maxCandles = math.min(array.size(htfCandles), max_htf_candles)
        for i = 0 to maxCandles - 1
            c = array.get(htfCandles, i)
            y1 = math.min(c.o, c.c)
            y2 = math.max(c.o, c.c)

            ocLine = line.new(
                 x1=c.o_time, y1=y1,
                 x2=c.o_time, y2=y2,
                 xloc=xloc.bar_time,
                 extend=extend.both,
                 color=ocLineColor,
                 style=getLineStyle(ocLineStyle),
                 width=ocLineWidth
             )
            array.push(ocLines, ocLine)

if period_changed
    prevC2Buy      := c2_buy[1]
    prevC2Sell     := c2_sell[1]
    prevHighTime2  := prevHighTime
    prevLowTime2   := prevLowTime
    prevHighTime   := periodHighTime[1]
    prevLowTime    := periodLowTime[1]
    prevHighPrice  := periodHigh[1]
    prevLowPrice   := periodLow[1]
    prevHTFHigh    := htfH[1]
    prevHTFLow     := htfL[1]
    c3HighForMid   := currentH[1]
    c3LowForMid    := currentL[1]
    periodHigh     := high
    periodHighTime := time
    periodLow      := low
    periodLowTime  := time
else
    if high > periodHigh
        periodHigh := high
        periodHighTime := time
    if low < periodLow
        periodLow := low
        periodLowTime := time

if low == l0 and low < l1
    if (dw[0] or eq[0]) and (up[1] or eq[1]) and not (eq[0] and eq[1])
        bull_level_fixed := open
        bull_index_fixed := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up[i] or eq[i]) and dw[i-1]
                bar = i - 1
                bull_level_fixed := open[bar]
                bull_index_fixed := bar_index - bar
                for j = bar to 0
                    if open[j] > bull_level_fixed and dw[j]
                        bull_level_fixed := open[j]
                        bull_index_fixed := bar_index - j

                if bull_level_fixed < open and not (close > open)
                    bull_level_fixed := open
                    bull_index_fixed := bar_index
                if bull_level_fixed < open and (close > open)
                    bull_level_fixed := high
                    bull_index_fixed := bar_index
                break

if high == h0 and high > h1
    if (up[0] or eq[0]) and (dw[1] or eq[1]) and not (eq[0] and eq[1])
        bear_level_fixed := open
        bear_index_fixed := bar_index
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw[i] or eq[i]) and up[i-1]
                ybar = i - 1
                bear_level_fixed := open[ybar]
                bear_index_fixed := bar_index - ybar
                for j = ybar to 0
                    if open[j] < bear_level_fixed and up[j]
                        bear_level_fixed := open[j]
                        bear_index_fixed := bar_index - j

                if bear_level_fixed > open and not (close < open)
                    bear_level_fixed := open
                    bear_index_fixed := bar_index
                if bear_level_fixed > open and (close < open)
                    bear_level_fixed := low
                    bear_index_fixed := bar_index
                break

xbull = close[1] > bull_level_fixed and not na(bull_level_fixed) and (l_swept[1] or (l1 <= l0 and l_swept1)) and not bull_reclaimed_current and (bar_index - 1 >= bull_index_fixed)
if xbull
    bull_reclaimed_current := true
    bull_reclaim_bar := bar_index - 1

xbear = close[1] < bear_level_fixed and not na(bear_level_fixed) and (h_swept[1] or (h1 >= h0 and h_swept1)) and not bear_reclaimed_current and (bar_index - 1 >= bear_index_fixed)
if xbear
    bear_reclaimed_current := true
    bear_reclaim_bar := bar_index - 1

if close[1] > bull_level_fixed and not na(bull_level_fixed) and not (l_swept[1] or (l1 <= l0 and l_swept1)) and not bull_reclaimed_current and (bar_index - 1 >= bull_index_fixed)
    bull_reclaimed_current := true
    bull_reclaim_bar := bar_index - 1

if close[1] < bear_level_fixed and not na(bear_level_fixed) and not (h_swept[1] or (h1 >= h0 and h_swept1)) and not bear_reclaimed_current and (bar_index - 1 >= bear_index_fixed)
    bear_reclaimed_current := true
    bear_reclaim_bar := bar_index - 1

if timeframe.change(auto_tf)
    if c2_buy[1] and not na(bull_level_fixed[1])
        c2_had_bull_sweep := true
        c2_bull_level := bull_level_fixed[1]
        c2_bull_index := bull_index_fixed[1]
        // C2 swept C1's low → targets are C1's EQ (50%) and C1's high (100%).
        // h2/l2 hold C1's range here (h1/l1 were just rolled to C2's range above),
        // prevHighTime2 holds the time of C1's high so the 100% line anchors to it.
        c2_bull_tgt_eq        := (h2 + l2) / 2
        c2_bull_tgt_full      := h2
        c2_bull_tgt_full_time := prevHighTime2
        if showCISDNeo and cisdMode == "Hybrid"
            f_addCISD(true, c2_bull_index, c2_bull_level, 0)
        c2_already_invalidated_bull := false
        htf_count_since_sweep := 0
        bull_cisd_confirmed := bull_reclaimed_current[1] and not na(bull_reclaim_bar[1])
    else if not c2_buy[1]
        c2_had_bull_sweep := false

    if c2_sell[1] and not na(bear_level_fixed[1])
        c2_had_bear_sweep := true
        c2_bear_level := bear_level_fixed[1]
        c2_bear_index := bear_index_fixed[1]
        // C2 swept C1's high → targets are C1's EQ (50%) and C1's low (100%).
        c2_bear_tgt_eq        := (h2 + l2) / 2
        c2_bear_tgt_full      := l2
        c2_bear_tgt_full_time := prevLowTime2
        if showCISDNeo and cisdMode == "Hybrid"
            f_addCISD(false, c2_bear_index, c2_bear_level, 0)
        c2_already_invalidated_bear := false
        htf_count_since_sweep := 0
        bear_cisd_confirmed := bear_reclaimed_current[1] and not na(bear_reclaim_bar[1])
    else if not c2_sell[1]
        c2_had_bear_sweep := false

if timeframe.change(auto_tf) and (c2_had_bull_sweep or c2_had_bear_sweep)
    htf_count_since_sweep += 1
    if htf_count_since_sweep > 2
        c2_had_bull_sweep := false
        c2_had_bear_sweep := false
        htf_count_since_sweep := 0
        bull_cisd_confirmed := false
        bear_cisd_confirmed := false
        c2_already_invalidated_bull := false
        c2_already_invalidated_bear := false

htf_c2_close = request.security(syminfo.tickerid, auto_tf, close[1], lookahead=barmerge.lookahead_off)

if c2_had_bull_sweep and htf_count_since_sweep == 2 and not na(c2_bull_level) and htf_c2_close > c2_bull_level
    bull_cisd_confirmed := true

if c2_had_bear_sweep and htf_count_since_sweep == 2 and not na(c2_bear_level) and htf_c2_close < c2_bear_level
    bear_cisd_confirmed := true

if showCISDNeo and cisdMode == "Hybrid"
    if c2_had_bull_sweep
        bullState = bull_cisd_confirmed ? 2 : (htf_count_since_sweep >= 2 ? 1 : 0)
        f_setLastCISDStyle(true, bullState)
    if c2_had_bear_sweep
        bearState = bear_cisd_confirmed ? 2 : (htf_count_since_sweep >= 2 ? 1 : 0)
        f_setLastCISDStyle(false, bearState)

f_deleteHistory(SetupHistory h) =>
    if not na(h.c2_lbl)
        label.delete(h.c2_lbl)
    if not na(h.open_ln)
        line.delete(h.open_ln)
    if not na(h.mid_ln)
        line.delete(h.mid_ln)
    if not na(h.c3_box)
        box.delete(h.c3_box)
    if not na(h.c4_lbl)
        label.delete(h.c4_lbl)
    if not na(h.c4_open_ln)
        line.delete(h.c4_open_ln)
    if not na(h.c4_mid_ln)
        line.delete(h.c4_mid_ln)
    if not na(h.c4_box)
        box.delete(h.c4_box)
    if not na(h.std)
        for ln in h.std.lines
            line.delete(ln)
        for lb in h.std.labels
            label.delete(lb)
    if not na(h.tgt)
        line.delete(h.tgt.ln_eq)
        label.delete(h.tgt.lb_eq)
        line.delete(h.tgt.ln_full)
        label.delete(h.tgt.lb_full)
    if not na(h.inv_ln)
        line.delete(h.inv_ln)
    if not na(h.inv_lbl)
        label.delete(h.inv_lbl)

f_invLabelX(int x1, int x2) =>
    invLabelPos == "Left" ? x1 : invLabelPos == "Center" ? (x1 + x2) / 2 : x2

f_pushHistory(SetupHistory h) =>
    if not showHistorical
        f_deleteHistory(h)
    else
        array.push(historySetups, h)
        while array.size(historySetups) > maxHistorical
            old = array.shift(historySetups)
            f_deleteHistory(old)

createC2Setup(bool isShort, int setupTime, float setupPrice, float _htfOpen, float midPoint, float cisdLevel, int cisdIndex, int currentCount, float tgtEQ, float tgtFull, int tgtFullTime) =>
    shouldCreate = biasFilter == "Neutral" or (biasFilter == "Bullish" and not isShort) or (biasFilter == "Bearish" and isShort)
    if shouldCreate
        lbl = label.new(setupTime, setupPrice, "C2",
             xloc=xloc.bar_time,
             style=isShort ? label.style_label_down : label.style_label_up,
             color=color.new(color.white, 100),
             textcolor=coloroftext,
             size=size.small,
             text_font_family=font.family_monospace)

        array.push(activeLabels, lbl)
        array.push(activeStops, setupPrice)
        array.push(activeShorts, isShort)
        array.push(activeCounts, currentCount)
        array.push(activeC3Mids, na)
        array.push(activeCisdConfirmed, true)
        array.push(activeInvalidated, false)

        openLine = showHTFOpen ? line.new(htfTime, _htfOpen, htfTimeClose, _htfOpen, xloc=xloc.bar_time, color=htfOpenColor, width=htfOpenWidth, style=getLineStyle(htfOpenStyle)) : na
        midLine  = showPrevHTFMid and not na(midPoint) ? line.new(htfTime, midPoint, htfTimeClose, midPoint, xloc=xloc.bar_time, color=prevHTFMidColor, width=prevHTFMidWidth, style=getLineStyle(prevHTFMidStyle)) : na
        c3Box    = showBox and not na(midPoint) and showHTFOpen ? box.new(htfTime, math.max(_htfOpen, midPoint), htfTimeClose, math.min(_htfOpen, midPoint), bgcolor=boxColor, border_width=0, xloc=xloc.bar_time) : na

        array.push(activeOpenLines, openLine)
        array.push(activeMidLines,  midLine)
        array.push(activeC3Boxes,   c3Box)
        array.push(activeC4Labels,  na)
        array.push(activeC4OpenLines, na)
        array.push(activeC4MidLines,  na)
        array.push(activeC4Boxes,     na)

        if showCISDNeo and not na(cisdLevel) and not na(cisdIndex)
            f_removeLastPendingCISD(not isShort)
            f_addCISD(not isShort, cisdIndex, cisdLevel, 2)

        stdDevLinesArray  = array.new<line>()
        stdDevLabelsArray = array.new<label>()

        if showStdDev and array.size(stdDeviations) > 0
            level1 = setupPrice
            level0 = float(na)

            if not isShort
                level0 := high[bar_index - cisdIndex]
                if cisdIndex < bar_index
                    prevCandleHigh = high[bar_index - cisdIndex + 1]
                    level0 := math.max(level0, prevCandleHigh)
            else
                level0 := low[bar_index - cisdIndex]
                if cisdIndex < bar_index
                    prevCandleLow = low[bar_index - cisdIndex + 1]
                    level0 := math.min(level0, prevCandleLow)

            priceRange = isShort ? (level1 - level0) : (level0 - level1)

            leftTime = time[bar_index - cisdIndex]
            if not isShort
                if cisdIndex < bar_index and high[bar_index - cisdIndex + 1] > high[bar_index - cisdIndex]
                    leftTime := time[bar_index - cisdIndex + 1]
            else
                if cisdIndex < bar_index and low[bar_index - cisdIndex + 1] < low[bar_index - cisdIndex]
                    leftTime := time[bar_index - cisdIndex + 1]

            rightTime = setupTime

            for i = 0 to array.size(stdDeviations) - 1
                dev = array.get(stdDeviations, i)
                devPrice = float(na)

                if not isShort
                    devPrice := level0 - (priceRange * dev)
                else
                    devPrice := level0 + (priceRange * dev)

                devLine = line.new(leftTime, devPrice, rightTime, devPrice, xloc=xloc.bar_time, color=stdDevColor, width=stdDevWidth, style=line.style_solid)
                devLabel = label.new(leftTime, devPrice, str.tostring(dev), xloc=xloc.bar_time,
                     color=color.new(color.white, 100),
                     style=label.style_label_right,
                     textcolor=showStdDevLabels ? stdDevColor : color.new(stdDevColor, 100),
                     size=size.small, text_font_family=font.family_monospace)

                array.push(stdDevLinesArray, devLine)
                array.push(stdDevLabelsArray, devLabel)

        array.push(activeStdDevData, StdDevData.new(stdDevLinesArray, stdDevLabelsArray))

        td = TargetData.new(na, na, na, false, na, na, na, false)
        if showTargets
            tgtStyle = getLineStyle(targetStyleInput)
            if showTargetEQ and not na(tgtEQ)
                td.ln_eq := line.new(setupTime, tgtEQ, time, tgtEQ, xloc=xloc.bar_time, color=targetColor, width=targetWidth, style=tgtStyle)
                td.p_eq := tgtEQ
                if showTargetLabels
                    td.lb_eq := label.new(time, tgtEQ, "TGT 50% " + str.tostring(tgtEQ, format.mintick),
                         xloc=xloc.bar_time,
                         style=label.style_label_left,
                         color=color.new(color.white, 100),
                         textcolor=targetColor,
                         size=size.small,
                         text_font_family=font.family_monospace)
            if showTargetFull and not na(tgtFull)
                // Anchor the 100% line to the bar where C1's extreme formed so it
                // connects directly to the C1 candle; fall back to the sweep point.
                fullAnchorTime = na(tgtFullTime) ? setupTime : tgtFullTime
                td.ln_full := line.new(fullAnchorTime, tgtFull, time, tgtFull, xloc=xloc.bar_time, color=targetColor, width=targetWidth, style=tgtStyle)
                td.p_full := tgtFull
                if showTargetLabels
                    td.lb_full := label.new(time, tgtFull, "TGT 100% " + str.tostring(tgtFull, format.mintick),
                         xloc=xloc.bar_time,
                         style=label.style_label_left,
                         color=color.new(color.white, 100),
                         textcolor=targetColor,
                         size=size.small,
                         text_font_family=font.family_monospace)
        array.push(activeTargets, td)

        // Invalidation level = the C2 sweep wick (setupPrice is C2's extreme).
        invLine = showInvLine ? line.new(setupTime, setupPrice, time, setupPrice, xloc=xloc.bar_time, color=invLineColor, width=invLineWidth, style=getLineStyle(invLineStyle)) : na
        invLbl  = showInvLine and showInvLabel ? label.new(f_invLabelX(setupTime, time), setupPrice, "Invalidation",
             xloc=xloc.bar_time,
             style=invLabelStyle,
             color=color.new(color.white, 100),
             textcolor=invLineColor,
             size=size.small,
             text_font_family=font.family_monospace) : na
        array.push(activeInvLines, invLine)
        array.push(activeInvLabels, invLbl)

if period_changed
    if prevC2Buy and bull_cisd_confirmed and not c2_already_invalidated_bull
        midPoint = not na(prevHTFHigh) and not na(prevHTFLow) ? (prevHTFHigh + prevHTFLow) / 2 : na
        createC2Setup(false, prevLowTime, prevLowPrice, htfO, midPoint, c2_bull_level, c2_bull_index, 0, c2_bull_tgt_eq, c2_bull_tgt_full, c2_bull_tgt_full_time)

    if prevC2Sell and bear_cisd_confirmed and not c2_already_invalidated_bear
        midPoint = not na(prevHTFHigh) and not na(prevHTFLow) ? (prevHTFHigh + prevHTFLow) / 2 : na
        createC2Setup(true, prevHighTime, prevHighPrice, htfO, midPoint, c2_bear_level, c2_bear_index, 0, c2_bear_tgt_eq, c2_bear_tgt_full, c2_bear_tgt_full_time)

if bull_cisd_confirmed and c2_had_bull_sweep and not c2_already_invalidated_bull and htf_count_since_sweep <= 2
    needsCreation = true
    if array.size(activeLabels) > 0
        for i = 0 to array.size(activeLabels) - 1
            if not array.get(activeShorts, i) and array.get(activeCounts, i) <= htf_count_since_sweep
                needsCreation := false
                break
    if needsCreation
        midPoint = not na(prevHTFHigh) and not na(prevHTFLow) ? (prevHTFHigh + prevHTFLow) / 2 : na
        createC2Setup(false, prevLowTime, prevLowPrice, htfO, midPoint, c2_bull_level, c2_bull_index, htf_count_since_sweep, c2_bull_tgt_eq, c2_bull_tgt_full, c2_bull_tgt_full_time)

if bear_cisd_confirmed and c2_had_bear_sweep and not c2_already_invalidated_bear and htf_count_since_sweep <= 2
    needsCreation = true
    if array.size(activeLabels) > 0
        for i = 0 to array.size(activeLabels) - 1
            if array.get(activeShorts, i) and array.get(activeCounts, i) <= htf_count_since_sweep
                needsCreation := false
                break
    if needsCreation
        midPoint = not na(prevHTFHigh) and not na(prevHTFLow) ? (prevHTFHigh + prevHTFLow) / 2 : na
        createC2Setup(true, prevHighTime, prevHighPrice, htfO, midPoint, c2_bear_level, c2_bear_index, htf_count_since_sweep, c2_bear_tgt_eq, c2_bear_tgt_full, c2_bear_tgt_full_time)

if array.size(activeLabels) > 0
    for i = array.size(activeLabels) - 1 to 0
        lbl = array.get(activeLabels, i)
        stop = array.get(activeStops, i)
        isShort = array.get(activeShorts, i)
        count = array.get(activeCounts, i)
        c3Mid = array.get(activeC3Mids, i)
        c4Label = array.get(activeC4Labels, i)
        isInvalidated = array.get(activeInvalidated, i)

        if period_changed
            count += 1
            array.set(activeCounts, i, count)

            if count == 2 and not isInvalidated
                c3Mid := (c3HighForMid + c3LowForMid) / 2
                array.set(activeC3Mids, i, c3Mid)

                shouldCreateC4 = isShort ? c3Mid >= htfO : c3Mid <= htfO
                if shouldCreateC4
                    avg_bar_time = (time - time[1])
                    c4_offset_time = time + (avg_bar_time * 2)

                    c4Lbl = label.new(c4_offset_time, c3Mid, "C4",
                         xloc=xloc.bar_time,
                         style=isShort ? label.style_label_down : label.style_label_up,
                         color=color.new(color.white, 100),
                         textcolor=coloroftext,
                         size=size.small,
                         text_font_family=font.family_monospace)
                    array.set(activeC4Labels, i, c4Lbl)

                    c4OpenLine = showHTFOpen ? line.new(htfTime, htfO, htfTimeClose, htfO, xloc=xloc.bar_time, color=htfOpenColor, width=htfOpenWidth, style=getLineStyle(htfOpenStyle)) : na
                    c4MidLine  = showPrevHTFMid ? line.new(htfTime, c3Mid, htfTimeClose, c3Mid, xloc=xloc.bar_time, color=prevHTFMidColor, width=prevHTFMidWidth, style=getLineStyle(prevHTFMidStyle)) : na
                    c4Box      = showBox and showHTFOpen ? box.new(htfTime, math.max(htfO, c3Mid), htfTimeClose, math.min(htfO, c3Mid), bgcolor=boxColor, border_width=0, xloc=xloc.bar_time) : na

                    array.set(activeC4OpenLines, i, c4OpenLine)
                    array.set(activeC4MidLines, i, c4MidLine)
                    array.set(activeC4Boxes, i, c4Box)

        // Setup lifecycle is over (stop checks end at count 2, target extension
        // at count 4) — retire it into history so the cap can manage it.
        if count > 4
            hist = SetupHistory.new()
            hist.c2_lbl     := lbl
            hist.open_ln    := array.get(activeOpenLines, i)
            hist.mid_ln     := array.get(activeMidLines, i)
            hist.c3_box     := array.get(activeC3Boxes, i)
            hist.c4_lbl     := array.get(activeC4Labels, i)
            hist.c4_open_ln := array.get(activeC4OpenLines, i)
            hist.c4_mid_ln  := array.get(activeC4MidLines, i)
            hist.c4_box     := array.get(activeC4Boxes, i)
            hist.std        := array.get(activeStdDevData, i)
            hist.tgt        := array.get(activeTargets, i)
            hist.inv_ln     := array.get(activeInvLines, i)
            hist.inv_lbl    := array.get(activeInvLabels, i)

            array.remove(activeLabels, i)
            array.remove(activeStops, i)
            array.remove(activeShorts, i)
            array.remove(activeCounts, i)
            array.remove(activeOpenLines, i)
            array.remove(activeMidLines, i)
            array.remove(activeC3Boxes, i)
            array.remove(activeC4Labels, i)
            array.remove(activeC4OpenLines, i)
            array.remove(activeC4MidLines, i)
            array.remove(activeC4Boxes, i)
            array.remove(activeC3Mids, i)
            array.remove(activeCisdConfirmed, i)
            array.remove(activeInvalidated, i)
            array.remove(activeStdDevData, i)
            array.remove(activeTargets, i)
            array.remove(activeInvLines, i)
            array.remove(activeInvLabels, i)
            f_pushHistory(hist)
            continue

        if count <= 2 and not isInvalidated
            invLn = array.size(activeInvLines) > i ? array.get(activeInvLines, i) : na
            if not na(invLn)
                line.set_x2(invLn, time)
                invLb = array.size(activeInvLabels) > i ? array.get(activeInvLabels, i) : na
                if not na(invLb)
                    label.set_x(invLb, f_invLabelX(line.get_x1(invLn), time))

            stopHit = isShort ? high > stop : low < stop
            if stopHit
                array.set(activeInvalidated, i, true)
                if isShort
                    c2_already_invalidated_bear := true
                else
                    c2_already_invalidated_bull := true

                label.set_text(lbl, "XC2")
                label.set_textcolor(lbl, count == 1 ? color.red : color.orange)

                if not na(array.get(activeOpenLines, i))
                    line.delete(array.get(activeOpenLines, i))
                if not na(array.get(activeMidLines, i))
                    line.delete(array.get(activeMidLines, i))
                if not na(array.get(activeC3Boxes, i))
                    box.delete(array.get(activeC3Boxes, i))
                if not na(array.get(activeC4OpenLines, i))
                    line.delete(array.get(activeC4OpenLines, i))
                if not na(array.get(activeC4MidLines, i))
                    line.delete(array.get(activeC4MidLines, i))
                if not na(array.get(activeC4Boxes, i))
                    box.delete(array.get(activeC4Boxes, i))
                if not na(c4Label)
                    label.delete(c4Label)

                if array.size(activeStdDevData) > i
                    stdData = array.get(activeStdDevData, i)
                    for ln in stdData.lines
                        line.delete(ln)
                    for lb in stdData.labels
                        label.delete(lb)

                if array.size(activeTargets) > i
                    tdr = array.get(activeTargets, i)
                    if not na(tdr)
                        line.delete(tdr.ln_eq)
                        label.delete(tdr.lb_eq)
                        line.delete(tdr.ln_full)
                        label.delete(tdr.lb_full)
                    array.remove(activeTargets, i)

                // The XC2 marker and the breached invalidation line survive —
                // hand them to history so the Show Historical / max count
                // settings govern them too.
                hist = SetupHistory.new()
                hist.c2_lbl := lbl
                if array.size(activeInvLines) > i
                    hist.inv_ln := array.get(activeInvLines, i)
                    array.remove(activeInvLines, i)
                if array.size(activeInvLabels) > i
                    hist.inv_lbl := array.get(activeInvLabels, i)
                    array.remove(activeInvLabels, i)
                f_pushHistory(hist)

                array.remove(activeLabels, i)
                array.remove(activeStops, i)
                array.remove(activeShorts, i)
                array.remove(activeCounts, i)
                array.remove(activeOpenLines, i)
                array.remove(activeMidLines, i)
                array.remove(activeC3Boxes, i)
                array.remove(activeC4Labels, i)
                array.remove(activeC4OpenLines, i)
                array.remove(activeC4MidLines, i)
                array.remove(activeC4Boxes, i)
                array.remove(activeC3Mids, i)
                array.remove(activeCisdConfirmed, i)
                array.remove(activeInvalidated, i)
                array.remove(activeStdDevData, i)
                continue

        if count == 2 and not na(c4Label) and not na(c3Mid) and not isInvalidated
            c4StopHit = isShort ? close > c3Mid : close < c3Mid
            if c4StopHit and label.get_text(c4Label) == "C4"
                label.set_text(c4Label, "XC4")
                label.set_textcolor(c4Label, color.red)

                if not na(array.get(activeC4OpenLines, i))
                    line.delete(array.get(activeC4OpenLines, i))
                    array.set(activeC4OpenLines, i, na)
                if not na(array.get(activeC4Boxes, i))
                    box.delete(array.get(activeC4Boxes, i))
                    array.set(activeC4Boxes, i, na)

        if array.size(activeTargets) > i and not isInvalidated
            td = array.get(activeTargets, i)
            if not na(td)
                if not na(td.ln_eq) and not td.hit_eq and count <= 4
                    line.set_x2(td.ln_eq, time)
                    if not na(td.lb_eq)
                        label.set_x(td.lb_eq, time)
                    if (isShort ? low <= td.p_eq : high >= td.p_eq)
                        td.hit_eq := true
                        if not na(td.lb_eq)
                            label.set_text(td.lb_eq, "TGT 50% ✔ " + str.tostring(td.p_eq, format.mintick))
                if not na(td.ln_full) and not td.hit_full and count <= 4
                    line.set_x2(td.ln_full, time)
                    if not na(td.lb_full)
                        label.set_x(td.lb_full, time)
                    if (isShort ? low <= td.p_full : high >= td.p_full)
                        td.hit_full := true
                        if not na(td.lb_full)
                            label.set_text(td.lb_full, "TGT 100% ✔ " + str.tostring(td.p_full, format.mintick))
                array.set(activeTargets, i, td)

if barstate.islast
    tf_display = timeframe.isminutes ? timeframe.period + "m" : timeframe.isdaily ? "1D" : "1W"
    auto_tf_display = auto_tf == "1D" ? "1D" : auto_tf == "1W" ? "1W" : auto_tf == "1M" ? "1M" : auto_tf + "m"
    var table watermark = table.new(position.top_right, 1, 3)
    table.cell(watermark, 0, 0, "DeadCatCode [Beta]", text_color=color.new(color.white, 0), text_size=size.small, bgcolor=color.new(#000000, 0), text_font_family=font.family_monospace)
    table.cell(watermark, 0, 1, tf_display + " → " + auto_tf_display, text_color=color.gray, text_size=size.normal, bgcolor=color.new(color.white, 100), text_font_family=font.family_monospace)
    table.cell(watermark, 0, 2, "" + RemainingTime(auto_tf), text_color=color.new(color.white, 0), text_size=size.normal, bgcolor=color.new(#000000, 0), text_font_family=font.family_monospace)

leftLen = 20
rightLen = 20
ph = ta.pivothigh(high, leftLen, rightLen)
pl = ta.pivotlow(low, leftLen, rightLen)

getValue(piv, src, offset) =>
    curr = ta.valuewhen(not na(piv), src[offset], 0)
    prev = ta.valuewhen(not na(piv), src[offset], 1)
    [curr, prev]

[currH, prevH] = getValue(ph, high, rightLen)
[currL, prevL] = getValue(pl, low, rightLen)

isHH = not na(ph) and prevH < currH
isLH = not na(ph) and prevH > currH
isHL = not na(pl) and prevL < currL
isLL = not na(pl) and prevL > currL

plotchar(isHH and MQmarkers, "HH", "", location.abovebar, color.gray, offset=-rightLen, text="HH", textcolor=color.gray)
plotchar(isHL and MQmarkers, "HL", "", location.belowbar, color.gray, offset=-rightLen, text="HL", textcolor=color.gray)
plotchar(isLH and MQmarkers, "LH", "", location.abovebar, color.gray, offset=-rightLen, text="LH", textcolor=color.gray)
plotchar(isLL and MQmarkers, "LL", "", location.belowbar, color.gray, offset=-rightLen, text="LL", textcolor=color.gray)

_getPos(string pos) =>
    pos == "Top Left" ? position.top_left :
     pos == "Top Right" ? position.top_right :
     pos == "Bottom Left" ? position.bottom_left :
     position.bottom_right

if barstate.islast and show_info_table
    var table infoTbl = table.new(_getPos(info_table_pos), 1, 4, border_width=1)
    table.cell(infoTbl, 0, 0, "Model", text_color=info_table_text, bgcolor=info_table_bg, text_size=info_table_size, text_font_family=font.family_monospace)
    tf_display2 = timeframe.isminutes ? timeframe.period + "m" : timeframe.isdaily ? "1D" : timeframe.isweekly ? "1W" : timeframe.period
    auto_tf_display2 = auto_tf == "1D" ? "1D" : auto_tf == "1W" ? "1W" : auto_tf == "1M" ? "1M" : auto_tf + "m"
    table.cell(infoTbl, 0, 1, tf_display2 + " → " + auto_tf_display2, text_color=info_table_text, bgcolor=color.new(color.white, 100), text_size=info_table_size, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 2, "Bias: " + biasFilter, text_color=info_table_text, bgcolor=info_table_bg, text_size=info_table_size, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 3, RemainingTime(auto_tf), text_color=info_table_text, bgcolor=color.new(color.white, 100), text_size=info_table_size, text_font_family=font.family_monospace)

fvg_lineStyle(string style) =>
    style == '----' ? line.style_dashed : style == '····' ? line.style_dotted : line.style_solid

fvg_validtimeframe() =>
    timeframe.in_seconds() <= timeframe.in_seconds(hide_above_tf)

fvg_get_ltf_values(o, c, t) =>
    float _o = na
    float _c = na
    int   _t = na
    int index = na
    if o.size() > 1
        for i = 0 to o.size() - 1
            if not na(o.get(i))
                index := i
                break
        if not na(index)
            if o.size() >= index
                _o := o.get(index)
            if c.size() >= index
                _c := c.get(index)
            if t.size() >= index
                _t := t.get(index)
    [_o, _c, _t]

fvg_sessionStarted() =>
    bool started = false
    if timeframe.isseconds
        insession = request.security(syminfo.tickerid, "1", (not na(time("1", "1614-0930", "America/New_York")) and na(time("1", "1614-0930", "America/New_York")[1])), lookahead=barmerge.lookahead_on)
        started := insession
    else
        if (timeframe.isminutes and timeframe.multiplier == 1)
            insession = (not na(time("1", "1614-0930", "America/New_York")) and na(time("1", "1614-0930", "America/New_York")[1]))
            started := insession
        if (timeframe.isminutes and timeframe.multiplier > 1)
            insession = request.security_lower_tf(syminfo.tickerid, "1", (not na(time("1", "1614-0930", "America/New_York")) and na(time("1", "1614-0930", "America/New_York")[1])))
            started := insession.includes(true)
    started

fvg_sessionEnded() =>
    bool ended = false
    if timeframe.isseconds
        insession = request.security(syminfo.tickerid, "1", (na(time("1", "1614-0930", "America/New_York")) and not na(time("1", "1614-0930", "America/New_York")[1])), lookahead=barmerge.lookahead_on)
        ended := insession
    else
        if (timeframe.isminutes and timeframe.multiplier == 1)
            insession = (na(time("1", "1614-0930", "America/New_York")) and not na(time("1", "1614-0930", "America/New_York")[1]))
            ended := insession
        if (timeframe.isminutes and timeframe.multiplier > 1)
            insession = request.security_lower_tf(syminfo.tickerid, "1", (na(time("1", "1614-0930", "America/New_York")) and not na(time("1", "1614-0930", "America/New_York")[1])))
            ended := insession.includes(true)
    ended

fvg_get1mFVG(l1, l2, l3, h1, h2, h3, min1, max1, min2, max2, min3, max3, t3) =>
    float o = na
    float c = na
    if (hour(t3, "America/New_York") == 9 and minute(t3, "America/New_York") >= 31) or (hour(t3, "America/New_York") > 9 and hour(t3, "America/New_York") <= 12)
        if l1 > h3
            o := (min2 > max3) ? max3 : h3
            c := (min1 > max2) ? min1 : l1
        if h1 < l3
            c := (max1 < min2) ? max1 : h1
            o := (min3 > max2) ? min3 : l3
    [o, c, t3]

fvg_firstFVG() =>
    float fvg_o = na
    float fvg_c = na
    int   fvg_t = na

    if timeframe.change("1")
        if timeframe.isseconds
            [_o, _c, _t] = request.security(syminfo.tickerid, "1", fvg_get1mFVG(low[1], low[2], low[3], high[1], high[2], high[3], math.min(open[1], close[1]), math.max(open[1], close[1]), math.min(open[2], close[2]), math.max(open[2], close[2]), math.min(open[3], close[3]), math.max(open[3], close[3]), time[2]), lookahead=barmerge.lookahead_on)
            fvg_o := _o
            fvg_c := _c
            fvg_t := _t
        else
            if (timeframe.isminutes and timeframe.multiplier == 1)
                if barstate.isconfirmed
                    [_o, _c, _t] = fvg_get1mFVG(low, low[1], low[2], high, high[1], high[2], math.min(open, close), math.max(open, close), math.min(open[1], close[1]), math.max(open[1], close[1]), math.min(open[2], close[2]), math.max(open[2], close[2]), time[1])
                    fvg_o := _o
                    fvg_c := _c
                    fvg_t := _t
            if (timeframe.isminutes and timeframe.multiplier >= 2)
                [o, c, t] = request.security_lower_tf(syminfo.tickerid, "1", fvg_get1mFVG(low[1], low[2], low[3], high[1], high[2], high[3], math.min(open[1], close[1]), math.max(open[1], close[1]), math.min(open[2], close[2]), math.max(open[2], close[2]), math.min(open[3], close[3]), math.max(open[3], close[3]), time[2]))
                [_o, _c, _t] = fvg_get_ltf_values(o, c, t)
                fvg_o := _o
                fvg_c := _c
                fvg_t := time
    [fvg_o, fvg_c, fvg_t]

type FVGRange
    bool  is_monday
    int   woy
    line  line_o
    line  line_c
    line  line_ce
    line  line_link
    label lab
    linefill lf

method clear(FVGRange this) =>
    this.line_o.delete()
    this.line_c.delete()
    this.line_ce.delete()
    this.line_link.delete()
    this.lab.delete()
    this.lf.delete()

var FVGRange[] fvg_ranges = array.new<FVGRange>()

fvg_tc = (time - time[1]) * extend_right_by

if show_1m_fvg and fvg_validtimeframe()
    if fvg_sessionStarted()
        r = FVGRange.new()
        array.unshift(fvg_ranges, r)

    if fvg_ranges.size() > 0
        r = fvg_ranges.first()
        [fvg_o1, fvg_c1, fvg_t1] = fvg_firstFVG()
        if na(r.line_o)
            if not na(fvg_o1)
                r.is_monday := dayofweek(time, "America/New_York") == dayofweek.monday
                r.woy       := weekofyear(time, "America/New_York")
                r.line_o    := line.new(fvg_t1, fvg_o1, fvg_t1 + fvg_tc, fvg_o1, xloc=xloc.bar_time, color=fvg_o_color, style=fvg_lineStyle(fvg_o_style))
                r.line_c    := line.new(fvg_t1, fvg_c1, fvg_t1 + fvg_tc, fvg_c1, xloc=xloc.bar_time, color=fvg_c_color, style=fvg_lineStyle(fvg_c_style))
                r.line_ce   := line.new(fvg_t1, (fvg_o1 + fvg_c1) / 2, fvg_t1 + fvg_tc, (fvg_o1 + fvg_c1) / 2, xloc=xloc.bar_time, color=fvg_ce_color, style=fvg_lineStyle(fvg_ce_style))
                r.line_link := line.new(fvg_t1 + fvg_tc, fvg_o1, fvg_t1 + fvg_tc, fvg_c1, xloc=xloc.bar_time, color=fvg_link_color, style=fvg_lineStyle(fvg_link_style), width=3)
                if fvg_show_label
                    r.lab := label.new(time + fvg_tc, (fvg_o1 + fvg_c1) / 2, "1st FVG", xloc=xloc.bar_time, textcolor=fvg_label_color, color=fvg_label_bg, size=fvg_label_size, style=label.style_label_left)
                if fvg_show_bg
                    r.lf := linefill.new(r.line_o, r.line_c, fvg_bg_color)
                array.set(fvg_ranges, 0, r)

        for idx = 0 to fvg_ranges.size() - 1
            rr = fvg_ranges.get(idx)
            should_extend = (fvg_extend_monday and rr.is_monday and rr.woy == weekofyear(time, "America/New_York")) or (fvg_extend_all and rr.woy == weekofyear(time_tradingday, "America/New_York"))
            if should_extend and not na(rr.line_o)
                rr.line_o.set_x2(time + fvg_tc)
                rr.line_c.set_x2(time + fvg_tc)
                rr.line_ce.set_x2(time + fvg_tc)
                rr.line_link.set_x1(time + fvg_tc)
                rr.line_link.set_x2(time + fvg_tc)
                if not na(rr.lab)
                    rr.lab.set_x(time + fvg_tc)

    if fvg_ranges.size() > limit_days
        old = fvg_ranges.pop()
        old.clear()
