type StdDevData
    array<line>  lines
    array<label> labels

type TargetData
    line  ln_eq
    label lb_eq
    float p_eq
    bool  hit_eq
    line  ln_full
    label lb_full
    float p_full
    bool  hit_full

type SetupHistory
    label c2_lbl
    line  open_ln
    line  mid_ln
    box   c3_box
    label c4_lbl
    line  c4_open_ln
    line  c4_mid_ln
    box   c4_box
    StdDevData std
    TargetData tgt
    line  inv_ln
    label inv_lbl

type Candle
    float o
    float c
    float h
    float l
    int   o_idx
    int   c_idx
    int   h_idx
    int   l_idx
    int   o_time
    int   c_time
    box   body
    line  wick_up
    line  wick_down
    label time_label
    label htf_time_lbl
    label htf_rem_lbl
    label htf_int_lbl
    line  swing_high_line
    line  swing_low_line
    line  ltf_sweep_high
    line  ltf_sweep_low
    label ltf_sweep_high_lbl
    label ltf_sweep_low_lbl
    bool  is_closed

type FVG
    box b

type cisdNeo
    line  level
    label txt
    bool  completed

getLineStyle(s) => s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed
getTextSize(s)  => s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal

lblSize(opt) => opt == 'tiny' ? size.tiny : opt == 'small' ? size.small : opt == 'large' ? size.large : size.normal

parseUserLevels(inputStr) =>
    var parsedLevels = array.new<float>()
    array.clear(parsedLevels)
    if str.length(inputStr) > 0
        levels = str.split(inputStr, ",")
        for i = 0 to array.size(levels) - 1
            levelStr = str.replace_all(array.get(levels, i), " ", "")
            if str.length(levelStr) > 0
                levelValue = str.tonumber(levelStr)
                if not na(levelValue)
                    array.push(parsedLevels, levelValue)
    parsedLevels

stdDeviations = parseUserLevels(stdDevInput)

formatCandleTime(candleTime, htf) =>
    if str.tonumber(htf) < 60 or (htf == "15" or htf == "30" or htf == "45")
        str.format_time(candleTime, "HH:mm", "America/New_York")
    else if htf == "1D" or htf == "D"
        dayofweek(candleTime, "America/New_York") == 1 ? "M" :
         dayofweek(candleTime, "America/New_York") == 2 ? "T" :
         dayofweek(candleTime, "America/New_York") == 3 ? "W" :
         dayofweek(candleTime, "America/New_York") == 4 ? "T" :
         dayofweek(candleTime, "America/New_York") == 5 ? "F" :
         dayofweek(candleTime, "America/New_York") == 6 ? "S" : "S"
    else if htf == "1W" or htf == "W"
        str.format_time(candleTime, "MMM dd", "America/New_York")
    else if htf == "1M" or htf == "M"
        str.format_time(candleTime, "MMM", "America/New_York")
    else
        str.format_time(candleTime, "HH:mm", "America/New_York")

RemainingTime(auto_tf) =>
    if barstate.isrealtime
        timeRemaining = (time_close(auto_tf) - timenow) / 1000
        hours   = math.floor(timeRemaining / 3600)
        minutes = math.floor((timeRemaining - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - hours * 3600 - minutes * 60)
        str.tostring(hours, "00") + ":" + str.tostring(minutes, "00") + ":" + str.tostring(seconds, "00")
    else
        "n/a"

string calculated_tf =
     timeframe.isminutes ?
         (timeframe.period == "1"  ? "15"  :
          timeframe.period == "3"  ? "30"  :
          timeframe.period == "5"  ? "60"  :
          timeframe.period == "15" ? "240" :
          timeframe.period == "60" ? "1D"  :
          timeframe.period == "240"? "1W"  : "1M") : "1M"

string auto_tf = useAutoTF ? calculated_tf : manualTF

chartMin = timeframe.isminutes ? int(str.tonumber(timeframe.period)) : timeframe.isdaily ? 1440 : 10080
htfMin   = auto_tf == "1D" ? 1440 : auto_tf == "1W" ? 10080 : auto_tf == "1M" ? 43200 : int(str.tonumber(auto_tf))
is_valid_tf = chartMin <= htfMin

if not is_valid_tf or not C2
    runtime.error("Invalid timeframe or C2 disabled!")

[htfO, htfH, htfL, htfTime, htfTimeClose, currentH, currentL, currentC, prevH1, prevL1] = request.security(syminfo.tickerid, auto_tf,
        [open, high, low, time, time_close, high, low, close, high[1], low[1]],
        lookahead=barmerge.lookahead_on)

c2_buy  = currentL < prevL1 and currentC > prevL1
c2_sell = currentH > prevH1 and currentC < prevH1
period_changed = time(auto_tf) != time(auto_tf)[1]
up = close > open
dw = close < open
eq = close == open

