//@version=5
indicator("ledger47-zero-div-v5-dynamic-positive-zero-v1", overlay=false)
denominator = close - close
value = close / denominator
plot(time, title="INPUT_TIME")
plot(close, title="NUMERATOR_CLOSE")
plot(value, title="RAW")
plot(na(value) ? 1 : 0, title="IS_NA")
plot(nz(value, 42.0), title="NZ_42")
