//@version=6
indicator("Percentile hole linear_interpolation length14 p75 v1", precision=16, max_bars_back=500)
clean = close
missing = bar_index == 40 or bar_index == 41
source = missing ? na : clean
plot(bar_index, "input_bar_index", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(source, "input_source", display=display.data_window)
plot(missing ? 1 : 0, "input_missing", display=display.data_window)
plot(ta.percentile_linear_interpolation(source, 14, 75.0), "percentile_linear_interpolation_len14_pct75_hole40_41", display=display.data_window)
plot(ta.percentile_linear_interpolation(clean, 14, 75.0), "clean_control", display=display.data_window)
