indicator("V5-FRACTIONAL-INT-DIVISION-SERIES-NEGATIVE-V1", precision=16)
int numerator = bar_index % 2 == 0 ? -5 : -7
int assigned = numerator / 2
plot(time, "INPUT_TIME")
plot(numerator, "NUMERATOR")
plot(numerator / 2, "RAW")
plot(assigned, "ASSIGNED")
plot(assigned * 2 - numerator, "RESIDUAL")
