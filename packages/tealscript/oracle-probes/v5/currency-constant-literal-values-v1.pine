//@version=6
indicator("V5-CURRENCY-CONSTANT-LITERAL-VALUES-V1")
encode(string code) =>
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    a = str.pos(alphabet, str.substring(code, 0, 1))
    b = str.pos(alphabet, str.substring(code, 1, 2))
    c = str.pos(alphabet, str.substring(code, 2, 3))
    str.length(code) == 3 and a >= 0 and b >= 0 and c >= 0 ? a * 676 + b * 26 + c : na
plot(encode("ABC"), "CONTROL_ABC")
plot(encode("AZZ"), "CONTROL_AZZ")
plot(encode("ZZZ"), "CONTROL_ZZZ")
plot(encode(currency.ARS), "ARS_CODE")
plot(encode(currency.AUD), "AUD_CODE")
plot(encode(currency.BDT), "BDT_CODE")
