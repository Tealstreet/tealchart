//@version=6
indicator("RCI missing sign discriminator v1", precision=16)
phase = bar_index % 64
positive = 10.0 + phase % 7
negative = -10.0 - phase % 7
crossing = -3.0 + phase % 7
missing = phase == 20 or phase == 21
plot(bar_index, "input_bar_index", display=display.data_window)
positiveLeading = bar_index < 5 ? na : positive
positiveHole = missing ? na : positive
plot(positive, "input_positive_clean", display=display.data_window)
plot(ta.rci(positive, 4), "rci_len4_positive_clean", display=display.data_window)
plot(ta.rci(positive, 14), "rci_len14_positive_clean", display=display.data_window)
plot(positiveLeading, "input_positive_leading", display=display.data_window)
plot(ta.rci(positiveLeading, 4), "rci_len4_positive_leading", display=display.data_window)
plot(ta.rci(positiveLeading, 14), "rci_len14_positive_leading", display=display.data_window)
plot(positiveHole, "input_positive_hole", display=display.data_window)
plot(ta.rci(positiveHole, 4), "rci_len4_positive_hole", display=display.data_window)
plot(ta.rci(positiveHole, 14), "rci_len14_positive_hole", display=display.data_window)
negativeLeading = bar_index < 5 ? na : negative
negativeHole = missing ? na : negative
plot(negative, "input_negative_clean", display=display.data_window)
plot(ta.rci(negative, 4), "rci_len4_negative_clean", display=display.data_window)
plot(ta.rci(negative, 14), "rci_len14_negative_clean", display=display.data_window)
plot(negativeLeading, "input_negative_leading", display=display.data_window)
plot(ta.rci(negativeLeading, 4), "rci_len4_negative_leading", display=display.data_window)
plot(ta.rci(negativeLeading, 14), "rci_len14_negative_leading", display=display.data_window)
plot(negativeHole, "input_negative_hole", display=display.data_window)
plot(ta.rci(negativeHole, 4), "rci_len4_negative_hole", display=display.data_window)
plot(ta.rci(negativeHole, 14), "rci_len14_negative_hole", display=display.data_window)
crossingLeading = bar_index < 5 ? na : crossing
crossingHole = missing ? na : crossing
plot(crossing, "input_crossing_clean", display=display.data_window)
plot(ta.rci(crossing, 4), "rci_len4_crossing_clean", display=display.data_window)
plot(ta.rci(crossing, 14), "rci_len14_crossing_clean", display=display.data_window)
plot(crossingLeading, "input_crossing_leading", display=display.data_window)
plot(ta.rci(crossingLeading, 4), "rci_len4_crossing_leading", display=display.data_window)
plot(ta.rci(crossingLeading, 14), "rci_len14_crossing_leading", display=display.data_window)
plot(crossingHole, "input_crossing_hole", display=display.data_window)
plot(ta.rci(crossingHole, 4), "rci_len4_crossing_hole", display=display.data_window)
plot(ta.rci(crossingHole, 14), "rci_len14_crossing_hole", display=display.data_window)
