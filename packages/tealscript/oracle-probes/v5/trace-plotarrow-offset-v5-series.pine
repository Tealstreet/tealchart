//@version=5
indicator("trace-plotarrow-offset-v5-series",overlay=true)
phase=bar_index%32
source=phase==8?1:phase==9?-1:phase==11?4:phase==12?-4:0
series_offset=phase<10?2:phase<12?-1:-3
plotarrow(source,colorup=color.lime,colordown=color.red,offset=series_offset,minheight=10,maxheight=50)
plot(bar_index,"BAR_INDEX",display=display.data_window)
plot(source,"SOURCE",display=display.data_window)
plot(series_offset,"OFFSET",display=display.data_window)
plot(10,"MINHEIGHT",display=display.data_window)
plot(50,"MAXHEIGHT",display=display.data_window)
