//@version=6
indicator("trace-matrix-predicate-epsilon-v1")
phase=bar_index % 8
value=switch phase
    0 => 0.0
    1 => 1e-15
    2 => 1e-12
    3 => 1e-10
    4 => 1e-9
    5 => 1e-8
    6 => 1e-7
    => 1e-6
positive=matrix.new<float>(1,1,value)
negative=matrix.new<float>(1,1,-value)
nearOne=matrix.new<float>(1,1,1.0+value)
plot(phase,"PHASE")
plot(value,"VALUE")
plot(matrix.is_zero(positive)?1:0,"ZERO_POSITIVE")
plot(matrix.is_zero(negative)?1:0,"ZERO_NEGATIVE")
plot(matrix.is_binary(nearOne)?1:0,"BINARY_NEAR_ONE")
