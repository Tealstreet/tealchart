//@version=6
indicator("Percentile hole nearest_rank length14 p25 v1", precision=16, max_bars_back=500)
clean = close
missing = bar_index == 40 or bar_index == 41
source = missing ? na : clean
plot(bar_index, "input_bar_index", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(source, "input_source", display=display.data_window)
plot(missing ? 1 : 0, "input_missing", display=display.data_window)
plot(ta.percentile_nearest_rank(source, 14, 25.0), "percentile_nearest_rank_len14_pct25_hole40_41", display=display.data_window)
plot(ta.percentile_nearest_rank(clean, 14, 25.0), "clean_control", display=display.data_window)
