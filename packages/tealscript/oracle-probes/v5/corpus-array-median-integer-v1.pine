//@version=6
indicator("corpus-array-median-integer-v1")
a0 = array.new<int>()
array.push(a0, 2)
array.push(a0, 4)
array.push(a0, 6)
int m0 = array.median(a0)
plot(m0, "median_0")
a1 = array.new<int>()
array.push(a1, 1)
array.push(a1, 2)
int m1 = array.median(a1)
plot(m1, "median_1")
a2 = array.new<int>()
array.push(a2, -2)
array.push(a2, -1)
int m2 = array.median(a2)
plot(m2, "median_2")
