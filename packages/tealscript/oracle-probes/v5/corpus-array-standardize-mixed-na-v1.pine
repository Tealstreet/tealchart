//@version=6
indicator("Corpus array standardize mixed NA v1")
middle = array.standardize(array.from(10.0, na, 30.0))
plot(array.size(middle), "middle_size")
plot(array.size(middle) > 0 ? array.get(middle, 0) : -999.0, "middle_slot0")
plot(array.size(middle) > 1 ? array.get(middle, 1) : -999.0, "middle_slot1")
plot(array.size(middle) > 2 ? array.get(middle, 2) : -999.0, "middle_slot2")
first = array.standardize(array.from(na, 10.0, 30.0))
plot(array.size(first), "first_size")
plot(array.size(first) > 0 ? array.get(first, 0) : -999.0, "first_slot0")
plot(array.size(first) > 1 ? array.get(first, 1) : -999.0, "first_slot1")
plot(array.size(first) > 2 ? array.get(first, 2) : -999.0, "first_slot2")
last = array.standardize(array.from(10.0, 30.0, na))
plot(array.size(last), "last_size")
plot(array.size(last) > 0 ? array.get(last, 0) : -999.0, "last_slot0")
plot(array.size(last) > 1 ? array.get(last, 1) : -999.0, "last_slot1")
plot(array.size(last) > 2 ? array.get(last, 2) : -999.0, "last_slot2")
all = array.standardize(array.from(na, na, na))
plot(array.size(all), "all_size")
plot(array.size(all) > 0 ? array.get(all, 0) : -999.0, "all_slot0")
plot(array.size(all) > 1 ? array.get(all, 1) : -999.0, "all_slot1")
plot(array.size(all) > 2 ? array.get(all, 2) : -999.0, "all_slot2")
finite = array.standardize(array.from(10.0, 20.0, 30.0))
plot(array.size(finite), "finite_size")
plot(array.size(finite) > 0 ? array.get(finite, 0) : -999.0, "finite_slot0")
plot(array.size(finite) > 1 ? array.get(finite, 1) : -999.0, "finite_slot1")
plot(array.size(finite) > 2 ? array.get(finite, 2) : -999.0, "finite_slot2")
