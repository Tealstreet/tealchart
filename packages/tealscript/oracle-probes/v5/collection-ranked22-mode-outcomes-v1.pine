//@version=6
indicator("Collection22 mode outcomes")
int_unique = array.from(-8, 7, -8, 4, 7, 7)
int_tie = array.from(9, -2, 9, -2)
int_single = array.from(3)
int_distinct = array.from(8, 1, 3)
int_empty = array.new<int>()
float_unique = array.from(-8.5, 7.25, -8.5, 4.0, 7.25, 7.25)
float_tie = array.from(9.5, -2.5, 9.5, -2.5)
float_single = array.from(3.5)
float_distinct = array.from(8.5, 1.5, 3.5)
float_empty = array.new<float>()
plot(array.mode(int_unique), "int_unique")
plot(array.mode(int_tie), "int_tie")
plot(array.mode(int_single), "int_single")
plot(array.mode(int_distinct), "int_distinct_namespace")
plot(int_distinct.mode(), "int_distinct_method")
plot(array.mode(int_empty), "int_empty")
plot(array.mode(float_unique), "float_unique")
plot(array.mode(float_tie), "float_tie")
plot(array.mode(float_single), "float_single")
plot(array.mode(float_distinct), "float_distinct_namespace")
plot(float_distinct.mode(), "float_distinct_method")
plot(array.mode(float_empty), "float_empty")
