//@version=6
indicator("Collection11 eigenvectors and integer pinv", overlay=false)
m = matrix.new<float>(3, 3, 0)
matrix.set(m, 0, 1, 2)
matrix.set(m, 1, 0, 2)
matrix.set(m, 2, 2, 1)
v = matrix.eigenvectors(m)
plot(matrix.get(v, 0, 0), "V00")
plot(matrix.get(v, 1, 0), "V10")
plot(matrix.get(v, 2, 0), "V20")
plot(matrix.get(v, 0, 1), "V01")
plot(matrix.get(v, 1, 1), "V11")
plot(matrix.get(v, 2, 1), "V21")
plot(matrix.get(v, 0, 2), "V02")
plot(matrix.get(v, 1, 2), "V12")
plot(matrix.get(v, 2, 2), "V22")
i = matrix.new<int>(2, 2, 0)
matrix.set(i, 0, 0, 2)
matrix.set(i, 1, 1, 4)
p = matrix.pinv(i)
plot(matrix.get(p, 0, 0), "INT_PINV00")
plot(matrix.get(p, 1, 1), "INT_PINV11")
