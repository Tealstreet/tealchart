//@version=6
indicator("Percentile hole linear_interpolation length4 p75 v1", precision=16, max_bars_back=500)
phase = bar_index % 64
clean = 10.0 + phase % 7
missing = phase == 12 or phase == 13
source = missing ? na : clean
plot(bar_index, "input_bar_index", display=display.data_window)
plot(time, "input_time", display=display.data_window)
plot(close, "input_close", display=display.data_window)
plot(source, "input_source", display=display.data_window)
plot(missing ? 1 : 0, "input_missing", display=display.data_window)
plot(ta.percentile_linear_interpolation(source, 4, 75.0), "linear_hole_builtin", display=display.data_window)
plot(ta.percentile_linear_interpolation(clean, 4, 75.0), "clean_control", display=display.data_window)
