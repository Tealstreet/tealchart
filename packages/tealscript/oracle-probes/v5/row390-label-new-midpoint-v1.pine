//@version=6
indicator("row390-label-new-midpoint-v1", overlay=true)
invLabelPos = input.string("Right", "Label Position", options=["Left", "Center", "Right"])
f_invLabelX(int x1, int x2) =>
    invLabelPos == "Left" ? x1 : invLabelPos == "Center" ? (x1 + x2) / 2 : x2
if barstate.islast
    label.new(f_invLabelX(time[1], time), close, "Invalidation", xloc=xloc.bar_time)
plot(close, "compile_control")
