//@version=6
indicator("V54 hma-nested-rounding-startup", calc_bars_count=32)
var int sample = 0
ramp = 100.0 + sample
impulse = sample == 12 ? 20.0 : 0.0
rampHma9 = ta.hma(ramp, 9)
rampModel9HALF_FLOOR = ta.wma(2.0 * ta.wma(ramp, 4) - ta.wma(ramp, 9), 3)
rampModel9HALF_CEIL = ta.wma(2.0 * ta.wma(ramp, 5) - ta.wma(ramp, 9), 3)
rampHma10 = ta.hma(ramp, 10)
rampModel10SQRT_FLOOR = ta.wma(2.0 * ta.wma(ramp, 5) - ta.wma(ramp, 10), 3)
rampModel10SQRT_CEIL = ta.wma(2.0 * ta.wma(ramp, 5) - ta.wma(ramp, 10), 4)
impulseHma9 = ta.hma(impulse, 9)
impulseModel9HALF_FLOOR = ta.wma(2.0 * ta.wma(impulse, 4) - ta.wma(impulse, 9), 3)
impulseModel9HALF_CEIL = ta.wma(2.0 * ta.wma(impulse, 5) - ta.wma(impulse, 9), 3)
impulseHma10 = ta.hma(impulse, 10)
impulseModel10SQRT_FLOOR = ta.wma(2.0 * ta.wma(impulse, 5) - ta.wma(impulse, 10), 3)
impulseModel10SQRT_CEIL = ta.wma(2.0 * ta.wma(impulse, 5) - ta.wma(impulse, 10), 4)
plot(ramp, "INPUT_RAMP")
plot(impulse, "INPUT_IMPULSE")
plot(rampHma9, "RAMP_HMA_9")
plot(na(rampHma9) ? 1 : 0, "RAMP_HMA_9_NA")
plot(nz(rampHma9, 123456.0), "RAMP_HMA_9_NZ_SENTINEL")
plot(rampModel9HALF_FLOOR, "RAMP_MODEL_9_HALF_FLOOR")
plot(rampModel9HALF_CEIL, "RAMP_MODEL_9_HALF_CEIL")
plot(rampHma10, "RAMP_HMA_10")
plot(na(rampHma10) ? 1 : 0, "RAMP_HMA_10_NA")
plot(nz(rampHma10, 123456.0), "RAMP_HMA_10_NZ_SENTINEL")
plot(rampModel10SQRT_FLOOR, "RAMP_MODEL_10_SQRT_FLOOR")
plot(rampModel10SQRT_CEIL, "RAMP_MODEL_10_SQRT_CEIL")
plot(impulseHma9, "IMPULSE_HMA_9")
plot(na(impulseHma9) ? 1 : 0, "IMPULSE_HMA_9_NA")
plot(nz(impulseHma9, 123456.0), "IMPULSE_HMA_9_NZ_SENTINEL")
plot(impulseModel9HALF_FLOOR, "IMPULSE_MODEL_9_HALF_FLOOR")
plot(impulseModel9HALF_CEIL, "IMPULSE_MODEL_9_HALF_CEIL")
plot(impulseHma10, "IMPULSE_HMA_10")
plot(na(impulseHma10) ? 1 : 0, "IMPULSE_HMA_10_NA")
plot(nz(impulseHma10, 123456.0), "IMPULSE_HMA_10_NZ_SENTINEL")
plot(impulseModel10SQRT_FLOOR, "IMPULSE_MODEL_10_SQRT_FLOOR")
plot(impulseModel10SQRT_CEIL, "IMPULSE_MODEL_10_SQRT_CEIL")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
