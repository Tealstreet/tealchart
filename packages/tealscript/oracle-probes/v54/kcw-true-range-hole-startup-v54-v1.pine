//@version=6
indicator("V54 kcw-true-range-hole-startup", calc_bars_count=32)
var int sample = 0
ohlcMissing = na(high) or na(low) or na(close)
defaultValue = ta.kcw(close, 3, 2)
trueValue = ta.kcw(close, 3, 2, true)
falseValue = ta.kcw(close, 3, 2, false)
plot(ohlcMissing ? 1 : 0, "OHLC_MISSING")
plot(na(close[1]) ? 1 : 0, "PREVIOUS_CLOSE_NA")
plot(ta.tr, "TR_VARIABLE")
plot(ta.tr(true), "TR_TRUE_CONTROL")
plot(defaultValue, "DEFAULT_KCW")
plot(na(defaultValue) ? 1 : 0, "DEFAULT_KCW_NA")
plot(nz(defaultValue, 123456.0), "DEFAULT_KCW_NZ_SENTINEL")
plot(trueValue, "TRUE_KCW")
plot(na(trueValue) ? 1 : 0, "TRUE_KCW_NA")
plot(nz(trueValue, 123456.0), "TRUE_KCW_NZ_SENTINEL")
plot(falseValue, "FALSE_KCW")
plot(na(falseValue) ? 1 : 0, "FALSE_KCW_NA")
plot(nz(falseValue, 123456.0), "FALSE_KCW_NZ_SENTINEL")
plot(open, "INPUT_OPEN")
plot(high, "INPUT_HIGH")
plot(low, "INPUT_LOW")
plot(close, "INPUT_CLOSE")
plot(volume, "INPUT_VOLUME")
plot(na(high) ? 1 : 0, "HIGH_NA")
plot(na(low) ? 1 : 0, "LOW_NA")
plot(na(close) ? 1 : 0, "CLOSE_NA")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
