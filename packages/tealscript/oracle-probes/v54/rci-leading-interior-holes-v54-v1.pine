//@version=6
indicator("V54 rci-leading-interior-holes", calc_bars_count=32)
var int sample = 0
phase = sample % 8
clean = switch phase
    0 => 1
    1 => 4
    2 => 6
    3 => 2
    4 => 8
    5 => -1
    6 => 3
    => 5
float source = sample < 2 or phase == 2 or phase == 5 ? na : clean
rciValue = ta.rci(source, 4)
cleanValue = ta.rci(clean, 4)
plot(phase, "PHASE")
plot(source, "INPUT_SOURCE")
plot(clean, "CLEAN_SOURCE")
plot(na(source) ? 1 : 0, "SOURCE_NA")
plot(rciValue, "RCI_4")
plot(na(rciValue) ? 1 : 0, "RCI_4_NA")
plot(nz(rciValue, 123456.0), "RCI_4_NZ_SENTINEL")
plot(cleanValue, "CLEAN_RCI_4")
plot(na(cleanValue) ? 1 : 0, "CLEAN_RCI_4_NA")
plot(nz(cleanValue, 123456.0), "CLEAN_RCI_4_NZ_SENTINEL")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
