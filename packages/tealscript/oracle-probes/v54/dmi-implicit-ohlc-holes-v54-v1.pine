//@version=6
indicator("V54 dmi-implicit-ohlc-holes", calc_bars_count=32)
var int sample = 0
ohlcMissing = na(high) or na(low) or na(close)
[plusValue, minusValue, adxValue] = ta.dmi(3, 3)
plot(ohlcMissing ? 1 : 0, "OHLC_MISSING")
plot(not ohlcMissing and ohlcMissing[1] ? 1 : 0, "RECOVERY_AFTER_MISSING")
plot(plusValue, "PLUS_DI_3")
plot(na(plusValue) ? 1 : 0, "PLUS_DI_3_NA")
plot(nz(plusValue, 123456.0), "PLUS_DI_3_NZ_SENTINEL")
plot(minusValue, "MINUS_DI_3")
plot(na(minusValue) ? 1 : 0, "MINUS_DI_3_NA")
plot(nz(minusValue, 123456.0), "MINUS_DI_3_NZ_SENTINEL")
plot(adxValue, "ADX_3")
plot(na(adxValue) ? 1 : 0, "ADX_3_NA")
plot(nz(adxValue, 123456.0), "ADX_3_NZ_SENTINEL")
plot(open, "INPUT_OPEN")
plot(high, "INPUT_HIGH")
plot(low, "INPUT_LOW")
plot(close, "INPUT_CLOSE")
plot(volume, "INPUT_VOLUME")
plot(na(high) ? 1 : 0, "HIGH_NA")
plot(na(low) ? 1 : 0, "LOW_NA")
plot(na(close) ? 1 : 0, "CLOSE_NA")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
