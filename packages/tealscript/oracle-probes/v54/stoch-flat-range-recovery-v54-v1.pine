//@version=6
indicator("V54 stoch-flat-range-recovery", calc_bars_count=32)
var int sample = 0
phase = sample % 4
lowSource = 10.0
highSource = phase == 0 or phase == 2 ? 10.0 : 18.0
closeSource = phase == 1 ? 12.0 : phase == 3 ? 16.0 : 10.0
value = ta.stoch(closeSource, highSource, lowSource, 1)
plot(phase, "PHASE")
plot(lowSource, "INPUT_LOW_SOURCE")
plot(highSource, "INPUT_HIGH_SOURCE")
plot(closeSource, "INPUT_CLOSE_SOURCE")
plot(highSource - lowSource, "INPUT_RANGE")
plot(value, "STOCH_1")
plot(na(value) ? 1 : 0, "STOCH_1_NA")
plot(nz(value, 123456.0), "STOCH_1_NZ_SENTINEL")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
