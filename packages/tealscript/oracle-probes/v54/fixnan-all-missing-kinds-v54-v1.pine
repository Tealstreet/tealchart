//@version=6
indicator("V54 fixnan-all-missing-kinds", calc_bars_count=32)
var int sample = 0
int intValue = fixnan(int(na))
float floatValue = fixnan(float(na))
color colorValue = fixnan(color(na))
plot(intValue, "INT_ALL_MISSING")
plot(na(intValue) ? 1 : 0, "INT_ALL_MISSING_NA")
plot(nz(intValue, 123456.0), "INT_ALL_MISSING_NZ_SENTINEL")
plot(floatValue, "FLOAT_ALL_MISSING")
plot(na(floatValue) ? 1 : 0, "FLOAT_ALL_MISSING_NA")
plot(nz(floatValue, 123456.0), "FLOAT_ALL_MISSING_NZ_SENTINEL")
plot(na(colorValue) ? 1 : 0, "COLOR_ALL_MISSING_NA")
plot(na(colorValue) ? -1 : color.r(colorValue)*65536+color.g(colorValue)*256+color.b(colorValue), "COLOR_ALL_MISSING_RGB")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
