//@version=6
indicator("V54 kc-true-range-hole-startup", calc_bars_count=32)
var int sample = 0
ohlcMissing = na(high) or na(low) or na(close)
[defaultBasis, defaultUpper, defaultLower] = ta.kc(close, 3, 2)
[trueBasis, trueUpper, trueLower] = ta.kc(close, 3, 2, true)
[falseBasis, falseUpper, falseLower] = ta.kc(close, 3, 2, false)
plot(ohlcMissing ? 1 : 0, "OHLC_MISSING")
plot(na(close[1]) ? 1 : 0, "PREVIOUS_CLOSE_NA")
plot(ta.tr, "TR_VARIABLE")
plot(ta.tr(true), "TR_TRUE_CONTROL")
plot(defaultBasis, "DEFAULT_BASIS")
plot(na(defaultBasis) ? 1 : 0, "DEFAULT_BASIS_NA")
plot(nz(defaultBasis, 123456.0), "DEFAULT_BASIS_NZ_SENTINEL")
plot(defaultUpper, "DEFAULT_UPPER")
plot(defaultLower, "DEFAULT_LOWER")
plot(trueBasis, "TRUE_BASIS")
plot(na(trueBasis) ? 1 : 0, "TRUE_BASIS_NA")
plot(nz(trueBasis, 123456.0), "TRUE_BASIS_NZ_SENTINEL")
plot(trueUpper, "TRUE_UPPER")
plot(trueLower, "TRUE_LOWER")
plot(falseBasis, "FALSE_BASIS")
plot(na(falseBasis) ? 1 : 0, "FALSE_BASIS_NA")
plot(nz(falseBasis, 123456.0), "FALSE_BASIS_NZ_SENTINEL")
plot(falseUpper, "FALSE_UPPER")
plot(falseLower, "FALSE_LOWER")
plot(open, "INPUT_OPEN")
plot(high, "INPUT_HIGH")
plot(low, "INPUT_LOW")
plot(close, "INPUT_CLOSE")
plot(volume, "INPUT_VOLUME")
plot(na(high) ? 1 : 0, "HIGH_NA")
plot(na(low) ? 1 : 0, "LOW_NA")
plot(na(close) ? 1 : 0, "CLOSE_NA")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
