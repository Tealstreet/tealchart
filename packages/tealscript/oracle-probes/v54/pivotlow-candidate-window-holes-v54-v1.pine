//@version=6
indicator("V54 pivotlow-candidate-window-holes", calc_bars_count=32)
var int sample = 0
caseValue = input.int(1, "Hole case", options=[0, 1, 2, 3, 4])
phase = sample % 8
baseSource = switch phase
    0 => 1
    1 => 2
    2 => 9
    3 => 4
    4 => 1
    5 => 2
    6 => 1
    => 0
clean = baseSource * -1.0
hole = caseValue == 1 and phase == 2 or caseValue == 2 and phase == 1 or caseValue == 3 and phase == 3
source = hole ? float(na) : caseValue == 4 and phase == 1 ? 9.0 * -1 : clean
value11 = ta.pivotlow(source, 1, 1)
value21 = ta.pivotlow(source, 2, 1)
clean11 = ta.pivotlow(clean, 1, 1)
clean21 = ta.pivotlow(clean, 2, 1)
plot(phase, "PHASE")
plot(caseValue, "CASE")
plot(source, "INPUT_SOURCE")
plot(clean, "CLEAN_SOURCE")
plot(hole ? 1 : 0, "SOURCE_HOLE")
plot(value11, "PIVOT_1_1")
plot(na(value11) ? 1 : 0, "PIVOT_1_1_NA")
plot(nz(value11, 123456.0), "PIVOT_1_1_NZ_SENTINEL")
plot(value21, "PIVOT_2_1")
plot(na(value21) ? 1 : 0, "PIVOT_2_1_NA")
plot(nz(value21, 123456.0), "PIVOT_2_1_NZ_SENTINEL")
plot(clean11, "CLEAN_PIVOT_1_1")
plot(clean21, "CLEAN_PIVOT_2_1")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
