//@version=6
indicator("V54 supertrend-warmup-direction", calc_bars_count=32)
var int sample = 0
[lineValue, directionValue] = ta.supertrend(3, 3)
plot(lineValue, "SUPERTREND_LINE")
plot(na(lineValue) ? 1 : 0, "SUPERTREND_LINE_NA")
plot(nz(lineValue, 123456.0), "SUPERTREND_LINE_NZ_SENTINEL")
plot(directionValue, "SUPERTREND_DIRECTION")
plot(na(directionValue) ? 1 : 0, "SUPERTREND_DIRECTION_NA")
plot(nz(directionValue, 123456.0), "SUPERTREND_DIRECTION_NZ_SENTINEL")
plot(ta.atr(3), "ATR_3_CONTROL")
plot(sample < 6 ? 1 : 0, "ELIGIBLE_WARMUP")
plot(open, "INPUT_OPEN")
plot(high, "INPUT_HIGH")
plot(low, "INPUT_LOW")
plot(close, "INPUT_CLOSE")
plot(volume, "INPUT_VOLUME")
plot(na(high) ? 1 : 0, "HIGH_NA")
plot(na(low) ? 1 : 0, "LOW_NA")
plot(na(close) ? 1 : 0, "CLOSE_NA")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
