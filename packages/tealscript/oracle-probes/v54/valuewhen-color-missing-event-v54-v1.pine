//@version=6
indicator("V54 valuewhen-color-missing-event", calc_bars_count=32)
var int sample = 0
event = sample == 0 or sample == 2 or sample == 4
color eventSource = sample == 0 ? color(na) : sample < 4 ? #123456 : #a1b2c3
v0 = ta.valuewhen(event, eventSource, 0)
v1 = ta.valuewhen(event, eventSource, 1)
v2 = ta.valuewhen(event, eventSource, 2)
plot(event ? 1 : 0, "INPUT_EVENT")
plot(na(eventSource) ? -1 : color.r(eventSource) * 65536 + color.g(eventSource) * 256 + color.b(eventSource), "INPUT_SOURCE_ENCODED")
plot(na(eventSource) ? 1 : 0, "INPUT_SOURCE_NA")
plot(na(v0) ? -1 : color.r(v0) * 65536 + color.g(v0) * 256 + color.b(v0), "OCCURRENCE_0_ENCODED")
plot(na(v0) ? 1 : 0, "OCCURRENCE_0_NA")
plot(na(v1) ? -1 : color.r(v1) * 65536 + color.g(v1) * 256 + color.b(v1), "OCCURRENCE_1_ENCODED")
plot(na(v1) ? 1 : 0, "OCCURRENCE_1_NA")
plot(na(v2) ? -1 : color.r(v2) * 65536 + color.g(v2) * 256 + color.b(v2), "OCCURRENCE_2_ENCODED")
plot(na(v2) ? 1 : 0, "OCCURRENCE_2_NA")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
