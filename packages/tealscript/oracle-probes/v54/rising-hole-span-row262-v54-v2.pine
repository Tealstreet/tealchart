//@version=6
indicator("V54 rising-hole-span-row262", calc_bars_count=32)
var int sample = 0
phase = sample % 16
source = switch phase
    0 => 4
    1 => float(na)
    2 => 3
    3 => float(na)
    4 => 2
    5 => 5
    6 => 1
    7 => 9
    8 => 8
    9 => 7
    10 => 6
    11 => 5
    12 => 4
    13 => 5
    14 => 6
    => 7
clean = switch phase
    0 => 4
    1 => 3.5
    2 => 3
    3 => 2.5
    4 => 2
    5 => 5
    6 => 1
    7 => 9
    8 => 8
    9 => 7
    10 => 6
    11 => 5
    12 => 4
    13 => 5
    14 => 6
    => 7
result = ta.rising(source, 3)
cleanResult = ta.rising(clean, 3)
plot(phase, "PHASE")
plot(source, "INPUT_SOURCE")
plot(na(source) ? 1 : 0, "SOURCE_NA")
plot(source[1], "PHYSICAL_PREVIOUS_1")
plot(source[2], "PHYSICAL_PREVIOUS_2")
plot(source[3], "PHYSICAL_PREVIOUS_3")
plot(result ? 1 : 0, "BUILTIN_RESULT")
plot(clean, "CLEAN_SOURCE_CONTROL")
plot(cleanResult ? 1 : 0, "CLEAN_RESULT_CONTROL")
plot(sample, "SAMPLE_INDEX")
plot(bar_index, "SOURCE_INDEX")
plot(time, "SOURCE_TIME")
sample += 1
