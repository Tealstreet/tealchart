//@version=6
indicator("coverage-math-1-v1 — BTCUSDT 2m", overlay=false, precision=12, max_bars_back=200)
// Standard BINANCE:BTCUSDT 2-minute chart. Export all 60 Data Window columns.
// Leading na at b0..7; recurring interior na at b%97=40,41,42.
if timeframe.period != "2"
    runtime.error("Use BTCUSDT standard 2-minute candles")
int b = bar_index
bool hole = b % 97 == 40 or b % 97 == 41 or b % 97 == 42
float clean = (b % 17 - 8) / 4.0
float holes = hole ? na : clean
float warm = b < 8 ? na : clean

_v9_original_plot_000 = open
_v9_original_plot_001 = high
_v9_original_plot_002 = low
_v9_original_plot_003 = close
_v9_original_plot_004 = volume
_v9_original_plot_005 = time
_v9_original_plot_006 = bar_index
_v9_original_plot_007 = math.abs(clean)
_v9_original_plot_008 = math.abs(holes)
_v9_original_plot_009 = math.abs(warm)
_v9_original_plot_010 = math.sign(clean)
_v9_original_plot_011 = math.sign(holes)
_v9_original_plot_012 = math.sign(warm)
_v9_original_plot_013 = math.ceil(clean)
_v9_original_plot_014 = math.ceil(holes)
_v9_original_plot_015 = math.ceil(warm)
_v9_original_plot_016 = math.floor(clean)
_v9_original_plot_017 = math.floor(holes)
_v9_original_plot_018 = math.floor(warm)
_v9_original_plot_019 = math.round(clean)
_v9_original_plot_020 = math.round(holes)
_v9_original_plot_021 = math.round(warm)
_v9_original_plot_022 = math.round_to_mintick(100 + clean / 100)
_v9_original_plot_023 = math.round_to_mintick(100 + holes / 100)
_v9_original_plot_024 = math.round_to_mintick(100 + warm / 100)
_v9_original_plot_025 = math.sqrt(math.abs(clean) + 1)
_v9_original_plot_026 = math.sqrt(math.abs(holes) + 1)
_v9_original_plot_027 = math.sqrt(math.abs(warm) + 1)
_v9_original_plot_028 = math.pow(math.abs(clean) + 1, 0.5)
_v9_original_plot_029 = math.pow(math.abs(holes) + 1, 0.5)
_v9_original_plot_030 = math.pow(math.abs(warm) + 1, 0.5)
_v9_original_plot_031 = math.log(math.abs(clean) + 1)
_v9_original_plot_032 = math.log(math.abs(holes) + 1)
_v9_original_plot_033 = math.log(math.abs(warm) + 1)
_v9_original_plot_034 = math.log10(math.abs(clean) + 1)
_v9_original_plot_035 = math.log10(math.abs(holes) + 1)
_v9_original_plot_036 = math.log10(math.abs(warm) + 1)
_v9_original_plot_037 = math.exp(clean / 4)
_v9_original_plot_038 = math.exp(holes / 4)
_v9_original_plot_039 = math.exp(warm / 4)
_v9_original_plot_040 = math.sin(clean)
_v9_original_plot_041 = math.sin(holes)
_v9_original_plot_042 = math.sin(warm)
_v9_original_plot_043 = math.cos(clean)
_v9_original_plot_044 = math.cos(holes)
_v9_original_plot_045 = math.cos(warm)
_v9_original_plot_046 = math.tan(clean)
_v9_original_plot_047 = math.tan(holes)
_v9_original_plot_048 = math.tan(warm)
_v9_original_plot_049 = math.asin(clean / 3)
_v9_original_plot_050 = math.asin(holes / 3)
_v9_original_plot_051 = math.asin(warm / 3)
_v9_original_plot_052 = math.acos(clean / 3)
_v9_original_plot_053 = math.acos(holes / 3)
_v9_original_plot_054 = math.acos(warm / 3)
_v9_original_plot_055 = math.atan(clean)
_v9_original_plot_056 = math.atan(holes)
_v9_original_plot_057 = math.atan(warm)
_v9_original_plot_058 = math.sqrt(math.abs(clean)+1)-math.pow(math.abs(clean)+1,0.5)
_v9_original_plot_059 = math.round(clean)-math.floor(clean+0.5)

plot(_v9_original_plot_000, "input_open", display=display.data_window)
plot(_v9_original_plot_001, "input_high", display=display.data_window)
plot(_v9_original_plot_002, "input_low", display=display.data_window)
plot(_v9_original_plot_003, "input_close", display=display.data_window)
plot(_v9_original_plot_004, "input_volume", display=display.data_window)
plot(_v9_original_plot_005, "input_time", display=display.data_window)
plot(_v9_original_plot_006, "input_bar_index", display=display.data_window)
plot(_v9_original_plot_038, "exp_hole97", display=display.data_window)
plot(na(_v9_original_plot_038) ? 1 : 0, "V9_TARGET_NA", display=display.data_window)
_v9_match_0 = time == 1788134640000 and bar_index == 2
plot(_v9_match_0 ? 1 : 0, "V9_MATCH_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_038 == 0.6872892787909721 ? 1 : 0) : na, "V9_EQ_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_038 - 0.6872892787909721) * 1e11 : na, "V9_RESIDUAL_0", display=display.data_window)
_v9_match_1 = time == 1788135480000 and bar_index == 9
plot(_v9_match_1 ? 1 : 0, "V9_MATCH_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_038 == 1.0644944589178595 ? 1 : 0) : na, "V9_EQ_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_038 - 1.0644944589178595) * 1e11 : na, "V9_RESIDUAL_1", display=display.data_window)
_v9_match_2 = time == 1788136680000 and bar_index == 19
plot(_v9_match_2 ? 1 : 0, "V9_MATCH_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_038 == 0.6872892787909721 ? 1 : 0) : na, "V9_EQ_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_038 - 0.6872892787909721) * 1e11 : na, "V9_RESIDUAL_2", display=display.data_window)
_v9_match_3 = time == 1788137520000 and bar_index == 26
plot(_v9_match_3 ? 1 : 0, "V9_MATCH_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_038 == 1.0644944589178595 ? 1 : 0) : na, "V9_EQ_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_038 - 1.0644944589178595) * 1e11 : na, "V9_RESIDUAL_3", display=display.data_window)
_v9_match_4 = time == 1788138720000 and bar_index == 36
plot(_v9_match_4 ? 1 : 0, "V9_MATCH_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_038 == 0.6872892787909721 ? 1 : 0) : na, "V9_EQ_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_038 - 0.6872892787909721) * 1e11 : na, "V9_RESIDUAL_4", display=display.data_window)
plot(time, "V9_TIME_MS", display=display.data_window)
plot(bar_index, "V9_BAR_INDEX", display=display.data_window)
