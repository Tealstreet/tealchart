//@version=6
indicator("TA coverage 2 v1", overlay=false, precision=12, max_bars_back=200)
// Capture on BINANCE:BTCUSDT standard 2-minute candles; export full history 0..at least 200.
// All calls execute on every bar. No changing lengths and no HMA length 1.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_hole40_41 = hole ? na : close
s_lead0_4 = bar_index < 5 ? na : close
_v9_original_plot_000 = open
_v9_original_plot_001 = high
_v9_original_plot_002 = low
_v9_original_plot_003 = close
_v9_original_plot_004 = volume
_v9_original_plot_005 = time
_v9_original_plot_006 = bar_index
_v9_original_plot_007 = hole ? 1 : 0
[macd_line_clean, macd_signal_clean, macd_hist_clean] = ta.macd(s_clean, 12, 26, 9)
_v9_original_plot_008 = macd_line_clean
_v9_original_plot_009 = macd_signal_clean
_v9_original_plot_010 = macd_hist_clean
[macd_line_hole40_41, macd_signal_hole40_41, macd_hist_hole40_41] = ta.macd(s_hole40_41, 12, 26, 9)
_v9_original_plot_011 = macd_line_hole40_41
_v9_original_plot_012 = macd_signal_hole40_41
_v9_original_plot_013 = macd_hist_hole40_41
[macd_line_lead0_4, macd_signal_lead0_4, macd_hist_lead0_4] = ta.macd(s_lead0_4, 12, 26, 9)
_v9_original_plot_014 = macd_line_lead0_4
_v9_original_plot_015 = macd_signal_lead0_4
_v9_original_plot_016 = macd_hist_lead0_4
_v9_original_plot_017 = ta.tsi(s_clean, 5, 14)
_v9_original_plot_018 = ta.tsi(s_hole40_41, 5, 14)
_v9_original_plot_019 = ta.tsi(s_lead0_4, 5, 14)
_v9_original_plot_020 = ta.correlation(s_clean, open, 14)
_v9_original_plot_021 = ta.correlation(s_hole40_41, open, 14)
_v9_original_plot_022 = ta.correlation(s_lead0_4, open, 14)
_v9_original_plot_023 = ta.rci(s_clean, 14)
_v9_original_plot_024 = ta.rci(s_hole40_41, 14)
_v9_original_plot_025 = ta.rci(s_lead0_4, 14)
_v9_original_plot_026 = ta.mom(s_clean, 14)
_v9_original_plot_027 = ta.mom(s_hole40_41, 14)
_v9_original_plot_028 = ta.mom(s_lead0_4, 14)
_v9_original_plot_029 = ta.roc(s_clean, 14)
_v9_original_plot_030 = ta.roc(s_hole40_41, 14)
_v9_original_plot_031 = ta.roc(s_lead0_4, 14)
_v9_original_plot_032 = ta.cog(s_clean, 14)
_v9_original_plot_033 = ta.cog(s_hole40_41, 14)
_v9_original_plot_034 = ta.cog(s_lead0_4, 14)
_v9_original_plot_035 = ta.sma(s_clean, 14)
_v9_original_plot_036 = ta.sma(s_hole40_41, 14)
_v9_original_plot_037 = ta.sma(s_lead0_4, 14)
_v9_original_plot_038 = ta.ema(s_clean, 14)
_v9_original_plot_039 = ta.ema(s_hole40_41, 14)
_v9_original_plot_040 = ta.ema(s_lead0_4, 14)
_v9_original_plot_041 = ta.hma(s_clean, 14)
_v9_original_plot_042 = ta.hma(s_hole40_41, 14)
_v9_original_plot_043 = ta.hma(s_lead0_4, 14)
_v9_original_plot_044 = ta.wma(s_clean, 14)
_v9_original_plot_045 = ta.wma(s_hole40_41, 14)
_v9_original_plot_046 = ta.wma(s_lead0_4, 14)
_v9_original_plot_047 = ta.vwma(s_clean, 14)
_v9_original_plot_048 = ta.vwma(s_hole40_41, 14)
_v9_original_plot_049 = ta.vwma(s_lead0_4, 14)
_v9_original_plot_050 = ta.swma(s_clean)
_v9_original_plot_051 = ta.swma(s_hole40_41)
_v9_original_plot_052 = ta.swma(s_lead0_4)
_v9_original_plot_053 = ta.alma(s_clean, 14, 0.85, 6.0, false)
_v9_original_plot_054 = ta.alma(s_hole40_41, 14, 0.85, 6.0, false)
_v9_original_plot_055 = ta.alma(s_lead0_4, 14, 0.85, 6.0, false)
_v9_original_plot_056 = ta.linreg(s_clean, 14, 0)
_v9_original_plot_057 = ta.linreg(s_hole40_41, 14, 0)
_v9_original_plot_058 = ta.linreg(s_lead0_4, 14, 0)
_v9_original_plot_059 = macd_line_hole40_41 - macd_signal_hole40_41

plot(_v9_original_plot_000, "input_open", display=display.data_window)
plot(_v9_original_plot_001, "input_high", display=display.data_window)
plot(_v9_original_plot_002, "input_low", display=display.data_window)
plot(_v9_original_plot_003, "input_close", display=display.data_window)
plot(_v9_original_plot_004, "input_volume", display=display.data_window)
plot(_v9_original_plot_005, "input_time", display=display.data_window)
plot(_v9_original_plot_006, "input_bar_index", display=display.data_window)
plot(_v9_original_plot_007, "input_hole_bar40_41", display=display.data_window)
plot(_v9_original_plot_058, "linreg_len14_lead0_4", display=display.data_window)
plot(na(_v9_original_plot_058) ? 1 : 0, "V9_TARGET_NA", display=display.data_window)
_v9_match_0 = time == 1788136560000 and bar_index == 18
plot(_v9_match_0 ? 1 : 0, "V9_MATCH_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_058 == 78059.39885714289 ? 1 : 0) : na, "V9_EQ_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_058 - 78059.39885714289) * 1e11 : na, "V9_RESIDUAL_0", display=display.data_window)
_v9_match_1 = time == 1788136680000 and bar_index == 19
plot(_v9_match_1 ? 1 : 0, "V9_MATCH_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_058 == 78051.24342857141 ? 1 : 0) : na, "V9_EQ_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_058 - 78051.24342857141) * 1e11 : na, "V9_RESIDUAL_1", display=display.data_window)
_v9_match_2 = time == 1788136800000 and bar_index == 20
plot(_v9_match_2 ? 1 : 0, "V9_MATCH_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_058 == 78055.34942857143 ? 1 : 0) : na, "V9_EQ_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_058 - 78055.34942857143) * 1e11 : na, "V9_RESIDUAL_2", display=display.data_window)
_v9_match_3 = time == 1788136920000 and bar_index == 21
plot(_v9_match_3 ? 1 : 0, "V9_MATCH_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_058 == 78058.16771428572 ? 1 : 0) : na, "V9_EQ_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_058 - 78058.16771428572) * 1e11 : na, "V9_RESIDUAL_3", display=display.data_window)
_v9_match_4 = time == 1788137040000 and bar_index == 22
plot(_v9_match_4 ? 1 : 0, "V9_MATCH_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_058 == 78051.2765714285 ? 1 : 0) : na, "V9_EQ_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_058 - 78051.2765714285) * 1e11 : na, "V9_RESIDUAL_4", display=display.data_window)
plot(time, "V9_TIME_MS", display=display.data_window)
plot(bar_index, "V9_BAR_INDEX", display=display.data_window)
