_v9_original_plot_006 = clean
_v9_original_plot_007 = holes
_v9_original_plot_008 = ta.sma(clean, 1)
_v9_original_plot_009 = ta.sma(clean, 2)
_v9_original_plot_010 = ta.sma(clean, 5)
_v9_original_plot_011 = ta.ema(clean, 1)
_v9_original_plot_012 = ta.ema(clean, 2)
_v9_original_plot_013 = ta.ema(clean, 5)
_v9_original_plot_014 = ta.rma(clean, 1)
_v9_original_plot_015 = ta.rma(clean, 2)
_v9_original_plot_016 = ta.rma(clean, 5)
_v9_original_plot_017 = ta.wma(clean, 1)
_v9_original_plot_018 = ta.wma(clean, 2)
_v9_original_plot_019 = ta.wma(clean, 5)
_v9_original_plot_020 = ta.vwma(clean, 1)
_v9_original_plot_021 = ta.vwma(clean, 2)
_v9_original_plot_022 = ta.vwma(clean, 5)
_v9_original_plot_023 = ta.alma(clean, 1, 0.85, 6, false)
_v9_original_plot_024 = ta.alma(clean, 2, 0.85, 6, false)
_v9_original_plot_025 = ta.alma(clean, 5, 0.85, 6, false)
_v9_original_plot_026 = ta.hma(clean, 2)
_v9_original_plot_027 = ta.hma(clean, 5)
_v9_original_plot_028 = ta.linreg(clean, 1, 0)
_v9_original_plot_029 = ta.linreg(clean, 2, 0)
_v9_original_plot_030 = ta.linreg(clean, 5, 0)
_v9_original_plot_031 = ta.swma(clean)
_v9_original_plot_032 = ta.sma(holes, 2)
_v9_original_plot_033 = ta.sma(holes, 5)
_v9_original_plot_034 = ta.ema(holes, 2)
_v9_original_plot_035 = ta.ema(holes, 5)
_v9_original_plot_036 = ta.rma(holes, 2)
_v9_original_plot_037 = ta.rma(holes, 5)
_v9_original_plot_038 = ta.wma(holes, 2)
_v9_original_plot_039 = ta.wma(holes, 5)
_v9_original_plot_040 = ta.vwma(holes, 2)
_v9_original_plot_041 = ta.vwma(holes, 5)
_v9_original_plot_042 = ta.alma(holes, 2, 0.85, 6, false)
_v9_original_plot_043 = ta.alma(holes, 5, 0.85, 6, false)
_v9_original_plot_044 = ta.hma(holes, 2)
_v9_original_plot_045 = ta.hma(holes, 5)
_v9_original_plot_046 = ta.linreg(holes, 2, 0)
_v9_original_plot_047 = ta.linreg(holes, 5, 0)
_v9_original_plot_048 = ta.swma(holes)
_v9_original_plot_049 = f_valid_mean(holes, 5, false)
_v9_original_plot_050 = f_ema_skip(holes, 5)
_v9_original_plot_051 = f_rma_skip(holes, 5)
_v9_original_plot_052 = f_valid_mean(holes, 5, true)
_v9_original_plot_053 = f_valid_mean(holes * volume, 5, false) / f_valid_mean(volume, 5, false)
_v9_original_plot_054 = (holes + 2.0 * holes[1] + 2.0 * holes[2] + holes[3]) / 6.0
_v9_original_plot_055 = f_alma_window(holes, 5, false)
_v9_original_plot_056 = ta.wma(2.0 * ta.wma(holes, 2) - ta.wma(holes, 5), 2)
_v9_original_plot_057 = f_linreg_window(holes, 5)
_v9_original_plot_058 = ta.alma(clean, 5, 0.85, 6, true)

plot(_v9_original_plot_000, "input_open", display=display.data_window)
plot(_v9_original_plot_001, "input_high", display=display.data_window)
plot(_v9_original_plot_002, "input_low", display=display.data_window)
