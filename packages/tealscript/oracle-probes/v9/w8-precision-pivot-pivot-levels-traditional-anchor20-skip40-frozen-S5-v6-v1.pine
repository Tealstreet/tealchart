_v9_original_plot_051 = array.size(p_skip) > 7 ? array.get(p_skip, 7) : na
_v9_original_plot_052 = array.size(p_skip) > 8 ? array.get(p_skip, 8) : na
_v9_original_plot_053 = array.size(p_skip) > 9 ? array.get(p_skip, 9) : na
_v9_original_plot_054 = array.size(p_skip) > 10 ? array.get(p_skip, 10) : na
_v9_original_plot_055 = array.size(p_skip)
_v9_original_plot_056 = a_regular ? 1 : 0
_v9_original_plot_057 = a_delayed40 ? 1 : 0
_v9_original_plot_058 = a_skip_hole ? 1 : 0
_v9_original_plot_059 = a_never ? 1 : 0

plot(_v9_original_plot_000, "input_open", display=display.data_window)
plot(_v9_original_plot_001, "input_high", display=display.data_window)
plot(_v9_original_plot_002, "input_low", display=display.data_window)
plot(_v9_original_plot_003, "input_close", display=display.data_window)
plot(_v9_original_plot_004, "input_volume", display=display.data_window)
plot(_v9_original_plot_005, "input_time", display=display.data_window)
plot(_v9_original_plot_006, "input_bar_index", display=display.data_window)
plot(_v9_original_plot_007, "input_hole_bar40_41", display=display.data_window)
plot(_v9_original_plot_056, "input_a_regular", display=display.data_window)
plot(_v9_original_plot_057, "input_a_delayed40", display=display.data_window)
plot(_v9_original_plot_058, "input_a_skip_hole", display=display.data_window)
plot(_v9_original_plot_059, "input_a_never", display=display.data_window)
plot(_v9_original_plot_054, "pivot_levels_traditional_anchor20_skip40_frozen_S5", display=display.data_window)
plot(na(_v9_original_plot_054) ? 1 : 0, "V9_TARGET_NA", display=display.data_window)
_v9_match_0 = time == 1788141600000 and bar_index == 60
plot(_v9_match_0 ? 1 : 0, "V9_MATCH_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_054 == 76319.77333333336 ? 1 : 0) : na, "V9_EQ_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_054 - 76319.77333333336) * 1e11 : na, "V9_RESIDUAL_0", display=display.data_window)
_v9_match_1 = time == 1788141720000 and bar_index == 61
plot(_v9_match_1 ? 1 : 0, "V9_MATCH_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_054 == 76319.77333333336 ? 1 : 0) : na, "V9_EQ_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_054 - 76319.77333333336) * 1e11 : na, "V9_RESIDUAL_1", display=display.data_window)
_v9_match_2 = time == 1788141840000 and bar_index == 62
plot(_v9_match_2 ? 1 : 0, "V9_MATCH_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_054 == 76319.77333333336 ? 1 : 0) : na, "V9_EQ_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_054 - 76319.77333333336) * 1e11 : na, "V9_RESIDUAL_2", display=display.data_window)
_v9_match_3 = time == 1788141960000 and bar_index == 63
plot(_v9_match_3 ? 1 : 0, "V9_MATCH_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_054 == 76319.77333333336 ? 1 : 0) : na, "V9_EQ_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_054 - 76319.77333333336) * 1e11 : na, "V9_RESIDUAL_3", display=display.data_window)
_v9_match_4 = time == 1788142080000 and bar_index == 64
plot(_v9_match_4 ? 1 : 0, "V9_MATCH_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_054 == 76319.77333333336 ? 1 : 0) : na, "V9_EQ_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_054 - 76319.77333333336) * 1e11 : na, "V9_RESIDUAL_4", display=display.data_window)
plot(time, "V9_TIME_MS", display=display.data_window)
plot(bar_index, "V9_BAR_INDEX", display=display.data_window)
