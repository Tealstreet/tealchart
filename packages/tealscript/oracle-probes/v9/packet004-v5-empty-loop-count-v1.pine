//@version=5
indicator("Packet004 empty loop count v1")
values = array.new_float()
int visits = 0
int firstIndex = na
int lastIndex = na
for i = 0 to array.size(values) - 1
    visits += 1
    firstIndex := na(firstIndex) ? i : firstIndex
    lastIndex := i
plot(visits, "loop_visits")
plot(firstIndex, "first_index")
plot(lastIndex, "last_index")
