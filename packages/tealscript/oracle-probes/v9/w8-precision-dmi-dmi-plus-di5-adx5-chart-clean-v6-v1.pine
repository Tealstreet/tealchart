//@version=6
indicator("TA coverage 3 v1", overlay=false, precision=12, max_bars_back=200)
// Capture on BINANCE:BTCUSDT standard 2-minute candles; export full history 0..at least 200.
// All calls execute on every bar. No changing lengths and no HMA length 1.
hole = bar_index == 40 or bar_index == 41
s_clean = close
s_hole40_41 = hole ? na : close
s_lead0_4 = bar_index < 5 ? na : close
_v9_original_plot_000 = open
_v9_original_plot_001 = high
_v9_original_plot_002 = low
_v9_original_plot_003 = close
_v9_original_plot_004 = volume
_v9_original_plot_005 = time
_v9_original_plot_006 = bar_index
_v9_original_plot_007 = hole ? 1 : 0
// DMI/Supertrend/SAR and TA variables read implicit chart OHLC: cannot inject caller OHLC holes.
// Parameter variants expose natural startup. Explicit-input controls below probe formula holes only.
[dmi_plus_5, dmi_minus_5, dmi_adx_5] = ta.dmi(5, 5)
_v9_original_plot_008 = dmi_plus_5
_v9_original_plot_009 = dmi_minus_5
_v9_original_plot_010 = dmi_adx_5
[dmi_plus_14, dmi_minus_14, dmi_adx_14] = ta.dmi(14, 14)
_v9_original_plot_011 = dmi_plus_14
_v9_original_plot_012 = dmi_minus_14
_v9_original_plot_013 = dmi_adx_14
[dmi_plus_28, dmi_minus_28, dmi_adx_28] = ta.dmi(28, 28)
_v9_original_plot_014 = dmi_plus_28
_v9_original_plot_015 = dmi_minus_28
_v9_original_plot_016 = dmi_adx_28
[st_5, direction_5] = ta.supertrend(3.0, 5)
_v9_original_plot_017 = st_5
_v9_original_plot_018 = direction_5
[st_14, direction_14] = ta.supertrend(3.0, 14)
_v9_original_plot_019 = st_14
_v9_original_plot_020 = direction_14
[st_28, direction_28] = ta.supertrend(3.0, 28)
_v9_original_plot_021 = st_28
_v9_original_plot_022 = direction_28
_v9_original_plot_023 = ta.sar(0.02, 0.02, 0.2)
_v9_original_plot_024 = ta.sar(0.01, 0.01, 0.1)
_v9_original_plot_025 = ta.sar(0.05, 0.05, 0.5)
_v9_original_plot_026 = ta.iii
_v9_original_plot_027 = ta.wvad
_v9_original_plot_028 = ta.wad
vh_clean = false ? na : high
vl_clean = false ? na : low
vo_clean = false ? na : open
vc_clean = false ? na : close
vv_clean = false ? na : volume
_v9_original_plot_029 = (2.0 * vc_clean - vh_clean - vl_clean) / (vh_clean - vl_clean) * vv_clean
_v9_original_plot_030 = (vc_clean - vo_clean) / (vh_clean - vl_clean) * vv_clean
wad_mom_clean = ta.change(vc_clean)
wad_gain_clean = wad_mom_clean > 0 ? vc_clean - math.min(vl_clean, vc_clean[1]) : (wad_mom_clean < 0 ? vc_clean - math.max(vh_clean, vc_clean[1]) : 0.0)
_v9_original_plot_031 = ta.cum(wad_gain_clean)
vh_hole40_41 = hole ? na : high
vl_hole40_41 = hole ? na : low
vo_hole40_41 = hole ? na : open
vc_hole40_41 = hole ? na : close
vv_hole40_41 = hole ? na : volume
_v9_original_plot_032 = (2.0 * vc_hole40_41 - vh_hole40_41 - vl_hole40_41) / (vh_hole40_41 - vl_hole40_41) * vv_hole40_41
_v9_original_plot_033 = (vc_hole40_41 - vo_hole40_41) / (vh_hole40_41 - vl_hole40_41) * vv_hole40_41
wad_mom_hole40_41 = ta.change(vc_hole40_41)
wad_gain_hole40_41 = wad_mom_hole40_41 > 0 ? vc_hole40_41 - math.min(vl_hole40_41, vc_hole40_41[1]) : (wad_mom_hole40_41 < 0 ? vc_hole40_41 - math.max(vh_hole40_41, vc_hole40_41[1]) : 0.0)
_v9_original_plot_034 = ta.cum(wad_gain_hole40_41)
vh_lead0_4 = bar_index < 5 ? na : high
vl_lead0_4 = bar_index < 5 ? na : low
vo_lead0_4 = bar_index < 5 ? na : open
vc_lead0_4 = bar_index < 5 ? na : close
vv_lead0_4 = bar_index < 5 ? na : volume
_v9_original_plot_035 = (2.0 * vc_lead0_4 - vh_lead0_4 - vl_lead0_4) / (vh_lead0_4 - vl_lead0_4) * vv_lead0_4
_v9_original_plot_036 = (vc_lead0_4 - vo_lead0_4) / (vh_lead0_4 - vl_lead0_4) * vv_lead0_4
wad_mom_lead0_4 = ta.change(vc_lead0_4)
wad_gain_lead0_4 = wad_mom_lead0_4 > 0 ? vc_lead0_4 - math.min(vl_lead0_4, vc_lead0_4[1]) : (wad_mom_lead0_4 < 0 ? vc_lead0_4 - math.max(vh_lead0_4, vc_lead0_4[1]) : 0.0)
_v9_original_plot_037 = ta.cum(wad_gain_lead0_4)
_v9_original_plot_038 = ta.tr
_v9_original_plot_039 = ta.tr(true)
_v9_original_plot_040 = ta.tr(false)
_v9_original_plot_041 = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
_v9_original_plot_042 = hole ? na : ta.tr(true)
f_dmi_explicit(h, l, c) =>
    up = ta.change(h)
    down = -ta.change(l)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0.0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0.0)
    trValue = na(c[1]) ? h - l : math.max(h - l, math.max(math.abs(h - c[1]), math.abs(l - c[1])))
    trSmooth = ta.rma(trValue, 14)
    plus = 100.0 * ta.rma(plusDM, 14) / trSmooth
    minus = 100.0 * ta.rma(minusDM, 14) / trSmooth
    diSum = plus + minus
    adx = 100.0 * ta.rma(math.abs(plus - minus) / (diSum == 0 ? 1.0 : diSum), 14)
    [plus, minus, adx]
[manual_dmi_plus_clean, manual_dmi_minus_clean, manual_dmi_adx_clean] = f_dmi_explicit(vh_clean, vl_clean, vc_clean)
_v9_original_plot_043 = manual_dmi_plus_clean
_v9_original_plot_044 = manual_dmi_minus_clean
_v9_original_plot_045 = manual_dmi_adx_clean
[manual_dmi_plus_hole40_41, manual_dmi_minus_hole40_41, manual_dmi_adx_hole40_41] = f_dmi_explicit(vh_hole40_41, vl_hole40_41, vc_hole40_41)
_v9_original_plot_046 = manual_dmi_plus_hole40_41
_v9_original_plot_047 = manual_dmi_minus_hole40_41
_v9_original_plot_048 = manual_dmi_adx_hole40_41
[manual_dmi_plus_lead0_4, manual_dmi_minus_lead0_4, manual_dmi_adx_lead0_4] = f_dmi_explicit(vh_lead0_4, vl_lead0_4, vc_lead0_4)
_v9_original_plot_049 = manual_dmi_plus_lead0_4
_v9_original_plot_050 = manual_dmi_minus_lead0_4
_v9_original_plot_051 = manual_dmi_adx_lead0_4
_v9_original_plot_052 = ta.rma(false ? na : ta.tr(true), 14)
_v9_original_plot_053 = ta.rma(hole ? na : ta.tr(true), 14)
_v9_original_plot_054 = ta.rma(bar_index < 5 ? na : ta.tr(true), 14)
_v9_original_plot_055 = ta.sar(0.03, 0.03, 0.2)
_v9_original_plot_056 = ta.sar(0.04, 0.04, 0.2)
_v9_original_plot_057 = dmi_plus_5 + dmi_minus_5
_v9_original_plot_058 = dmi_plus_14 + dmi_minus_14
_v9_original_plot_059 = dmi_plus_28 + dmi_minus_28

plot(_v9_original_plot_000, "input_open", display=display.data_window)
plot(_v9_original_plot_001, "input_high", display=display.data_window)
plot(_v9_original_plot_002, "input_low", display=display.data_window)
plot(_v9_original_plot_003, "input_close", display=display.data_window)
plot(_v9_original_plot_004, "input_volume", display=display.data_window)
plot(_v9_original_plot_005, "input_time", display=display.data_window)
plot(_v9_original_plot_006, "input_bar_index", display=display.data_window)
plot(_v9_original_plot_007, "input_hole_bar40_41", display=display.data_window)
plot(_v9_original_plot_008, "dmi_plus_di5_adx5_chart_clean", display=display.data_window)
plot(na(_v9_original_plot_008) ? 1 : 0, "V9_TARGET_NA", display=display.data_window)
_v9_match_0 = time == 1788135360000 and bar_index == 8
plot(_v9_match_0 ? 1 : 0, "V9_MATCH_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_008 == 51.19805033829438 ? 1 : 0) : na, "V9_EQ_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_008 - 51.19805033829438) * 1e11 : na, "V9_RESIDUAL_0", display=display.data_window)
_v9_match_1 = time == 1788135600000 and bar_index == 10
plot(_v9_match_1 ? 1 : 0, "V9_MATCH_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_008 == 54.57112607742624 ? 1 : 0) : na, "V9_EQ_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_008 - 54.57112607742624) * 1e11 : na, "V9_RESIDUAL_1", display=display.data_window)
_v9_match_2 = time == 1788136440000 and bar_index == 17
plot(_v9_match_2 ? 1 : 0, "V9_MATCH_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_008 == 62.95494819349564 ? 1 : 0) : na, "V9_EQ_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_008 - 62.95494819349564) * 1e11 : na, "V9_RESIDUAL_2", display=display.data_window)
_v9_match_3 = time == 1788136560000 and bar_index == 18
plot(_v9_match_3 ? 1 : 0, "V9_MATCH_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_008 == 50.912382031277915 ? 1 : 0) : na, "V9_EQ_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_008 - 50.912382031277915) * 1e11 : na, "V9_RESIDUAL_3", display=display.data_window)
_v9_match_4 = time == 1788137760000 and bar_index == 28
plot(_v9_match_4 ? 1 : 0, "V9_MATCH_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_008 == 26.355984842429464 ? 1 : 0) : na, "V9_EQ_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_008 - 26.355984842429464) * 1e11 : na, "V9_RESIDUAL_4", display=display.data_window)
plot(time, "V9_TIME_MS", display=display.data_window)
plot(bar_index, "V9_BAR_INDEX", display=display.data_window)
