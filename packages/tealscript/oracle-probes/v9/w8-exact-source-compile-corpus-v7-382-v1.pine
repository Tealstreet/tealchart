//@version=6
// The plotted series is a MULTIPLE (2.34x), not a share count, so the pane
// axis is a plain 2-decimal number. format.volume would abbreviate it into
// K/M/B suffixes that make no sense on a ratio.
indicator("Volume Radar · D_RVol", shorttitle="D_RVol", overlay=false, precision=2)

// ════════════════════════════════════════════════════════════════════════
// VOLUME RADAR — D_RVol
// ════════════════════════════════════════════════════════════════════════
// D_RVol = today's cumulative DAILY volume ÷ the average of the preceding N
// full daily sessions. Lifted from key-valuation-ratios-table.pine, where it
// was one row in a fundamentals table, and given the room it needs: a plot,
// a baseline, its own bands and a status card.
//
// ── WHY IT IS ALWAYS DAILY ──────────────────────────────────────────────
// Every figure is pulled through request.security(..., "D", ...) rather than
// read off the chart's own bars, so D_RVol means the same thing on a 5-minute
// chart as on a weekly one: how busy is TODAY against a normal recent day.
// A raw relative-volume calculation on chart bars answers a different
// question at every timeframe you switch to, which makes the number
// impossible to build a habit around.
//
// Intraday, this is honestly a PARTIAL day against FULL days: at 10:00 the
// session is an hour old and D_RVol reads low by construction. The card says
// so rather than letting you read a quiet morning as a quiet day.
//
// ── WHAT THE BASELINE EXCLUDES ──────────────────────────────────────────
// The average is shifted by [1] so today is not part of its own baseline.
// Without that shift a genuine spike dilutes the average it is being measured
// against, and the biggest days quietly under-report.
//
// ── D_RVol IS DIRECTION-AGNOSTIC ────────────────────────────────────────
// D_RVol itself says nothing about buying or selling. Every trade has both
// sides, and Pine has no access to which of them crossed the spread. High
// D_RVol means DISAGREEMENT AND URGENCY — an unusual number of shares
// changing hands — and nothing more.
//
// ── PRESSURE: WHAT THE COLOURED MARKER ACTUALLY MEASURES ────────────────
// The direction estimate is a separate calculation, and it is an ESTIMATE.
// True buy/sell classification needs the aggressor side of each print, which
// no Pine script can see. What this does instead, in order of preference:
//
//   1. INTRABAR SPLIT — the session is broken into intrabars via
//      request.security_lower_tf() and each one's volume is filed as up
//      (close > open) or down (close < open). Pressure = up ÷ (up + down).
//      This is the same method as TradingView's own Up/Down Volume, and it
//      is a genuine measurement of WHERE the volume happened — just not of
//      who initiated it.
//
//   2. CLOSE LOCATION — when intrabar history isn't available (older bars,
//      or plan limits on intrabar depth) it falls back to where the day
//      closed inside its own range: (close − low) ÷ (high − low). Crude, but
//      it is the classic Accumulation/Distribution proxy and it degrades
//      gracefully instead of going blank.
//
// The card always states which of the two produced the number, because a
// 5-minute split and a single-bar proxy do not deserve equal trust.
// ════════════════════════════════════════════════════════════════════════


// ┌──────────────────────────────────────────────────────────────────────┐
// │  INPUTS                                                              │
// └──────────────────────────────────────────────────────────────────────┘
G_RVOL  = "① D_RVol"
G_PRESS = "② Pressure (Up / Down Split)"
G_WEEK  = "③ Week"
G_TBL   = "④ Card"
G_PLOT  = "⑤ Plot"
G_ALERT = "⑥ Alerts"

rvol_len       = input.int(20, "Baseline Length (Daily Sessions)", minval=1, group=G_RVOL, tooltip="Number of preceding full daily sessions averaged into the baseline. Today is excluded from its own average.\n\n20 is roughly a trading month — long enough to smooth single events, short enough to follow a change in a stock's normal activity.", display = display.none)
rvol_threshold = input.float(2.0, "ANOMALIE Threshold (x)", minval=0.5, step=0.1, group=G_RVOL, tooltip="D_RVol at or above this multiple is ANOMALIE: it fires the alert, the chart marker and the top band. 2.0 = twice a normal day.", display = display.none)
rvolActifMult  = input.float(0.6, "ACTIF Level (× threshold)",  minval=0.1, maxval=1.0, step=0.05, group=G_RVOL, tooltip="Fraction of the ANOMALIE threshold above which volume reads as ACTIF. Expressed as a fraction rather than an absolute so that moving the ANOMALIE threshold moves the whole ladder with it and the bands can never cross.", display = display.none)
rvolNormalMult = input.float(0.4, "NORMAL Level (× threshold)", minval=0.05, maxval=1.0, step=0.05, group=G_RVOL, tooltip="Fraction of the ANOMALIE threshold above which volume reads as NORMAL rather than SOMMEIL.", display = display.none)
activeLen      = input.int(20, "Activity Window (Daily Sessions)", minval=2, maxval=100, group=G_RVOL, tooltip="How many recent sessions the ACTIVE counter looks back over. It counts the days that closed at or above the ACTIF level — one loud day is an event, seven out of twenty is a campaign.", display = display.none)

showPressure  = input.bool(true, "Estimate Buy / Sell Pressure", group=G_PRESS, tooltip="Adds a Pressure row to the card and colours the ANOMALIE marker by direction.\n\nRead the header note in this file before trusting it: this is an ESTIMATE built from where volume traded, not from who initiated the trades. Pine has no access to the aggressor side of a print — no script does.", display = display.none)
splitLtf      = input.timeframe("5", "Intrabar Resolution", options=["1","3","5","10","15","30","60"], group=G_PRESS, tooltip="The session is cut into bars of this size and each one's volume is filed as up or down by its own close-vs-open.\n\nFiner is more faithful but burns intrabar quota fast: on a daily chart, 5-minute bars mean ~78 intrabars per day, 1-minute means ~390, and your TradingView plan caps how many can be pulled in total. If the Pressure row starts reading 'bar' instead of the resolution you picked, the quota ran out and it fell back.", display = display.none)
pressureBand  = input.float(5.0, "Neutral Zone (± %)", minval=0, maxval=25, step=1, group=G_PRESS, tooltip="How far from an even 50/50 split the estimate must be before it commits to a direction. Inside this band the marker is amber and the label reads Balanced.\n\nWithout a neutral zone the colour flips between green and red on noise every time the split crosses 50.00%, which makes it look precise and behave randomly.", display = display.none)
markerByPressure = input.bool(true, "Colour Marker by Pressure", group=G_PRESS, tooltip="ON: the ANOMALIE triangle is green when the split leans buy-side, red when it leans sell-side, amber when it is inside the neutral zone.\n\nOFF: the triangle is always the ANOMALIE colour, and marks size only — which is the one thing volume can state without estimating anything.", display = display.none)

showWeek     = input.bool(true, "Show Week Block", group=G_WEEK, tooltip="Adds a two-column block comparing THIS week against LAST week, on the same relative-volume and pressure logic as the daily rows above.\n\nA week filters what a day cannot: one loud session is an earnings print or an index rebalance, but a loud WEEK is participation that persisted through several sessions and at least one weekend of reflection.", display = display.none)
wLen         = input.int(13, "Weekly Baseline (Weeks)", minval=2, maxval=52, group=G_WEEK, tooltip="How many completed weeks the weekly baseline averages. The week being measured is always excluded from its own baseline, exactly as today is excluded from the daily one.\n\n13 is roughly a quarter — long enough to cover a full reporting cycle, short enough to follow a change in the stock's normal activity.", display = display.none)
weeksShown   = input.int(3, "Weeks Shown", minval=2, maxval=6, group=G_WEEK, tooltip="How many weekly columns the block draws: 2 is this week and last, 3 adds the week before that, up to 6.\n\nTwo columns tell you whether something changed. Three or more tell you whether it is a TREND — one loud week between two quiet ones is an event, three climbing weeks is accumulation. That is the whole reason to go past LAST.\n\nColumns you don't use collapse to zero width, so the card only grows when you ask it to.", display = display.none)
showWeekChange   = input.bool(true, "Show Weekly Change", group=G_WEEK, tooltip="The RESULT half of the block: how much price actually moved that week, close to close.\n\nRead it against W_RVol directly above it — that is the whole point of putting them in the same columns:\n• volume up + price up = demand, the move has fuel\n• volume up + price flat or down = distribution or absorption, the one worth stopping on\n• volume down + price up = a rally nobody is participating in\n• volume down + price flat = nothing is happening\n\nClose-to-close on purpose, so the gap between weeks is included.", display = display.none)
changeFlat       = input.float(0.5, "Flat Zone (± %)", minval=0, maxval=10, step=0.1, group=G_WEEK, tooltip="A week inside this band is painted amber rather than green or red. A week that closed +0.1% is flat, and colouring it green asserts a direction the number does not support.", display = display.none)
readStyle        = input.string("Icon only", "Read Row", options=["Icon only","Icon + Label","Off"], group=G_WEEK, tooltip="Classifies each week from its volume AND its price together, so the effort-vs-result call is made for you instead of read off the two rows above:\n\n🔥 Demand — loud week, price up. The move has fuel.\n⚖️ Absorption — loud week, price flat. Someone is taking the other side of everything. The one to stop on.\n🔻 Supply — loud week, price down. Sellers won it.\n🎈 No Demand — quiet week, price up. A rally nobody participated in.\n💤 Dormant — quiet week, price flat. Nothing is happening.\n🍃 No Supply — quiet week, price down. Nobody bothered to sell into it, which is constructive.\n\nIcon only (default) keeps the week columns as narrow as the numbers and puts the current week's word in the row label instead. Icon + Label spells every column out, at the cost of a wider card.\n\nThe COLOUR encodes effort alone — hot means the week had participation and is worth reading, cool means it did not. So the glance before you read any word already tells you whether the week matters.", display = display.none)
showWeekPressure = input.bool(false, "Show Weekly Pressure (clv)", group=G_WEEK, tooltip="OFF by default, and deliberately.\n\nThe weekly close-location estimate has three problems at a multi-week horizon. It is GAP-BLIND — it only sees where each day closed inside its own range, so a stock that gaps down 6% and closes near its highs scores as buying. It has LOW PERSISTENCE — it alternates week to week, and anything that flips faster than your holding period is noise at that horizon. And it is largely REDUNDANT with the candle you can already see.\n\nWhere it does earn its place is persistence and divergence: four consecutive buy-side weeks while price makes lower lows is absorption. That needs several columns stacked, not one reading — so turn it on, set Weeks Shown to 4 or more, and read the row, never the cell.\n\nThe DAILY Pressure row is a different thing and stays on: it is built from intrabars rather than close location, and it answers a timing question about today rather than describing a multi-week state.", display = display.none)
wThreshold   = input.float(1.6, "Weekly ANOMALIE Threshold (x)", minval=0.5, step=0.1, group=G_WEEK, tooltip="Deliberately LOWER than the daily 2.0x, and it should be. Aggregating five sessions averages out their individual noise, so weekly relative volume clusters much closer to 1.0 than daily does — a 2.0x week is far rarer than a 2.0x day. Reusing the daily threshold here would make the top band almost unreachable.\n\nThe ACTIF and NORMAL fractions from group ② are reused, so the ladder keeps the same shape at a different scale.", display = display.none)
wDaysPerWeek = input.int(5, "Trading Days per Week", minval=1, maxval=7, group=G_WEEK, tooltip="Used to judge how far through the week you are. 5 for equities, 7 for crypto and anything else that never closes.", display = display.none)
weekProRate  = input.bool(true, "Pro-rate the Partial Week", group=G_WEEK, tooltip="ON (default): this week's figure is scaled to a full-week pace — two days into five, volume is multiplied by 5/2 — and marked with ≈. It answers \"is this week shaping up loud\", which is the question you actually asked.\n\nOFF: the raw partial total. Honest, but structurally low on a Monday and not comparable to the completed weeks behind it.\n\nEither way the block header shows how many sessions are in, because a run-rate extrapolated from one day is a very different claim from one extrapolated from four. Pressure is never pro-rated — it is already a ratio, so elapsed time cancels out of it.", display = display.none)

showTable   = input.bool(true, "Show Card", group=G_TBL, display = display.none)
tblPosIn    = input.string("Top Right", "Card Position", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=G_TBL, display = display.none)
txtSize     = input.string("normal", "Text Size", options=["auto","tiny","small","normal","large","huge"], group=G_TBL, display = display.none)
themeIn     = input.string("Dark Blue", "Theme", options=["Dark Blue","Auto (chart)","Midnight","Light"], group=G_TBL, tooltip="Dark Blue (default): a fixed navy card, identical on any chart and in any TradingView theme. Auto derives every colour from the chart's own background and text colour instead, so the card follows your theme.", display = display.none)
contrast    = input.float(1.4, "Contrast", minval=0.5, maxval=2.5, step=0.1, group=G_TBL, tooltip="How far every surface is pushed away from the chart background. Applies to the Auto theme only; the fixed palettes carry their own contrast.", display = display.none)
showHelp    = input.bool(true, "Show ⓘ Method Badge", group=G_TBL, tooltip="A ⓘ in the card's top-right corner. Hovering it explains the whole calculation, built from your current settings. Pine cannot make a clickable button — hover is the only interaction a table cell has.", display = display.none)
tableTransp = input.int(0, "Card Transparency", minval=0, maxval=100, group=G_TBL, display = display.none)

plotStyle   = input.string("Columns", "Plot Style", options=["Columns","Area","Line","None"], group=G_PLOT, display = display.none)
showLevels  = input.bool(true, "Show Band Lines", group=G_PLOT, tooltip="Dashed guides at the ANOMALIE, ACTIF and NORMAL levels, plus a solid 1.0x line — an average day. Reading the plot without the 1.0x reference is guesswork.", display = display.none)
showMarker  = input.bool(true, "Mark ANOMALIE on Price Chart", group=G_PLOT, tooltip="Puts a triangle under the price bar on the main chart when the threshold is crossed, so a spike is visible without this pane open.", display = display.none)

alertOnlyHighTF = input.bool(true, "Alerts Only on Daily/Weekly Charts", group=G_ALERT, tooltip="When on, the alert and the chart marker only fire on Daily/Weekly charts, so glancing at a 5-minute view doesn't re-trigger a day you have already seen. When off, they fire on whatever timeframe you are viewing.", display = display.none)

// Derived levels — every label, colour, line and tooltip reads from these, so
// "ANOMALIE" always means exactly what fires the alert.
rvolActifLvl  = rvol_threshold * rvolActifMult
rvolNormalLvl = rvol_threshold * rvolNormalMult


// ┌──────────────────────────────────────────────────────────────────────┐
// │  THEME — same palette as fundamentals-scorecard.pine                 │
// └──────────────────────────────────────────────────────────────────────┘
solid(color c) => color.new(c, tableTransp)
ink(color c)   => color.new(c, 0)
mix(color base, color over, float w) => color.from_gradient(w, 0, 1, base, over)

isAuto  = themeIn == "Auto (chart)"
isLight = themeIn == "Light"
isMid   = themeIn == "Midnight"

chartBg = chart.bg_color
chartFg = chart.fg_color

tint(float w) => mix(chartBg, chartFg, math.min(w * contrast, 0.92))

COL_OUTER_BG  = solid(isAuto ? tint(0.02) : isLight ? color.new(#d7dbe6, 0) : isMid ? color.new(#04040c, 0) : color.new(#0a1526, 0))
COL_ROW_EVEN  = solid(isAuto ? tint(0.08) : isLight ? color.new(#ffffff, 0) : isMid ? color.new(#0e1428, 0) : color.new(#142033, 0))
COL_ROW_ODD   = solid(isAuto ? tint(0.15) : isLight ? color.new(#eef1f7, 0) : isMid ? color.new(#131a33, 0) : color.new(#1c2c47, 0))
COL_BORDER_IN = solid(isAuto ? tint(0.18) : isLight ? color.new(#c8cede, 0) : isMid ? color.new(#2a2a4a, 0) : color.new(#1f3350, 0))
COL_DIVIDER   = solid(isAuto ? tint(0.30) : isLight ? color.new(#b9c0d2, 0) : isMid ? color.new(#22305a, 0) : color.new(#33507d, 0))
accentCol     = solid(isAuto ? tint(0.34) : color.new(#2b4a80, 0))
frameCol      = solid(isAuto ? tint(0.52) : color.new(#7396cc, 0))

COL_TXT        = ink(isAuto ? chartFg : isLight ? color.new(#12182b, 0) : color.new(#eaf0fa, 0))
COL_TXT_DIM    = ink(isAuto ? mix(chartBg, chartFg, 0.66) : isLight ? color.new(#5a6072, 0) : color.new(#93a6c4, 0))
COL_TXT_ON_BG  = ink(color.new(#ffffff, 0))
COL_TXT_HEADER = isAuto ? COL_TXT : COL_TXT_ON_BG

// The band palette. Deliberately NOT the scorecard's red→green ramp: there,
// red means bad. Here nothing is bad — a quiet stock is not a failing one —
// so the ladder runs cool (asleep) to hot (unusual) and says only "how much
// is happening", never "is that good".
COL_SLEEP  = solid(color.new(#3f5573, 0))   // SOMMEIL — slate
COL_NORMAL = solid(color.new(#2f6f8f, 0))   // NORMAL  — cool blue
COL_ACTIF  = solid(color.new(#b8860b, 0))   // ACTIF   — amber
COL_ANOM   = solid(color.new(#c0392b, 0))   // ANOMALIE — hot
COL_NA     = solid(isLight ? color.new(#7d8496, 0) : color.new(#35435e, 0))


// ┌──────────────────────────────────────────────────────────────────────┐
// │  D_RVOL — carried over unchanged from key-valuation-ratios-table     │
// └──────────────────────────────────────────────────────────────────────┘
// The baseline excludes the current (still-forming) daily bar via the [1]
// shift so a live spike doesn't dilute its own average; the na/zero guards
// stop bogus readings on symbols that publish no volume at all.
float daily_avg_vol      = request.security(syminfo.tickerid, "D", ta.sma(volume, rvol_len)[1])
float daily_volume_total = request.security(syminfo.tickerid, "D", volume)
bool  hasDailyVolume     = not na(daily_volume_total) and not na(daily_avg_vol) and daily_avg_vol != 0
float d_rvol             = hasDailyVolume ? daily_volume_total / daily_avg_vol : na

// Counted on DAILY bars inside the request, not on chart bars: on an intraday
// chart every bar of the same day carries the same D_RVol, so counting chart
// bars would score one busy day dozens of times.
float activeDays = request.security(syminfo.tickerid, "D",
     math.sum((ta.sma(volume, rvol_len)[1] > 0 and volume / ta.sma(volume, rvol_len)[1] >= rvolActifLvl) ? 1 : 0, activeLen))

bool is_high_tf    = not alertOnlyHighTF or (timeframe.isdaily or timeframe.isweekly)
bool alert_trigger = hasDailyVolume and (d_rvol >= rvol_threshold) and is_high_tf

rvolDesc = na(d_rvol) ? "N/A" :
     d_rvol >= rvol_threshold ? "ANOMALIE" :
     d_rvol >= rvolActifLvl   ? "ACTIF"    :
     d_rvol >= rvolNormalLvl  ? "NORMAL"   :
     "SOMMEIL"

rvolIcon = na(d_rvol) ? "➖" :
     d_rvol >= rvol_threshold ? "🔴" :
     d_rvol >= rvolActifLvl   ? "🟠" :
     d_rvol >= rvolNormalLvl  ? "🔵" :
     "🌙"

bandCol = na(d_rvol) ? COL_NA :
     d_rvol >= rvol_threshold ? COL_ANOM :
     d_rvol >= rvolActifLvl   ? COL_ACTIF :
     d_rvol >= rvolNormalLvl  ? COL_NORMAL :
     COL_SLEEP

// Intraday this compares a PARTIAL session against FULL ones, so the reading
// is structurally low until the close. Surfaced rather than hidden — see the
// note at the top of the file.
partialDay = not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  PRESSURE — the up / down split behind the marker's colour           │
// └──────────────────────────────────────────────────────────────────────┘
// Green / red only OUTSIDE the neutral zone. A split of 50.4% is not a
// buy-side day, and colouring it green would make the reading flicker on noise
// while looking authoritative. One set of helpers serves both the daily and
// the weekly figures, so the two can never disagree about what 58% means.
buyLvl  = 50 + pressureBand
sellLvl = 50 - pressureBand

pressLabel(float p) => na(p) ? "N/A" : p >= buyLvl ? "Buy-side" : p <= sellLvl ? "Sell-side" : "Balanced"
pressIcon(float p)  => na(p) ? "➖"  : p >= buyLvl ? "▲" : p <= sellLvl ? "▼" : "◆"
pressColor(float p) => na(p) ? COL_NA :
     p >= buyLvl  ? solid(color.new(#1b5e20, 0)) :
     p <= sellLvl ? solid(color.new(#8c1f1f, 0)) :
     solid(color.new(#8a7300, 0))
// request.security_lower_tf returns one array element per intrabar INSIDE THE
// CURRENT CHART BAR. That is exactly a session on a daily chart, and only a
// fragment of one on an intraday chart — hence the accumulator below.
//
// It cannot be nested inside a request.security(..., "D", ...) call — Pine
// forbids a request.*() inside another request.*() expression — so there is no
// way to ask directly for "today's intrabars" from a 15-minute chart. The
// session totals have to be built up bar by bar instead.
ltfOk = timeframe.in_seconds() > timeframe.in_seconds(splitLtf)

// ignore_invalid_timeframe is what stops a runtime error when you drop to a
// chart at or below the intrabar resolution — a 5-minute chart asking for
// 5-minute intrabars. It returns an empty array instead, which flows straight
// into the close-location fallback below.
upArr = request.security_lower_tf(syminfo.tickerid, splitLtf, close > open ? volume : 0.0, ignore_invalid_timeframe = true)
dnArr = request.security_lower_tf(syminfo.tickerid, splitLtf, close < open ? volume : 0.0, ignore_invalid_timeframe = true)

// array.sum of an empty array is na, which is the signal that no intrabar
// history was returned for this bar — plan limits, or simply too far back.
// Flat intrabars (close == open) are filed on neither side rather than split
// arbitrarily, so up + down can be slightly less than total volume.
barUp = ltfOk ? array.sum(upArr) : na
barDn = ltfOk ? array.sum(dnArr) : na

// Intraday, one chart bar is a fragment of the session, so the day's totals
// are accumulated. Closed bars are committed once via barstate.isconfirmed and
// the still-forming bar is added live — adding it to the accumulator on every
// tick instead would count the same bar hundreds of times.
newSession = ta.change(time("D")) != 0

var float upClosed = 0.0
var float dnClosed = 0.0
if newSession
    upClosed := 0.0
    dnClosed := 0.0

upSession = timeframe.isintraday ? upClosed + nz(barUp) : barUp
dnSession = timeframe.isintraday ? dnClosed + nz(barDn) : barDn

if timeframe.isintraday and barstate.isconfirmed
    upClosed := upClosed + nz(barUp)
    dnClosed := dnClosed + nz(barDn)

pressureIntrabar = (na(upSession) or na(dnSession) or upSession + dnSession <= 0) ? na : upSession / (upSession + dnSession) * 100

// Fallback: where the day closed inside its own range. Deliberately NOT
// "close > open → 100% buying", which would dress a coin flip up as certainty;
// the close location is continuous and is the same quantity the classic
// Accumulation/Distribution line is built on.
[dHigh, dLow, dClose] = request.security(syminfo.tickerid, "D", [high, low, close])
pressureCLV = (na(dHigh) or na(dLow) or na(dClose) or dHigh == dLow) ? na : (dClose - dLow) / (dHigh - dLow) * 100

usingIntrabar = not na(pressureIntrabar)
pressure      = usingIntrabar ? pressureIntrabar : pressureCLV
pressureSrc   = na(pressure) ? "—" : usingIntrabar ? splitLtf : "bar"

pressureLab = pressLabel(pressure)
pressureIcn = pressIcon(pressure)
pressureCol = pressColor(pressure)

// The marker keeps the ANOMALIE colour unless you ask for direction: size is
// something volume can state outright, direction is only ever inferred.
markerCol = (showPressure and markerByPressure) ? pressureCol : COL_ANOM


// ┌──────────────────────────────────────────────────────────────────────┐
// │  WEEK — this week vs last week, on the same logic one scale up       │
// └──────────────────────────────────────────────────────────────────────┘
// Everything the week needs comes out of ONE pass over the daily series. The
// function carries `var` state, so when it is handed to request.security at
// the "D" timeframe it accumulates across the daily bars of each week and
// snapshots the completed week the moment the week number rolls over.
//
// Why not the intrabar split used for the daily Pressure row: that only ever
// returns intrabars of the CURRENT chart bar, and Pine forbids nesting a
// request.*() inside another, so there is no way to ask for five days' worth
// of intrabars. Weekly pressure is therefore built the other honest way —
// each day's volume shared out by where that day CLOSED inside its own range,
// then summed. It is the Accumulation/Distribution weighting, at daily
// granularity rather than a single smeared weekly bar. The block labels it
// "clv" so it is never mistaken for the finer daily estimate.
// The completed weeks are kept in a rolling array, newest first, so the depth
// is a setting rather than a rewrite: raising "Weeks Shown" adds a column and
// nothing else changes. MAX_BACK is the ceiling the arrays and the tuple are
// sized for — the tuple returned from request.security has to be a fixed
// shape, so the depth cannot itself be an input to the calculation, only to
// how much of it gets drawn.
MAX_BACK = 5                     // completed weeks retained
MAX_WEEK_COLS = MAX_BACK + 1     // + the week in progress

weeklyFlow() =>
    var float[] upHist = array.new_float(MAX_BACK, na)
    var float[] dnHist = array.new_float(MAX_BACK, na)
    var float upCur  = 0.0
    var float dnCur  = 0.0
    var int   dayCnt = 0
    // On the roll-over the week that just ended is pushed onto the front of
    // the history and the oldest falls off the back, so index 0 is always
    // "last week" however many weeks the chart has run for.
    if weekofyear != weekofyear[1]
        array.unshift(upHist, upCur)
        array.unshift(dnHist, dnCur)
        array.pop(upHist)
        array.pop(dnHist)
        upCur  := 0.0
        dnCur  := 0.0
        dayCnt := 0
    // A day with no range at all (limit up, halt) has no close location to
    // read, so it is split evenly rather than being assigned a direction the
    // bar never expressed.
    float clv = high == low ? 0.5 : (close - low) / (high - low)
    upCur  := upCur + volume * clv
    dnCur  := dnCur + volume * (1.0 - clv)
    dayCnt := dayCnt + 1
    [upCur, dnCur, dayCnt,
     array.get(upHist, 0), array.get(dnHist, 0),
     array.get(upHist, 1), array.get(dnHist, 1),
     array.get(upHist, 2), array.get(dnHist, 2),
     array.get(upHist, 3), array.get(dnHist, 3),
     array.get(upHist, 4), array.get(dnHist, 4)]

[wUp0, wDn0, wDays, wUp1, wDn1, wUp2, wDn2, wUp3, wDn3, wUp4, wDn4, wUp5, wDn5] = request.security(syminfo.tickerid, "D", weeklyFlow())

// Every week is measured against the weeks BEFORE it, so the offset grows with
// the column: [1] excludes the week in progress, [2] also excludes last week,
// and so on. No week is ever part of its own baseline — the same rule as the
// daily [1] shift, one timeframe up.
[wB0, wB1, wB2, wB3, wB4, wB5] = request.security(syminfo.tickerid, "W",
     [ta.sma(volume, wLen)[1], ta.sma(volume, wLen)[2], ta.sma(volume, wLen)[3],
      ta.sma(volume, wLen)[4], ta.sma(volume, wLen)[5], ta.sma(volume, wLen)[6]])

// Elapsed sessions, capped so a 7-day crypto week under a 5-day setting can
// never scale a figure DOWN — pro-rating is only ever an extrapolation
// forward from an incomplete week.
wDaysIn  = na(wDays) ? 0 : math.min(wDays, wDaysPerWeek)
wPartial = wDaysIn > 0 and wDaysIn < wDaysPerWeek
paceMult = (weekProRate and wPartial) ? wDaysPerWeek * 1.0 / wDaysIn : 1.0

// clv + (1 − clv) = 1, so the two sides always add back to that week's total
// volume: the split costs no extra request and cannot drift from the totals.
// Only column 0 is ever pro-rated — every other week is complete.
wkRVol(float[] ups, float[] dns, float[] bases, int i) =>
    u = array.get(ups, i)
    d = array.get(dns, i)
    b = array.get(bases, i)
    v = (na(u) or na(d)) ? na : u + d
    (na(v) or na(b) or b <= 0) ? na : v / b * (i == 0 ? paceMult : 1.0)

// Pressure is a ratio, so elapsed time cancels out of it: it is never
// pro-rated, and a Monday reading is as valid as a Friday one.
wkPress(float[] ups, float[] dns, int i) =>
    u = array.get(ups, i)
    d = array.get(dns, i)
    (na(u) or na(d) or u + d <= 0) ? na : u / (u + d) * 100

// RESULT — what the participation actually produced.
//
// Measured close-to-close, which is the whole point of it: a close-to-close
// change INCLUDES the gap between weeks, and the close-location estimate
// cannot see gaps at all. A stock that gaps down 6% and then closes near its
// highs scores as buying under CLV while you are 6% under water. Over a
// multi-week hold, gaps are a large share of the move, so a direction reading
// blind to them is the wrong instrument for the horizon.
//
// It is also not an estimate. Nobody has to infer who was buying: if the week
// closed down, sellers won.
//
// Seven closes for six columns — every week is compared with the one before
// it, so the oldest column still needs a predecessor behind it.
[wC0, wC1, wC2, wC3, wC4, wC5, wC6] = request.security(syminfo.tickerid, "W",
     [close, close[1], close[2], close[3], close[4], close[5], close[6]])

wkChange(float[] closes, int i) =>
    c  = array.get(closes, i)
    cp = array.get(closes, i + 1)
    (na(c) or na(cp) or cp <= 0) ? na : (c - cp) / cp * 100

// A week that closed +0.1% is flat, not green. Same reasoning as the pressure
// neutral zone: without a deadband the colour asserts a direction the number
// does not support.
changeCol(float v) => na(v) ? COL_NA :
     v >=  changeFlat ? solid(color.new(#1b5e20, 0)) :
     v <= -changeFlat ? solid(color.new(#8c1f1f, 0)) :
     solid(color.new(#8a7300, 0))

// ── THE READ — effort against result, resolved into one word ────────────
// Volume alone cannot say much, and price alone can be faked by a thin tape.
// Together they answer the only question that matters at a swing horizon: did
// the participation SHOW UP IN PRICE?
//
//              price up        price flat        price down
//   loud       Demand          Absorption        Supply
//   quiet      No Demand       Dormant           No Supply
//
// The names are Wyckoff's, and they are load-bearing rather than decorative.
// "No Supply" — a down week nobody bothered to sell into — is constructive,
// while "No Demand" — an up week nobody bothered to buy into — is not, and a
// generic label like "quiet drift" would collapse that distinction.
//
// EFFORT is judged against the ACTIF rung of the weekly ladder, not a new
// threshold of its own, so the whole instrument still moves from the single
// Weekly ANOMALIE input. RESULT uses the same Flat Zone the Change row is
// coloured by, so the word can never disagree with the cell above it.
readIdx(float rv, float ch) =>
    int out = 0
    if not na(rv) and not na(ch)
        bool loud = rv >= wActifLvl
        bool up   = ch >=  changeFlat
        bool down = ch <= -changeFlat
        out := loud ? (up ? 1 : down ? 3 : 2) : (up ? 4 : down ? 6 : 5)
    out

readWord(int i) => i == 1 ? "Demand" : i == 2 ? "Absorption" : i == 3 ? "Supply" : i == 4 ? "No Demand" : i == 5 ? "Dormant" : i == 6 ? "No Supply" : "N/A"
readIcon(int i) => i == 1 ? "🔥" : i == 2 ? "⚖️" : i == 3 ? "🔻" : i == 4 ? "🎈" : i == 5 ? "💤" : i == 6 ? "🍃" : "➖"

// Colour encodes EFFORT only: hot means the week had participation and is
// worth reading, cool means it did not and the word is just describing quiet.
// So the fastest possible glance — before any word is read — answers "does
// this week matter at all?"
readCol(int i) => i == 1 ? solid(color.new(#1b5e20, 0)) :
     i == 2 ? solid(color.new(#8a7300, 0)) :
     i == 3 ? solid(color.new(#8c1f1f, 0)) :
     i == 0 ? COL_NA : COL_SLEEP

// Column 0 is the week in progress, 1 is last week, 2 the week before that.
wkHdr(int i) => i == 0 ? "THIS" : i == 1 ? "LAST" : "−" + str.tostring(i)

// The weekly ladder keeps the daily ladder's SHAPE — the same ACTIF and NORMAL
// fractions — at its own lower scale, so one threshold still moves everything.
wActifLvl  = wThreshold * rvolActifMult
wNormalLvl = wThreshold * rvolNormalMult

wBandCol(float v) => na(v) ? COL_NA :
     v >= wThreshold ? COL_ANOM :
     v >= wActifLvl  ? COL_ACTIF :
     v >= wNormalLvl ? COL_NORMAL :
     COL_SLEEP


// ┌──────────────────────────────────────────────────────────────────────┐
// │  PLOT                                                                │
// └──────────────────────────────────────────────────────────────────────┘
plot(plotStyle == "Columns" ? d_rvol : na, "D_RVol (columns)", color=bandCol, style=plot.style_columns, linewidth=2)
plot(plotStyle == "Area"    ? d_rvol : na, "D_RVol (area)",    color=bandCol, style=plot.style_area,    linewidth=1)
plot(plotStyle == "Line"    ? d_rvol : na, "D_RVol (line)",    color=bandCol, style=plot.style_line,    linewidth=2)

// 1.0x is the only line that is not a threshold: it is an ordinary day, and
// without it every other level is unanchored.
// hline takes an "input color" — a colour that is fixed before the first bar.
// ink() is a function call, and every function call in Pine returns a SERIES
// value, so these four have to carry literal colours rather than go through
// the theme helpers. They are constants for the same reason the score
// gradients are theme-independent in the scorecard: white-on-hot has to read
// on any chart background, and a line has no text to protect anyway.
hline(showLevels ? 1.0 : na,            "Average day (1.0x)", color=#7f8fa6, linestyle=hline.style_solid)
hline(showLevels ? rvolNormalLvl : na,  "NORMAL level",       color=#2f6f8f, linestyle=hline.style_dotted)
hline(showLevels ? rvolActifLvl : na,   "ACTIF level",        color=#b8860b, linestyle=hline.style_dashed)
hline(showLevels ? rvol_threshold : na, "ANOMALIE level",     color=#c0392b, linestyle=hline.style_dashed)

plotshape(showMarker and alert_trigger,
     title     = "ANOMALIE marker",
     style     = shape.triangleup,
     location  = location.belowbar,
     color     = markerCol,
     size      = size.small,
     text      = "VOL",
     textcolor = ink(color.new(#ffffff, 0)),
     force_overlay = true)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  CARD                                                                │
// └──────────────────────────────────────────────────────────────────────┘
posFromString(string s) =>
    s == "Top Left"      ? position.top_left      :
     s == "Top Center"    ? position.top_center    :
     s == "Top Right"     ? position.top_right     :
     s == "Middle Left"   ? position.middle_left   :
     s == "Middle Center" ? position.middle_center :
     s == "Middle Right"  ? position.middle_right  :
     s == "Bottom Left"   ? position.bottom_left   :
     s == "Bottom Center" ? position.bottom_center :
     position.bottom_right

// COLUMN MAP — every index is derived, so the card is exactly as wide as the
// content asks for and not one column wider:
//
//   [0] gutter
//   [1] label
//   [2] the value on daily rows · THIS on week rows
//   [3 .. lastValCol] the remaining week columns
//   [3 .. statusEnd]  the daily rows' status text, MERGED across that same span
//   [C_END] gutter + the ⓘ badge
//
// The daily status shares the week columns rather than sitting in a lane of its
// own past them. A dedicated status column meant every daily row had to reach
// across the unused week columns to get to it, which is the empty gap between
// the value and the status text. Merging instead puts the status immediately
// beside the value, and lets a long string like "15% above ACTIF" occupy space
// the week block already needs — so it costs nothing and saves the column the
// status used to have to itself.
C_LABEL = 1
C_VAL   = 2

// How many of the six week columns are in play. Nothing may be written beyond
// this: a table column collapses to zero width only while NOTHING has been
// written to it, and a cell painted with an empty string still counts as
// written.
weekCols   = showWeek ? math.min(weeksShown, MAX_WEEK_COLS) : 1
lastValCol = C_VAL + weekCols - 1
C_STATUS   = C_VAL + 1                          // status starts right of the value
statusEnd  = math.max(C_STATUS, lastValCol)     // ... and runs to the last week column
C_END      = statusEnd + 1

var table card = table.new(
     posFromString(tblPosIn), 10, 14,
     bgcolor      = COL_OUTER_BG,
     border_width = 1,
     frame_width  = 2,
     frame_color  = frameCol,
     border_color = COL_BORDER_IN,
     force_overlay = true
     )

// Paints a row's band before any content goes on top — without it a row that
// writes fewer columns than the weekly block leaves transparent gaps and the
// banding breaks. It paints the columns IN USE and stops, so the unused week
// columns stay collapsed.
paintRow(int row, color bg, int h) =>
    table.cell(card, 0, row, "", bgcolor=COL_OUTER_BG, height=h)
    for c = C_LABEL to statusEnd
        table.cell(card, c, row, "", bgcolor=bg, height=h)
    table.cell(card, C_END, row, "", bgcolor=COL_OUTER_BG, height=h)

// Writes a daily row's status and stretches it across the week columns beside
// it. The merge is what removes the gap: without it the text would sit in one
// column and the rest of the span would stay blank.
//
// Merging the same cells twice is a runtime error, and this table is rebuilt on
// every realtime tick — table.clear() at the top of the draw block is what
// makes that safe, by dissolving the previous merge before it is remade.
statusCell(int row, string txt, color bg, color txtCol, string tip, bool alignRight) =>
    table.cell(card, C_STATUS, row, txt, bgcolor=bg, text_color=txtCol, text_size=txtSize, text_halign = alignRight ? text.align_right : text.align_left, tooltip=tip)
    if statusEnd > C_STATUS
        table.merge_cells(card, C_STATUS, row, statusEnd, row)

// Share counts run to ten digits, which is unreadable at a glance and makes
// the card as wide as the pane. Everything is abbreviated to three
// significant figures — the magnitude is the information, not the units digit.
fmtVol(float v) =>
     na(v)       ? "N/A" :
     v >= 1e12   ? str.tostring(v / 1e12, "#.##") + "T" :
     v >= 1e9    ? str.tostring(v / 1e9,  "#.##") + "B" :
     v >= 1e6    ? str.tostring(v / 1e6,  "#.##") + "M" :
     v >= 1e3    ? str.tostring(v / 1e3,  "#.##") + "K" :
     str.tostring(v, "#")

methodTooltip = "HOW D_RVol IS BUILT\n\n" +
     "① TODAY — the running total of today's DAILY volume, requested at the daily timeframe whatever chart you are on.\n\n" +
     "② BASELINE — the mean daily volume of the " + str.tostring(rvol_len) + " sessions BEFORE today. Today is excluded from its own average: leave it in and a genuine spike dilutes the very number it is measured against, so the biggest days under-report themselves.\n\n" +
     "③ D_RVol = today ÷ baseline. 1.00x is an ordinary day.\n\n" +
     "④ BANDS — set as fractions of the ANOMALIE threshold, so moving that one number moves the whole ladder and the bands can never cross:\n" +
     "• 🔴 ANOMALIE ≥ " + str.tostring(rvol_threshold, "#.##") + "x\n" +
     "• 🟠 ACTIF ≥ "    + str.tostring(rvolActifLvl, "#.##") + "x  (" + str.tostring(rvolActifMult * 100, "#") + "% of threshold)\n" +
     "• 🔵 NORMAL ≥ "   + str.tostring(rvolNormalLvl, "#.##") + "x  (" + str.tostring(rvolNormalMult * 100, "#") + "% of threshold)\n" +
     "• 🌙 SOMMEIL below that\n\n" +
     "⑤ ACTIVE — how many of the last " + str.tostring(activeLen) + " sessions closed at or above the ACTIF level. One loud day is an event; a third of the month above ACTIF is a campaign, and that is the reading that matters for position building.\n\n" +
     "WHY ALWAYS DAILY — every figure is pulled at the daily timeframe rather than off the chart's bars, so the number means the same thing on a 5-minute chart as on a weekly one. A plain relative-volume calculation answers a different question at every timeframe you switch to.\n\n" +
     "D_RVol IS NOT DIRECTION — it counts shares, not intent. Every trade has a buyer and a seller, so a big number means unusual URGENCY and DISAGREEMENT, never 'buying'.\n\n" +
     (showPressure ?
     "PRESSURE — the direction estimate, and it IS an estimate.\n" +
     "• Currently from: " + (usingIntrabar ? splitLtf + "-minute intrabars — the session is cut into bars and each one's volume is filed up (close > open) or down (close < open). Pressure = up ÷ (up + down). This measures WHERE the volume traded, which is real; it does not measure who initiated it, which no Pine script can see." : "the daily bar's close location, (close − low) ÷ (high − low). Intrabar history was not available — too far back, or your plan's intrabar quota is spent — so it fell back to the classic Accumulation/Distribution proxy. Cruder, and the card says 'bar' rather than a resolution so you always know which one you are reading.") + "\n" +
     "• ▲ Buy-side ≥ " + str.tostring(buyLvl, "#") + "% · ▼ Sell-side ≤ " + str.tostring(sellLvl, "#") + "% · ◆ Balanced between. The neutral zone exists because a 50.4% split is not a buy-side day, and colouring it green would flicker on noise while looking authoritative.\n" +
     "• Flat intrabars (close == open) are filed on neither side rather than split arbitrarily, so up + down can be a little under total volume.\n\n"
     : "") +
     (partialDay ? "\n\n⚠ PARTIAL SESSION — you are on an intraday chart, so this compares a day still in progress against " + str.tostring(rvol_len) + " completed ones. It reads low early and climbs through the session by construction; only at the close is it comparing like with like." : "")

weekTooltip = "THE WEEK BLOCK — same two questions as the daily rows, one timeframe up.\n\n" +
     "W_RVol = that week's total volume ÷ the average of the " + str.tostring(wLen) + " weeks BEFORE it. The week being measured is never part of its own baseline, exactly as today is excluded from the daily one.\n\n" +
     "WHY A WEEK IS WORTH ITS OWN BLOCK — a single loud day is usually an event: an earnings print, an index rebalance, one block trade. A loud WEEK is participation that survived several sessions and a weekend, which is much harder to manufacture and much closer to the thing you are actually looking for.\n\n" +
     "BANDS — " + str.tostring(wThreshold, "#.##") + "x ANOMALIE · " + str.tostring(wActifLvl, "#.##") + "x ACTIF · " + str.tostring(wNormalLvl, "#.##") + "x NORMAL. Lower than the daily ladder on purpose: averaging five sessions cancels their individual noise, so weekly relative volume sits much closer to 1.0 and a 2.0x week is far rarer than a 2.0x day.\n\n" +
     "THIS WEEK — " + str.tostring(wDaysIn) + " of " + str.tostring(wDaysPerWeek) + " sessions are in. " +
     ((weekProRate and wPartial) ? "The figure is scaled to a full-week pace (× " + str.tostring(paceMult, "#.##") + ") and marked ≈. Treat a run-rate built from one or two sessions as a hint, not a reading." : wPartial ? "The figure is the RAW partial total, so it reads low against the completed weeks beside it — turn on \"Pro-rate the Partial Week\" to see it as a pace instead." : "The week is complete, so no adjustment is applied.") + "\n\n" +
     "PRESSURE · clv — this one is NOT the intrabar split used in the daily row above, and the label says so. Intrabars are only available for the current chart bar, and Pine forbids nesting one request inside another, so five days of them cannot be reached. Instead each day's volume is shared out by where that day CLOSED inside its own range and the days are summed — the Accumulation/Distribution weighting, at daily granularity.\n" +
     "▲ Buy-side ≥ " + str.tostring(buyLvl, "#") + "% · ▼ Sell-side ≤ " + str.tostring(sellLvl, "#") + "% · ◆ Balanced between.\n" +
     "It is never pro-rated: a ratio has elapsed time on both sides, so a Monday reading is as valid as a Friday one.\n\n" +
     "READING ACROSS — two columns tell you whether something CHANGED; three or more tell you whether it is a TREND, which is the only reason to go past LAST. One loud week between two quiet ones is an event. Three weeks climbing, each above the one before with pressure staying ▲, is accumulation — and it is the pattern a single week cannot show you no matter how extreme it is.\n\n" +
     "This week loud and buy-side against a quiet previous week is a fresh bid. Weeks loud in sequence with pressure flipping ▼ → ▲ is a hand-over. Loud in sequence and all ▼ is distribution, however good the fundamentals card looks.\n\n" +
     "THE READ ROW — W_RVol is the EFFORT, Change is the RESULT, and the read is simply the two of them together:\n" +
     "• 🔥 Demand — loud, price up. The move has fuel.\n" +
     "• ⚖️ Absorption — loud, price flat. Someone is taking the other side of everything. The one to stop on.\n" +
     "• 🔻 Supply — loud, price down. Sellers won it.\n" +
     "• 🎈 No Demand — quiet, price up. A rally nobody participated in.\n" +
     "• 💤 Dormant — quiet, price flat. Nothing is happening.\n" +
     "• 🍃 No Supply — quiet, price down. Nobody bothered to sell into it, which is constructive.\n\n" +
     "A week counts as loud at or above the ACTIF rung (" + str.tostring(wActifLvl, "#.##") + "x) and as flat inside ±" + str.tostring(changeFlat, "#.#") + "%, both taken from the settings the two rows above are already coloured by — so the word can never disagree with the cells it sits under.\n\n" +
     "The names are Wyckoff's and the distinctions are load-bearing: No Supply, a down week nobody bothered to sell into, is constructive, while No Demand, an up week nobody bothered to buy into, is not. A single generic label for \"quiet\" would lose exactly that.\n\n" +
     "READ THE SEQUENCE, NOT THE CELL. 🔻🔻⚖️ is supply that has stopped being absorbed. 🔥🔥🔥 is a trend with participation behind it. 🎈 after a long advance is a rally running on nobody, whatever the price says. And a row of cool colours means this block has nothing to tell you this month — which is itself an answer, and the most common one."

if barstate.islast and showTable
    // Dissolves last tick's merged status cells before they are remade.
    // Without this the second call to table.merge_cells on the same range is a
    // runtime error, and this card is rebuilt on every realtime tick.
    table.clear(card, 0, 0, 9, 13)

    int r = 0

    // header
    paintRow(r, accentCol, 0)
    table.cell(card, C_LABEL, r, "VOLUME", bgcolor=accentCol, text_color=COL_TXT_HEADER, text_size=txtSize, text_halign=text.align_left, text_formatting=text.format_bold, tooltip=methodTooltip)
    statusCell(r, partialDay ? "⚠ intraday" : "daily", accentCol, partialDay ? ink(color.new(#ffcf6b, 0)) : COL_TXT_HEADER, methodTooltip, true)
    table.cell(card, C_END,   r, showHelp ? "ⓘ" : "", bgcolor = showHelp ? accentCol : COL_OUTER_BG, text_color=COL_TXT_HEADER, text_size=txtSize, text_halign=text.align_center, tooltip = showHelp ? methodTooltip : "")
    r := r + 1

    // D_RVol — the headline, painted in its band colour
    paintRow(r, COL_ROW_EVEN, 0)
    table.cell(card, C_LABEL, r, "D_RVol", bgcolor=COL_ROW_EVEN, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=methodTooltip)
    table.cell(card, C_VAL,   r, na(d_rvol) ? "N/A" : str.tostring(d_rvol, "#.##") + "x", bgcolor=bandCol, text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=methodTooltip)
    statusCell(r, rvolIcon + " " + rvolDesc, COL_ROW_EVEN, COL_TXT, methodTooltip, false)
    r := r + 1

    // direction estimate — sits directly under D_RVol because it is what the
    // marker's colour is reading, and a colour with no number behind it is not
    // something anyone should trade on
    if showPressure
        paintRow(r, COL_ROW_ODD, 0)
        table.cell(card, C_LABEL, r, "Pressure", bgcolor=COL_ROW_ODD, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=methodTooltip)
        table.cell(card, C_VAL,   r, na(pressure) ? "N/A" : str.tostring(pressure, "#") + "%", bgcolor=pressureCol, text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=methodTooltip)
        statusCell(r, pressureIcn + " " + pressureLab + " · " + pressureSrc, COL_ROW_ODD, usingIntrabar ? COL_TXT : COL_TXT_DIM, methodTooltip, false)
        r := r + 1

    // today's shares
    paintRow(r, COL_ROW_ODD, 0)
    table.cell(card, C_LABEL, r, "Today", bgcolor=COL_ROW_ODD, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=methodTooltip)
    table.cell(card, C_VAL,   r, fmtVol(daily_volume_total), bgcolor=COL_ROW_ODD, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_right, tooltip=methodTooltip)
    statusCell(r, "shares", COL_ROW_ODD, COL_TXT_DIM, methodTooltip, false)
    r := r + 1

    // the baseline it is being measured against
    paintRow(r, COL_ROW_EVEN, 0)
    table.cell(card, C_LABEL, r, "Avg " + str.tostring(rvol_len) + "D", bgcolor=COL_ROW_EVEN, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=methodTooltip)
    table.cell(card, C_VAL,   r, fmtVol(daily_avg_vol), bgcolor=COL_ROW_EVEN, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_right, tooltip=methodTooltip)
    statusCell(r, "baseline", COL_ROW_EVEN, COL_TXT_DIM, methodTooltip, false)
    r := r + 1

    // one loud day is an event; many is a campaign
    activeTxt = na(activeDays) ? "N/A" : str.tostring(activeDays, "#") + "/" + str.tostring(activeLen)
    activePct = na(activeDays) ? na : activeDays / activeLen
    paintRow(r, COL_ROW_ODD, 0)
    table.cell(card, C_LABEL, r, "Active " + str.tostring(activeLen) + "D", bgcolor=COL_ROW_ODD, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=methodTooltip)
    table.cell(card, C_VAL,   r, activeTxt, bgcolor=COL_ROW_ODD, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=methodTooltip)
    statusCell(r, na(activePct) ? "" : str.tostring(activePct * 100, "#") + "% above ACTIF", COL_ROW_ODD, COL_TXT_DIM, methodTooltip, false)
    r := r + 1

    // ── WEEK ──
    // A sub-table across columns rather than a row per week: the question is
    // always "this against the ones before it", and side by side makes that
    // comparison the shape of the block instead of something you do in your
    // head. Both weekly rows are driven by the same loop, so the column count
    // is a setting and adding depth costs nothing.
    if showWeek
        wkUp   = array.from(wUp0, wUp1, wUp2, wUp3, wUp4, wUp5)
        wkDn   = array.from(wDn0, wDn1, wDn2, wDn3, wDn4, wDn5)
        wkBase  = array.from(wB0,  wB1,  wB2,  wB3,  wB4,  wB5)
        wkClose = array.from(wC0, wC1, wC2, wC3, wC4, wC5, wC6)

        // separator — painted through the same helper so it can never reach a
        // column the rest of the card leaves collapsed
        paintRow(r, COL_DIVIDER, 1)
        r := r + 1

        // sub-header
        paintRow(r, accentCol, 0)
        table.cell(card, C_LABEL, r, "WEEK" + (wDaysIn > 0 ? "  " + str.tostring(wDaysIn) + "/" + str.tostring(wDaysPerWeek) + "d" : ""), bgcolor=accentCol, text_color=COL_TXT_HEADER, text_size=txtSize, text_halign=text.align_left, text_formatting=text.format_bold, tooltip=weekTooltip)
        for i = 0 to weekCols - 1
            table.cell(card, C_VAL + i, r, wkHdr(i) + ((i == 0 and weekProRate and wPartial) ? " ≈" : ""), bgcolor=accentCol, text_color=COL_TXT_HEADER, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=weekTooltip)
        r := r + 1

        // W_RVol per week
        paintRow(r, COL_ROW_EVEN, 0)
        table.cell(card, C_LABEL, r, "W_RVol", bgcolor=COL_ROW_EVEN, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=weekTooltip)
        for i = 0 to weekCols - 1
            v = wkRVol(wkUp, wkDn, wkBase, i)
            table.cell(card, C_VAL + i, r, na(v) ? "N/A" : str.tostring(v, "#.##") + "x", bgcolor=wBandCol(v), text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=weekTooltip)
        r := r + 1

        // result per week — the other half of effort vs result
        if showWeekChange
            r := r + 1
            paintRow(r, COL_ROW_ODD, 0)
            table.cell(card, C_LABEL, r, "Change", bgcolor=COL_ROW_ODD, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=weekTooltip)
            for i = 0 to weekCols - 1
                ch = wkChange(wkClose, i)
                table.cell(card, C_VAL + i, r, na(ch) ? "N/A" : (ch > 0 ? "+" : "") + str.tostring(ch, "#.#") + "%", bgcolor=changeCol(ch), text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=weekTooltip)

        // the read — effort and result resolved into one word per week
        if readStyle != "Off"
            r := r + 1
            paintRow(r, COL_ROW_EVEN, 0)
            // In Icon-only mode the current week's word moves into the row
            // label, so you still get it in full without every week column
            // having to be wide enough to hold "Absorption".
            thisRead = readIdx(wkRVol(wkUp, wkDn, wkBase, 0), wkChange(wkClose, 0))
            table.cell(card, C_LABEL, r, readStyle == "Icon only" ? "Read · " + readWord(thisRead) : "Read", bgcolor=COL_ROW_EVEN, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, text_formatting=text.format_bold, tooltip=weekTooltip)
            for i = 0 to weekCols - 1
                ri = readIdx(wkRVol(wkUp, wkDn, wkBase, i), wkChange(wkClose, i))
                table.cell(card, C_VAL + i, r, readStyle == "Icon only" ? readIcon(ri) : readIcon(ri) + " " + readWord(ri), bgcolor=readCol(ri), text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=weekTooltip)

        // pressure per week — off by default, see the input's tooltip
        if showWeekPressure
            r := r + 1
            paintRow(r, COL_ROW_EVEN, 0)
            table.cell(card, C_LABEL, r, "Pressure · clv", bgcolor=COL_ROW_EVEN, text_color=COL_TXT, text_size=txtSize, text_halign=text.align_left, tooltip=weekTooltip)
            for i = 0 to weekCols - 1
                p = wkPress(wkUp, wkDn, i)
                table.cell(card, C_VAL + i, r, na(p) ? "N/A" : pressIcon(p) + " " + str.tostring(p, "#") + "%", bgcolor=pressColor(p), text_color=COL_TXT_ON_BG, text_size=txtSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=weekTooltip)


// ┌──────────────────────────────────────────────────────────────────────┐
// │  ALERTS                                                              │
// └──────────────────────────────────────────────────────────────────────┘
if alert_trigger
    alert("Explosion de volume (Daily) sur " + syminfo.ticker + " ! D_RVol: " + str.tostring(d_rvol, "#.##") + "x", alert.freq_once_per_bar_close)

alertcondition(alert_trigger, title="Volume Explosion", message="Daily volume explosion on {{ticker}} — D_RVol above threshold.")
