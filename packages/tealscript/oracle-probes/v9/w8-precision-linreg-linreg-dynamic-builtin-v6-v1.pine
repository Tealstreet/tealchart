//@version=6
indicator("Coverage ta-b 1 v1 (60 plots)", overlay=false, precision=10, max_bars_back=200)
// Export all loaded chart rows starting at bar_index 0; minimum 80 historical bars.
// All 60 plots are data-window-only. No HMA length1, float period, or series-simple argument.
// Explicit int casts are LEGAL CONTROLS, not tests of the original forbidden argument.

p = bar_index % 16
dyn_source = p == 0 ? 1.0 : p == 1 ? 3.0 : p == 2 ? 2.0 : p == 3 ? 8.0 : p == 4 ? 4.0 : p == 5 ? 9.0 : p == 6 ? 5.0 : p == 7 ? 11.0 : p == 8 ? 7.0 : p == 9 ? 13.0 : p == 10 ? 6.0 : p == 11 ? 15.0 : p == 12 ? 4.0 : p == 13 ? 17.0 : p == 14 ? 10.0 : 19.0
q = bar_index % 8
fall_source = q == 0 ? 8.0 : q == 1 ? 6.0 : q == 2 ? 7.0 : q == 3 ? 5.0 : q == 4 ? 5.0 : q == 5 ? 4.0 : q == 6 ? 3.0 : 2.0
dynamic_length = p < 5 ? 2 : int(3.0)
hole_source = bar_index == 40 or bar_index == 41 ? float(na) : close
_v9_original_plot_000 = open
_v9_original_plot_001 = high
_v9_original_plot_002 = low
_v9_original_plot_003 = close
_v9_original_plot_004 = volume
_v9_original_plot_005 = bar_index
_v9_original_plot_006 = dyn_source
_v9_original_plot_007 = fall_source
_v9_original_plot_008 = dynamic_length
_v9_original_plot_009 = hole_source
f_manual_dev(src, n) =>
    result = float(na)
    if bar_index >= n - 1
        total = 0.0
        for i = 0 to n - 1
            total := total + src[i]
        mean = total / n
        deviation = 0.0
        for i = 0 to n - 1
            deviation := deviation + math.abs(src[i] - mean)
        result := deviation / n
    result
f_manual_extreme(src, n, upper) =>
    result = float(na)
    offset = float(na)
    if bar_index >= n - 1
        result := src
        offset := 0.0
        for i = 1 to n - 1
            value = src[i]
            better = upper ? value > result : value < result
            if better
                result := value
                offset := -i
    [result, offset]
f_manual_linreg(src, n) =>
    result = float(na)
    if bar_index >= n - 1
        sx = 0.0
        sy = 0.0
        sxy = 0.0
        sxx = 0.0
        for i = 0 to n - 1
            x = float(i)
            y = src[n - 1 - i]
            sx := sx + x
            sy := sy + y
            sxy := sxy + x * y
            sxx := sxx + x * x
        slope = (n * sxy - sx * sy) / (n * sxx - sx * sx)
        intercept = (sy - slope * sx) / n
        result := intercept + slope * (n - 1)
    result
f_manual_falling(src, n) =>
    result = false
    if bar_index >= n
        result := true
        for i = 1 to n
            if src >= src[i]
                result := false
    result
[manual_hi, manual_hibars] = f_manual_extreme(dyn_source, dynamic_length, true)
[manual_lo, manual_lobars] = f_manual_extreme(dyn_source, dynamic_length, false)
_v9_original_plot_010 = ta.dev(dyn_source, dynamic_length)
_v9_original_plot_011 = f_manual_dev(dyn_source,dynamic_length)
_v9_original_plot_012 = ta.highest(dyn_source, dynamic_length)
_v9_original_plot_013 = manual_hi
_v9_original_plot_014 = ta.lowest(dyn_source, dynamic_length)
_v9_original_plot_015 = manual_lo
_v9_original_plot_016 = ta.linreg(dyn_source, dynamic_length, 0)
_v9_original_plot_017 = f_manual_linreg(dyn_source,dynamic_length)
_v9_original_plot_018 = ta.highestbars(dyn_source, dynamic_length)
_v9_original_plot_019 = manual_hibars
_v9_original_plot_020 = ta.lowestbars(dyn_source, dynamic_length)
_v9_original_plot_021 = manual_lobars
_v9_original_plot_022 = ta.falling(fall_source, dynamic_length) ? 1 : 0
_v9_original_plot_023 = f_manual_falling(fall_source,dynamic_length) ? 1 : 0
pine_dev(source, length) =>
    mean = ta.sma(source, length)
    sum = 0.0
    for i = 0 to length - 1
        val = source[i]
        sum := sum + math.abs(val - mean)
    dev = sum/length
pine_ema(src, length) =>
    alpha = 2 / (length + 1)
    sum = 0.0
    sum := na(sum[1]) ? src : alpha * src + (1 - alpha) * nz(sum[1])
f_kc(src, length, mult, useTrueRange) =>
    float basis = ta.ema(src, length)
    float span = (useTrueRange) ? ta.tr : (high - low)
    float rangeEma = ta.ema(span, length)
    [basis, basis + rangeEma * mult, basis - rangeEma * mult]
f_kcw(src, length, mult, useTrueRange) =>
    float basis = ta.ema(src, length)
    float span = (useTrueRange) ? ta.tr : (high - low)
    float rangeEma = ta.ema(span, length)

    ((basis + rangeEma * mult) - (basis - rangeEma * mult)) / basis
_v9_original_plot_024 = ta.dev(close,10)
_v9_original_plot_025 = pine_dev(close,10)
_v9_original_plot_026 = f_manual_dev(close,10)
ema15_alpha = 2.0 / 16
ema15_inline = 0.0
ema15_inline := na(ema15_inline[1]) ? close : ema15_alpha * close + (1 - ema15_alpha) * nz(ema15_inline[1])
_v9_original_plot_027 = ta.ema(close,15)
_v9_original_plot_028 = pine_ema(close,15)
_v9_original_plot_029 = ema15_inline
[kc_omit_mid, kc_omit_up, kc_omit_lo] = ta.kc(close,5,4)
[kc_true_mid, kc_true_up, kc_true_lo] = ta.kc(close,5,4,true)
[kc_false_mid, kc_false_up, kc_false_lo] = ta.kc(close,5,4,false)
[kc_doc_mid, kc_doc_up, kc_doc_lo] = f_kc(close,5,4,true)
_v9_original_plot_030 = kc_omit_mid
_v9_original_plot_031 = kc_omit_up
_v9_original_plot_032 = kc_omit_lo
_v9_original_plot_033 = kc_true_mid
_v9_original_plot_034 = kc_true_up
_v9_original_plot_035 = kc_true_lo
_v9_original_plot_036 = kc_false_mid
_v9_original_plot_037 = kc_false_up
_v9_original_plot_038 = kc_false_lo
_v9_original_plot_039 = kc_doc_mid
_v9_original_plot_040 = kc_doc_up
_v9_original_plot_041 = kc_doc_lo
_v9_original_plot_042 = ta.ema(ta.tr,5)
_v9_original_plot_043 = ta.ema(close,5)
_v9_original_plot_044 = ta.kcw(close,5,4)
_v9_original_plot_045 = ta.kcw(close,5,4,true)
_v9_original_plot_046 = ta.kcw(close,5,4,false)
_v9_original_plot_047 = f_kcw(close,5,4,true)
f_ema_reseed_control(src, n) =>
    alpha = 2.0 / (n + 1)
    result = 0.0
    result := na(result[1]) ? src : alpha * src + (1 - alpha) * nz(result[1])
    result
var float hole_hold_state = na
var float hole_sma_state = na
var float hole_seed_sum = 0.0
var int hole_seed_count = 0
if not na(hole_source)
    hole_hold_state := na(hole_hold_state) ? hole_source : (2.0 / 15) * hole_source + (13.0 / 15) * hole_hold_state
    if hole_seed_count < 14
        hole_seed_count := hole_seed_count + 1
        hole_seed_sum := hole_seed_sum + hole_source
        if hole_seed_count == 14
            hole_sma_state := hole_seed_sum / 14
    else
        hole_sma_state := (2.0 / 15) * hole_source + (13.0 / 15) * hole_sma_state
_v9_original_plot_048 = ta.ema(hole_source,14)
_v9_original_plot_049 = pine_ema(hole_source,14)
_v9_original_plot_050 = na(hole_source) ? float(na) : hole_hold_state
_v9_original_plot_051 = f_ema_reseed_control(hole_source,14)
_v9_original_plot_052 = na(hole_source) ? float(na) : hole_sma_state
[dmi_cast_plus, dmi_cast_minus, dmi_cast_adx] = ta.dmi(int(3.0),int(3.0))
[kc_cast_mid, kc_cast_up, kc_cast_lo] = ta.kc(close,int(3.0),2.0,true)
[macd_cast_line, macd_cast_signal, macd_cast_hist] = ta.macd(close,int(3.0),int(5.0),int(3.0))
_v9_original_plot_053 = dmi_cast_plus
_v9_original_plot_054 = ta.ema(close,int(3.0))
_v9_original_plot_055 = ta.hma(close,int(3.0))
_v9_original_plot_056 = kc_cast_mid
_v9_original_plot_057 = ta.kcw(close,int(3.0),2.0,true)
_v9_original_plot_058 = macd_cast_line
_v9_original_plot_059 = ta.linreg(close,3,int(3.0))

plot(_v9_original_plot_000, "input_open", display=display.data_window)
plot(_v9_original_plot_001, "input_high", display=display.data_window)
plot(_v9_original_plot_002, "input_low", display=display.data_window)
plot(_v9_original_plot_003, "input_close", display=display.data_window)
plot(_v9_original_plot_004, "input_volume", display=display.data_window)
plot(_v9_original_plot_005, "input_bar_index", display=display.data_window)
plot(_v9_original_plot_006, "input_dynamic_source", display=display.data_window)
plot(_v9_original_plot_007, "input_falling_source", display=display.data_window)
plot(_v9_original_plot_008, "input_dynamic_length", display=display.data_window)
plot(_v9_original_plot_009, "input_ema_hole_source", display=display.data_window)
plot(_v9_original_plot_016, "linreg_dynamic_builtin", display=display.data_window)
plot(na(_v9_original_plot_016) ? 1 : 0, "V9_TARGET_NA", display=display.data_window)
_v9_match_0 = time == 1788135240000 and bar_index == 7
plot(_v9_match_0 ? 1 : 0, "V9_MATCH_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_016 == 9.333333333333332 ? 1 : 0) : na, "V9_EQ_0", display=display.data_window)
plot(_v9_match_0 ? (_v9_original_plot_016 - 9.333333333333332) * 1e11 : na, "V9_RESIDUAL_0", display=display.data_window)
_v9_match_1 = time == 1788136080000 and bar_index == 14
plot(_v9_match_1 ? 1 : 0, "V9_MATCH_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_016 == 13.333333333333332 ? 1 : 0) : na, "V9_EQ_1", display=display.data_window)
plot(_v9_match_1 ? (_v9_original_plot_016 - 13.333333333333332) * 1e11 : na, "V9_RESIDUAL_1", display=display.data_window)
_v9_match_2 = time == 1788137160000 and bar_index == 23
plot(_v9_match_2 ? 1 : 0, "V9_MATCH_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_016 == 9.333333333333332 ? 1 : 0) : na, "V9_EQ_2", display=display.data_window)
plot(_v9_match_2 ? (_v9_original_plot_016 - 9.333333333333332) * 1e11 : na, "V9_RESIDUAL_2", display=display.data_window)
_v9_match_3 = time == 1788138000000 and bar_index == 30
plot(_v9_match_3 ? 1 : 0, "V9_MATCH_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_016 == 13.333333333333332 ? 1 : 0) : na, "V9_EQ_3", display=display.data_window)
plot(_v9_match_3 ? (_v9_original_plot_016 - 13.333333333333332) * 1e11 : na, "V9_RESIDUAL_3", display=display.data_window)
_v9_match_4 = time == 1788139080000 and bar_index == 39
plot(_v9_match_4 ? 1 : 0, "V9_MATCH_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_016 == 9.333333333333332 ? 1 : 0) : na, "V9_EQ_4", display=display.data_window)
plot(_v9_match_4 ? (_v9_original_plot_016 - 9.333333333333332) * 1e11 : na, "V9_RESIDUAL_4", display=display.data_window)
plot(time, "V9_TIME_MS", display=display.data_window)
plot(bar_index, "V9_BAR_INDEX", display=display.data_window)
