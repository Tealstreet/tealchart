//@version=6
indicator("V49 qualifier-consumer-controls")
consumeString(simple string sampleText) => str.length(sampleText)
consumeNumber(simple int sampleNumber) => sampleNumber
consumeBool(simple bool sampleBool) => sampleBool ? 1 : 0
sourceText = input.string("abXab", "Source text")
sourceBool = input.bool(true, "Source bool")
sourceNumber = input.int(3, "Source number", minval=1, maxval=4)
activeBool = input.bool(true, "Direct bool active", active=sourceBool)
activeComparison = input.bool(true, "Input comparison active", active=sourceText == "abXab")
plot(close, "WIDTH_CONTROL", linewidth=sourceNumber)
plot(consumeString("ab"), "SIMPLE_CONST_STRING")
plot(consumeString(sourceText), "SIMPLE_INPUT_STRING")
plot(consumeString(syminfo.ticker), "SIMPLE_SYMBOL_STRING")
plot(consumeNumber(sourceNumber), "SIMPLE_INPUT_INT")
plot(consumeBool(sourceBool), "SIMPLE_INPUT_BOOL")
plot(activeBool ? 1 : 0, "ACTIVE_DIRECT")
plot(activeComparison ? 1 : 0, "ACTIVE_COMPARISON")
plot(bar_index, "INDEX")
plot(close, "CONTROL_CLOSE")
