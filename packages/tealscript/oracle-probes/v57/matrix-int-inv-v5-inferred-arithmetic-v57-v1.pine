//@version=5
indicator("matrix-int-inv-v5-inferred-arithmetic-v57-v1", precision=16)
m = matrix.new<int>(2, 2, 0)
matrix.set(m, 0, 0, 2)
matrix.set(m, 1, 1, 4)
r = matrix.inv(m)
a = matrix.get(r, 0, 0)
b = matrix.get(r, 1, 1)
plot(a, "VALUE_A")
plot(b, "VALUE_B")
plot(a / 2, "DIV_A_2")
plot(b / 2, "DIV_B_2")
plot(a * 3, "MUL_A_3")
