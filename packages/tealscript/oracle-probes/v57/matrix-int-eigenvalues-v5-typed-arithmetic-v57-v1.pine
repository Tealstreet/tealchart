//@version=5
indicator("matrix-int-eigenvalues-v5-typed-arithmetic-v57-v1", precision=16)
m = matrix.new<int>(2, 2, 0)
matrix.set(m, 0, 0, 1)
matrix.set(m, 0, 1, 1)
matrix.set(m, 1, 0, 1)
array<int> r = matrix.eigenvalues(m)
a = array.get(r, 0)
b = array.get(r, 1)
plot(a, "VALUE_A")
plot(b, "VALUE_B")
plot(a / 2, "DIV_A_2")
plot(b / 2, "DIV_B_2")
plot(a * 3, "MUL_A_3")
