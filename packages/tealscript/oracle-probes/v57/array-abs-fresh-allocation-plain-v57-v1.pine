//@version=6
indicator("Array abs allocation plain")
a = array.from(-2, 3)
b = a.abs()
plot(a.get(0), "SOURCE_BEFORE")
plot(b.get(0), "RESULT_BEFORE")
b.set(0, 17)
plot(a.get(0), "SOURCE_AFTER_RESULT_EDIT")
a.set(1, -7)
plot(b.get(1), "RESULT_AFTER_SOURCE_EDIT")
b.push(9)
plot(a.size(), "SOURCE_SIZE")
plot(b.size(), "RESULT_SIZE")
