//@version=6
indicator("Even extracted matrix median")
parent = matrix.new<float>(3, 4, 97.0)
parent.set(1, 1, -31.0)
parent.set(1, 2, 5.0)
parent.set(2, 1, 17.0)
parent.set(2, 2, -8.0)
m = parent.submatrix(1, 3, 1, 3)
plot(matrix.median(m), "EVEN_MEDIAN")
plot(matrix.elements_count(m), "ELEMENT_COUNT")
