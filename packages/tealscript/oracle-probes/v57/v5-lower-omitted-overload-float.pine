//@version=5
indicator("Default method context frame")
method width(array<int> values) => values.size()
method width(array<float> values) => values.size() + 3
seed = array.new_float(2, 1.5)

read(value = seed.width()) => value

values = request.security_lower_tf("REMOTE:ALT", "1", read())
value = array.size(values) > 0 ? array.get(values, 0) : na
plot(value, "Length")