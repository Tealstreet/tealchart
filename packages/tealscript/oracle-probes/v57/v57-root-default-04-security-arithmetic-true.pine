//@version=5
indicator("Default context discriminator")
enum Side
    up = "UP TITLE"
make() =>
    values = map.new<string, Side>()
    values.put("k", Side.up)
    values
show(values = make()) => str.tostring(values.get("k"))
value = request.security("REMOTE:VERIFY", "1", show())
plot(close + 0, "Activation")
plot(value == "UP TITLE" ? 1 : 0, "Match")
plot(str.length(value), "Length")