//@version=6
indicator("Integer fractional moments v57 v1", precision=16)
i = array.from(-3, 2)
f = array.from(-3.0, 2.0)
mi = matrix.new<int>(1, 2, -3)
mi.set(0, 1, 2)
mf = matrix.new<float>(1, 2, -3.0)
mf.set(0, 1, 2.0)
plot(i.avg(), "INT_AVG")
plot(f.avg(), "FLOAT_AVG")
plot(i.stdev(), "INT_STDEV")
plot(f.stdev(), "FLOAT_STDEV")
plot(i.variance(), "INT_VARIANCE")
plot(f.variance(), "FLOAT_VARIANCE")
plot(mi.avg(), "INT_MATRIX_AVG")
plot(mf.avg(), "FLOAT_MATRIX_AVG")
