//@version=6
indicator("v43 ta-c-separated-missing-ranks-v1", precision=16)
phase = bar_index % 12
pattern = array.from(9.0, 1.0, na, 8.0, na, 2.0, 7.0, na, 3.0, 6.0, 4.0, 5.0)
src = array.get(pattern, phase)
plot(src, "SOURCE")
plot(ta.percentile_nearest_rank(src, 5, 25), "NEAREST25")
plot(ta.percentile_nearest_rank(src, 5, 50), "NEAREST50")
plot(ta.percentile_nearest_rank(src, 5, 75), "NEAREST75")
plot(ta.percentile_linear_interpolation(src, 5, 25), "LINEAR25")
plot(ta.percentile_linear_interpolation(src, 5, 50), "LINEAR50")
plot(ta.percentile_linear_interpolation(src, 5, 75), "LINEAR75")
plot(ta.percentrank(src, 5), "PERCENTRANK5")
plot(bar_index, "INDEX")
plot(phase, "PHASE")
