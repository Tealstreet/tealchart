//@version=6
indicator("TealScript Timenow Trace V1", overlay = false, max_bars_back = 500)

// Acquisition:
// 1. Open a live chart, paste this script, add it to the chart, and open Pine Logs.
// 2. Copy TS_TRACE_V1 lines after initial load.
// 3. Reload the chart or wait for a realtime update, then copy the new TS_TRACE_V1 lines.
// 4. Save the copied Pine Logs text with the symbol, timeframe, timezone, and session.

trace_session = input.string("session_001", "Trace session")
chart_session = input.string("regular_or_extended", "Chart session")
timezone_label = input.string("exchange", "Timezone")

varip int update_seq = 0
if barstate.isnew
    update_seq := 0
else
    update_seq += 1

bool_to_int(value) =>
    value ? 1 : 0

num_to_string(value) =>
    na(value) ? "na" : str.tostring(value)

emit_trace() =>
    "TS_TRACE_V1" +
      " schema=1" +
      " kind=timenow" +
      " declaredVersion=6" +
      " traceSession=" + trace_session +
      " script=tradingview-timenow-trace-v1" +
      " symbol=" + syminfo.tickerid +
      " timeframe=" + timeframe.period +
      " chartSession=" + chart_session +
      " timezone=" + timezone_label +
      " updateSeq=" + str.tostring(update_seq) +
      " barIndex=" + str.tostring(bar_index) +
      " time=" + str.tostring(time) +
      " timeClose=" + str.tostring(time_close) +
      " timenow=" + str.tostring(timenow) +
      " open=" + num_to_string(open) +
      " high=" + num_to_string(high) +
      " low=" + num_to_string(low) +
      " close=" + num_to_string(close) +
      " volume=" + num_to_string(volume) +
      " isnew=" + str.tostring(bool_to_int(barstate.isnew)) +
      " isrealtime=" + str.tostring(bool_to_int(barstate.isrealtime)) +
      " isconfirmed=" + str.tostring(bool_to_int(barstate.isconfirmed)) +
      " islast=" + str.tostring(bool_to_int(barstate.islast)) +
      " islastconfirmedhistory=" + str.tostring(bool_to_int(barstate.islastconfirmedhistory))

if barstate.islast or barstate.islastconfirmedhistory
    log.info(emit_trace())

plot(timenow, "ts_trace__timenow")
plot(time, "ts_trace__time")
plot(time_close, "ts_trace__time_close")
plot(barstate.isrealtime ? 1 : 0, "ts_trace__barstate_isrealtime")
