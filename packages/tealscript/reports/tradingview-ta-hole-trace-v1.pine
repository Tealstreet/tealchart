//@version=6
indicator("TealScript TA Hole Trace V1", overlay = false, max_bars_back = 200)

// Export chart data after adding this indicator. Save the CSV together with:
// symbol, exchange, timeframe, timezone, chart session, and visible OHLCV range.

trace_source =
     bar_index < 3 ? na :
     bar_index == 7 ? na :
     bar_index >= 11 and bar_index <= 13 ? na :
     bar_index >= 17 and bar_index <= 21 ? 50.0 :
     bar_index % 6 == 0 ? 55.0 :
     bar_index % 6 == 1 ? 45.0 :
     bar_index % 6 == 2 ? 58.0 :
     bar_index % 6 == 3 ? 42.0 :
     bar_index % 6 == 4 ? 61.0 :
     39.0

cross_source =
     bar_index < 3 ? na :
     bar_index == 8 ? na :
     bar_index >= 12 and bar_index <= 14 ? na :
     bar_index % 4 == 0 ? 40.0 :
     bar_index % 4 == 1 ? 60.0 :
     bar_index % 4 == 2 ? 35.0 :
     65.0

cross_reference =
     bar_index < 3 ? na :
     bar_index == 8 ? na :
     bar_index >= 12 and bar_index <= 14 ? na :
     50.0

vwap_source =
     bar_index < 3 ? na :
     bar_index == 9 ? na :
     bar_index >= 15 and bar_index <= 17 ? na :
     trace_source

stoch_high = na(trace_source) ? na : bar_index >= 17 and bar_index <= 21 ? trace_source : trace_source + 5.0
stoch_low = na(trace_source) ? na : bar_index >= 17 and bar_index <= 21 ? trace_source : trace_source - 5.0
vwap_anchor = bar_index % 10 == 0

[bb_basis, bb_upper, bb_lower] = ta.bb(trace_source, 3, 2.0)

plot(bar_index, "ts_trace__bar_index")
plot(time, "ts_trace__time")
plot(open, "ts_trace__open")
plot(high, "ts_trace__high")
plot(low, "ts_trace__low")
plot(close, "ts_trace__close")
plot(volume, "ts_trace__volume")
plot(trace_source, "ts_trace__source")
plot(cross_source, "ts_trace__cross_source")
plot(cross_reference, "ts_trace__cross_reference")
plot(vwap_source, "ts_trace__vwap_source")
plot(stoch_high, "ts_trace__stoch_high")
plot(stoch_low, "ts_trace__stoch_low")
plot(ta.crossover(cross_source, cross_reference) ? 1.0 : 0.0, "ts_trace__ta_crossover")
plot(ta.crossunder(cross_source, cross_reference) ? 1.0 : 0.0, "ts_trace__ta_crossunder")
plot(ta.cross(cross_source, cross_reference) ? 1.0 : 0.0, "ts_trace__ta_cross")
plot(bb_basis, "ts_trace__ta_bb_basis")
plot(bb_upper, "ts_trace__ta_bb_upper")
plot(bb_lower, "ts_trace__ta_bb_lower")
plot(ta.rsi(trace_source, 3), "ts_trace__ta_rsi")
plot(ta.stoch(trace_source, stoch_high, stoch_low, 3), "ts_trace__ta_stoch")
plot(ta.vwap(vwap_source, vwap_anchor), "ts_trace__ta_vwap")
